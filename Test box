local screenGui = make("ScreenGui", {
	Name = randomName(20),
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	DisplayOrder = 2147483647, -- above every other GUI
	OnTopOfCoreBlur = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, nil)
screenGui:SetAttribute(TAG, "Toggle")
CollectionService:AddTag(screenGui, TAG)
parentGui(screenGui)

local function viewport()
	local size = screenGui.AbsoluteSize
	if size.X < 1 or size.Y < 1 then
		size = workspace.CurrentCamera.ViewportSize
	end
	return size
end

local function fitSize(size)
	local v = viewport()
	return Vector2.new(
		math.min(size.X, v.X - SCREEN_MARGIN * 2),
		math.min(size.Y, v.Y - SCREEN_MARGIN * 2)
	)
end

local function clampCenter(center, size)
	local v = viewport()
	local half = size / 2
	local minX, minY = half.X + SCREEN_MARGIN, half.Y + SCREEN_MARGIN
	return Vector2.new(
		math.clamp(center.X, minX, math.max(minX, v.X - minX)),
		math.clamp(center.Y, minY, math.max(minY, v.Y - minY))
	)
end

-- Both versions use the same size and the same SPAWN point, so they appear in the exact same spot
local startSize = fitSize(START_SIZE)
local v0 = viewport()
local startCenter = clampCenter(Vector2.new(v0.X * SPAWN.X, v0.Y * SPAWN.Y), startSize)

-- Holder: the thing that moves and resizes. Everything lives inside it.
local holder = make("Frame", {
	Name = "Holder",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromOffset(startCenter.X, startCenter.Y),
	Size = UDim2.fromOffset(startSize.X, startSize.Y),
	BackgroundTransparency = 1,
}, screenGui)

local popScale = make("UIScale", { Name = "PopScale", Scale = 0.7 }, holder)

-- Glow: soft image behind the box
