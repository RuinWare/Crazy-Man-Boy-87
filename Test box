local GLOW_COLOR = Color3.new(1, 1, 1)
local GLOW_SPREAD = 36                          -- how far the glow reaches past the box (pixels)
local GLOW_BRIGHTNESS = 0.9                     -- 0 to 1
local SCREEN_MARGIN = 6                         -- the box always stays this far inside the screen
local RUN_OFF_CODE_ON_DESTROY = true          -- run the OFF code if the GUI is destroyed while ON

