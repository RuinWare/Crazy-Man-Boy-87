--!nonstrict
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local PlayerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

local Pill = {}
Pill.__index = Pill

function Pill.new(props)
    local self = setmetatable({
        title = props.title or "RuinWare",
        subtitle = props.subtitle or "Tap to show",
        icon = props.icon or "rbxassetid://10734895456",
        onShow = props.onShow,
        onHide = props.onHide,
        onClick = props.onClick,
        visible = false,
    }, Pill)
    self:_build()
    return self
end

function Pill:_build()
    self.gui = Instance.new("ScreenGui")
    self.gui.Name = HttpService:GenerateGUID(false)
    self.gui.IgnoreGuiInset = true
    self.gui.ResetOnSpawn = false
    self.gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    self.gui.Parent = PlayerGui

    -- Perfect pill shape (Sized compactly: 240x72)
    self.main = Instance.new("Frame")
    self.main.Size = UDim2.fromOffset(240, 72)
    self.main.Position = UDim2.new(0.5, 0, 0.85, 0)
    self.main.AnchorPoint = Vector2.new(0.5, 0.5)
    self.main.BackgroundColor3 = Color3.fromRGB(22, 22, 24)
    self.main.BackgroundTransparency = 1
    self.main.BorderSizePixel = 0
    self.main.Visible = false
    self.main.Parent = self.gui

    -- 180 Degree Rounding
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = self.main

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 60, 65)
    stroke.Transparency = 1
    stroke.Parent = self.main

    -- Circular Icon Background (Properly sized at 52x52)
    local iconBg = Instance.new("Frame")
    iconBg.Size = UDim2.fromOffset(52, 52)
    iconBg.Position = UDim2.new(0, 10, 0.5, 0)
    iconBg.AnchorPoint = Vector2.new(0, 0.5)
    iconBg.BackgroundColor3 = Color3.fromRGB(35, 35, 38)
    iconBg.BackgroundTransparency = 1
    iconBg.Parent = self.main
    
    local iconCorner = Instance.new("UICorner")
    iconCorner.CornerRadius = UDim.new(1, 0)
    iconCorner.Parent = iconBg

    -- Icon Image
    local iconImg = Instance.new("ImageLabel")
    iconImg.Size = UDim2.fromOffset(28, 28)
    iconImg.Position = UDim2.fromScale(0.5, 0.5)
    iconImg.AnchorPoint = Vector2.new(0.5, 0.5)
    iconImg.BackgroundTransparency = 1
    iconImg.Image = self.icon
    iconImg.ImageColor3 = Color3.fromRGB(255, 255, 255)
    iconImg.ImageTransparency = 1
    iconImg.Parent = iconBg

    -- Text
    local textContainer = Instance.new("Frame")
    textContainer.Size = UDim2.new(1, -80, 1, 0)
    textContainer.Position = UDim2.new(0, 74, 0, 0)
    textContainer.BackgroundTransparency = 1
    textContainer.Parent = self.main

    local layout = Instance.new("UIListLayout")
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = textContainer

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 22)
    title.BackgroundTransparency = 1
    title.Text = self.title
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextSize = 22
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.TextTransparency = 1
    title.LayoutOrder = 1
    title.Parent = textContainer

    local subtitle = Instance.new("TextLabel")
    subtitle.Size = UDim2.new(1, 0, 0, 18)
    subtitle.BackgroundTransparency = 1
    subtitle.Text = self.subtitle
    subtitle.TextColor3 = Color3.fromRGB(160, 160, 165)
    subtitle.TextSize = 18
    subtitle.Font = Enum.Font.GothamMedium
    subtitle.TextXAlignment = Enum.TextXAlignment.Left
    subtitle.TextTransparency = 1
    subtitle.LayoutOrder = 2
    subtitle.Parent = textContainer

    -- Interaction (Click + Drag)
    local interact = Instance.new("TextButton")
    interact.Size = UDim2.fromScale(1, 1)
    interact.BackgroundTransparency = 1
    interact.Text = ""
    interact.TextTransparency = 1
    interact.Parent = self.main

    local dragging, moved = false, false
    local startMouse, startPos

    interact.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            startMouse = UserInputService:GetMouseLocation()
            startPos = self.main.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local currentMouse = UserInputService:GetMouseLocation()
            local delta = currentMouse - startMouse
            if delta.Magnitude > 5 then
                moved = true
            end
            if moved then
                self.main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                if not moved and self.onClick then
                    task.spawn(self.onClick)
                end
            end
        end
    end)

    self.reveal = {self.main, iconBg, iconImg, title, subtitle, stroke}
end

-- 2. TRIGGER VIS
function Pill:Show()
    if self.visible then return end
    self.visible = true
    self.main.Visible = true

    local info = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    TweenService:Create(self.main, info, {BackgroundTransparency = 0}):Play()
    TweenService:Create(self.main.UIStroke, info, {Transparency = 0.8}):Play()
    TweenService:Create(self.main:FindFirstChildOfClass("Frame"), info, {BackgroundTransparency = 0}):Play()
    TweenService:Create(self.main:FindFirstChildOfClass("Frame"):FindFirstChildOfClass("ImageLabel"), info, {ImageTransparency = 0}):Play()
    
    local textContainer = self.main:FindFirstChildOfClass("Frame")
    for _, v in ipairs(textContainer:GetChildren()) do
        if v:IsA("TextLabel") then
            TweenService:Create(v, info, {TextTransparency = v.Name == "TextLabel" and 0 or 0.2}):Play()
        end
    end

    if self.onShow then task.spawn(self.onShow) end
end

-- 3. TRIGGER OFF
function Pill:Hide()
    if not self.visible then return end
    self.visible = false

    local info = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    TweenService:Create(self.main, info, {BackgroundTransparency = 1}):Play()
    TweenService:Create(self.main.UIStroke, info, {Transparency = 1}):Play()
    TweenService:Create(self.main:FindFirstChildOfClass("Frame"), info, {BackgroundTransparency = 1}):Play()
    TweenService:Create(self.main:FindFirstChildOfClass("Frame"):FindFirstChildOfClass("ImageLabel"), info, {ImageTransparency = 1}):Play()
    
    local textContainer = self.main:FindFirstChildOfClass("Frame")
    for _, v in ipairs(textContainer:GetChildren()) do
        if v:IsA("TextLabel") then
            TweenService:Create(v, info, {TextTransparency = 1}):Play()
        end
    end

    task.delay(0.3, function()
        if not self.visible then
            self.main.Visible = false
        end
    end)

    if self.onHide then task.spawn(self.onHide) end
end

return Pill
