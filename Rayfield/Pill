local Pill = {}
Pill.__index = Pill

function Pill.new(props)
    local self = setmetatable({
        showName = props.title or "Rayfield",
        showSubtitle = props.subtitle or "Tap to show",
        showIcon = props.icon or "rbxassetid://10734895456",
        showIconOnly = false,
        onShow = props.onShow,
        onHide = props.onHide,
        onClick = props.onClick,
        hidden = true, -- true means it accepts clicks
        animating = false,
        connections = {},
        themeProperties = {},
    }, Pill)

    self:_build()
    return self
end

function Pill:_build()
    -- 1. ScreenGui (No dimming background)
    self.screenGui = Instance.new("ScreenGui")
    self.screenGui.Name = HttpService:GenerateGUID(false)
    self.screenGui.IgnoreGuiInset = true
    self.screenGui.ResetOnSpawn = false
    self.screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    self.screenGui.Parent = variables.guiContainer

    -- 2. Main Pill Frame (Exact size from your window.lua: 185x50)
    self.main = self:Create("Frame", {
        Name = "Pill",
        Size = UDim2.fromOffset(185, 50),
        Position = UDim2.new(0.5, 0, 0.85, 0), -- Default bottom center
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.fromRGB(22, 22, 24),
        BackgroundTransparency = 1,
        Visible = false,
        BorderSizePixel = 0,
        Parent = self.screenGui,
    })

    -- Exact 180 degree roundness
    self:Create("UICorner", { Parent = self.main }).CornerRadius = UDim.new(1, 0)
    
    -- Subtle stroke matching Rayfield
    local stroke = self:Create("UIStroke", { Parent = self.main })
    stroke.Color = Color3.fromRGB(60, 60, 65)
    stroke.Transparency = 1

    -- 3. Build the exact face from your chrome.lua
    chrome.buildCollapsedFace(self)
    
    -- Initial state setup
    self.collapsedInteract.Visible = true
    chrome.setCollapsedShown(self, false, nil)
end

-- Mock Create function so your exact code works
function Pill:Create(className, props, themeMap)
    local inst = Instance.new(className)
    if props then
        for k, v in pairs(props) do
            if k ~= "Parent" and typeof(v) ~= "table" then -- Skip theme tables
                inst[k] = v
            end
        end
    end
    if themeMap then
        for prop, spec in pairs(themeMap) do
            local key = if typeof(spec) == "table" then spec[1] else spec
            if key == "TitlingColor" then inst[prop] = Color3.fromRGB(255, 255, 255)
            elseif key == "ContentColor" then inst[prop] = Color3.fromRGB(180, 180, 185)
            elseif key == "PillCornerRadius" then inst[prop] = UDim.new(1,0)
            end
        end
    end
    if props and props.Parent then inst.Parent = props.Parent end
    return inst
end

function Pill:Connect(signal, callback)
    local conn = signal:Connect(callback)
    table.insert(self.connections, conn)
    return conn
end

-- Called by the drag logic when clicked
function Pill:ToggleHide()
    if self.animating then return end
    if self.onClick then
        task.spawn(self.onClick)
    end
end

-- 2. TRIGGER VIS
function Pill:Show()
    if not self.hidden then return end
    self.hidden = false
    self.animating = true
    
    self.main.Visible = true
    local fadeInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    
    -- Fade in the background frame
    TweenService:Create(self.main, fadeInfo, { BackgroundTransparency = 0 }):Play()
    if self.main:FindFirstChildOfClass("UIStroke") then
        TweenService:Create(self.main:FindFirstChildOfClass("UIStroke"), fadeInfo, { Transparency = 0.9 }):Play()
    end
    
    -- Fade in the text/icon using your exact function
    chrome.setCollapsedShown(self, true, fadeInfo)
    
    task.delay(0.3, function() self.animating = false end)
    if self.onShow then task.spawn(self.onShow) end
end

-- 3. TRIGGER OFF
function Pill:Hide()
    if self.hidden then return end
    self.hidden = true
    self.animating = true
    
    local fadeInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    
    -- Fade out the background frame
    TweenService:Create(self.main, fadeInfo, { BackgroundTransparency = 1 }):Play()
    if self.main:FindFirstChildOfClass("UIStroke") then
        TweenService:Create(self.main:FindFirstChildOfClass("UIStroke"), fadeInfo, { Transparency = 1 }):Play()
    end
    
    -- Fade out text/icon using your exact function
    chrome.setCollapsedShown(self, false, fadeInfo)
    
    task.delay(0.3, function()
        if self.hidden then
            self.main.Visible = false
            self.animating = false
        end
    end)
    
    if self.onHide then task.spawn(self.onHide) end
end

return Pill
