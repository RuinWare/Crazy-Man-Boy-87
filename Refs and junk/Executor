local settingsFades = snapshotFor(settingsPanel)
local settingsToken = 0

-- Opens / closes the Settings menu. While it is open no file shows as selected.
function setSettingsOpen(open)
	if open == settingsOpen then return end
	settingsOpen = open
	settingsToken += 1
	local token = settingsToken
	closeMenu()
	hideToast()
	editor:ReleaseFocus()
	applySelection()

	if open then
		for _, dropdown in ipairs(allDropdowns) do dropdown.close() end
		settingsPanel.Visible = true
		setGroup(settingsFades, 1)
		fadeGroup(settingsFades, true, 0.25)
		task.delay(0.27, function()
			if token ~= settingsToken or not settingsOpen then return end
			editorPanel.Visible = false
			for _, refresh in ipairs(settingRefreshers) do refresh() end
		end)
	else
		editorPanel.Visible = true
		fadeGroup(settingsFades, false, 0.2)
		task.delay(0.22, function()
			if token == settingsToken and not settingsOpen then settingsPanel.Visible = false end
		end)
	end
end
