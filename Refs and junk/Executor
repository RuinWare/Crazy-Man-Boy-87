-- Liquid glass, built like a thick piece of glass instead of a flat sheet:
--   1. an outer rim that is bright where the light hits (top-left, bottom-right) and dim on the sides
--   2. a second, softer rim just inside it, so the edge has thickness
--   3. a small glossy highlight along the top edge
--   4. a soft shade along the bottom edge, like light passing through
-- opts: noGloss, noDepth, glossH, glossInset, depthH
-- Returns the outer stroke and a list of every glass part (so it can be faded in and out).
local function glass(frame, radius, strength, opts)
	strength = strength or 1
	opts = opts or {}
	local parts = {}
	local function track(obj, prop)
		parts[#parts + 1] = { obj, prop, obj[prop] }
	end
	local function soft(t)
		return 1 - (1 - t) * strength
	end
	local innerRadius = radius
	if radius.Scale == 0 then innerRadius = UDim.new(0, math.max(2, radius.Offset - 2)) end

	-- 1) outer rim
	local stroke = make("UIStroke", {
		Name = "GlassStroke",
		Color = WHITE,
		Thickness = 1.6,
		Transparency = soft(0.3),
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, frame)
	make("UIGradient", {
		Rotation = 40,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.22, 0.55),
			NumberSequenceKeypoint.new(0.5, 0.88),
			NumberSequenceKeypoint.new(0.78, 0.55),
			NumberSequenceKeypoint.new(1, 0.12),
		}),
	}, stroke)
	track(stroke, "Transparency")

	-- 2) inner rim
	local rim = make("Frame", {
		Name = "GlassInner",
		Position = UDim2.fromOffset(2, 2),
		Size = UDim2.new(1, -4, 1, -4),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 1,
	}, frame)
	corner(rim, innerRadius)
	local rimStroke = make("UIStroke", {
		Color = WHITE,
		Thickness = 1,
		Transparency = soft(0.72),
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, rim)
	make("UIGradient", {
		Rotation = 220,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.1),
			NumberSequenceKeypoint.new(0.45, 0.85),
			NumberSequenceKeypoint.new(1, 0.45),
		}),
	}, rimStroke)
	track(rimStroke, "Transparency")

	-- 3) glossy highlight along the top edge
	if not opts.noGloss then
		local gloss = make("Frame", {
			Name = "GlassGloss",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 3),
			Size = UDim2.new(1, -(opts.glossInset or 18), 0, opts.glossH or 14),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0,
			BorderSizePixel = 0,
			ZIndex = 1,
		}, frame)
		corner(gloss, UDim.new(1, 0))
		make("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, soft(0.8)),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}, gloss)
		track(gloss, "BackgroundTransparency")
	end

	-- 4) soft shade along the bottom edge
	if not opts.noDepth then
		local depth = make("Frame", {
			Name = "GlassDepth",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -3),
			Size = UDim2.new(1, -(opts.glossInset or 18), 0, opts.depthH or 14),
			BackgroundColor3 = BLACK,
			BackgroundTransparency = 0,
			BorderSizePixel = 0,
			ZIndex = 1,
		}, frame)
		corner(depth, UDim.new(1, 0))
		make("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(1, soft(0.8)),
			}),
		}, depth)
		track(depth, "BackgroundTransparency")
	end

	return stroke, parts
end

-- A soft shadow behind something (the glow image recolored black, sliced so resizing never stretches it)
local function makeShadow(parent, spread, transparency, zindex)
	local shadow = make("ImageLabel", {
		Name = "Shadow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, spread * 0.35),
		Size = UDim2.new(1, spread * 2, 1, spread * 2),
		BackgroundTransparency = 1,
		Image = SHADOW_ASSET,
		ImageColor3 = BLACK,
		ImageTransparency = transparency,
		ScaleType = Enum.ScaleType.Stretch,
		ZIndex = zindex,
	}, parent)
	task.spawn(function()
		local deadline = os.clock() + 5
		while shadow.Parent and os.clock() < deadline do
			local ok, size = pcall(function() return shadow.ContentImageSize end)
			if not ok then return end
			if size.X > 0 and size.Y > 0 then
				local sx, sy = size.X * 0.4, size.Y * 0.4
				shadow.SliceCenter = Rect.new(sx, sy, size.X - sx, size.Y - sy)
				shadow.SliceScale = math.max(spread, 1) / sx
				shadow.ScaleType = Enum.ScaleType.Slice
				return
			end
			task.wait(0.05)
		end
	end)
	return shadow
end

-- Fading groups of things in and out (without blurring text): remember each value, then tween it
local function snapshotFor(root)
	local list = {}
	local function add(obj, prop)
		list[#list + 1] = { obj, prop, obj[prop] }
	end
	local function visit(obj)
		if obj:IsA("GuiObject") then
			add(obj, "BackgroundTransparency")
			if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
				add(obj, "TextTransparency")
			end
			if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
				add(obj, "ImageTransparency")
			end
		elseif obj:IsA("UIStroke") then
			add(obj, "Transparency")
		end
	end
	visit(root)
	for _, d in ipairs(root:GetDescendants()) do visit(d) end
	return list
end

local function setGroup(list, value)
	for _, item in ipairs(list) do item[1][item[2]] = value end
end

local function fadeGroup(list, visible, duration)
	for _, item in ipairs(list) do
		tween(item[1], duration, { [item[2]] = visible and item[3] or 1 }, Enum.EasingStyle.Quad)
	end
end

-- Custom scroll thumb: a thin bar that fades in while you scroll, follows the scroll position,
-- and can be dragged. Returns functions to refresh it.
local function makeScrollbar(scroll, host, rightInset, topInset, bottomInset, zindex)
	local track = make("Frame", {
		Name = "ScrollTrack",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -rightInset, 0, topInset),
		Size = UDim2.new(0, 10, 1, -(topInset + bottomInset)),
		BackgroundTransparency = 1,
		ZIndex = zindex,
	}, host)
	local thumb = make("TextButton", {
		Name = "Thumb",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromOffset(10, 30),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Selectable = false,
		ZIndex = zindex,
	}, track)
	local bar = make("Frame", {
		Name = "Bar",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 4, 1, 0),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = zindex,
	}, thumb)
	corner(bar, UDim.new(1, 0))
	bind(bar, "BackgroundColor3", "icon")

	local fadeToken = 0
	local dragging = false

	local function show()
		fadeToken += 1
		local token = fadeToken
		tween(bar, 0.15, { BackgroundTransparency = 0.45 }, Enum.EasingStyle.Quad)
		task.delay(0.9, function()
			if token == fadeToken and not dragging then
				tween(bar, 0.45, { BackgroundTransparency = 1 }, Enum.EasingStyle.Sine)
			end
		end)
	end

	local function metrics()
		return scroll.AbsoluteWindowSize.Y, scroll.AbsoluteCanvasSize.Y, track.AbsoluteSize.Y
	end

	local function update()
		local viewH, contentH, trackH = metrics()
		if contentH <= viewH + 1 or trackH < 10 then
			thumb.Visible = false
			return
		end
		thumb.Visible = true
		local thumbH = math.max(28, trackH * viewH / contentH)
		local alpha = math.clamp(scroll.CanvasPosition.Y / (contentH - viewH), 0, 1)
		thumb.Size = UDim2.fromOffset(10, thumbH)
		thumb.Position = UDim2.new(0.5, 0, 0, alpha * (trackH - thumbH))
	end

	scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		update()
		show()
	end)
	scroll:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(update)
	scroll:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(update)
	track:GetPropertyChangedSignal("AbsoluteSize"):Connect(update)
	thumb.MouseEnter:Connect(show)

	thumb.InputBegan:Connect(function(input)
		if not isPress(input) then return end
		dragging = true
		show()
		local startY = p2(input).Y
		local startCanvas = scroll.CanvasPosition.Y
		local connection
		connection = UserInputService.InputChanged:Connect(function(change)
			if change.UserInputType ~= Enum.UserInputType.MouseMovement and change ~= input then return end
			local viewH, contentH, trackH = metrics()
			local thumbH = math.max(28, trackH * viewH / contentH)
			local movable = trackH - thumbH
			if movable <= 0 then return end
			local maxScroll = contentH - viewH
			local target = startCanvas + (p2(change).Y - startY) * (maxScroll / movable)
			scroll.CanvasPosition = Vector2.new(scroll.CanvasPosition.X, math.clamp(target, 0, maxScroll))
		end)
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				connection:Disconnect()
				show()
			end
		end)
	end)

	update()
	return { update = update, show = show }
end

-- Button feel: press squish and a shimmer across the glass
local function attachPress(button, scale, down)
	down = down or 0.94
	button.InputBegan:Connect(function(input)
		if isPress(input) then tween(scale, 0.1, { Scale = down }, Enum.EasingStyle.Quad) end
	end)
	button.InputEnded:Connect(function(input)
		if isPress(input) then tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back) end
    	end)
    end
end
