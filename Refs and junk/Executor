function layout()
	layoutDirty = false
	local w, h = sizeCur.X, sizeCur.Y
	local contentW = math.max(100, w - PAD * 2)
	local contentH = math.max(60, h - HEADER_H - FOOT_H)
	local maxSide = math.max(MIN_SIDEBAR, contentW - MIN_EDITOR - GAP)
	local sideW = math.floor(math.clamp(data.sidebar * contentW, MIN_SIDEBAR, maxSide))
	local editorW = math.floor(math.max(80, contentW - sideW - GAP))
	local cH = math.floor(contentH)
	lastSideW = sideW

	sidebar.Position = UDim2.fromOffset(PAD, HEADER_H)
	sidebar.Size = UDim2.fromOffset(sideW, cH)
	editorPanel.Position = UDim2.fromOffset(PAD + sideW + GAP, HEADER_H)
	editorPanel.Size = UDim2.fromOffset(editorW, cH)
	divider.Position = UDim2.fromOffset(PAD + sideW + GAP / 2, HEADER_H + cH / 2)
	divider.Size = UDim2.fromOffset(GAP + 8, cH)
	toast.Size = UDim2.fromOffset(math.floor(math.clamp(w - 60, 220, 480)), 0)
end

----------------------------------------------------------------
-- Colored code (Lua syntax highlighting)
----------------------------------------------------------------
local COLORS = {
	default = "#d4d4d4", keyword = "#c586c0", constant = "#569cd6", builtin = "#4fc1d9",
	func = "#dcdcaa", property = "#9cdcfe", string = "#98c379", number = "#d19a66",
	comment = "#6b6b76", operator = "#b9b9c2", error = "#ff5555", flash = "#000000",
}

local function toSet(words)
	local set = {}
	for word in words:gmatch("%S+") do set[word] = true end
	return set
end

local KEYWORDS = toSet("and break do else elseif end for function if in local not or repeat return then until while continue")
local CONSTANTS = toSet("true false nil")
local BUILTINS = toSet([[
game workspace script task math string table os coroutine utf8 bit32 debug print warn error assert pcall xpcall select
type typeof tostring tonumber pairs ipairs next require setmetatable getmetatable rawget rawset rawequal rawlen unpack
loadstring Instance Vector2 Vector3 CFrame Color3 UDim UDim2 Enum Ray Rect BrickColor TweenInfo NumberSequence
ColorSequence NumberRange Random wait spawn delay tick time shared _G _VERSION getgenv gethui self
]])

local RICH_ESCAPES = { ["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;", ['"'] = "&quot;", ["'"] = "&apos;" }
local function escapeRich(text)
	return (text:gsub("[&<>\"']", RICH_ESCAPES))
end

-- Returns one string of colored text for every line of the code
local function highlightLines(code, errorLine, flashedLine)
	local lines = { {} }
	local line = 1

	local function emit(text, color)
		local start = 1
		while true do
			local newline = text:find("\n", start, true)
			local piece = text:sub(start, (newline or (#text + 1)) - 1)
			if piece ~= "" then
				local current = lines[line]
				if piece:find("^%s+$") then
					current[#current + 1] = piece
				else
					local use = color
					if line == flashedLine then
						use = COLORS.flash
					elseif line == errorLine and color ~= COLORS.comment then
						use = COLORS.error
					end
					current[#current + 1] = '<font color="' .. use .. '">' .. escapeRich(piece) .. "</font>"
				end
			end
			if not newline then break end
			line += 1
			lines[line] = {}
			start = newline + 1
		end
	end

	local i, n = 1, #code
	local prevText, prevWord = "", ""
	while i <= n do
		local c = code:sub(i, i)
		if c:find("%s") then
			local stop = (code:find("[^%s]", i) or (n + 1)) - 1
			emit(code:sub(i, stop), COLORS.default)
			i = stop + 1
		elseif c == "-" and code:sub(i + 1, i + 1) == "-" then
			local level = code:match("^%-%-%[(=*)%[", i)
			local stop
			if level then
				local _, closeAt = code:find("]" .. level .. "]", i + 4 + #level, true)
				stop = closeAt or n
			else
				stop = (code:find("\n", i, true) or (n + 1)) - 1
			end
			emit(code:sub(i, stop), COLORS.comment)
			i = stop + 1
			prevText = "--"
		elseif c == '"' or c == "'" then
			local j = i + 1
			local stop = n
			while j <= n do
				local d = code:sub(j, j)
				if d == "\\" then
					j += 2
				elseif d == c then
					stop = j
					break
				elseif d == "\n" then
					stop = j - 1
					break
				else
					j += 1
				end
			end
			emit(code:sub(i, stop), COLORS.string)
			i = stop + 1
			prevText = "str"
		elseif c == "[" and code:find("^%[=*%[", i) then
			local level = code:match("^%[(=*)%[", i)
			local _, closeAt = code:find("]" .. level .. "]", i + 2 + #level, true)
			local stop = closeAt or n
			emit(code:sub(i, stop), COLORS.string)
			i = stop + 1
			prevText = "str"
		elseif c:find("%d") or (c == "." and code:sub(i + 1, i + 1):find("%d")) then
			local number = code:match("^0[xX][%x_]+", i)
				or code:match("^%d[%d_]*%.?[%d_]*[eE][%+%-]?%d+", i)
				or code:match("^%d[%d_]*%.?[%d_]*", i)
				or code:match("^%.%d[%d_]*", i)
				or c
			emit(number, COLORS.number)
			i += #number
			prevText = "num"
		elseif c:find("[%a_]") then
			local word = code:match("^[%a_][%w_]*", i)
			local nextAt = code:find("[^%s]", i + #word)
			local after = nextAt and code:sub(nextAt, nextAt) or ""
			local color = COLORS.default
			if KEYWORDS[word] then
				color = COLORS.keyword
			elseif CONSTANTS[word] then
				color = COLORS.constant
			elseif prevText == "." or prevText == ":" then
				color = (after == "(") and COLORS.func or COLORS.property
			elseif BUILTINS[word] then
				color = COLORS.builtin
			elseif after == "(" or prevWord == "function" then
				color = COLORS.func
			end
			emit(word, color)
			i += #word
			prevText = word
			prevWord = word
		elseif c == "." then
			local dots = code:match("^%.%.%.?", i)
			if dots then
				emit(dots, COLORS.operator)
				i += #dots
				prevText = ".."
			else
				emit(".", COLORS.operator)
				i += 1
				prevText = "."
			end
		else
			local char = code:match("^" .. utf8.charpattern, i) or c
			emit(char, #char > 1 and COLORS.default or COLORS.operator)
			i += #char
			prevText = char
		end
	end

	local result = table.create(#lines)
	for index = 1, #lines do
		result[index] = table.concat(lines[index])
	end
	return result
end

-- The colored copy of the code sits under the real text box, in chunks of a few lines
local chunkLabels = {}
local function chunkLabel(index)
	local label = chunkLabels[index]
	if label then return label end
	label = make("TextLabel", {
		Name = "Code" .. index,
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundTransparency = 1,
		Text = "",
		RichText = true,
		TextColor3 = Color3.fromRGB(212, 212, 212),
		TextSize = CODE_SIZE,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = false,
		Font = CODE_FONT,
		ZIndex = 2,
	}, scroll)
	chunkLabels[index] = label
	return label
end

function render()
	local lines = highlightLines(editor.Text, liveErrorLine, flashLine)
	lineCount = #lines

	local chunks = math.ceil(lineCount / CHUNK)
	for index = 1, chunks do
		local label = chunkLabel(index)
		local first = (index - 1) * CHUNK + 1
		label.Visible = true
		label.Position = UDim2.fromOffset(PADX, PADY + (first - 1) * lineH)
		label.Text = table.concat(lines, "\n", first, math.min(index * CHUNK, lineCount))
	end
	for index = chunks + 1, #chunkLabels do
		chunkLabels[index].Visible = false
	end

	local numbers = table.create(lineCount)
	for index = 1, lineCount do numbers[index] = tostring(index) end
	gutterLabel.Text = table.concat(numbers, "\n")
end

-- keep the text box big enough to fill the visible area
local function fitEditor()
	local size = scroll.AbsoluteWindowSize
	editor.Size = UDim2.fromOffset(size.X, size.Y)
end
scroll:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(fitEditor)
scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
	gutterLabel.Position = UDim2.fromOffset(0, PADY - scroll.CanvasPosition.Y)
end)

-- keep the cursor on screen while typing
function followCaret()
	local cursor = editor.CursorPosition
	if cursor < 1 then return end
	local before = editor.Text:sub(1, cursor - 1)
	local _, newlines = before:gsub("\n", "")
	local top = PADY + newlines * lineH
	local bottom = top + lineH
	local view = scroll.AbsoluteWindowSize
	local position = scroll.CanvasPosition
	local x, y = position.X, position.Y

	if top < y then
		y = top - lineH
	elseif bottom > y + view.Y - 16 then
		y = bottom - view.Y + 16 + lineH
	end

	local lastLine = before:match("([^\n]*)$") or ""
	local width = TextService:GetTextSize(lastLine, CODE_SIZE, CODE_FONT, Vector2.new(100000, 100000)).X
	local caretX = PADX + width
	if caretX < x + 12 then
		x = math.max(0, caretX - 40)
	elseif caretX > x + view.X - 30 then
		x = caretX - view.X + 70
	end

	if x ~= position.X or y ~= position.Y then
		scroll.CanvasPosition = Vector2.new(math.max(0, x), math.max(0, y))
	end
end

-- A quick syntax check a moment after you stop typing, so a mistake turns red
local liveToken = 0
function scheduleLiveCheck()
	liveToken += 1
	local token = liveToken
	task.delay(0.5, function()
		if token ~= liveToken or not loadstring then return end
		local code = editor.Text
		local newLine = nil
		if code:find("%S") then
			local ok, fn, err = pcall(loadstring, code, "=CodeRunner")
			if ok and not fn then
				local number = tonumber(tostring(err):match(":(%d+):"))
				if number then newLine = math.clamp(number, 1, lineCount) end
			end
		end
		if newLine ~= liveErrorLine then
			liveErrorLine = newLine
			render()
		end
	end)
end

editor:GetPropertyChangedSignal("Text"):Connect(function()
	local text = editor.Text
	if text:find("\t", 1, true) then
		-- tabs become four spaces
		local cursor = editor.CursorPosition
		local _, tabsBefore = text:sub(1, math.max(cursor - 1, 0)):gsub("\t", "")
		editor.Text = (text:gsub("\t", "    "))
		if cursor > 0 then editor.CursorPosition = cursor + tabsBefore * 3 end
		return
	end
	local entry = data.scripts[data.selected]
	if entry then entry.code = text end
	liveErrorLine = nil
	render()
	followCaret()
	scheduleLiveCheck()
	scheduleSave()
end)
editor:GetPropertyChangedSignal("CursorPosition"):Connect(followCaret)

----------------------------------------------------------------
-- Running code and reporting errors
----------------------------------------------------------------
local function describe(kind, line, because)
	if line then
		return ("%s error at line %d, this happened because %s."):format(kind, line, because)
	end
	return ("%s error, this happened because %s."):format(kind, because)
end

local function cleanMessage(message)
	return (tostring(message):gsub("^.-:%d+:%s*", ""))
end

local function errorLineOf(message)
	return tonumber(tostring(message):match(":(%d+):"))
end

local function lineTextOf(code, number)
	local index = 0
	for text in (code .. "\n"):gmatch("(.-)\n") do
		index += 1
		if index == number then return text end
	end
	return nil
end

local function classifyCompile(message)
	if message:find("Expected 'end'") or message:find("Expected 'then'") or message:find("Expected 'do'")
		or message:find("Expected '%)'") or message:find("Expected '}'") or message:find("Expected '%]'")
		or message:find("<eof>") then
		return "Parsing"
	end
	return "Syntax"
end

-- Turns a Luau error message into the "because ..." part of the notification
local function explain(message, lineText)
	local word = lineText and lineText:match("[%a_][%w_]*") or nil

	local blockName, blockLine = message:match("Expected 'end' %(to close '([%w_]+)' at line (%d+)%)")
	if blockName then
		return ("the '%s' on line %s is never closed with 'end'"):format(blockName, blockLine)
	end
	if message:find("Incomplete statement") then
		return ("'%s' is not a line of code"):format(word or "this")
	end
	if message:find("Expected 'end'") then return "a block is never closed with 'end'" end
	if message:find("Expected 'then'") then return "an 'if' is missing its 'then'" end
	if message:find("Expected 'do'") then return "a loop is missing its 'do'" end
	if message:find("Expected '%)'") then return "a '(' is never closed with ')'" end
	if message:find("Expected '}'") then return "a '{' is never closed with '}'" end
	if message:find("Expected '%]'") then return "a '[' is never closed with ']'" end
	if message:find("Unfinished string") or message:find("unfinished string") then
		return "a piece of text is missing its closing quote"
	end
	if message:find("Malformed number") then return "a number is written wrong" end

	local _, name = message:match("attempt to call a nil value %((%a+) '([^']+)'%)")
	if name then return ("'%s' is undefined (nil)"):format(name) end
	if message:find("attempt to call a nil value") then return "something that is called is undefined (nil)" end
	local _, indexed = message:match("attempt to index a nil value %((%a+) '([^']+)'%)")
	if indexed then return ("'%s' is undefined (nil)"):format(indexed) end
	local key = message:match("attempt to index nil with '([^']+)'")
	if key then return ("something is undefined (nil), so '%s' can't be read from it"):format(key) end
	if message:find("attempt to index") then return "something is undefined (nil), so it can't be indexed" end
	if message:find("attempt to perform arithmetic") then return "a value is the wrong type to be used in math" end
	if message:find("attempt to compare") then return "two values of different types are being compared" end
	if message:find("attempt to concatenate") then return "a value is the wrong type to be joined with text" end
	if message:find("stack overflow") or message:find("exhausted allowed execution time") or message:find("timeout") then
		return "something keeps looping and never ends"
	end

	if #message > 100 then message = message:sub(1, 97) .. "..." end
	return ("Luau said: %s"):format(message)
end

-- Blank out some lines (keeps every other line number the same)
local function blankLines(code, skip)
	if next(skip) == nil then return code end
	local out = {}
	local index = 0
	for text in (code .. "\n"):gmatch("(.-)\n") do
		index += 1
		out[#out + 1] = skip[index] and "" or text
	end
	return table.concat(out, "\n")
end

-- Scroll to a line, then flash it red and turn its text black for a moment
local function goToLine(line)
	if not line or line < 1 or line > lineCount then return end
	local target = math.max(0, PADY + (line - 1) * lineH - scroll.AbsoluteWindowSize.Y / 2 + lineH)
	local move = tween(scroll, 0.4, { CanvasPosition = Vector2.new(0, target) }, Enum.EasingStyle.Quint)
	move.Completed:Wait()

	flashLine = line
	render()
	flashBar.Position = UDim2.fromOffset(0, PADY + (line - 1) * lineH)
	flashBar.Size = UDim2.fromOffset(math.max(scroll.AbsoluteCanvasSize.X, scroll.AbsoluteWindowSize.X), lineH)
	flashBar.BackgroundTransparency = 0.1
	tween(flashBar, 0.9, { BackgroundTransparency = 1 }, Enum.EasingStyle.Sine)
	task.delay(1, function()
		if flashLine == line then
			flashLine = nil
			render()
		end
	end)
end

local toastToken = 0
local toastAction = nil

function hideToast()
	toastToken += 1
	toastAction = nil
	if not toast.Visible then return end
	local token = toastToken
	fadeGroup(toastFades, false, 0.2)
	tween(toast, 0.25, { Position = UDim2.new(0.5, -18, 0, HEADER_H + 2) }, Enum.EasingStyle.Quint)
	task.delay(0.25, function()
		if token == toastToken then toast.Visible = false end
	end)
end

function showToast(message, onProceed)
	toastToken += 1
	local token = toastToken
	toastAction = onProceed
	toastText.Text = message
	toastLink.Visible = onProceed ~= nil

	toast.Visible = true
	toast.Position = UDim2.new(0.5, -28, 0, HEADER_H + 2) -- slides in from the left
	setGroup(toastFades, 1)
	tween(toast, 0.45, { Position = UDim2.new(0.5, 0, 0, HEADER_H + 2) }, Enum.EasingStyle.Back)
	fadeGroup(toastFades, true, 0.25)

	task.delay(10, function()
		if token == toastToken then hideToast() end
	end)
end

toast.Activated:Connect(function() hideToast() end)
toastLink.Activated:Connect(function()
	local action = toastAction
	hideToast()
	if action then action() end
end)

local function reportError(kind, line, because, onProceed)
	showToast(describe(kind, line, because), onProceed)
	if line then task.spawn(goToLine, line) end
end

-- Runs the code. `skip` holds lines to leave out, `proceeding` means "run it anyway".
function execute(code, skip, proceeding)
	skip = skip or {}
	hideToast()

	if not loadstring then
		showToast("Runtime error, this happened because loadstring isn't available here, so code can't be run.", nil)
		return
	end

	local function compile(text)
		local ok, fn, err = pcall(loadstring, text, "=CodeRunner")
		if not ok then return nil, tostring(fn) end
		return fn, err
	end

	local fn, err = compile(blankLines(code, skip))
	local guard = 0
	while not fn do
		local message = cleanMessage(err)
		local line = errorLineOf(err)
		local kind = classifyCompile(message)
		if proceeding and kind == "Parsing" and line and not skip[line] and guard < 30 then
			-- run it anyway: leave out the line that can't be understood and try again
			skip[line] = true
			guard += 1
			fn, err = compile(blankLines(code, skip))
		else
			local because = explain(message, line and lineTextOf(code, line))
			local proceed = nil
			if kind == "Parsing" and not proceeding then
				proceed = function()
					task.spawn(execute, code, {}, true)
				end
			end
			reportError(kind, line, because, proceed)
			return
		end
	end

	local ok, runtimeError = xpcall(fn, function(message) return tostring(message) end)
	if not ok then
		local message = cleanMessage(runtimeError)
		local line = errorLineOf(runtimeError)
		if line and (line < 1 or line > lineCount) then line = nil end
		local because = explain(message, line and lineTextOf(code, line))
		local proceed = nil
		if line then
			proceed = function()
				local nextSkip = {}
				for key, value in pairs(skip) do nextSkip[key] = value end
				nextSkip[line] = true
				task.spawn(execute, code, nextSkip, true)
			end
		end
		reportError("Runtime", line, because, proceed)
	end
end

runButton.Activated:Connect(function()
	task.spawn(execute, editor.Text, {}, false)
end)
clearButton.Activated:Connect(function()
	hideToast()
	editor.Text = ""
	editor:ReleaseFocus()
end)

