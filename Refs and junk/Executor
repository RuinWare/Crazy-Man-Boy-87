local modalToken = 0

local function closePopup()
	modalToken += 1
	local token = modalToken
	deleteIndex = nil
	fadeGroup(modalFades, false, 0.2)
	tween(dialogScale, 0.2, { Scale = 0.9 }, Enum.EasingStyle.Quad)
	task.delay(0.22, function()
		if token == modalToken then modal.Visible = false end
	end)
end

function openDeletePopup(index)
	local entry = data.scripts[index]
	if not entry then return end
	modalToken += 1
	deleteIndex = index
	dialogBody.Text = ("Are you sure you want to delete %s?"):format(entry.name)

	modal.Visible = true
	dialogScale.Scale = 0.88
	setGroup(modalFades, 1)
	tween(dialogScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	fadeGroup(modalFades, true, 0.25)
end

cancelButton.Activated:Connect(closePopup)
modal.Activated:Connect(closePopup)
confirmButton.Activated:Connect(function()
	local index = deleteIndex
	closePopup()
	if not index or not data.scripts[index] then return end

	local ref = itemRefs[index]
	if ref then
		tween(ref.item, 0.25, { Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1 }, Enum.EasingStyle.Quint)
		task.wait(0.26)
	end

	table.remove(data.scripts, index)
	if #data.scripts == 0 then
		data.scripts[1] = { name = "Script 1.lua", code = "" }
		data.selected = 1
	elseif index < data.selected then
		data.selected -= 1
	elseif index == data.selected then
		data.selected = math.min(index, #data.scripts)
	end
	buildList()
	loadEditorText()
	scheduleSave()
end)

----------------------------------------------------------------
-- Moving, resizing and the divider
----------------------------------------------------------------
local function begin(kind, input, extra)
	local state = { kind = kind, input = input, start = p2(input) }
	if extra then
		for key, value in pairs(extra) do state[key] = value end
	end
	drag = state
	return state
end

-- Drag bar: moves the window
dragHit.InputBegan:Connect(function(input)
	if not isPress(input) or drag.kind or busy then return end
	begin("move", input, { origin = posTarget })
	tween(bar, 0.2, { BackgroundTransparency = 0.15, Size = BAR_SIZE_ACTIVE })
	input.Changed:Connect(function()
		if input.UserInputState == Enum.UserInputState.End then
			drag = {}
			tween(bar, 0.3, { BackgroundTransparency = BAR_IDLE, Size = BAR_SIZE })
		end
	end)
end)

-- Corner icon: resizes the window
handle.InputBegan:Connect(function(input)
	if not isPress(input) or drag.kind or busy then return end
	begin("resize", input, { originSize = sizeTarget, topLeft = posTarget - sizeTarget / 2 })
	tween(iconGroup, 0.2, { GroupTransparency = 0.05 })
	input.Changed:Connect(function()
		if input.UserInputState == Enum.UserInputState.End then
			drag = {}
			tween(iconGroup, 0.3, { GroupTransparency = ICON_IDLE })
		end
	end)
end)

-- Divider: changes how wide the sidebar is compared to the editor
divider.InputBegan:Connect(function(input)
	if not isPress(input) or drag.kind or busy then return end
	begin("divider", input, { startSide = lastSideW })
	tween(dividerPill, 0.2, { BackgroundTransparency = 0.25, Size = UDim2.fromOffset(4, 50) }, Enum.EasingStyle.Back)
	input.Changed:Connect(function()
		if input.UserInputState == Enum.UserInputState.End then
			drag = {}
			tween(dividerPill, 0.3, { BackgroundTransparency = 0.78, Size = UDim2.fromOffset(3, 34) }, Enum.EasingStyle.Quint)
			scheduleSave()
		end
	end)
end)

connections[#connections + 1] = UserInputService.InputChanged:Connect(function(input)
	local kind = drag.kind
	if not kind then return end
	if input.UserInputType ~= Enum.UserInputType.MouseMovement and input ~= drag.input then return end

	local delta = p2(input) - drag.start
	if kind == "move" then
		posTarget = clampCenter(drag.origin + delta, sizeTarget)
	elseif kind == "resize" then
		local v = viewport()
		local newSize = Vector2.new(
			math.clamp(drag.originSize.X + delta.X, MIN_SIZE.X, MAX_SIZE.X),
			math.clamp(drag.originSize.Y + delta.Y, MIN_SIZE.Y, MAX_SIZE.Y)
		)
		newSize = Vector2.new(
			math.min(newSize.X, v.X - SCREEN_MARGIN - drag.topLeft.X),
			math.min(newSize.Y, v.Y - SCREEN_MARGIN - BAR_BELOW - drag.topLeft.Y)
		)
		sizeTarget = newSize
		posTarget = drag.topLeft + newSize / 2 -- the top-left corner stays put
	elseif kind == "divider" then
		local contentW = math.max(100, sizeCur.X - PAD * 2)
		data.sidebar = math.clamp((drag.startSide + delta.X) / contentW, 0.12, 0.6)
		layoutDirty = true
	elseif kind == "pill" then
		if delta.Magnitude > 6 then drag.moved = true end
		if drag.moved then pillCenter = drag.origin + delta end
	end
end)

----------------------------------------------------------------
-- Open / close, with the floating pill
----------------------------------------------------------------
local fadeValue = Instance.new("NumberValue")
local fadeList = {}
fadeValue.Changed:Connect(function(alpha)
	for _, item in ipairs(fadeList) do
		item[1][item[2]] = item[3] + (1 - item[3]) * alpha
	end
end)

local function showPill()
	if not pillCenter then
		pillCenter = Vector2.new(viewport().X / 2, 44)
	end
	pill.Visible = true
	pillScale.Scale = 0.6
	setGroup(pillFades, 1)
	tween(pillScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	fadeGroup(pillFades, true, 0.3)
end

local function hidePill()
	if not pill.Visible then return end
	tween(pillScale, 0.25, { Scale = 0.6 }, Enum.EasingStyle.Quad)
	fadeGroup(pillFades, false, 0.22)
	task.wait(0.25)
	pill.Visible = false
end

function setOpen(open)
	if busy or open == isOpen then return end
	busy = true
	closeMenu()
	if open then
		hidePill()
		fadeList = snapshotFor(holder)
		holder.Visible = true
		popScale.Scale = 0.92
		fadeValue.Value = 1
		tween(popScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
		local fade = tween(fadeValue, 0.35, { Value = 0 }, Enum.EasingStyle.Quad)
		fade.Completed:Wait()
		isOpen = true
	else
		fadeList = snapshotFor(holder)
		fadeValue.Value = 0
		tween(popScale, 0.3, { Scale = 0.92 }, Enum.EasingStyle.Quint)
		local fade = tween(fadeValue, 0.28, { Value = 1 }, Enum.EasingStyle.Quad)
		fade.Completed:Wait()
		holder.Visible = false
		isOpen = false
		showPill()
	end
	busy = false
end

pill.InputBegan:Connect(function(input)
	if not isPress(input) or drag.kind or busy then return end
	begin("pill", input, { origin = pillCenter or Vector2.new(0, 0), moved = false })
	tween(pillScale, 0.1, { Scale = 0.94 }, Enum.EasingStyle.Quad)
	input.Changed:Connect(function()
		if input.UserInputState == Enum.UserInputState.End then
			local moved = drag.moved
			drag = {}
			tween(pillScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			if not moved then task.spawn(setOpen, true) end
		end
	end)
end)

----------------------------------------------------------------
-- Every frame: smooth movement, off-screen protection, layout
----------------------------------------------------------------
local lastLayoutKey = -1

connections[#connections + 1] = RunService.RenderStepped:Connect(function(dt)
	sizeTarget = fitSize(sizeTarget)
	posTarget = clampCenter(posTarget, sizeTarget)

	local speed = drag.kind == "resize" and RESIZE_FOLLOW_SPEED or DRAG_FOLLOW_SPEED
	local alpha = 1 - math.exp(-dt * speed)
	sizeCur = fitSize(sizeCur:Lerp(sizeTarget, alpha))
	posCur = clampCenter(posCur:Lerp(posTarget, alpha), sizeCur)

	holder.Size = UDim2.fromOffset(math.floor(sizeCur.X + 0.5), math.floor(sizeCur.Y + 0.5))
	holder.Position = UDim2.fromOffset(math.floor(posCur.X + 0.5), math.floor(posCur.Y + 0.5))

	local key = math.floor(sizeCur.X + 0.5) * 8192 + math.floor(sizeCur.Y + 0.5)
	if key ~= lastLayoutKey or layoutDirty then
		lastLayoutKey = key
		layout()
	end

	-- the Open pill: off-screen protection too
	if pill.Visible and pillCenter then
		local v = viewport()
		local half = PILL_SIZE / 2
		pillCenter = Vector2.new(
			math.clamp(pillCenter.X, half.X + SCREEN_MARGIN, math.max(half.X + SCREEN_MARGIN, v.X - half.X - SCREEN_MARGIN)),
			math.clamp(pillCenter.Y, half.Y + SCREEN_MARGIN, math.max(half.Y + SCREEN_MARGIN, v.Y - half.Y - SCREEN_MARGIN))
		)
		pill.Position = UDim2.fromOffset(math.floor(pillCenter.X + 0.5), math.floor(pillCenter.Y + 0.5))
	end
end)

screenGui.Destroying:Connect(function()
	for _, c in ipairs(connections) do c:Disconnect() end
	table.clear(connections)
	writeData()
end)

