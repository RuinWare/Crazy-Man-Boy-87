		tween(iconButton, 0.25, { BackgroundTransparency = 1 })
		tween(fileIcon, 0.25, { ImageTransparency = isSelected(index) and 0.05 or 0.35 })
	end)
	attachPress(iconButton, iconScale, 0.82)
	iconButton.Activated:Connect(function()
		openMenu(index)
	end)

	if animate then
		tween(item, 0.4, { Size = UDim2.new(1, 0, 0, ITEM_H) }, Enum.EasingStyle.Back)
	end
end

function buildList(animateIndex)
	for _, child in ipairs(listScroll:GetChildren()) do
		if child:IsA("GuiObject") then child:Destroy() end
	end
	table.clear(itemRefs)
	for index, entry in ipairs(data.scripts) do
		createItem(index, entry, index == animateIndex)
	end
	listBar.update()
end

function applySelection()
	for index, ref in pairs(itemRefs) do
		local selected = isSelected(index)
		tween(ref.item, 0.25, { BackgroundTransparency = selected and 0.94 or 1, BackgroundColor3 = theme.icon })
		fadeGroup(ref.glass, selected, 0.3)
		tween(ref.stroke, 0.3, { Color = theme.rim })
		tween(ref.accent, 0.3, { BackgroundTransparency = selected and 0.15 or 1, BackgroundColor3 = theme.icon })
		tween(ref.name, 0.25, { TextColor3 = selected and theme.strong or theme.sub })
		tween(ref.icon, 0.25, { ImageTransparency = selected and 0.05 or 0.35, ImageColor3 = theme.icon })
		tween(ref.iconButton, 0.25, { BackgroundColor3 = theme.icon })
	end
end

function selectScript(index)
	if not data.scripts[index] then return end
	closeMenu()
	hideToast()
	if settingsOpen then
		-- tapping a file while Settings is open brings the editor back with that file
		data.selected = index
		loadEditorText()
		setSettingsOpen(false)
		scheduleSave()
		return
	end
	if index == data.selected then return end
	data.selected = index
	loadEditorText()
	applySelection()
	scheduleSave()
end

function addScript()
	closeMenu()
	if settingsOpen then setSettingsOpen(false) end
	local used = {}
	for _, entry in ipairs(data.scripts) do used[entry.name] = true end
	local number = #data.scripts + 1
	while used["Script " .. number .. ".lua"] do number += 1 end

	data.scripts[#data.scripts + 1] = { name = "Script " .. number .. ".lua", code = "" }
	data.selected = #data.scripts
	buildList(data.selected)
	loadEditorText()
	task.defer(function()
		listScroll.CanvasPosition = Vector2.new(0, 100000)
	end)
	scheduleSave()
end

-- The options menu for a file
local menuToken = 0
local menuIndex = nil

function closeMenu()
	menuToken += 1
	if not menu.Visible then return end
	local token = menuToken
	menuIndex = nil
	menuCatcher.Visible = false
	tween(menuScale, 0.2, { Scale = 0.88 }, Enum.EasingStyle.Quad)
	fadeGroup(menuFades, false, 0.2)
	task.delay(0.22, function()
		if token == menuToken then menu.Visible = false end
	end)
end

function openMenu(index)
	local ref = itemRefs[index]
	if not ref then return end
	menuToken += 1
	menuIndex = index

	-- next to the file icon, kept inside the window
	local relative = ref.item.AbsolutePosition - body.AbsolutePosition
	local size = body.AbsoluteSize
	local x = math.clamp(relative.X + 38, 8, math.max(8, size.X - MENU_W - 8))
	local y = math.clamp(relative.Y + ITEM_H - 6, HEADER_H, math.max(HEADER_H, size.Y - MENU_H - FOOT_H))
	menu.Position = UDim2.fromOffset(x, y)

	menu.Visible = true
	menuCatcher.Visible = true
	menuScale.Scale = 0.85
	setGroup(menuFades, 1)
	tween(menuScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	fadeGroup(menuFades, true, 0.22)
end

menuCatcher.Activated:Connect(function() closeMenu() end)
listScroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
	if menu.Visible then closeMenu() end
end)
renameOption.Activated:Connect(function()
	local index = menuIndex
	closeMenu()
	if index then beginRename(index) end
end)
deleteOption.Activated:Connect(function()
	local index = menuIndex
	closeMenu()
	if index then openDeletePopup(index) end
end)

-- Renaming: the name turns into a text box
function beginRename(index)
	local ref = itemRefs[index]
	local entry = data.scripts[index]
	if not ref or not entry then return end

	ref.name.Visible = false
	local box = make("TextBox", {
		Name = "RenameBox",
		Position = UDim2.new(0, 42, 0.5, -12),
		Size = UDim2.new(1, -50, 0, 24),
		BackgroundColor3 = theme.icon,
		BackgroundTransparency = 0.88,
		Text = entry.name,
		TextColor3 = theme.strong,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		FontFace = UI_FONT,
		ZIndex = 8,
	}, ref.item)
	corner(box, UDim.new(0, 8))
	make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 6) }, box)
	box:CaptureFocus()
	box.CursorPosition = #box.Text + 1

	local finished = false
	box.FocusLost:Connect(function()
		if finished then return end
		finished = true
		local text = box.Text:match("^%s*(.-)%s*$")
		if text ~= "" then
			if not text:lower():find("%.lua$") then text = text .. ".lua" end
			if #text > 40 then text = text:sub(1, 40) end
			entry.name = text
			scheduleSave()
		end
		ref.name.Text = entry.name
		ref.name.Visible = true
		box:Destroy()
	end)
end

-- The "Are You Sure" popup. It uses the Popup library; the built-in popup below is only a backup
-- for when the library can't be loaded.
local popupLib = nil
local function getPopup()
	if popupLib ~= nil then return popupLib or nil end
	local ok, lib = pcall(function()
		return loadstring(game:HttpGet(POPUP_URL))()
	end)
	popupLib = (ok and lib) or false
	return popupLib or nil
end

-- backup popup
local pendingConfirm = nil
local modalToken = 0

local function closePopup()
	modalToken += 1
	local token = modalToken
	pendingConfirm = nil
	fadeGroup(modalFades, false, 0.2)
	tween(dialogScale, 0.2, { Scale = 0.9 }, Enum.EasingStyle.Quad)
	task.delay(0.22, function()
		if token == modalToken then modal.Visible = false end
	end)
end

-- Asks "Are You Sure?" and calls onConfirm if the player presses Delete
function confirmPopup(content, onConfirm)
	local lib = getPopup()
	if lib then
		local ok = pcall(function()
			lib.new({
				title = "Are You Sure?",
				content = content,
				options = {
					{ text = "Cancel", style = "neutral" },
					{
						text = "Delete",
						style = "danger",
						callback = function()
							task.spawn(onConfirm)
						end,
					},
				},
			})
		end)
		if ok then return end
	end

	-- backup popup
	modalToken += 1
	pendingConfirm = onConfirm
	dialogBody.Text = content
	modal.Visible = true
	dialogScale.Scale = 0.88
	setGroup(modalFades, 1)
	tween(dialogScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	fadeGroup(modalFades, true, 0.25)
end

cancelButton.Activated:Connect(closePopup)
modal.Activated:Connect(closePopup)
confirmButton.Activated:Connect(function()
	local action = pendingConfirm
	closePopup()
	if action then task.spawn(action) end
end)

-- Deletes a script (with a little shrink animation)
local function deleteEntry(entry)
	local index = table.find(data.scripts, entry)
	if not index then return end

	local ref = itemRefs[index]
	if ref then
		tween(ref.item, 0.25, { Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1 }, Enum.EasingStyle.Quint)
		task.wait(0.26)
	end

	index = table.find(data.scripts, entry) -- the list may have changed while it animated
	if not index then return end
	table.remove(data.scripts, index)
	if #data.scripts == 0 then
		data.scripts[1] = { name = "Script 1.lua", code = "" }
		data.selected = 1
	elseif index < data.selected then
		data.selected -= 1
	elseif index == data.selected then
		data.selected = math.min(index, #data.scripts)
	end
	buildList()
	loadEditorText()
	scheduleSave()
end

-- Deletes every script and leaves one fresh empty one
local function deleteAllScripts()
	for _, ref in pairs(itemRefs) do
		tween(ref.item, 0.25, { Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1 }, Enum.EasingStyle.Quint)
	end
	task.wait(0.27)
	data.scripts = { { name = "Script 1.lua", code = "" } }
	data.selected = 1
	buildList()
	loadEditorText()
	scheduleSave()
end

-- Delete from the file menu: with a popup, or straight away if Show Delete Warnings is off
function openDeletePopup(index)
	local entry = data.scripts[index]
	if not entry then return end
	if data.settings.warnings == false then
		task.spawn(deleteEntry, entry)
		return
	end
	confirmPopup(("Are you sure you want to delete %s?"):format(entry.name), function()
		deleteEntry(entry)
	end)
end
end
