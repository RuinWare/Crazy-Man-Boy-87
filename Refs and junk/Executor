local itemRefs = {}

local function loadEditorText()
	local entry = data.scripts[data.selected]
	liveErrorLine, flashLine = nil, nil
	editor.Text = entry and entry.code or ""
	scroll.CanvasPosition = Vector2.new(0, 0)
	render()
end

local function createItem(index, entry, animate)
	local selected = index == data.selected
	local item = make("TextButton", {
		Name = "Item",
		LayoutOrder = index,
		Size = UDim2.new(1, 0, 0, animate and 0 or ITEM_H),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = selected and 0.9 or 1,
		Text = "",
		AutoButtonColor = false,
		Selectable = false,
		ClipsDescendants = true,
		ZIndex = 4,
	}, listScroll)
	corner(item, UDim.new(0, 11))

	local accent = make("Frame", {
		Name = "Accent",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(3, 14),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = selected and 0.15 or 1,
		BorderSizePixel = 0,
		ZIndex = 5,
	}, item)
	corner(accent, UDim.new(1, 0))

	-- the file icon: tap it for Rename / Delete
	local iconButton = make("TextButton", {
		Name = "FileButton",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.5, 0),
		Size = UDim2.fromOffset(28, 28),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Selectable = false,
		ZIndex = 6,
	}, item)
	corner(iconButton, UDim.new(1, 0))
	local iconScale = make("UIScale", { Scale = 1 }, iconButton)
	local fileIcon = makeIcon(iconButton, ICON_FILE, WHITE, 16, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ImageTransparency = selected and 0.05 or 0.35,
		ZIndex = 7,
	})

	local nameLabel = make("TextLabel", {
		Name = "Name",
		Position = UDim2.new(0, 42, 0, 0),
		Size = UDim2.new(1, -48, 1, 0),
		BackgroundTransparency = 1,
		Text = entry.name,
		TextColor3 = selected and OFFWHITE or SUBTITLE_COLOR,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		FontFace = UI_FONT,
		ZIndex = 5,
	}, item)

	itemRefs[index] = { item = item, accent = accent, icon = fileIcon, name = nameLabel }

	item.MouseEnter:Connect(function()
		if index ~= data.selected then tween(item, 0.2, { BackgroundTransparency = 0.94 }) end
	end)
	item.MouseLeave:Connect(function()
		if index ~= data.selected then tween(item, 0.25, { BackgroundTransparency = 1 }) end
	end)
	item.Activated:Connect(function()
		selectScript(index)
	end)

	iconButton.MouseEnter:Connect(function()
		tween(iconButton, 0.2, { BackgroundTransparency = 0.86 })
		tween(fileIcon, 0.2, { ImageTransparency = 0 })
	end)
	iconButton.MouseLeave:Connect(function()
		tween(iconButton, 0.25, { BackgroundTransparency = 1 })
		tween(fileIcon, 0.25, { ImageTransparency = index == data.selected and 0.05 or 0.35 })
	end)
	attachPress(iconButton, iconScale, 0.82)
	iconButton.Activated:Connect(function()
		openMenu(index)
	end)

	if animate then
		tween(item, 0.4, { Size = UDim2.new(1, 0, 0, ITEM_H) }, Enum.EasingStyle.Back)
	end
end

function buildList(animateIndex)
	for _, child in ipairs(listScroll:GetChildren()) do
		if child:IsA("GuiObject") then child:Destroy() end
	end
	table.clear(itemRefs)
	for index, entry in ipairs(data.scripts) do
		createItem(index, entry, index == animateIndex)
	end
	listBar.update()
end

function applySelection()
	for index, ref in pairs(itemRefs) do
		local selected = index == data.selected
		tween(ref.item, 0.25, { BackgroundTransparency = selected and 0.9 or 1 })
		tween(ref.accent, 0.3, { BackgroundTransparency = selected and 0.15 or 1 })
		tween(ref.name, 0.25, { TextColor3 = selected and OFFWHITE or SUBTITLE_COLOR })
		tween(ref.icon, 0.25, { ImageTransparency = selected and 0.05 or 0.35 })
	end
end

function selectScript(index)
	if index == data.selected or not data.scripts[index] then return end
	closeMenu()
	hideToast()
	data.selected = index
	loadEditorText()
	applySelection()
	scheduleSave()
end

function addScript()
	closeMenu()
	local used = {}
	for _, entry in ipairs(data.scripts) do used[entry.name] = true end
	local number = #data.scripts + 1
	while used["Script " .. number .. ".lua"] do number += 1 end

	data.scripts[#data.scripts + 1] = { name = "Script " .. number .. ".lua", code = "" }
	data.selected = #data.scripts
	buildList(data.selected)
	loadEditorText()
	task.defer(function()
		listScroll.CanvasPosition = Vector2.new(0, 100000)
	end)
	scheduleSave()
end

-- The options menu for a file
local menuToken = 0
local menuIndex = nil

function closeMenu()
	menuToken += 1
	if not menu.Visible then return end
	local token = menuToken
	menuIndex = nil
	menuCatcher.Visible = false
	tween(menuScale, 0.2, { Scale = 0.88 }, Enum.EasingStyle.Quad)
	fadeGroup(menuFades, false, 0.2)
	task.delay(0.22, function()
		if token == menuToken then menu.Visible = false end
	end)
end

function openMenu(index)
	local ref = itemRefs[index]
	if not ref then return end
	menuToken += 1
	menuIndex = index

	-- next to the file icon, kept inside the window
	local relative = ref.item.AbsolutePosition - body.AbsolutePosition
	local size = body.AbsoluteSize
	local x = math.clamp(relative.X + 38, 8, math.max(8, size.X - MENU_W - 8))
	local y = math.clamp(relative.Y + ITEM_H - 6, HEADER_H, math.max(HEADER_H, size.Y - MENU_H - FOOT_H))
	menu.Position = UDim2.fromOffset(x, y)

	menu.Visible = true
	menuCatcher.Visible = true
	menuScale.Scale = 0.85
	setGroup(menuFades, 1)
	tween(menuScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	fadeGroup(menuFades, true, 0.22)
end

menuCatcher.Activated:Connect(function() closeMenu() end)
listScroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
	if menu.Visible then closeMenu() end
end)
renameOption.Activated:Connect(function()
	local index = menuIndex
	closeMenu()
	if index then beginRename(index) end
end)
deleteOption.Activated:Connect(function()
	local index = menuIndex
	closeMenu()
	if index then openDeletePopup(index) end
end)

-- Renaming: the name turns into a text box
function beginRename(index)
	local ref = itemRefs[index]
	local entry = data.scripts[index]
	if not ref or not entry then return end

	ref.name.Visible = false
	local box = make("TextBox", {
		Name = "RenameBox",
		Position = UDim2.new(0, 42, 0.5, -12),
		Size = UDim2.new(1, -50, 0, 24),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.88,
		Text = entry.name,
		TextColor3 = WHITE,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		FontFace = UI_FONT,
		ZIndex = 8,
	}, ref.item)
	corner(box, UDim.new(0, 8))
	make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 6) }, box)
	box:CaptureFocus()
	box.CursorPosition = #box.Text + 1

	local finished = false
	box.FocusLost:Connect(function()
		if finished then return end
		finished = true
		local text = box.Text:match("^%s*(.-)%s*$")
		if text ~= "" then
			if not text:lower():find("%.lua$") then text = text .. ".lua" end
			if #text > 40 then text = text:sub(1, 40) end
			entry.name = text
			scheduleSave()
		end
		ref.name.Text = entry.name
		ref.name.Visible = true
		box:Destroy()
	end)
end

-- The "Are You Sure" popup
