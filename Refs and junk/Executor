	corner(iconButton, UDim.new(1, 0))
	local iconScale = make("UIScale", { Scale = 1 }, iconButton)
	local fileIcon = makeIcon(iconButton, ICON_FILE, theme.icon, 16, {
		AnchorPoint = Vector2.new(0.5, 0.5),
