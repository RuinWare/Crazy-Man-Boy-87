-- A dropdown: tap it and the options slide open under it
local function makeDropdown(order, labelText, iconImage, options, getValue, display, onPick)
	local closedHeight = 50
	local listHeight = #options * 34 + 8
	local container = make("Frame", {
		Name = labelText,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, closedHeight),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 5,
	}, settingsScroll)
	local header = make("TextButton", {
		Name = "Header",
		Position = UDim2.fromOffset(2, 2),
		Size = UDim2.new(1, -4, 0, 46),
		Text = "",
		AutoButtonColor = false,
		Selectable = false,
		ZIndex = 5,
	}, container)
	styleRow(header)

	local left = 18
	if iconImage then
		local icon = makeIcon(header, iconImage, WHITE, 18, {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 16, 0.5, 0),
			ZIndex = 6,
		})
		bind(icon, "ImageColor3", "icon")
		left = 44
	end
	local label = make("TextLabel", {
		Position = UDim2.new(0, left, 0, 0),
		Size = UDim2.new(1, -(left + 120), 1, 0),
		BackgroundTransparency = 1,
		Text = labelText,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = UI_FONT_BOLD,
		ZIndex = 6,
	}, header)
	bind(label, "TextColor3", "strong")
	local valueLabel = make("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -40, 0.5, 0),
		Size = UDim2.fromOffset(100, 20),
		BackgroundTransparency = 1,
		Text = "",
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Right,
		FontFace = UI_FONT,
		ZIndex = 6,
	}, header)
	bind(valueLabel, "TextColor3", "sub")

	-- a small "v" that flips over when the dropdown is open
	local chevron = make("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(12, 12),
		BackgroundTransparency = 1,
		ZIndex = 6,
	}, header)
	for _, spec in ipairs({ { -3, 45 }, { 3, -45 } }) do
		local arm = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, spec[1], 0.5, 0),
			Size = UDim2.fromOffset(7, 2),
			Rotation = spec[2],
			BorderSizePixel = 0,
			ZIndex = 6,
		}, chevron)
		corner(arm, UDim.new(1, 0))
		bind(arm, "BackgroundColor3", "sub")
	end

	local list = make("Frame", {
		Name = "Options",
		Position = UDim2.fromOffset(2, closedHeight + 4),
		Size = UDim2.new(1, -4, 0, listHeight),
		BackgroundTransparency = 0.96,
		BorderSizePixel = 0,
		ZIndex = 5,
	}, container)
	bind(list, "BackgroundColor3", "icon")
	corner(list, UDim.new(0, 14))
	make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, list)
	make("UIPadding", {
		PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),
	}, list)

	local optionButtons = {}
	local self = {}
	local open = false

	local function setOpenState(state)
		open = state
		tween(container, 0.4, {
			Size = UDim2.new(1, 0, 0, state and (closedHeight + 4 + listHeight + 2) or closedHeight),
		}, Enum.EasingStyle.Quint)
		tween(chevron, 0.4, { Rotation = state and 180 or 0 }, Enum.EasingStyle.Quint)
	end

	local function refresh()
		local current = getValue()
		for index, button in ipairs(optionButtons) do
			tween(button, 0.2, { BackgroundTransparency = options[index].value == current and 0.88 or 1 })
		end
		valueLabel.Text = tostring(display(current))
	end

	for index, option in ipairs(options) do
		local button = make("TextButton", {
			LayoutOrder = index,
			Size = UDim2.new(1, 0, 0, 34),
			BackgroundTransparency = 1,
			Text = option.text,
			TextSize = 13,
			FontFace = UI_FONT,
			AutoButtonColor = false,
			Selectable = false,
			ZIndex = 6,
		}, list)
		bind(button, "BackgroundColor3", "icon")
		bind(button, "TextColor3", "strong")
		corner(button, UDim.new(0, 10))
		button.MouseEnter:Connect(function()
			if getValue() ~= option.value then tween(button, 0.2, { BackgroundTransparency = 0.93 }) end
		end)
		button.MouseLeave:Connect(function()
			if getValue() ~= option.value then tween(button, 0.25, { BackgroundTransparency = 1 }) end
		end)
		button.Activated:Connect(function()
			onPick(option.value)
			refresh()
			setOpenState(false)
		end)
		optionButtons[index] = button
	end

	header.MouseEnter:Connect(function() tween(header, 0.2, { BackgroundTransparency = 0.88 }) end)
	header.MouseLeave:Connect(function() tween(header, 0.25, { BackgroundTransparency = 0.94 }) end)
	header.Activated:Connect(function()
		if not open then
			for _, other in ipairs(allDropdowns) do
				if other ~= self then other.close() end
			end
		end
		setOpenState(not open)
	end)

	self.refresh = refresh
	self.close = function() setOpenState(false) end
	allDropdowns[#allDropdowns + 1] = self
	settingRefreshers[#settingRefreshers + 1] = refresh
	refresh()
	return self
end

