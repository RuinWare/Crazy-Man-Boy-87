-- A file counts as selected only while the editor is showing (not while Settings is open)
local function isSelected(index)
	return not settingsOpen and index == data.selected
end

local function createItem(index, entry, animate)
	local selected = isSelected(index)
	local item = make("TextButton", {
		Name = "Item",
