-- Liquid glass: a bright edge that fades around the shape, plus a soft sheen across the surface.
-- Returns the stroke, the sheen frame and the sheen gradient (so buttons can make it shimmer).
local function glass(frame, radius, strength)
	strength = strength or 1
	local stroke = make("UIStroke", {
		Name = "GlassStroke",
		Color = WHITE,
		Thickness = 1.2,
		Transparency = 0.4,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, frame)
	make("UIGradient", {
		Rotation = 45,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.05),
			NumberSequenceKeypoint.new(0.4, 0.82),
			NumberSequenceKeypoint.new(0.75, 0.92),
			NumberSequenceKeypoint.new(1, 0.5),
		}),
	}, stroke)

	local sheen = make("Frame", {
		Name = "Sheen",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		ZIndex = 1,
	}, frame)
	corner(sheen, radius)
	local function soft(t) return 1 - (1 - t) * strength end
	local gradient = make("UIGradient", {
		Rotation = 60,
		Offset = Vector2.new(-0.5, 0),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, soft(0.82)),
			NumberSequenceKeypoint.new(0.4, soft(0.95)),
			NumberSequenceKeypoint.new(1, soft(0.985)),
		}),
	}, sheen)
	return stroke, sheen, gradient
end

-- Fading groups of things in and out (without blurring text): remember each value, then tween it
local function snapshotFor(root)
	local list = {}
	local function add(obj, prop)
		list[#list + 1] = { obj, prop, obj[prop] }
	end
	local function visit(obj)
		if obj:IsA("GuiObject") then
			add(obj, "BackgroundTransparency")
			if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
				add(obj, "TextTransparency")
			end
			if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
				add(obj, "ImageTransparency")
			end
		elseif obj:IsA("UIStroke") then
			add(obj, "Transparency")
		end
	end
	visit(root)
	for _, d in ipairs(root:GetDescendants()) do visit(d) end
	return list
end

local function setGroup(list, value)
	for _, item in ipairs(list) do item[1][item[2]] = value end
end

local function fadeGroup(list, visible, duration)
	for _, item in ipairs(list) do
		tween(item[1], duration, { [item[2]] = visible and item[3] or 1 }, Enum.EasingStyle.Quad)
	end
end

-- Custom scroll thumb: a thin bar that fades in while you scroll, follows the scroll position,
-- and can be dragged. Returns functions to refresh it.
local function makeScrollbar(scroll, host, rightInset, topInset, bottomInset, zindex)
	local track = make("Frame", {
		Name = "ScrollTrack",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -rightInset, 0, topInset),
		Size = UDim2.new(0, 10, 1, -(topInset + bottomInset)),
		BackgroundTransparency = 1,
		ZIndex = zindex,
	}, host)
	local thumb = make("TextButton", {
		Name = "Thumb",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromOffset(10, 30),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Selectable = false,
		ZIndex = zindex,
	}, track)
	local bar = make("Frame", {
		Name = "Bar",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 4, 1, 0),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = zindex,
	}, thumb)
	corner(bar, UDim.new(1, 0))

	local fadeToken = 0
	local dragging = false

	local function show()
		fadeToken += 1
		local token = fadeToken
		tween(bar, 0.15, { BackgroundTransparency = 0.45 }, Enum.EasingStyle.Quad)
		task.delay(0.9, function()
			if token == fadeToken and not dragging then
				tween(bar, 0.45, { BackgroundTransparency = 1 }, Enum.EasingStyle.Sine)
			end
		end)
	end

	local function metrics()
		return scroll.AbsoluteWindowSize.Y, scroll.AbsoluteCanvasSize.Y, track.AbsoluteSize.Y
	end

	local function update()
		local viewH, contentH, trackH = metrics()
		if contentH <= viewH + 1 or trackH < 10 then
			thumb.Visible = false
			return
		end
		thumb.Visible = true
		local thumbH = math.max(28, trackH * viewH / contentH)
		local alpha = math.clamp(scroll.CanvasPosition.Y / (contentH - viewH), 0, 1)
		thumb.Size = UDim2.fromOffset(10, thumbH)
		thumb.Position = UDim2.new(0.5, 0, 0, alpha * (trackH - thumbH))
	end

	scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		update()
		show()
	end)
	scroll:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(update)
	scroll:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(update)
	track:GetPropertyChangedSignal("AbsoluteSize"):Connect(update)
	thumb.MouseEnter:Connect(show)

	thumb.InputBegan:Connect(function(input)
		if not isPress(input) then return end
		dragging = true
		show()
		local startY = p2(input).Y
		local startCanvas = scroll.CanvasPosition.Y
		local connection
		connection = UserInputService.InputChanged:Connect(function(change)
			if change.UserInputType ~= Enum.UserInputType.MouseMovement and change ~= input then return end
			local viewH, contentH, trackH = metrics()
			local thumbH = math.max(28, trackH * viewH / contentH)
			local movable = trackH - thumbH
			if movable <= 0 then return end
			local maxScroll = contentH - viewH
			local target = startCanvas + (p2(change).Y - startY) * (maxScroll / movable)
			scroll.CanvasPosition = Vector2.new(scroll.CanvasPosition.X, math.clamp(target, 0, maxScroll))
		end)
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				connection:Disconnect()
				show()
			end
		end)
	end)

	update()
	return { update = update, show = show }
end

-- Button feel: press squish and a shimmer across the glass
local function attachPress(button, scale, down)
	down = down or 0.94
	button.InputBegan:Connect(function(input)
		if isPress(input) then tween(scale, 0.1, { Scale = down }, Enum.EasingStyle.Quad) end
	end)
	button.InputEnded:Connect(function(input)
		if isPress(input) then tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back) end
	end)
end

