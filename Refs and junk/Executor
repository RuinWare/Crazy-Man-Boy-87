-- Saved scripts (kept in a file, so they survive between sessions)
----------------------------------------------------------------
local canUseFiles = type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
local memoryStore = _G
pcall(function()
	if getgenv then memoryStore = getgenv() end
end)

local function defaultData()
	return { scripts = { { name = "Script 1.lua", code = "" } }, selected = 1, sidebar = 0.28 }
end

local function loadData()
	local raw
	if canUseFiles then
		local ok, result = pcall(function()
			if isfile(SAVE_FILE) then return HttpService:JSONDecode(readfile(SAVE_FILE)) end
			return nil
		end)
		if ok then raw = result end
	else
		raw = memoryStore.CodeRunnerData
	end

	local result = defaultData()
	if type(raw) == "table" and type(raw.scripts) == "table" then
		local scripts = {}
		for _, item in ipairs(raw.scripts) do
			if type(item) == "table" and type(item.name) == "string" and type(item.code) == "string" then
				scripts[#scripts + 1] = { name = item.name, code = item.code }
			end
		end
		if #scripts > 0 then
			result.scripts = scripts
			result.selected = math.clamp(tonumber(raw.selected) or 1, 1, #scripts)
			result.sidebar = math.clamp(tonumber(raw.sidebar) or 0.28, 0.12, 0.6)
		end
	end
	return result
end

local data = loadData()

local function writeData()
	if canUseFiles then
		pcall(function()
			writefile(SAVE_FILE, HttpService:JSONEncode(data))
		end)
	else
		memoryStore.CodeRunnerData = data
	end
end

local saveToken = 0
local function scheduleSave()
	saveToken += 1
	local token = saveToken
	task.delay(0.5, function()
		if token == saveToken then writeData() end
	end)
end

