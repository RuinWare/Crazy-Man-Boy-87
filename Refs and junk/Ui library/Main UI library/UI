	----------------------------------------------------------------
	-- The Settings tab (always there, always last)
	----------------------------------------------------------------
	function W.buildSettings(window, tab)
		local settings = window._settings

		tab:CreateLeftRow()
		tab:CreateSection({ name = "Configuration Saving" })
		local nameOut, listOut = {}, {}
		tab:CreateInput({ name = "Name:", placeholder = "Configuration name", internal = true, _out = nameOut })
		tab:CreateDropdown({
			name = "Configurations:",
			options = window:ListConfigs(),
			internal = true,
			_out = listOut,
		})

		local function refreshList(select)
			listOut.el:_setOptions(window:ListConfigs())
			if select then listOut.el:_set(select, true) end
		end

		tab:CreateButton({
			name = "Save",
			internal = true,
			callback = function()
				local name = nameOut.el:_currentText():match("^%s*(.-)%s*$")
				if name == "" then
					Library:Toast({ title = "Type a name first", subtitle = "Use the Name: box" })
					return
				end
				window:Save(name)
				refreshList(name)
				Library:Toast({ title = "Saved", subtitle = name })
			end,
		})
		tab:CreateButton({
			name = "Load",
			internal = true,
			callback = function()
				local name = listOut.el.selected[1]
				if not name then
					Library:Toast({ title = "Pick a configuration first" })
					return
				end
				if window:Load(name) then
					Library:Toast({ title = "Loaded", subtitle = name })
				end
			end,
		})
		tab:CreateButton({
			name = "Delete",
			internal = true,
			callback = function()
				local name = listOut.el.selected[1]
				if not name then
					Library:Toast({ title = "Pick a configuration first" })
					return
				end
				window:DeleteConfig(name)
				listOut.el:_set(nil, true)
				refreshList()
				Library:Toast({ title = "Deleted", subtitle = name })
			end,
		})
		tab:CreateToggle({
			name = "Auto Load Last Settings",
			value = settings.autoLoad,
			default = false,
			internal = true,
			setting = true,
			callback = function(on)
				settings.autoLoad = on
				window:_saveSettings()
				if on then window:_changed() end
			end,
		})

		tab:CreateSection({ name = "Danger Zone" })
		tab:CreateButton({
			name = "Unload",
			internal = true,
			callback = function()
				window:Unload()
			end,
		})
		tab:CreateButton({
			name = "Reset All Settings",
			internal = true,
			callback = function()
				window:_resetAll()
				Library:Toast({ title = "Settings reset", subtitle = "Everything is back to default" })
			end,
		})

		tab:CreateRightRow()
		tab:CreateSection({ name = "Menu" })
		tab:CreateToggle({
			name = "Off Screen Protection",
			value = settings.protect,
			default = true,
			internal = true,
			setting = true,
			callback = function(on)
				settings.protect = on
				window:_saveSettings()
			end,
		})
		tab:CreateToggle({
			name = "Hide Mobile Pill",
			value = settings.hidePill,
			default = false,
			internal = true,
			setting = true,
			callback = function(on)
				settings.hidePill = on
				window:_saveSettings()
				window:_pillRefresh(true)
			end,
		})
		tab:CreateToggle({
			name = "Notifications",
			value = settings.notifications,
			default = true,
			internal = true,
			setting = true,
			callback = function(on)
				settings.notifications = on
				N.enabled = on
				window:_saveSettings()
			end,
		})
		local reopenKey = nil
		local okKey, foundKey = pcall(function() return Enum.KeyCode[settings.reopen] end)
		if okKey then reopenKey = foundKey end
		tab:CreateKeybind({
			name = "Reopen Keybind",
			value = reopenKey or Enum.KeyCode.RightShift,
			default = "RightShift",
			internal = true,
			setting = true,
			callback = function()
				window:_toggleOpen()
			end,
			onChanged = function(key)
				settings.reopen = key and key.Name or ""
				window:_saveSettings()
			end,
		})
	end

	----------------------------------------------------------------
	-- Library:CreateWindow
	----------------------------------------------------------------
	function Library:CreateWindow(config)
		config = config or {}
		ensureInit()

		local window = setmetatable({
			Name = tostring(config.name or "Window"),
			Tabs = {},
			_values = {},
			_all = {},
			_allList = {},
			_search = {},
			_flagCount = {},
			_settingEls = {},
			_conns = {},
			_userTabs = 0,
			_open = true,
			_openToken = 0,
		}, Window)

		-- the saved file: settings, last session, configurations, window position
		local store = S.read(window.Name)
		store.settings = type(store.settings) == "table" and store.settings or {}
		store.last = type(store.last) == "table" and store.last or {}
		store.last.values = type(store.last.values) == "table" and store.last.values or {}
		store.last.extras = type(store.last.extras) == "table" and store.last.extras or {}
		store.configs = type(store.configs) == "table" and store.configs or {}
		window._store = store
		local saved = store.settings
		window._settings = {
			autoLoad = saved.autoLoad == true,
			protect = saved.protect ~= false,
			hidePill = saved.hidePill == true,
			notifications = saved.notifications ~= false,
			reopen = type(saved.reopen) == "string" and saved.reopen or "RightShift",
		}
		N.enabled = window._settings.notifications

		-- window.Flags.Name reads a value, window.Flags.Name = value writes it
		window.Flags = setmetatable({}, {
			__index = function(_, flag) return window._values[flag] end,
			__newindex = function(_, flag, value)
				local el = window._all[flag]
				if el then el:_set(value) end
			end,
			__iter = function() return next, window._values end,
		})

		W.shell(window, config)
		W.header(window, config)
		W.sidebar(window)
		W.search(window)
		W.pill(window, config)
		W.mode(window)

		-- the Settings tab (made first, listed last); it is what shows until you make a tab
		local settingsTab = W.newTab(window, { title = "Settings", icon = ICON_SETTINGS }, true)
		window._settingsTab = settingsTab
		W.buildSettings(window, settingsTab)
		window:_select(settingsTab)

		Library.Windows[#Library.Windows + 1] = window
		window:_applyMode(false)
		return window
	end

	-- notifications and toasts belong to the library, not to a window
	function Library:Notify(props)
		ensureInit()
		N.notify(props)
	end

	function Library:Toast(props)
		ensureInit()
		N.toast(props)
	end

                      	return Library
                 end)()
return Library
