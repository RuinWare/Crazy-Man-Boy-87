		----------------------------------------------------------------
		-- Slider
		----------------------------------------------------------------
		function E.slider(row, cfg)
			local window = row._window
			local minValue, maxValue = 0, 100
			if type(cfg.range) == "table" then
				minValue = tonumber(cfg.range[1]) or 0
				maxValue = tonumber(cfg.range[2]) or (minValue + 100)
			end
			if maxValue <= minValue then maxValue = minValue + 1 end
			local increment = tonumber(cfg.increment) or 1
			if increment <= 0 then increment = 1 end
			local decimals = U.decimalsOf(increment)

			local function snap(value)
				value = math.clamp(value, minValue, maxValue)
				local steps = math.floor((value - minValue) / increment + 0.5)
				value = minValue + steps * increment
				value = tonumber(string.format("%." .. decimals .. "f", value)) or value
				return math.clamp(value, minValue, maxValue)
			end

			local el = {
				kind = "slider",
				_window = window,
				name = tostring(cfg.name or "Slider"),
				callback = cfg.callback,
				value = snap(tonumber(cfg.value) or minValue),
			}

			local frame, sep = makeItem(row)
			U.label(frame, {
				Name = "Name",
				Position = UDim2.fromOffset(12, 0),
				Size = UDim2.new(0.4, -12, 1, 0),
				Text = el.name,
				ZIndex = 2,
			})
			local chip, valueBox = makeChipBox(frame, {
				position = UDim2.new(1, -10, 0.5, 0),
				size = UDim2.fromOffset(48, 24),
				text = "",
				align = Enum.TextXAlignment.Center,
			})
			valueBox.Position = UDim2.fromOffset(2, 0)
			valueBox.Size = UDim2.new(1, -4, 1, 0)

			local track = U.make("Frame", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0.4, 0, 0.5, 0),
				Size = UDim2.new(0.6, -(10 + 48 + 12), 0, 6),
				BackgroundColor3 = T.off,
				BorderSizePixel = 0,
				ZIndex = 2,
			}, frame)
			U.corner(track, 3)
			local fill = U.make("Frame", {
				Size = UDim2.fromScale(0, 1),
				BackgroundColor3 = T.green,
				BorderSizePixel = 0,
				ZIndex = 3,
			}, track)
			U.corner(fill, 3)
			local knob = U.make("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0, 0.5),
				Size = UDim2.fromOffset(12, 12),
				BackgroundColor3 = T.white,
				BorderSizePixel = 0,
				ZIndex = 4,
			}, track)
			U.corner(knob, 6)

			-- the grab area: the track, a little wider than it is, the full height of the row
			local hit = U.button(frame, {
				Name = "Hit",
				Position = UDim2.new(0.4, -8, 0, 0),
				Size = UDim2.new(0.6, -(10 + 48 + 6), 1, 0),
				ZIndex = 5,
			})

			local function render(instant)
				local alpha = (el.value - minValue) / (maxValue - minValue)
				if instant then
					fill.Size = UDim2.fromScale(alpha, 1)
					knob.Position = UDim2.fromScale(alpha, 0.5)
				else
					U.tween(fill, 0.06, { Size = UDim2.fromScale(alpha, 1) }, Enum.EasingStyle.Linear)
					U.tween(knob, 0.06, { Position = UDim2.fromScale(alpha, 0.5) }, Enum.EasingStyle.Linear)
				end
				valueBox.Text = string.format("%." .. decimals .. "f", el.value)
			end
			render(true)

			function el:_natural() return self.value end
			function el:_serialize() return self.value end
			function el:_set(value, quiet)
				value = snap(tonumber(value) or self.value)
				if value == self.value then
					render(true)
					return
				end
				self.value = value
				render()
				window._values[self.flag] = value
				window:_changed()
				if not quiet then U.run(self.callback, value) end
			end
			function el:_load(data)
				if type(data) ~= "number" then return false end
				self:_set(data, true)
				return true
			end
			function el:_fire() U.run(self.callback, self.value) end

			local function fromX(x)
				local alpha = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
				el:_set(minValue + (maxValue - minValue) * alpha)
			end

			-- press and slide: the tab stops scrolling while you do
			hit.InputBegan:Connect(function(input)
				if not U.isPress(input) then return end
				local started = D.begin(input, function(moved)
					fromX(U.p2(moved).X)
				end, function()
					U.tween(knob, 0.2, { Size = UDim2.fromOffset(12, 12) }, Enum.EasingStyle.Quad)
				end, row._tab._page)
				if not started then return end
				U.tween(knob, 0.15, { Size = UDim2.fromOffset(16, 16) }, Enum.EasingStyle.Back)
				fromX(U.p2(input).X)
			end)

			valueBox.FocusLost:Connect(function()
				local typed = tonumber(valueBox.Text)
				if typed then el:_set(typed) else render(true) end
			end)

			return finish(row, el, cfg, frame, sep)
		end

		----------------------------------------------------------------
		-- Dropdown (multiSelect for several)
		----------------------------------------------------------------
		function E.dropdown(row, cfg)
			local window = row._window
			local OPTION_H = 30
			local el = {
				kind = "dropdown",
				_window = window,
				name = tostring(cfg.name or "Dropdown"),
				callback = cfg.callback,
				multi = cfg.multiSelect == true,
				options = {},
				selected = {},
			}
			for _, option in ipairs(cfg.options or {}) do el.options[#el.options + 1] = tostring(option) end

			local function pick(value)
				local chosen = {}
				local list = type(value) == "table" and value or (value ~= nil and { value } or {})
				for _, entry in ipairs(list) do
					entry = tostring(entry)
					if table.find(el.options, entry) and not table.find(chosen, entry) then
						chosen[#chosen + 1] = entry
						if not el.multi then break end
					end
				end
				el.selected = chosen
			end
			pick(cfg.value)

			local frame, sep = makeItem(row)
			frame.ClipsDescendants = true
			local hit = makeHit(frame)
			U.label(frame, {
				Name = "Name",
				Position = UDim2.fromOffset(12, 0),
				Size = UDim2.new(0.5, -12, 0, ROW_H),
				Text = el.name,
				ZIndex = 2,
			})

			local chip = U.make("Frame", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -10, 0, (ROW_H - 24) / 2),
				Size = UDim2.new(0.5, -14, 0, 24),
				BackgroundColor3 = T.chip,
				BorderSizePixel = 0,
				ZIndex = 2,
			}, frame)
			U.corner(chip, 6)
			local valueLabel = U.label(chip, {
				Position = UDim2.fromOffset(8, 0),
				Size = UDim2.new(1, -28, 1, 0),
				Text = "None",
				TextSize = 12,
				TextColor3 = T.text,
				ZIndex = 3,
			})
			local chevron = U.make("Frame", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -8, 0.5, 0),
				Size = UDim2.fromOffset(12, 12),
				BackgroundTransparency = 1,
				ZIndex = 3,
			}, chip)
			for _, spec in ipairs({ { -3, 45 }, { 3, -45 } }) do
				local arm = U.make("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(0.5, spec[1], 0.5, 0),
					Size = UDim2.fromOffset(7, 2),
					Rotation = spec[2],
					BackgroundColor3 = T.sub,
					BorderSizePixel = 0,
					ZIndex = 3,
				}, chevron)
				U.corner(arm, 1)
			end

			local list = U.make("ScrollingFrame", {
				Name = "List",
				Position = UDim2.fromOffset(8, ROW_H + 2),
				Size = UDim2.new(1, -16, 0, 0),
				BackgroundColor3 = T.panel,
				BorderSizePixel = 0,
				ScrollBarThickness = 3,
				ScrollBarImageColor3 = T.line,
				CanvasSize = UDim2.new(),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollingDirection = Enum.ScrollingDirection.Y,
				ZIndex = 2,
			}, frame)
			U.corner(list, 8)
			U.make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, list)
			U.make("UIPadding", {
				PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
				PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),
			}, list)

			local buttons = {}
			local open = false
			local listHeight = 0

			local function refresh()
				if #el.selected == 0 then
					valueLabel.Text = "None"
				elseif #el.selected == 1 or not el.multi then
					valueLabel.Text = el.selected[1]
				else
					valueLabel.Text = #el.selected .. " selected"
				end
				for index, entry in ipairs(buttons) do
					local on = table.find(el.selected, el.options[index]) ~= nil
					U.tween(entry.dot, 0.2, { BackgroundTransparency = on and 0 or 1 }, Enum.EasingStyle.Quad)
					U.tween(entry.button, 0.2, { TextColor3 = on and T.text or T.sub }, Enum.EasingStyle.Quad)
				end
			end

			local function setOpen(state)
				open = state
				local height = state and (ROW_H + 2 + listHeight + 8) or ROW_H
				U.tween(frame, 0.35, { Size = UDim2.new(1, 0, 0, height) }, Enum.EasingStyle.Quint)
				U.tween(list, 0.35, { Size = UDim2.new(1, -16, 0, listHeight) }, Enum.EasingStyle.Quint)
				U.tween(chevron, 0.35, { Rotation = state and 180 or 0 }, Enum.EasingStyle.Quint)
			end

			local function build()
				for _, entry in ipairs(buttons) do entry.button:Destroy() end
				buttons = {}
				listHeight = math.min(#el.options * OPTION_H + 8, 164)
				for index, option in ipairs(el.options) do
					local button = U.button(list, {
						LayoutOrder = index,
						Size = UDim2.new(1, 0, 0, OPTION_H),
						Text = option,
						TextColor3 = T.sub,
						TextSize = 12,
						Font = Enum.Font.GothamMedium,
						TextXAlignment = Enum.TextXAlignment.Left,
						ZIndex = 3,
					})
					U.make("UIPadding", { PaddingLeft = UDim.new(0, 10) }, button)
					local dot = U.make("Frame", {
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, -8, 0.5, 0),
						Size = UDim2.fromOffset(7, 7),
						BackgroundColor3 = T.green,
						BackgroundTransparency = 1,
						BorderSizePixel = 0,
						ZIndex = 4,
					}, button)
					U.corner(dot, 4)
					button.Activated:Connect(function()
						if el.multi then
							local chosen = U.copyList(el.selected)
							local at = table.find(chosen, option)
							if at then table.remove(chosen, at) else chosen[#chosen + 1] = option end
							el:_set(chosen)
						else
							if el.selected[1] ~= option then el:_set(option) end
							setOpen(false)
						end
					end)
					buttons[index] = { button = button, dot = dot }
				end
				refresh()
				if open then setOpen(true) end
			end

			function el:_natural()
				if self.multi then return U.copyList(self.selected) end
				return self.selected[1]
			end
			function el:_serialize() return U.copyList(self.selected) end
			function el:_set(value, quiet)
				pick(value)
				refresh()
				window._values[self.flag] = self:_natural()
				window:_changed()
				if not quiet then U.run(self.callback, self:_natural()) end
			end
			function el:_load(data)
				if type(data) ~= "table" and type(data) ~= "string" then return false end
				self:_set(data, true)
				return true
			end
			function el:_fire() U.run(self.callback, self:_natural()) end
			-- (used by the Settings tab) replace the options, dropping a selection that no longer exists
			function el:_setOptions(options)
				self.options = {}
				for _, option in ipairs(options) do self.options[#self.options + 1] = tostring(option) end
				pick(self.selected)
				build()
			end

			hit.Activated:Connect(function() setOpen(not open) end)
			build()
			return finish(row, el, cfg, frame, sep)
		end

		----------------------------------------------------------------
		-- Input (a text box, commits when you press enter or click away)
		----------------------------------------------------------------
		function E.input(row, cfg)
