		----------------------------------------------------------------
		-- Toggle
		----------------------------------------------------------------
		function E.toggle(row, cfg)
			local window = row._window
			local el = {
				kind = "toggle",
				_window = window,
				name = tostring(cfg.name or "Toggle"),
				callback = cfg.callback,
				value = cfg.value == true,
				haveKeybinds = cfg.haveKeybinds == true,
				haveMB = cfg.haveMB == true,
			}
			local frame, sep = makeItem(row)
			local hit = makeHit(frame)
			local label = U.label(frame, {
				Name = "Name",
				Position = UDim2.fromOffset(12, 0),
				Size = UDim2.new(1, -72, 1, 0),
				Text = el.name,
				ZIndex = 2,
			})
			local switch = makeSwitch(frame, UDim2.new(1, -12, 0.5, 0), Vector2.new(1, 0.5))
			switch.set(el.value, true)
			attachOptions(el, frame, 12 + 40 + 8)

			function el:_updateLabel()
				local reserve = 12 + 40 + 12
				if self._hasOptions then reserve += 30 end
				label.Size = UDim2.new(1, -reserve, 1, 0)
			end
			el:_updateLabel()

			function el:_natural() return self.value end
			function el:_serialize() return self.value end
			function el:_set(value, quiet)
				value = value == true
				if self.value == value then return end
				self.value = value
				switch.set(value)
				window._values[self.flag] = value
				if self._mb then self._mb.SetState(value) end
				window:_changed()
				if not quiet then U.run(self.callback, value) end
			end
			function el:_load(data)
				if type(data) ~= "boolean" then return false end
				self:_set(data, true)
				return true
			end
			function el:_fire() U.run(self.callback, self.value) end
			function el:_onKey() self:_set(not self.value) end

			hit.Activated:Connect(function() el:_onKey() end)
			return finish(row, el, cfg, frame, sep)
		end

