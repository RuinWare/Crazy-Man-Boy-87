-- Library (the main UI)
--
-- Big, resizable, draggable window: sidebar tabs, sections, two rows that scroll together, a profile card,
-- search, a Settings tab that is always there, notifications and toasts.
--
-- The first part is the library body (it only declares things, nothing is built until CreateWindow is called).
-- Everything below "TEST" builds a window to try it out. To use the body from a loadstring, put it in its own
-- file and end it with `return Library`.
--
-- Handles: every Create... call returns an empty handle. Read and write values through the window:
--   window.Flags.MyFlag        read a value        window.Flags.MyFlag = true    write it (UI + callback)
--   window:Get("MyFlag")       the same read        window:Set("MyFlag", true)    the same write

----------------------------------------------------------------
-- LIBRARY BODY
----------------------------------------------------------------
local Library = (function()
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local TweenService = game:GetService("TweenService")
	local UserInputService = game:GetService("UserInputService")
	local GuiService = game:GetService("GuiService")
	local HttpService = game:GetService("HttpService")
	local TextService = game:GetService("TextService")

	local Library = { Windows = {} }

	-- the icons that are part of the UI itself (they are not declared in your script)
	local ICON_CLOSE = 105495420516711
	local ICON_CLOSE_CROPPED = 79433481401060
	local ICON_SEARCH = 77209819096039
	local ICON_SETTINGS = 140694242057630
	local ICON_DOTS = 123906774409861
	local GLOW_ASSET = "rbxassetid://138843696730147"

	-- sizes (pixels)
	local C = {
		HEADER_H = 54,
		SIDEBAR_W = 168,
		PANEL_PAD = 8,
		TAB_H = 34,
		ROW_H = 38,
		PROFILE_H = 64,
		PAGE_PAD = 12,
		COL_GAP = 10,
		START_SIZE = Vector2.new(680, 420),
		MIN_SIZE = Vector2.new(500, 280),
		MAX_SIZE = Vector2.new(1100, 760),
		SCREEN_MARGIN = 6,
		-- drag bar + resize corner (same as the mobile buttons)
		BAR_DISTANCE = 5,
		BAR_SIZE = Vector2.new(51, 3),
		BAR_SIZE_ACTIVE = Vector2.new(61, 4),
		BAR_HIT = Vector2.new(72, 22),
		DRAG_FOLLOW_SPEED = 9,
		RESIZE_FOLLOW_SPEED = 26,
		BAR_IDLE = 0.55,
		ICON_IDLE = 0.45,
		ICON_R = 15,
		ICON_THICK = 2.5,
		ICON_INSET = 12,
		GLOW_SPREAD = 46,
		GLOW_BRIGHTNESS = 0.3,
		GLOW_SLICE = 0.4,
	}
	C.BAR_BELOW = C.BAR_DISTANCE + C.BAR_HIT.Y / 2

	-- colors (plain gray, no blue)
	local T = {
		base = Color3.fromRGB(17, 17, 17),
		baseAlpha = 0.06,
		panel = Color3.fromRGB(24, 24, 24),
		panelAlpha = 0.04,
		card = Color3.fromRGB(30, 30, 30),
		line = Color3.fromRGB(46, 46, 46),
		chip = Color3.fromRGB(42, 42, 42),
		chipHover = Color3.fromRGB(54, 54, 54),
		selected = Color3.fromRGB(38, 38, 38),
		text = Color3.fromRGB(236, 236, 236),
		sub = Color3.fromRGB(140, 140, 140),
		green = Color3.fromRGB(48, 209, 88),
		off = Color3.fromRGB(54, 54, 54),
		knobOff = Color3.fromRGB(150, 150, 150),
		white = Color3.new(1, 1, 1),
	}

	local U, D, K, S, N, E, W = {}, {}, {}, {}, {}, {}, {}

	----------------------------------------------------------------
	-- Helpers
	----------------------------------------------------------------
	do
		local gui = nil
		local CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
		local rng = Random.new()

		function U.tween(obj, time, props, style, direction)
			local t = TweenService:Create(
				obj,
				TweenInfo.new(time, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out),
				props
			)
			t:Play()
			return t
		end

		function U.make(class, props, parent)
			local inst = Instance.new(class)
			for key, value in pairs(props) do
				inst[key] = value
			end
			inst.Parent = parent
			return inst
		end

		function U.corner(parent, radius)
			return U.make("UICorner", { CornerRadius = typeof(radius) == "UDim" and radius or UDim.new(0, radius) }, parent)
		end

		function U.stroke(parent, color, transparency, thickness)
			return U.make("UIStroke", {
				Color = color or T.line,
				Transparency = transparency or 0,
				Thickness = thickness or 1,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			}, parent)
		end

		function U.label(parent, props)
			local p = {
				BackgroundTransparency = 1,
				Text = "",
				TextColor3 = T.text,
				TextSize = 13,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			}
			for key, value in pairs(props) do p[key] = value end
			return U.make("TextLabel", p, parent)
		end

		function U.button(parent, props)
			local p = {
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				Selectable = false,
			}
			for key, value in pairs(props or {}) do p[key] = value end
			return U.make("TextButton", p, parent)
		end

		function U.isPress(input)
			return input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
		end

		function U.p2(input)
			return Vector2.new(input.Position.X, input.Position.Y)
		end

		-- screen coordinates that match AbsolutePosition (the GUIs here ignore the top bar inset)
		function U.screenPos(input)
			local inset = GuiService:GetGuiInset()
			return Vector2.new(input.Position.X + inset.X, input.Position.Y + inset.Y)
		end

		function U.hasIcon(id)
			return id ~= nil and id ~= 0 and id ~= "0" and id ~= ""
		end

		function U.assetUrl(id)
			if type(id) == "string" and id:find("://", 1, true) then return id end
			return "rbxassetid://" .. tostring(id)
		end

		-- runs a callback on its own thread so an error in it can't break the UI
		function U.run(callback, ...)
			if type(callback) ~= "function" then return end
			local args = table.pack(...)
			task.spawn(function()
				local ok, err = pcall(callback, table.unpack(args, 1, args.n))
				if not ok then warn("[Library] " .. tostring(err)) end
			end)
		end

		function U.randomName(length)
			local out = {}
			for i = 1, length do
				local n = rng:NextInteger(1, #CHARS)
				out[i] = CHARS:sub(n, n)
			end
			return table.concat(out)
		end

		-- hidden UI container > CoreGui > PlayerGui
		function U.parentGui(target)
			local places = {}
			if gethui then
				local ok, container = pcall(gethui)
				if ok and container then places[#places + 1] = container end
			end
			local okCore, coreGui = pcall(function() return game:GetService("CoreGui") end)
			if okCore and coreGui then places[#places + 1] = coreGui end
			local localPlayer = Players.LocalPlayer
			local playerGui = localPlayer and localPlayer:FindFirstChildOfClass("PlayerGui")
			if playerGui then places[#places + 1] = playerGui end
			for _, place in ipairs(places) do
				local ok = pcall(function() target.Parent = place end)
				if ok and target.Parent == place then return end
			end
		end

		-- the one ScreenGui everything lives in
		function U.gui()
			if gui and gui.Parent then return gui end
			gui = U.make("ScreenGui", {
				Name = U.randomName(20),
				ResetOnSpawn = false,
				IgnoreGuiInset = true,
				DisplayOrder = 2147483000,
				ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
			}, nil)
			U.parentGui(gui)
			return gui
		end

		function U.destroyGui()
			if gui then gui:Destroy() end
			gui = nil
		end

		function U.viewport()
			if gui and gui.AbsoluteSize.X > 1 and gui.AbsoluteSize.Y > 1 then return gui.AbsoluteSize end
			return workspace.CurrentCamera.ViewportSize
		end

		-- how many decimals a step like 0.01 has
		function U.decimalsOf(step)
			local text = string.format("%.8f", step)
			text = text:gsub("0+$", "")
			local decimals = text:match("%.(%d*)$")
			return decimals and #decimals or 0
		end

		function U.rgbOf(color)
			return math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5)
		end

		function U.copyList(list)
			local out = {}
			for index, value in ipairs(list) do out[index] = value end
			return out
		end
	end

	----------------------------------------------------------------
	-- Storage: one file per window name (settings, last session, saved configurations, window position)
	----------------------------------------------------------------
	do
		local canFiles = type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
		local memory = {}
		pcall(function()
			if getgenv then
				local env = getgenv()
				env.__LibraryMemory = env.__LibraryMemory or {}
				memory = env.__LibraryMemory
			end
		end)

		function S.file(name)
			local clean = tostring(name):gsub("[^%w_%-]", "_")
			return "Library_" .. clean .. ".json"
		end

		function S.read(name)
			local file = S.file(name)
			local ok, data = pcall(function()
				if canFiles then
					if not isfile(file) then return nil end
					return HttpService:JSONDecode(readfile(file))
				end
				if memory[file] then return HttpService:JSONDecode(memory[file]) end
				return nil
			end)
			if ok and type(data) == "table" then return data end
			return {}
		end

		function S.write(name, data)
			local file = S.file(name)
			local ok, text = pcall(function() return HttpService:JSONEncode(data) end)
			if not ok then return false end
			if canFiles then
				return (pcall(writefile, file, text))
			end
			memory[file] = text
			return true
		end
	end

	----------------------------------------------------------------
	-- Keys: bound keys, and "press a key" capture
	----------------------------------------------------------------
	do
		K.list = {}       -- elements that have a key
		K.capturing = nil -- when set, the next key press goes to this function

		local NAMES = {
			One = "1", Two = "2", Three = "3", Four = "4", Five = "5",
			Six = "6", Seven = "7", Eight = "8", Nine = "9", Zero = "0",
			Return = "Enter", Backquote = "`", Minus = "-", Equals = "=",
			LeftBracket = "[", RightBracket = "]", Semicolon = ";", Quote = "'",
			Comma = ",", Period = ".", Slash = "/", BackSlash = "\\",
		}

		-- Q, E, Left Shift, Caps Lock ...
		function K.label(keyCode)
			if not keyCode then return "None" end
			local name = keyCode.Name
			if NAMES[name] then return NAMES[name] end
			return (name:gsub("(%l)(%u)", "%1 %2"))
		end

		function K.add(element)
			if not table.find(K.list, element) then K.list[#K.list + 1] = element end
		end

		function K.remove(element)
			local index = table.find(K.list, element)
			if index then table.remove(K.list, index) end
		end

		-- cancel runs if the capture is replaced or abandoned
		function K.capture(callback, cancel)
			if K.capturing and K.cancel then K.cancel() end
			K.capturing = callback
			K.cancel = cancel
		end

		function K.began(input)
			if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
			if K.capturing then
				local callback = K.capturing
				K.capturing = nil
				K.cancel = nil
				callback(input.KeyCode)
				return
			end
			if UserInputService:GetFocusedTextBox() then return end
			for _, element in ipairs(table.clone(K.list)) do
				if element._key == input.KeyCode then
					local ok, err = pcall(element._onKey, element)
					if not ok then warn("[Library] " .. tostring(err)) end
				end
			end
		end
	end

	----------------------------------------------------------------
	-- Dragging: one thing at a time (window bar, resize, slider, color picker)
	----------------------------------------------------------------
	do
		D.state = nil

		function D.finish(state)
			if D.state ~= state then return end
			D.state = nil
			if state.connection then state.connection:Disconnect() end
			if state.scroller then state.scroller.ScrollingEnabled = true end
			if state.onEnd then state.onEnd() end
		end

		-- scroller: a ScrollingFrame to freeze while dragging (otherwise a moving finger gets taken over by the scrolling)
		function D.begin(input, onMove, onEnd, scroller)
			if D.state then return false end
			local state = { input = input, onMove = onMove, onEnd = onEnd, scroller = scroller }
			D.state = state
			if scroller then scroller.ScrollingEnabled = false end
			state.connection = input.Changed:Connect(function()
				local s = input.UserInputState
				if s == Enum.UserInputState.End or s == Enum.UserInputState.Cancel then D.finish(state) end
			end)
			return true
		end

		function D.changed(input)
			local state = D.state
			if not state then return end
			if input.UserInputType ~= Enum.UserInputType.MouseMovement and input ~= state.input then return end
			state.onMove(input)
		end

		function D.ended(input)
			local state = D.state
			if not state then return end
			local same = input == state.input
				or (state.input.UserInputType == Enum.UserInputType.MouseButton1
					and input.UserInputType == Enum.UserInputType.MouseButton1)
			if same then D.finish(state) end
		end
	end

	local initialized = false
	local connections = {}

	local function ensureInit()
		if initialized then return end
		initialized = true
		U.gui()
		connections[#connections + 1] = UserInputService.InputChanged:Connect(D.changed)
		connections[#connections + 1] = UserInputService.InputEnded:Connect(D.ended)
		connections[#connections + 1] = UserInputService.InputBegan:Connect(K.began)
	end

	----------------------------------------------------------------
	-- Notifications (bottom right, click to dismiss) and toasts (a pill from the top)
	----------------------------------------------------------------
	do
		local stack, toastStack = nil, nil
		local active = {}
		local counter = 0

		local function autoDuration(...)
			local length = 0
			for _, text in ipairs({ ... }) do length += #tostring(text or "") end
			return math.clamp(3 + length / 25, 3, 9)
		end

		local function getStack()
			if stack and stack.Parent then return stack end
			stack = U.make("Frame", {
				Name = "Notifications",
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -14, 1, -14),
				Size = UDim2.new(0, 290, 1, -28),
				BackgroundTransparency = 1,
			}, U.gui())
			U.make("UIListLayout", {
				VerticalAlignment = Enum.VerticalAlignment.Bottom,
				HorizontalAlignment = Enum.HorizontalAlignment.Right,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 8),
			}, stack)
			return stack
		end

		local function getToastStack()
			if toastStack and toastStack.Parent then return toastStack end
			toastStack = U.make("Frame", {
				Name = "Toasts",
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, 14),
				Size = UDim2.new(0, 360, 1, -28),
				BackgroundTransparency = 1,
			}, U.gui())
			U.make("UIListLayout", {
				VerticalAlignment = Enum.VerticalAlignment.Top,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 8),
			}, toastStack)
			return toastStack
		end

		-- slides the card out, then closes the gap it leaves
		local function retire(wrapper, card, offX, offY)
			if not wrapper.Parent then return end
			local height = wrapper.AbsoluteSize.Y
			wrapper.AutomaticSize = Enum.AutomaticSize.None
			wrapper.Size = UDim2.new(1, 0, 0, height)
			U.tween(card, 0.3, { Position = UDim2.new(card.Position.X.Scale, offX, 0, offY) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			task.delay(0.3, function()
				if not wrapper.Parent then return end
				U.tween(wrapper, 0.25, { Size = UDim2.new(1, 0, 0, 0) }, Enum.EasingStyle.Quint)
				task.delay(0.26, function() wrapper:Destroy() end)
			end)
		end

		N.enabled = true

		function N.notify(props)
			if N.enabled == false then return end
			props = props or {}
			local list = getStack()
			counter += 1

			-- the stack holds six: the oldest leaves early
			while #active >= 6 do
				local oldest = table.remove(active, 1)
				oldest.finish(true)
			end

			local wrapper = U.make("Frame", {
				Name = "Wrapper",
				LayoutOrder = counter,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
			}, list)
			local card = U.button(wrapper, {
				Name = "Card",
				Position = UDim2.new(0, 330, 0, 0),
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundColor3 = T.card,
				BackgroundTransparency = 0.04,
			})
			card.Parent = wrapper
			U.corner(card, 10)
			U.stroke(card, T.white, 0.88)
			U.make("UIPadding", {
				PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
				PaddingTop = UDim.new(0, 11), PaddingBottom = UDim.new(0, 10),
			}, card)
			U.make("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, card)

			local head = U.make("Frame", {
				LayoutOrder = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
			}, card)
			local titleX = 0
			if U.hasIcon(props.icon) then
				U.make("ImageLabel", {
					Position = UDim2.fromOffset(0, 0),
					Size = UDim2.fromOffset(18, 18),
					BackgroundTransparency = 1,
					Image = U.assetUrl(props.icon),
					ScaleType = Enum.ScaleType.Fit,
				}, head)
				titleX = 26
			end
			U.label(head, {
				Position = UDim2.fromOffset(titleX, 0),
				Size = UDim2.new(1, -titleX, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Text = tostring(props.title or "Notification"),
				TextSize = 14,
				Font = Enum.Font.GothamBold,
				TextWrapped = true,
				TextTruncate = Enum.TextTruncate.None,
			})
			if props.content and tostring(props.content) ~= "" then
				U.label(card, {
					LayoutOrder = 2,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					Text = tostring(props.content),
					TextSize = 12,
					TextColor3 = T.sub,
					TextWrapped = true,
					TextTruncate = Enum.TextTruncate.None,
				})
			end
			local track = U.make("Frame", {
				LayoutOrder = 3,
				Size = UDim2.new(1, 0, 0, 2),
				BackgroundColor3 = T.off,
				BorderSizePixel = 0,
			}, card)
			U.corner(track, 1)
			local fill = U.make("Frame", {
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = T.green,
				BorderSizePixel = 0,
			}, track)
			U.corner(fill, 1)

			U.tween(card, 0.45, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Back)

			local entry = {}
			local done = false
			local paused = false
			function entry.finish(instant)
				if done then return end
				done = true
				local index = table.find(active, entry)
				if index then table.remove(active, index) end
				if instant then
					wrapper:Destroy()
				else
					retire(wrapper, card, 330, 0)
				end
			end
			active[#active + 1] = entry

			card.MouseEnter:Connect(function() paused = true end)
			card.MouseLeave:Connect(function() paused = false end)
			card.Activated:Connect(function() entry.finish(true) end)

			local duration = tonumber(props.duration) or autoDuration(props.title, props.content)
			task.spawn(function()
				local remaining = duration
				while remaining > 0 and not done do
					local dt = task.wait()
					if not paused then
						remaining -= dt
						if fill.Parent then fill.Size = UDim2.fromScale(math.max(remaining, 0) / duration, 1) end
					end
				end
				entry.finish(false)
			end)
		end

		function N.toast(props)
			props = props or {}
			local list = getToastStack()
			counter += 1

			local wrapper = U.make("Frame", {
				Name = "Wrapper",
				LayoutOrder = -counter, -- newest on top
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
			}, list)
			local pill = U.make("Frame", {
				Name = "Toast",
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, -90),
				Size = UDim2.fromOffset(0, 0),
				AutomaticSize = Enum.AutomaticSize.XY,
				BackgroundColor3 = T.card,
				BackgroundTransparency = 0.04,
			}, wrapper)
			U.corner(pill, 22)
			U.stroke(pill, T.white, 0.88)
			U.make("UIPadding", {
				PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 18),
				PaddingTop = UDim.new(0, 9), PaddingBottom = UDim.new(0, 9),
			}, pill)
			U.make("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				Padding = UDim.new(0, 10),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}, pill)
			U.make("UISizeConstraint", { MaxSize = Vector2.new(340, 200) }, pill)

			if tonumber(props.avatar) then
				local avatar = U.make("ImageLabel", {
					LayoutOrder = 1,
					Size = UDim2.fromOffset(26, 26),
					BackgroundColor3 = T.chip,
					Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=100&h=100", props.avatar),
				}, pill)
				U.corner(avatar, 13)
			elseif U.hasIcon(props.icon) then
				U.make("ImageLabel", {
					LayoutOrder = 1,
					Size = UDim2.fromOffset(22, 22),
					BackgroundTransparency = 1,
					Image = U.assetUrl(props.icon),
					ScaleType = Enum.ScaleType.Fit,
				}, pill)
			end

			local texts = U.make("Frame", {
				LayoutOrder = 2,
				Size = UDim2.fromOffset(0, 0),
				AutomaticSize = Enum.AutomaticSize.XY,
				BackgroundTransparency = 1,
			}, pill)
			U.make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 1) }, texts)
			U.label(texts, {
				LayoutOrder = 1,
				Size = UDim2.fromOffset(0, 0),
				AutomaticSize = Enum.AutomaticSize.XY,
				Text = tostring(props.title or "Toast"),
				TextSize = 13,
				Font = Enum.Font.GothamBold,
				TextTruncate = Enum.TextTruncate.None,
			})
			if props.subtitle and tostring(props.subtitle) ~= "" then
