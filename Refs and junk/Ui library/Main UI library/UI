		----------------------------------------------------------------
		-- Keybind (shows the key, outputs an Enum.KeyCode)
		----------------------------------------------------------------
		function E.keybind(row, cfg)
			local window = row._window
			local function toKey(value)
				if typeof(value) == "EnumItem" then return value end
				if type(value) == "string" and value ~= "" then
					local ok, key = pcall(function() return Enum.KeyCode[value] end)
					if ok then return key end
				end
				return nil
			end

			local el = {
				kind = "keybind",
				_window = window,
				name = tostring(cfg.name or "Keybind"),
				callback = cfg.callback,
				onChanged = cfg.onChanged,
				value = toKey(cfg.value),
			}
			el._key = el.value
			if el._key then K.add(el) end

			local frame, sep = makeItem(row)
			U.label(frame, {
				Name = "Name",
				Position = UDim2.fromOffset(12, 0),
				Size = UDim2.new(0.5, -12, 1, 0),
				Text = el.name,
				ZIndex = 2,
			})
			local chip = U.button(frame, {
				Name = "Key",
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.fromOffset(96, 24),
				BackgroundTransparency = 0,
				BackgroundColor3 = T.chip,
				Text = K.label(el.value),
				TextColor3 = T.text,
				TextSize = 12,
				Font = Enum.Font.GothamMedium,
				ZIndex = 3,
			})
			U.corner(chip, 6)
			local chipScale = U.make("UIScale", { Scale = 1 }, chip)

			function el:_natural() return self.value end
			function el:_serialize() return self.value and self.value.Name or "" end
			-- changing the key never runs the press callback
			function el:_set(value)
				value = toKey(value)
				self.value = value
				self._key = value
				if value then K.add(self) else K.remove(self) end
				chip.Text = K.label(value)
				window._values[self.flag] = value
				window:_changed()
				if self.onChanged then U.run(self.onChanged, value) end
			end
			function el:_load(data)
				if type(data) ~= "string" then return false end
				self:_set(data)
				return false -- nothing to fire: the callback is for presses
			end
			function el:_fire() end
			function el:_onKey() U.run(self.callback, self.value) end

			local function restore()
				if chip.Parent then
					chip.Text = K.label(el.value)
					U.tween(chip, 0.2, { BackgroundColor3 = T.chip }, Enum.EasingStyle.Quad)
				end
			end
			chip.MouseEnter:Connect(function()
				if not K.capturing then U.tween(chip, 0.15, { BackgroundColor3 = T.chipHover }, Enum.EasingStyle.Quad) end
			end)
			chip.MouseLeave:Connect(function()
				if not K.capturing then U.tween(chip, 0.2, { BackgroundColor3 = T.chip }, Enum.EasingStyle.Quad) end
			end)
			chip.InputBegan:Connect(function(input)
				if U.isPress(input) then U.tween(chipScale, 0.08, { Scale = 0.94 }, Enum.EasingStyle.Quad) end
			end)
			chip.InputEnded:Connect(function(input)
				if U.isPress(input) then U.tween(chipScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back) end
			end)
			chip.Activated:Connect(function()
				-- press a key to bind it: Backspace clears, Escape keeps the current one
				chip.Text = "..."
				U.tween(chip, 0.15, { BackgroundColor3 = T.green }, Enum.EasingStyle.Quad)
				K.capture(function(keyCode)
					if keyCode == Enum.KeyCode.Backspace then
						el:_set(nil)
					elseif keyCode ~= Enum.KeyCode.Escape then
						el:_set(keyCode)
					end
					restore()
				end, restore)
			end)

			return finish(row, el, cfg, frame, sep)
		end

		----------------------------------------------------------------
		-- Color picker (whole-number RGB, no alpha)
		----------------------------------------------------------------
		function E.colorpicker(row, cfg)
			local window = row._window
			local PICK_H = 112
			local FIELDS_Y = ROW_H + 4 + PICK_H + 8
			local OPEN_H = FIELDS_Y + 24 + 10

			local function quantize(color)
				local r, g, b = U.rgbOf(color)
				return Color3.fromRGB(r, g, b)
			end
			local function toColor(value)
				if typeof(value) == "Color3" then return quantize(value) end
				if type(value) == "table" and #value >= 3 then
					return Color3.fromRGB(
						math.clamp(math.floor(tonumber(value[1]) or 0), 0, 255),
						math.clamp(math.floor(tonumber(value[2]) or 0), 0, 255),
						math.clamp(math.floor(tonumber(value[3]) or 0), 0, 255)
					)
				end
				return nil
			end

			local el = {
				kind = "color",
				_window = window,
				name = tostring(cfg.name or "Color Picker"),
				callback = cfg.callback,
				value = toColor(cfg.color) or Color3.new(1, 1, 1),
			}
			local hue, sat, val = el.value:ToHSV()

			local frame, sep = makeItem(row)
			frame.ClipsDescendants = true
			local hit = makeHit(frame)
			U.label(frame, {
				Name = "Name",
				Position = UDim2.fromOffset(12, 0),
				Size = UDim2.new(1, -90, 0, ROW_H),
				Text = el.name,
				ZIndex = 2,
			})
			local swatch = U.make("Frame", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -12, 0, ROW_H / 2),
				Size = UDim2.fromOffset(46, 22),
				BackgroundColor3 = el.value,
				BorderSizePixel = 0,
				ZIndex = 2,
			}, frame)
			U.corner(swatch, 6)
			U.stroke(swatch, T.white, 0.8)

			-- the map: saturation across, brightness down
			local map = U.make("Frame", {
				Position = UDim2.new(0, 12, 0, ROW_H + 4),
				Size = UDim2.new(1, -50, 0, PICK_H),
				BackgroundColor3 = Color3.fromHSV(hue, 1, 1),
				BorderSizePixel = 0,
				ZIndex = 2,
			}, frame)
			U.corner(map, 6)
			local whiteLayer = U.make("Frame", {
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = T.white,
				BorderSizePixel = 0,
				ZIndex = 3,
			}, map)
			U.corner(whiteLayer, 6)
			U.make("UIGradient", {
				Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
			}, whiteLayer)
			local blackLayer = U.make("Frame", {
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Color3.new(0, 0, 0),
				BorderSizePixel = 0,
				ZIndex = 4,
			}, map)
			U.corner(blackLayer, 6)
			U.make("UIGradient", {
				Rotation = 90,
				Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }),
			}, blackLayer)
			local mapCursor = U.make("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(12, 12),
				BackgroundTransparency = 1,
				ZIndex = 6,
			}, map)
			U.corner(mapCursor, 6)
			U.stroke(mapCursor, T.white, 0, 2)

			-- the hue bar
			local bar = U.make("Frame", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -12, 0, ROW_H + 4),
				Size = UDim2.fromOffset(16, PICK_H),
				BackgroundColor3 = T.white,
				BorderSizePixel = 0,
				ZIndex = 2,
			}, frame)
			U.corner(bar, 6)
			local keypoints = {}
			for step = 0, 6 do
				keypoints[#keypoints + 1] = ColorSequenceKeypoint.new(step / 6, Color3.fromHSV(math.min(step / 6, 0.9999), 1, 1))
			end
			U.make("UIGradient", { Rotation = 90, Color = ColorSequence.new(keypoints) }, bar)
			local barCursor = U.make("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(22, 4),
				BackgroundColor3 = T.white,
				BorderSizePixel = 0,
				ZIndex = 6,
			}, bar)
			U.corner(barCursor, 2)
			U.stroke(barCursor, Color3.new(0, 0, 0), 0.6, 1)

			-- R G B and hex
			local fields = U.make("Frame", {
				Position = UDim2.new(0, 12, 0, FIELDS_Y),
				Size = UDim2.new(1, -24, 0, 24),
				BackgroundTransparency = 1,
				ZIndex = 2,
			}, frame)
			U.make("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}, fields)
			local boxes = {}
			local function field(order, width, placeholder)
				local chip = U.make("Frame", {
					LayoutOrder = order,
					Size = width,
					BackgroundColor3 = T.chip,
					BorderSizePixel = 0,
					ZIndex = 2,
				}, fields)
				U.corner(chip, 6)
				local box = U.make("TextBox", {
					Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1,
					ClearTextOnFocus = false,
					Text = "",
					PlaceholderText = placeholder,
					PlaceholderColor3 = T.sub,
					TextColor3 = T.text,
					TextSize = 12,
					Font = Enum.Font.GothamMedium,
					ZIndex = 3,
				}, chip)
				return box
			end
			boxes.r = field(1, UDim2.new(0.19, -5, 1, 0), "R")
			boxes.g = field(2, UDim2.new(0.19, -5, 1, 0), "G")
			boxes.b = field(3, UDim2.new(0.19, -5, 1, 0), "B")
			boxes.hex = field(4, UDim2.new(0.43, -5, 1, 0), "#RRGGBB")

			local function paint()
				local r, g, b = U.rgbOf(el.value)
				swatch.BackgroundColor3 = el.value
				map.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
				mapCursor.Position = UDim2.fromScale(sat, 1 - val)
				barCursor.Position = UDim2.fromScale(0.5, hue)
				boxes.r.Text, boxes.g.Text, boxes.b.Text = tostring(r), tostring(g), tostring(b)
				boxes.hex.Text = string.format("#%02X%02X%02X", r, g, b)
			end

			-- takes the current hue / saturation / value and publishes the color if it changed
			local function commit(quiet)
				local color = quantize(Color3.fromHSV(hue, sat, val))
				paint()
				if color == el.value then return end
				el.value = color
				paint()
				window._values[el.flag] = color
				window:_changed()
				if not quiet then U.run(el.callback, color) end
			end
			paint()

			function el:_natural() return self.value end
			function el:_serialize()
				local r, g, b = U.rgbOf(self.value)
				return { r, g, b }
			end
			function el:_set(value, quiet)
				local color = toColor(value)
				if not color then return end
				local h, s, v = color:ToHSV()
				if s > 0 and v > 0 then hue = h end
				sat, val = s, v
				el.value = quantize(Color3.fromHSV(hue, sat, val))
				if el.value ~= color then el.value = color end
				paint()
				window._values[self.flag] = el.value
				window:_changed()
				if not quiet then U.run(self.callback, el.value) end
			end
			function el:_load(data)
				if not toColor(data) then return false end
				self:_set(data, true)
				return true
			end
			function el:_fire() U.run(self.callback, self.value) end

			local function dragMap(input)
				local pos = U.screenPos(input)
				sat = math.clamp((pos.X - map.AbsolutePosition.X) / math.max(1, map.AbsoluteSize.X), 0, 1)
				val = 1 - math.clamp((pos.Y - map.AbsolutePosition.Y) / math.max(1, map.AbsoluteSize.Y), 0, 1)
				commit(false)
			end
			local function dragBar(input)
				local pos = U.screenPos(input)
				hue = math.clamp((pos.Y - bar.AbsolutePosition.Y) / math.max(1, bar.AbsoluteSize.Y), 0, 0.9999)
				commit(false)
			end
			map.InputBegan:Connect(function(input)
				if not U.isPress(input) then return end
				if D.begin(input, dragMap, nil, row._tab._page) then dragMap(input) end
			end)
			bar.InputBegan:Connect(function(input)
				if not U.isPress(input) then return end
				if D.begin(input, dragBar, nil, row._tab._page) then dragBar(input) end
			end)

			local function typed()
				local r, g, b = tonumber(boxes.r.Text), tonumber(boxes.g.Text), tonumber(boxes.b.Text)
				if r and g and b then
					el:_set(Color3.fromRGB(
						math.clamp(math.floor(r), 0, 255), math.clamp(math.floor(g), 0, 255), math.clamp(math.floor(b), 0, 255)
					))
				else
					paint()
				end
			end
			boxes.r.FocusLost:Connect(typed)
			boxes.g.FocusLost:Connect(typed)
			boxes.b.FocusLost:Connect(typed)
			boxes.hex.FocusLost:Connect(function()
				local r, g, b = boxes.hex.Text:match("^#?(%x%x)(%x%x)(%x%x)$")
				if r then
					el:_set(Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16)))
				else
					paint()
				end
			end)

			local open = false
			hit.Activated:Connect(function()
				open = not open
				U.tween(frame, 0.35, { Size = UDim2.new(1, 0, 0, open and OPEN_H or ROW_H) }, Enum.EasingStyle.Quint)
			end)

			return finish(row, el, cfg, frame, sep)
		end

		----------------------------------------------------------------
		-- Divider (a line, with a word in the middle if you give it one)
		----------------------------------------------------------------
		function E.divider(row, cfg)
			cfg = cfg or {}
			local text = tostring(cfg.text or "")
			local frame = U.make("Frame", {
				Name = "Divider",
				Size = UDim2.new(1, 0, 0, 26),
				BackgroundTransparency = 1,
			}, row._frame)
			local left = U.make("Frame", { BackgroundColor3 = T.line, BorderSizePixel = 0 }, frame)
			local right = U.make("Frame", { BackgroundColor3 = T.line, BorderSizePixel = 0 }, frame)
			local label = U.label(frame, {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(10, 16),
				Text = text,
				TextSize = 11,
				TextColor3 = T.sub,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextTruncate = Enum.TextTruncate.None,
			})

			local function layout()
				if text == "" then
					label.Visible = false
					right.Visible = false
					left.AnchorPoint = Vector2.new(0, 0.5)
					left.Position = UDim2.new(0, 12, 0.5, 0)
					left.Size = UDim2.new(1, -24, 0, 1)
					return
				end
				label.Visible = true
				right.Visible = true
				local width = frame.AbsoluteSize.X
				local textWidth = label.TextBounds.X
				label.Size = UDim2.fromOffset(textWidth + 4, 16)
				local side = math.max(0, (width - 24 - textWidth - 20) / 2)
				left.AnchorPoint = Vector2.new(0, 0.5)
				left.Position = UDim2.new(0, 12, 0.5, 0)
				left.Size = UDim2.fromOffset(side, 1)
				right.AnchorPoint = Vector2.new(1, 0.5)
				right.Position = UDim2.new(1, -12, 0.5, 0)
				right.Size = UDim2.fromOffset(side, 1)
			end
			frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
			label:GetPropertyChangedSignal("TextBounds"):Connect(layout)
			layout()

			row:_add({ kind = "divider", frame = frame })
			return {}
		end

		----------------------------------------------------------------
		-- Section (the small heading above a box)
		----------------------------------------------------------------
		function E.section(row, cfg)
			cfg = cfg or {}
			local name = tostring(cfg.name or "Section")
			local frame = U.make("Frame", {
				Name = "Section",
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundTransparency = 1,
			}, row._frame)
			local x = 6
			if U.hasIcon(cfg.icon) then
				U.make("ImageLabel", {
					AnchorPoint = Vector2.new(0, 1),
					Position = UDim2.new(0, 6, 1, -3),
					Size = UDim2.fromOffset(14, 14),
					BackgroundTransparency = 1,
					Image = U.assetUrl(cfg.icon),
					ImageColor3 = T.sub,
					ScaleType = Enum.ScaleType.Fit,
				}, frame)
				x = 26
			end
			U.label(frame, {
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.new(0, x, 1, -2),
				Size = UDim2.new(1, -(x + 6), 0, 18),
				Text = name,
				TextSize = 12,
				TextColor3 = T.sub,
			})
			row._lastSection = name
			row:_add({ kind = "section", frame = frame })
			return {}
		end
	end

	----------------------------------------------------------------
	-- Rows, tabs and the window object
	----------------------------------------------------------------
	local Row, Tab, Window = {}, {}, {}
	Row.__index = Row
	Tab.__index = Tab
	Window.__index = Window

	local COMPONENTS = {
		"CreateSection", "CreateToggle", "CreateButton", "CreateSlider", "CreateDropdown",
		"CreateInput", "CreateKeybind", "CreateColorPicker", "CreateDivider",
	}

	-- Row: one of the two scrolling columns. Components that follow each other form one box; a section or a
	-- standalone divider breaks the box.
	do
		local function makeCard(parent)
			local card = U.make("Frame", {
				Name = "Card",
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundColor3 = T.card,
				BorderSizePixel = 0,
			}, parent)
			U.corner(card, 10)
			U.stroke(card, T.white, 0.93)
			U.make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, card)
			return card
		end

		function Row:_add(item)
			self._items[#self._items + 1] = item
			self:_queueLayout()
		end

		function Row:_queueLayout()
			if self._queued then return end
			self._queued = true
			task.defer(function()
				self._queued = false
				if self._frame.Parent then self:_layout() end
			end)
		end

		function Row:_layout()
			local items = self._items
			local count = #items
			local blocks = {}

			-- sections are free; every run of other items between sections becomes a box,
			-- except dividers at the start or the end of the run (those stay outside)
			local i = 1
			while i <= count do
				if items[i].kind == "section" then
					blocks[#blocks + 1] = { type = "free", item = items[i] }
					i += 1
				else
					local j = i
					while j <= count and items[j].kind ~= "section" do j += 1 end
					local first, last = i, j - 1
					while first <= last and items[first].kind == "divider" do
						blocks[#blocks + 1] = { type = "free", item = items[first] }
						first += 1
					end
					local trailing = {}
					while last >= first and items[last].kind == "divider" do
						table.insert(trailing, 1, items[last])
						last -= 1
					end
					if first <= last then
						local group = {}
						for k = first, last do group[#group + 1] = items[k] end
						blocks[#blocks + 1] = { type = "card", items = group }
					end
					for _, item in ipairs(trailing) do
						blocks[#blocks + 1] = { type = "free", item = item }
					end
					i = j
				end
			end

			local order, cardIndex = 0, 0
			for _, block in ipairs(blocks) do
				order += 1
				if block.type == "free" then
					block.item.frame.Parent = self._frame
					block.item.frame.LayoutOrder = order
					if block.item.sep then block.item.sep.Visible = false end
				else
					cardIndex += 1
					local card = self._cards[cardIndex]
					if not card then
						card = makeCard(self._frame)
						self._cards[cardIndex] = card
					end
					card.LayoutOrder = order
					for index, item in ipairs(block.items) do
						item.frame.Parent = card
						item.frame.LayoutOrder = index
						local following = block.items[index + 1]
						if item.sep then
							item.sep.Visible = following ~= nil and following.kind == "component" and item.kind == "component"
						end
					end
				end
			end
			for k = cardIndex + 1, #self._cards do
				self._cards[k]:Destroy()
				self._cards[k] = nil
			end
		end

		function Row:CreateSection(cfg) return E.section(self, cfg or {}) end
		function Row:CreateToggle(cfg) return E.toggle(self, cfg or {}) end
		function Row:CreateButton(cfg) return E.button(self, cfg or {}) end
		function Row:CreateSlider(cfg) return E.slider(self, cfg or {}) end
		function Row:CreateDropdown(cfg) return E.dropdown(self, cfg or {}) end
		function Row:CreateInput(cfg) return E.input(self, cfg or {}) end
		function Row:CreateKeybind(cfg) return E.keybind(self, cfg or {}) end
		function Row:CreateColorPicker(cfg) return E.colorpicker(self, cfg or {}) end
		function Row:CreateDivider(cfg) return E.divider(self, cfg or {}) end
	end

	-- Tab: tab:CreateLeftRow() / tab:CreateRightRow() choose where the components below go.
	-- (they also return the row, so row:CreateToggle(...) works too)
	do
		function Tab:CreateLeftRow()
			self._current = self.Left
			return self.Left
		end

		function Tab:CreateRightRow()
			self._current = self.Right
			return self.Right
		end

		for _, method in ipairs(COMPONENTS) do
			Tab[method] = function(self, cfg)
				local row = self._current
				return row[method](row, cfg)
			end
		end
	end

	----------------------------------------------------------------
	-- Window internals
	----------------------------------------------------------------
	function W.newRow(tab, side)
		local frame = U.make("Frame", {
			Name = side .. "Row",
			LayoutOrder = side == "Left" and 1 or 2,
			Size = UDim2.new(0.5, -C.COL_GAP / 2, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
		}, tab._cols)
		U.make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, frame)
		return setmetatable({
			_tab = tab,
			_window = tab._window,
			_frame = frame,
			_items = {},
			_cards = {},
			_queued = false,
		}, Row)
	end

	function W.newTab(window, config, isSettings)
		local tab = setmetatable({
			_window = window,
			_title = tostring(config.title or config.name or "Tab"),
		}, Tab)

		-- the sidebar button
		local button = U.button(window._tabList, {
			Name = tab._title,
			LayoutOrder = isSettings and 1000000 or (#window.Tabs + 1),
			Size = UDim2.new(1, 0, 0, C.TAB_H),
			BackgroundTransparency = 1,
			BackgroundColor3 = T.selected,
		})
		U.corner(button, 8)
		local textX = 12
		if U.hasIcon(config.icon) then
			tab._icon = U.make("ImageLabel", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 10, 0.5, 0),
				Size = UDim2.fromOffset(18, 18),
				BackgroundTransparency = 1,
				Image = U.assetUrl(config.icon),
				ImageColor3 = T.sub,
				ScaleType = Enum.ScaleType.Fit,
			}, button)
			textX = 38
		end
		tab._label = U.label(button, {
			Position = UDim2.fromOffset(textX, 0),
			Size = UDim2.new(1, -(textX + 6), 1, 0),
			Text = tab._title,
			TextColor3 = T.sub,
		})
		tab._button = button
		button.MouseEnter:Connect(function()
			if window._selected ~= tab then U.tween(button, 0.15, { BackgroundTransparency = 0.7 }, Enum.EasingStyle.Quad) end
		end)
		button.MouseLeave:Connect(function()
			if window._selected ~= tab then U.tween(button, 0.2, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad) end
		end)
		button.Activated:Connect(function()
			window:_closeSearch()
			window:_select(tab)
		end)

		-- the page: one scrolling frame holding both rows, so they scroll together
		local page = U.make("ScrollingFrame", {
			Name = tab._title,
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = T.line,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			Visible = false,
		}, window._content)
		U.make("UIPadding", {
			PaddingLeft = UDim.new(0, C.PAGE_PAD), PaddingRight = UDim.new(0, C.PAGE_PAD),
			PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 28),
		}, page)
		tab._page = page
		tab._cols = U.make("Frame", {
			Name = "Columns",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
		}, page)
		U.make("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, C.COL_GAP),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}, tab._cols)

		tab.Left = W.newRow(tab, "Left")
		tab.Right = W.newRow(tab, "Right")
		tab._current = tab.Left

		window.Tabs[#window.Tabs + 1] = tab
		return tab
	end

	function Window:_select(tab)
		if self._selected == tab then return end
		local previous = self._selected
		self._selected = tab
		for _, other in ipairs(self.Tabs) do
			local on = other == tab
			U.tween(other._button, 0.2, { BackgroundTransparency = on and 0 or 1 }, Enum.EasingStyle.Quad)
			U.tween(other._label, 0.2, { TextColor3 = on and T.text or T.sub }, Enum.EasingStyle.Quad)
			if other._icon then
				U.tween(other._icon, 0.2, { ImageColor3 = on and T.text or T.sub }, Enum.EasingStyle.Quad)
			end
		end
		if self._menu then self._menu.close() end
		if previous then previous._page.Visible = false end
		tab._page.Visible = not self._searching
		tab._page.Position = UDim2.fromOffset(0, 12)
		U.tween(tab._page, 0.35, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quint)
	end

	-- takes you to a tab (by its handle or its title)
	function Window:Navigate(target)
		for _, tab in ipairs(self.Tabs) do
			if tab == target or tab._title == target then
				self:_closeSearch()
				self:_select(tab)
				return true
			end
		end
		return false
	end

	function Window:CreateTab(config)
		config = config or {}
		local tab = W.newTab(self, config, false)
		-- the first tab you make is the one that opens (Settings is only the start until then)
		if self._userTabs == 0 then self:_select(tab) end
		self._userTabs += 1
		return tab
	end

	----------------------------------------------------------------
	-- Values, saving, resetting
	----------------------------------------------------------------
	function Window:_register(el, row, cfg, frame, sep)
		local tab = row._tab
		el._tab = tab
		el._frame = frame
		el._internal = cfg.internal == true

		local flag = cfg.flag
		if flag == nil then
			local base = tab._title .. "/" .. el.name
			self._flagCount[base] = (self._flagCount[base] or 0) + 1
			flag = self._flagCount[base] > 1 and (base .. "#" .. self._flagCount[base]) or base
		end
		el.flag = tostring(flag)
		if cfg._out then cfg._out.el = el end

		if el._serialize then
			if cfg.default ~= nil then el._default = cfg.default else el._default = el:_serialize() end
		end
		row:_add({ kind = "component", frame = frame, sep = sep, el = el })
		self._search[#self._search + 1] = { el = el, tab = tab, section = row._lastSection or "" }

		if el._internal then
			if cfg.setting then self._settingEls[#self._settingEls + 1] = el end
			return {}
		end

		self._all[el.flag] = el
		self._allList[#self._allList + 1] = el
		if el._natural then self._values[el.flag] = el:_natural() end

		-- start from the last session when Auto Load Last Settings is on
		if self._settings.autoLoad then
			local last = self._store.last.values[el.flag]
			if last ~= nil then self:_applyData(el, last) end
			local extras = self._store.last.extras[el.flag]
			if type(extras) == "table" then self:_applyExtras(el, extras) end
		end
		return {}
	end

	-- applies saved data to a component and runs its callback (on the next frame, so your script has finished)
	function Window:_applyData(el, data)
		if el._load and el:_load(data) then
			task.defer(function()
				if not self._unloaded then el:_fire() end
			end)
		end
	end

	function Window:_applyExtras(el, extras)
		if not el._hasOptions then return end
		if el.haveKeybinds then
			local key = nil
			if type(extras.key) == "string" then
				local ok, found = pcall(function() return Enum.KeyCode[extras.key] end)
				if ok then key = found end
			end
			el:_setKey(key)
		end
		if el.haveMB then el:_setMB(extras.mb == true) end
	end

	function Window:_snapshot()
		local values, extras = {}, {}
		for _, el in ipairs(self._allList) do
			if el._serialize then values[el.flag] = el:_serialize() end
			if el._hasOptions then
				local entry = {}
				if el._key then entry.key = el._key.Name end
				if el._mbOn then entry.mb = true end
				extras[el.flag] = entry
			end
		end
		return values, extras
	end

	function Window:_flush()
		S.write(self.Name, self._store)
	end

	-- remembers the last session (a second and a half after the last change)
	function Window:_changed()
		if self._flushQueued or self._unloaded then return end
		self._flushQueued = true
		task.delay(1.5, function()
			self._flushQueued = false
			if self._unloaded then return end
			local values, extras = self:_snapshot()
			for flag, value in pairs(values) do self._store.last.values[flag] = value end
			for flag, entry in pairs(extras) do self._store.last.extras[flag] = entry end
			self:_flush()
		end)
	end

	function Window:_saveSettings()
		local s = self._settings
		self._store.settings = {
			autoLoad = s.autoLoad, protect = s.protect, hidePill = s.hidePill,
			notifications = s.notifications, reopen = s.reopen,
		}
		self:_flush()
	end

	function Window:Get(flag)
		return self._values[flag]
	end

	function Window:Set(flag, value)
		local el = self._all[flag]
		if not el then return false end
		el:_set(value)
		return true
	end

	function Window:Save(name)
		name = tostring(name or "default")
		local values, extras = self:_snapshot()
		self._store.configs[name] = { values = values, extras = extras }
		self:_flush()
		return true
	end

	function Window:Load(name)
		local config = self._store.configs[tostring(name)]
		if type(config) ~= "table" then return false end
		for flag, data in pairs(config.values or {}) do
			local el = self._all[flag]
			if el then self:_applyData(el, data) end
		end
		for flag, entry in pairs(config.extras or {}) do
			local el = self._all[flag]
			if el and type(entry) == "table" then self:_applyExtras(el, entry) end
		end
		return true
	end

	function Window:ListConfigs()
		local names = {}
		for name in pairs(self._store.configs) do names[#names + 1] = name end
		table.sort(names)
		return names
	end

	function Window:DeleteConfig(name)
		if self._store.configs[tostring(name)] == nil then return false end
		self._store.configs[tostring(name)] = nil
		self:_flush()
		return true
	end

	function Window:_resetElement(el)
		if el._serialize and el._default ~= nil and el:_load(el._default) then el:_fire() end
		if el._hasOptions then
			if el.haveKeybinds then el:_setKey(nil) end
			if el.haveMB then el:_setMB(false) end
		end
	end

	-- every component back to the value it was created with (callbacks run)
	function Window:_resetAll()
		for _, el in ipairs(self._allList) do self:_resetElement(el) end
		for _, el in ipairs(self._settingEls) do self:_resetElement(el) end
	end

	function Window:_destroy()
		if self._unloaded then return end
		self._unloaded = true
		if self._menu then self._menu.close() end
		for _, el in ipairs(self._allList) do
			if el._setMB then el:_setMB(false) end
			K.remove(el)
		end
		for _, el in ipairs(self._settingEls) do K.remove(el) end
		for _, connection in ipairs(self._conns) do connection:Disconnect() end
		table.clear(self._conns)
		if D.state then D.finish(D.state) end
		if self._holder then self._holder:Destroy() end
		if self._pillGui then self._pillGui:Destroy() end
		local at = table.find(Library.Windows, self)
		if at then table.remove(Library.Windows, at) end
		if #Library.Windows == 0 then
			for _, connection in ipairs(connections) do connection:Disconnect() end
			table.clear(connections)
			initialized = false
			U.destroyGui()
		end
	end

	-- every component back to default, then the window (and its mobile buttons) is gone
	function Window:Unload()
		if self._unloaded then return end
		self:_resetAll()
		self:_destroy()
	end

	----------------------------------------------------------------
	-- Open / closed (mobile: a pill, PC: a keybind)
	----------------------------------------------------------------
	function Window:_setOpen(state)
		if self._unloaded or self._open == state then return end
		self._open = state
		if self._menu then self._menu.close() end
		self:_closeSearch()
		if D.state then D.finish(D.state) end
		self._openToken += 1
		local mine = self._openToken

		if state then
			self._holder.Visible = true
			self._popScale.Scale = 0.9
			U.tween(self._popScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
			self:_pillHide()
		else
			U.tween(self._popScale, 0.2, { Scale = 0.9 }, Enum.EasingStyle.Quad)
			task.delay(0.21, function()
				if not self._open and mine == self._openToken and self._holder.Parent then
					self._holder.Visible = false
				end
			end)
			if self._mobile then self:_pillShow() end
		end
	end

	function Window:_toggleOpen()
		self:_setOpen(not self._open)
	end

	-- PC or mobile changed: the close button and the pill follow, with animations
	function Window:_applyMode(animate)
		if self._layoutHeader then self:_layoutHeader(animate) end
		if not self._open then
			if self._mobile then self:_pillShow() else self:_pillHide() end
		end
	end

	-- touch and controller = mobile, keyboard and mouse = PC; it follows whatever was used last
	function W.mode(window)
		local function classify(inputType)
			if inputType == Enum.UserInputType.Touch or inputType.Name:find("^Gamepad") then return true end
			if inputType == Enum.UserInputType.Keyboard or inputType.Name:find("^Mouse") then return false end
			return nil
		end

		local mobile = classify(UserInputService:GetLastInputType())
		if mobile == nil then
			mobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
		end
		window._mobile = mobile

		window._conns[#window._conns + 1] = UserInputService.LastInputTypeChanged:Connect(function(inputType)
			local result = classify(inputType)
			if result == nil or result == window._mobile then return end
			window._mobile = result
			window:_applyMode(true)
		end)
	end

	-- the small pill at the top center: icon + title + the cropped icon. Click anywhere to reopen.
	function W.pill(window, config)
		local gui = U.gui()
		local title = window.Name
		local hasLogo = U.hasIcon(config.icon)
		local textWidth = math.min(TextService:GetTextSize(title, 13, Enum.Font.GothamBold, Vector2.new(1000, 20)).X, 170)
		local leftPad = 14 + (hasLogo and 28 or 0)
		local width = leftPad + textWidth + 12 + 18 + 14

		local pill = U.make("CanvasGroup", {
			Name = "Pill",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, -60),
			Size = UDim2.fromOffset(width, 36),
			BackgroundColor3 = T.card,
			BackgroundTransparency = 0.04,
			GroupTransparency = 0,
			Visible = false,
		}, gui)
		U.corner(pill, 18)
		U.stroke(pill, T.white, 0.88)
		if hasLogo then
			U.make("ImageLabel", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 14, 0.5, 0),
				Size = UDim2.fromOffset(20, 20),
				BackgroundTransparency = 1,
				Image = U.assetUrl(config.icon),
				ScaleType = Enum.ScaleType.Fit,
			}, pill)
		end
		U.label(pill, {
			Position = UDim2.fromOffset(leftPad, 0),
			Size = UDim2.fromOffset(textWidth, 36),
			Text = title,
			TextSize = 13,
			Font = Enum.Font.GothamBold,
		})
		U.make("ImageLabel", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			Size = UDim2.fromOffset(18, 18),
			BackgroundTransparency = 1,
			Image = U.assetUrl(ICON_CLOSE_CROPPED),
			ImageColor3 = T.sub,
			ScaleType = Enum.ScaleType.Fit,
		}, pill)

		-- the click area: the whole pill, on top of everything in it
		local hit = U.button(pill, { Name = "Hit", Size = UDim2.fromScale(1, 1), ZIndex = 10 })
		local function reopen() window:_setOpen(true) end
		hit.Activated:Connect(reopen)
		hit.InputBegan:Connect(function(input)
			if U.isPress(input) then reopen() end
		end)

		window._pillGui = pill
		local token = 0

		-- "Hide Mobile Pill": it stays there and stays clickable, you just can't see it
		function window:_pillRefresh(animate)
			local target = self._settings.hidePill and 0.995 or 0
			if animate then
				U.tween(pill, 0.3, { GroupTransparency = target }, Enum.EasingStyle.Quad)
			else
				pill.GroupTransparency = target
			end
		end

		function window:_pillShow()
			token += 1
			pill.Visible = true
			self:_pillRefresh(false)
			U.tween(pill, 0.45, { Position = UDim2.new(0.5, 0, 0, 8) }, Enum.EasingStyle.Back)
		end

		function window:_pillHide()
			token += 1
			local mine = token
			U.tween(pill, 0.25, { Position = UDim2.new(0.5, 0, 0, -60) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			task.delay(0.26, function()
				if token == mine then pill.Visible = false end
			end)
		end
	end

	----------------------------------------------------------------
	-- The window shell: glow, body, drag bar, resize corner
	----------------------------------------------------------------
	function W.shell(window, config)
		local gui = U.gui()
		local conns = window._conns
		local HEADER_H, SIDEBAR_W, PAD = C.HEADER_H, C.SIDEBAR_W, C.PANEL_PAD
		local MARGIN = C.SCREEN_MARGIN

		local function protect() return window._settings.protect ~= false end

		local function fit(size)
			local v = U.viewport()
			local maxX, maxY = C.MAX_SIZE.X, C.MAX_SIZE.Y
			if protect() then
				maxX = math.min(maxX, v.X - MARGIN * 2)
				maxY = math.min(maxY, v.Y - MARGIN * 2 - C.BAR_BELOW)
			end
			return Vector2.new(math.max(1, math.min(size.X, maxX)), math.max(1, math.min(size.Y, maxY)))
		end

		-- Off Screen Protection on: the whole window stays on screen.
		-- Off: it can hang over the edges, but the drag bar stays reachable.
		local function clampCenter(center, size)
			local v = U.viewport()
			local half = size / 2
			local minX, maxX, minY, maxY
			if protect() then
				minX, maxX = half.X + MARGIN, v.X - half.X - MARGIN
				minY, maxY = half.Y + MARGIN, v.Y - half.Y - MARGIN - C.BAR_BELOW
			else
				minX, maxX = 10, v.X - 10
				minY, maxY = 60 - half.Y, v.Y - C.BAR_BELOW - 4 - half.Y
			end
			return Vector2.new(
				math.clamp(center.X, minX, math.max(minX, maxX)),
				math.clamp(center.Y, minY, math.max(minY, maxY))
			)
		end

		local startSize = fit(C.START_SIZE)
		local v0 = U.viewport()
		local center = Vector2.new(v0.X / 2, (v0.Y - C.BAR_BELOW) / 2)
		local saved = window._store.window
		if type(saved) == "table" and tonumber(saved.x) and tonumber(saved.y) then
			center = Vector2.new(v0.X * saved.x, v0.Y * saved.y)
		end
		center = clampCenter(center, startSize)

		local sizeTarget, posTarget = startSize, center
		local sizeCur, posCur = startSize, center
		local dragging, resizing = false, false

		local holder = U.make("Frame", {
			Name = "Window",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(center.X, center.Y),
			Size = UDim2.fromOffset(startSize.X, startSize.Y),
			BackgroundTransparency = 1,
		}, gui)
		local popScale = U.make("UIScale", { Scale = 0.92 }, holder)
		U.tween(popScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
		window._holder, window._popScale = holder, popScale

		-- glow: a soft image behind the window (9-sliced so resizing never distorts it)
		local glow = U.make("ImageLabel", {
			Name = "Glow",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, C.GLOW_SPREAD * 2, 1, C.GLOW_SPREAD * 2),
			BackgroundTransparency = 1,
			Image = GLOW_ASSET,
			ImageColor3 = T.white,
			ImageTransparency = 1 - C.GLOW_BRIGHTNESS,
			ScaleType = Enum.ScaleType.Stretch,
			ZIndex = 0,
		}, holder)
		task.spawn(function()
			local deadline = os.clock() + 5
			while glow.Parent and os.clock() < deadline do
				local ok, size = pcall(function() return glow.ContentImageSize end)
				if not ok then return end
				if size.X > 0 and size.Y > 0 then
					local sx, sy = size.X * C.GLOW_SLICE, size.Y * C.GLOW_SLICE
					glow.SliceCenter = Rect.new(sx, sy, size.X - sx, size.Y - sy)
					glow.SliceScale = math.max(C.GLOW_SPREAD, 1) / sx
					glow.ScaleType = Enum.ScaleType.Slice
					return
				end
				task.wait(0.05)
			end
		end)

		-- the body (gray, a little see-through)
		local root = U.make("Frame", {
			Name = "Body",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = T.base,
			BackgroundTransparency = T.baseAlpha,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			ZIndex = 1,
		}, holder)
		U.corner(root, 14)
		U.stroke(root, T.white, 0.9)
		window._root = root

		-- the lighter panel on the right: its top strip holds search + close, the rest is the page
		local panel = U.make("Frame", {
			Name = "Panel",
			Position = UDim2.new(0, SIDEBAR_W, 0, PAD),
			Size = UDim2.new(1, -(SIDEBAR_W + PAD), 1, -PAD * 2),
			BackgroundColor3 = T.panel,
			BackgroundTransparency = T.panelAlpha,
			BorderSizePixel = 0,
			ZIndex = 2,
		}, root)
		U.corner(panel, 12)
		U.make("Frame", {
			Name = "TopLine",
			Position = UDim2.fromOffset(0, HEADER_H - PAD - 1),
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundColor3 = T.line,
			BorderSizePixel = 0,
			ZIndex = 3,
		}, panel)
		window._content = U.make("Frame", {
			Name = "Content",
			Position = UDim2.fromOffset(0, HEADER_H - PAD),
			Size = UDim2.new(1, 0, 1, -(HEADER_H - PAD)),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			ZIndex = 3,
		}, panel)
		window._panel = panel

		window._sidebar = U.make("Frame", {
			Name = "Sidebar",
			Position = UDim2.fromOffset(0, HEADER_H),
			Size = UDim2.new(0, SIDEBAR_W, 1, -HEADER_H),
			BackgroundTransparency = 1,
			ZIndex = 2,
		}, root)

		-- drag bar: outside the body, just below it
		local dragHit = U.button(holder, {
			Name = "DragHit",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 1, C.BAR_DISTANCE),
			Size = UDim2.fromOffset(C.BAR_HIT.X, C.BAR_HIT.Y),
			ZIndex = 5,
		})
		local bar = U.make("Frame", {
			Name = "Bar",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(C.BAR_SIZE.X, C.BAR_SIZE.Y),
			BackgroundColor3 = T.white,
			BackgroundTransparency = C.BAR_IDLE,
			BorderSizePixel = 0,
			ZIndex = 5,
		}, dragHit)
		U.corner(bar, UDim.new(1, 0))

		-- resize corner: a hollow quarter circle drawn with round dots
		local handle = U.button(root, {
			Name = "ResizeHandle",
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, 0, 1, 0),
			Size = UDim2.fromOffset(34, 34),
			ZIndex = 8,
		})
		local boxSize = math.ceil(C.ICON_R + C.ICON_THICK)
		local iconGroup = U.make("CanvasGroup", {
			Name = "Icon",
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -C.ICON_INSET, 1, -C.ICON_INSET),
			Size = UDim2.fromOffset(boxSize, boxSize),
			BackgroundTransparency = 1,
			GroupTransparency = C.ICON_IDLE,
			ZIndex = 8,
		}, handle)
		do
			local half = C.ICON_THICK / 2
			local steps = math.max(8, math.ceil((math.pi / 2 * C.ICON_R) / (C.ICON_THICK / 3)))
			for step = 0, steps do
				local angle = (math.pi / 2) * (step / steps)
				local dot = U.make("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromOffset(half + C.ICON_R * math.cos(angle), half + C.ICON_R * math.sin(angle)),
					Size = UDim2.fromOffset(C.ICON_THICK, C.ICON_THICK),
					BackgroundColor3 = T.white,
					BorderSizePixel = 0,
					ZIndex = 8,
				}, iconGroup)
				U.corner(dot, UDim.new(1, 0))
			end
		end

		local function saveWindowPosition()
			local v = U.viewport()
			window._store.window = { x = posTarget.X / v.X, y = posTarget.Y / v.Y }
			window:_flush()
		end

		-- drag (the bar)
		dragHit.InputBegan:Connect(function(input)
			if not U.isPress(input) or dragging or resizing then return end
			local start, origin = U.p2(input), posTarget
			local started = D.begin(input, function(moved)
				posTarget = clampCenter(origin + (U.p2(moved) - start), sizeTarget)
			end, function()
				dragging = false
				U.tween(bar, 0.3, { BackgroundTransparency = C.BAR_IDLE, Size = UDim2.fromOffset(C.BAR_SIZE.X, C.BAR_SIZE.Y) })
				saveWindowPosition()
			end)
			if not started then return end
			dragging = true
			U.tween(bar, 0.2, {
				BackgroundTransparency = 0.15,
				Size = UDim2.fromOffset(C.BAR_SIZE_ACTIVE.X, C.BAR_SIZE_ACTIVE.Y),
			})
		end)
		dragHit.MouseEnter:Connect(function()
			if not dragging then U.tween(bar, 0.2, { BackgroundTransparency = 0.3 }) end
		end)
		dragHit.MouseLeave:Connect(function()
			if not dragging then U.tween(bar, 0.25, { BackgroundTransparency = C.BAR_IDLE }) end
		end)

		-- resize (the corner)
		handle.InputBegan:Connect(function(input)
			if not U.isPress(input) or dragging or resizing then return end
			local startSize2, start = sizeTarget, U.p2(input)
			local topLeft = posTarget - sizeTarget / 2
			local started = D.begin(input, function(moved)
				local v = U.viewport()
				local target = startSize2 + (U.p2(moved) - start)
				local maxX, maxY = C.MAX_SIZE.X, C.MAX_SIZE.Y
				if protect() then
					maxX = math.min(maxX, v.X - MARGIN - topLeft.X)
					maxY = math.min(maxY, v.Y - MARGIN - C.BAR_BELOW - topLeft.Y)
				end
				local newSize = Vector2.new(
					math.clamp(target.X, math.min(C.MIN_SIZE.X, maxX), math.max(C.MIN_SIZE.X, maxX)),
					math.clamp(target.Y, math.min(C.MIN_SIZE.Y, maxY), math.max(C.MIN_SIZE.Y, maxY))
				)
				sizeTarget = newSize
				posTarget = topLeft + newSize / 2
			end, function()
				resizing = false
				U.tween(iconGroup, 0.3, { GroupTransparency = C.ICON_IDLE })
			end)
			if not started then return end
			resizing = true
			U.tween(iconGroup, 0.2, { GroupTransparency = 0.05 })
		end)
		handle.MouseEnter:Connect(function()
			if not resizing then U.tween(iconGroup, 0.2, { GroupTransparency = 0.2 }) end
		end)
		handle.MouseLeave:Connect(function()
			if not resizing then U.tween(iconGroup, 0.25, { GroupTransparency = C.ICON_IDLE }) end
		end)

		-- smooth follow (same feel as the mobile buttons)
		conns[#conns + 1] = RunService.RenderStepped:Connect(function(dt)
			sizeTarget = fit(sizeTarget)
			posTarget = clampCenter(posTarget, sizeTarget)
			local speed = resizing and C.RESIZE_FOLLOW_SPEED or C.DRAG_FOLLOW_SPEED
			local alpha = 1 - math.exp(-dt * speed)
			sizeCur = fit(sizeCur:Lerp(sizeTarget, alpha))
			posCur = clampCenter(posCur:Lerp(posTarget, alpha), sizeCur)
			holder.Size = UDim2.fromOffset(math.floor(sizeCur.X + 0.5), math.floor(sizeCur.Y + 0.5))
			holder.Position = UDim2.fromOffset(math.floor(posCur.X + 0.5), math.floor(posCur.Y + 0.5))
		end)
	end

	----------------------------------------------------------------
	-- Header: logo, title, subtitle, search, close
	----------------------------------------------------------------
	function W.header(window, config)
		local root = window._root
		local HEADER_H = C.HEADER_H
		local SEARCH_W = 180

		local header = U.make("Frame", {
			Name = "Header",
			Size = UDim2.new(1, 0, 0, HEADER_H),
			BackgroundTransparency = 1,
			ZIndex = 5,
		}, root)
		window._header = header

		local titleX = 16
		if U.hasIcon(config.icon) then
			U.make("ImageLabel", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 14, 0.5, 0),
				Size = UDim2.fromOffset(32, 32),
				BackgroundTransparency = 1,
				Image = U.assetUrl(config.icon),
				ScaleType = Enum.ScaleType.Fit,
				ZIndex = 6,
			}, header)
			titleX = 14 + 32 + 10
		end
		local hasSubtitle = config.subtitle ~= nil and tostring(config.subtitle) ~= ""
		local textWidth = C.SIDEBAR_W - titleX - 6
		U.label(header, {
			Position = UDim2.fromOffset(titleX, hasSubtitle and 9 or 0),
			Size = UDim2.fromOffset(textWidth, hasSubtitle and 20 or HEADER_H),
			Text = window.Name,
			TextSize = 15,
			Font = Enum.Font.GothamBold,
			ZIndex = 6,
		})
		if hasSubtitle then
			U.label(header, {
				Position = UDim2.fromOffset(titleX, 28),
				Size = UDim2.fromOffset(textWidth, 14),
				Text = tostring(config.subtitle),
				TextSize = 11,
				TextColor3 = T.sub,
				ZIndex = 6,
			})
		end

		local function iconButton(name, icon)
			local button = U.button(header, {
				Name = name,
				AnchorPoint = Vector2.new(1, 0.5),
				Size = UDim2.fromOffset(30, 30),
				BackgroundColor3 = T.white,
				ZIndex = 6,
			})
			U.corner(button, 8)
			local image = U.make("ImageLabel", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(20, 20),
				BackgroundTransparency = 1,
				Image = U.assetUrl(icon),
				ImageColor3 = T.sub,
				ScaleType = Enum.ScaleType.Fit,
				ZIndex = 7,
			}, button)
			local scale = U.make("UIScale", { Scale = 1 }, button)
			button.MouseEnter:Connect(function()
				U.tween(button, 0.15, { BackgroundTransparency = 0.9 }, Enum.EasingStyle.Quad)
				U.tween(image, 0.15, { ImageColor3 = T.text }, Enum.EasingStyle.Quad)
			end)
			button.MouseLeave:Connect(function()
				U.tween(button, 0.2, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
				U.tween(image, 0.2, { ImageColor3 = T.sub }, Enum.EasingStyle.Quad)
			end)
			button.InputBegan:Connect(function(input)
				if U.isPress(input) then U.tween(scale, 0.08, { Scale = 0.88 }, Enum.EasingStyle.Quad) end
			end)
			button.InputEnded:Connect(function(input)
				if U.isPress(input) then U.tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back) end
			end)
			return button, scale
		end

		local closeButton, closeScale = iconButton("Close", ICON_CLOSE)
		local searchButton = iconButton("Search", ICON_SEARCH)
		closeButton.Position = UDim2.new(1, -12, 0.5, 0)

		local searchOpen = false
		local searchBox = U.make("Frame", {
			Name = "SearchBox",
			AnchorPoint = Vector2.new(1, 0.5),
			Size = UDim2.fromOffset(0, 28),
			BackgroundColor3 = T.chip,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			ZIndex = 6,
		}, header)
		U.corner(searchBox, 8)
		local input = U.make("TextBox", {
			Position = UDim2.fromOffset(10, 0),
			Size = UDim2.new(1, -20, 1, 0),
			BackgroundTransparency = 1,
			ClearTextOnFocus = false,
			Text = "",
			PlaceholderText = "Search",
			PlaceholderColor3 = T.sub,
			TextColor3 = T.text,
			TextSize = 12,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 7,
		}, searchBox)

		-- where the buttons sit: the close button is only there on mobile, search takes its place on PC
		local function searchRight() return window._mobile and (12 + 30 + 4) or 12 end

		function window:_layoutHeader(animate)
			local mobile = self._mobile
			local searchX = searchRight()
			local boxProps = {
				Position = UDim2.new(1, -(searchX + 30 + 6), 0.5, 0),
				Size = UDim2.fromOffset(searchOpen and SEARCH_W or 0, 28),
			}
			local buttonProps = { Position = UDim2.new(1, -searchX, 0.5, 0) }
			if animate then
				U.tween(searchButton, 0.3, buttonProps, Enum.EasingStyle.Quint)
				U.tween(searchBox, 0.3, boxProps, Enum.EasingStyle.Quint)
			else
				for key, value in pairs(buttonProps) do searchButton[key] = value end
				for key, value in pairs(boxProps) do searchBox[key] = value end
			end
			if mobile then
				closeButton.Visible = true
				if animate then
					closeScale.Scale = 0.4
					U.tween(closeScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
				else
					closeScale.Scale = 1
				end
			elseif animate then
				U.tween(closeScale, 0.2, { Scale = 0 }, Enum.EasingStyle.Quad)
				task.delay(0.21, function()
					if not window._mobile then closeButton.Visible = false end
				end)
			else
				closeButton.Visible = false
			end
		end

		function window:_closeSearch()
			if not searchOpen then return end
			searchOpen = false
			self._searching = false
			input.Text = ""
			input:ReleaseFocus()
			U.tween(searchBox, 0.25, { Size = UDim2.fromOffset(0, 28) }, Enum.EasingStyle.Quint)
			if self._searchPage then self._searchPage.Visible = false end
			if self._selected then self._selected._page.Visible = true end
		end

		searchButton.Activated:Connect(function()
			if searchOpen then
				window:_closeSearch()
				return
			end
			searchOpen = true
			U.tween(searchBox, 0.3, { Size = UDim2.fromOffset(SEARCH_W, 28) }, Enum.EasingStyle.Quint)
			task.delay(0.1, function() input:CaptureFocus() end)
		end)
		input:GetPropertyChangedSignal("Text"):Connect(function()
			if searchOpen then window:_runSearch(input.Text) end
		end)

		-- the close button (mobile): collapses the window into the pill
		closeButton.Activated:Connect(function()
			window:_setOpen(false)
		end)
	end

	----------------------------------------------------------------
	-- Search: finds components on every tab; tapping one takes you there
	----------------------------------------------------------------
	function W.search(window)
		local page = U.make("ScrollingFrame", {
			Name = "SearchResults",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = T.line,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			Visible = false,
		}, window._content)
		U.make("UIPadding", {
			PaddingLeft = UDim.new(0, C.PAGE_PAD), PaddingRight = UDim.new(0, C.PAGE_PAD),
			PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 28),
		}, page)
		window._searchPage = page

		local card = U.make("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = T.card,
			BorderSizePixel = 0,
		}, page)
		U.corner(card, 10)
		U.stroke(card, T.white, 0.93)
		U.make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, card)

		function window:_runSearch(text)
			text = (text or ""):lower():match("^%s*(.-)%s*$")
			for _, child in ipairs(card:GetChildren()) do
				if child:IsA("GuiObject") then child:Destroy() end
			end
			if text == "" then
				self._searching = false
				page.Visible = false
				if self._selected then self._selected._page.Visible = true end
				return
			end
			self._searching = true
			if self._selected then self._selected._page.Visible = false end
			page.Visible = true

			local count = 0
			for _, entry in ipairs(self._search) do
				if entry.el.name:lower():find(text, 1, true) then
					count += 1
					local result = U.button(card, { LayoutOrder = count, Size = UDim2.new(1, 0, 0, 40), ZIndex = 1 })
					U.label(result, {
						Position = UDim2.fromOffset(12, 0),
						Size = UDim2.new(0.55, -12, 1, 0),
						Text = entry.el.name,
					})
					local where = entry.tab._title
					if entry.section ~= "" then where = where .. "  >  " .. entry.section end
					U.label(result, {
						AnchorPoint = Vector2.new(1, 0),
						Position = UDim2.new(1, -12, 0, 0),
						Size = UDim2.new(0.45, -12, 1, 0),
						Text = where,
						TextSize = 11,
						TextColor3 = T.sub,
						TextXAlignment = Enum.TextXAlignment.Right,
					})
					U.make("Frame", {
						AnchorPoint = Vector2.new(0, 1),
						Position = UDim2.new(0, 10, 1, 0),
						Size = UDim2.new(1, -20, 0, 1),
						BackgroundColor3 = T.line,
						BorderSizePixel = 0,
					}, result)
					result.MouseEnter:Connect(function()
						U.tween(result, 0.15, { BackgroundTransparency = 0.94, BackgroundColor3 = T.white }, Enum.EasingStyle.Quad)
					end)
					result.MouseLeave:Connect(function()
						U.tween(result, 0.2, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
					end)
					result.Activated:Connect(function()
						self:_goTo(entry)
					end)
				end
			end
			if count == 0 then
				U.label(card, {
					Size = UDim2.new(1, 0, 0, 44),
					Text = "No results",
					TextColor3 = T.sub,
					TextXAlignment = Enum.TextXAlignment.Center,
				})
			end
		end

		-- opens the tab, scrolls to the component and flashes it
		function window:_goTo(entry)
			self:_closeSearch()
			self:_select(entry.tab)
			task.delay(0.3, function()
				local tabPage, frame = entry.tab._page, entry.el._frame
				if not (tabPage.Parent and frame.Parent) then return end
				local target = frame.AbsolutePosition.Y - tabPage.AbsolutePosition.Y + tabPage.CanvasPosition.Y - 24
				tabPage.CanvasPosition = Vector2.new(0, math.max(0, target))
				local flash = U.make("Frame", {
					Size = UDim2.fromScale(1, 1),
					BackgroundColor3 = T.green,
					BackgroundTransparency = 0.7,
					BorderSizePixel = 0,
					ZIndex = 9,
				}, frame)
				U.corner(flash, 8)
				U.tween(flash, 0.9, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
				task.delay(0.95, function() flash:Destroy() end)
			end)
		end
	end

