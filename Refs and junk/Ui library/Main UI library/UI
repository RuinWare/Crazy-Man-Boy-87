			local lastInset = -1
			local morphUntil = 0

			-- Each shape remembers its own size, so switching back and forth feels natural
			local circleStart = math.clamp((startSize.X + startSize.Y) / 2, circleMin, circleMax)
			local modeSizes = {
				default = startSize,
				pill = Vector2.new(math.clamp(startSize.X, pillMinWidth, MAX_SIZE.X), PILL_HEIGHT),
				circle = Vector2.new(circleStart, circleStart),
			}

			connections[#connections + 1] = RunService.RenderStepped:Connect(function(dt)
				-- off-screen protection every frame (and the shape rules)
				sizeTarget = fitSize(sizeTarget)
				if mode == "circle" then
					local side = math.min(sizeTarget.X, sizeTarget.Y)
					sizeTarget = Vector2.new(side, side)
				elseif mode == "pill" then
					sizeTarget = Vector2.new(sizeTarget.X, math.min(sizeTarget.Y, PILL_HEIGHT))
				end
				posTarget = clampCenter(posTarget, sizeTarget)

				-- slower follow while dragging = the box trails behind the bar, shape changes ease in gently
				local speed = DRAG_FOLLOW_SPEED
				if resizing then
					speed = RESIZE_FOLLOW_SPEED
				elseif os.clock() < morphUntil then
					speed = MORPH_FOLLOW_SPEED
				end
				local alpha = 1 - math.exp(-dt * speed)
				sizeCur = fitSize(sizeCur:Lerp(sizeTarget, alpha))
				posCur = clampCenter(posCur:Lerp(posTarget, alpha), sizeCur)

				holder.Size = UDim2.fromOffset(math.floor(sizeCur.X + 0.5), math.floor(sizeCur.Y + 0.5))
				holder.Position = UDim2.fromOffset(math.floor(posCur.X + 0.5), math.floor(posCur.Y + 0.5))

				-- the corners ease toward the roundness of the current shape
				cornerCur += (cornerFor(sizeCur, mode) - cornerCur) * (1 - math.exp(-dt * CORNER_SPEED))
				local corner = math.floor(cornerCur + 0.5)
				if corner ~= lastCorner then
					lastCorner = corner
					boxCorner.CornerRadius = UDim.new(0, corner)
				end

				-- the corner icons follow the rounded edge, so they always stay inside the shape
				local inset = math.max(ICON_INSET, 0.293 * cornerCur + 1)
				if math.abs(inset - lastInset) > 0.05 then
					lastInset = inset
					local extra = inset - ICON_INSET
					handle.Position = UDim2.new(1, -extra, 1, -extra)
					local c = inset + 9
					collapseHit.Position = UDim2.new(0, c, 0, c)
				end
			end)

			-- Save where this button is (by its FLAG)
			local function savePosition()
				if not SAVE_POSITION then return end
				local v = viewport()
				local all = loadAllPositions()
				all[FLAG] = { x = posTarget.X / v.X, y = posTarget.Y / v.Y }
				saveAllPositions(all)
			end

			-- ResetMBPositions sends every button back to its starting point
			screenGui:GetAttributeChangedSignal("ResetPosition"):Connect(function()
				posTarget = clampCenter(defaultCenter, sizeTarget)
			end)

			-- Drag: only while holding the bar
			dragHit.InputBegan:Connect(function(input)
				if not isPress(input) or dragging or resizing then return end
				dragging = true
				activeInput = input
				inputStart = p2(input)
				dragOrigin = posTarget
				tween(bar, 0.2, { BackgroundTransparency = 0.15, Size = BAR_SIZE_ACTIVE })
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
						tween(bar, 0.3, { BackgroundTransparency = BAR_IDLE, Size = BAR_SIZE })
						savePosition()
					end
				end)
			end)
			dragHit.MouseEnter:Connect(function()
				if not dragging then tween(bar, 0.2, { BackgroundTransparency = 0.3 }) end
			end)
			dragHit.MouseLeave:Connect(function()
				if not dragging then tween(bar, 0.25, { BackgroundTransparency = BAR_IDLE }) end
			end)

			-- Resize (default and circle shapes): only while holding the corner handle
			handle.InputBegan:Connect(function(input)
				if not isPress(input) or dragging or resizing or mode == "pill" then return end
				resizing = true
				activeInput = input
				inputStart = p2(input)
				resizeOriginSize = sizeTarget
				resizeTopLeft = posTarget - sizeTarget / 2
				tween(iconGroup, 0.2, { GroupTransparency = 0.05 })
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						resizing = false
						if mode ~= "pill" then tween(iconGroup, 0.3, { GroupTransparency = ICON_IDLE }) end
					end
				end)
			end)
			handle.MouseEnter:Connect(function()
				if not resizing and mode ~= "pill" then tween(iconGroup, 0.2, { GroupTransparency = 0.2 }) end
			end)
			handle.MouseLeave:Connect(function()
				if not resizing and mode ~= "pill" then tween(iconGroup, 0.25, { GroupTransparency = ICON_IDLE }) end
			end)

			-- Resize (pill shape): only the length, by holding the vertical bar
			pillHandle.InputBegan:Connect(function(input)
				if not isPress(input) or dragging or resizing or mode ~= "pill" then return end
				resizing = true
				activeInput = input
				inputStart = p2(input)
				resizeOriginSize = sizeTarget
				resizeTopLeft = posTarget - sizeTarget / 2
				tween(pillBar, 0.2, { BackgroundTransparency = 0.15, Size = PILL_BAR_SIZE_ACTIVE })
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						resizing = false
						if mode == "pill" then tween(pillBar, 0.3, { BackgroundTransparency = BAR_IDLE, Size = PILL_BAR_SIZE }) end
					end
				end)
			end)
			pillHandle.MouseEnter:Connect(function()
				if not resizing and mode == "pill" then tween(pillBar, 0.2, { BackgroundTransparency = 0.3 }) end
			end)
			pillHandle.MouseLeave:Connect(function()
				if not resizing and mode == "pill" then tween(pillBar, 0.25, { BackgroundTransparency = BAR_IDLE }) end
			end)

			connections[#connections + 1] = UserInputService.InputChanged:Connect(function(input)
				if not (dragging or resizing) then return end
				if input.UserInputType ~= Enum.UserInputType.MouseMovement and input ~= activeInput then return end

				local delta = p2(input) - inputStart
				if dragging then
					posTarget = clampCenter(dragOrigin + delta, sizeTarget)
				else
					local v = viewport()
					local newSize
					if mode == "pill" then
						-- only the length changes, the height stays locked
						newSize = Vector2.new(math.clamp(resizeOriginSize.X + delta.X, pillMinWidth, MAX_SIZE.X), PILL_HEIGHT)
					elseif mode == "circle" then
						-- x and y always stay the same size
						local side = math.clamp(resizeOriginSize.X + (delta.X + delta.Y) / 2, circleMin, circleMax)
						newSize = Vector2.new(side, side)
					else
						newSize = Vector2.new(
							math.clamp(resizeOriginSize.X + delta.X, MIN_SIZE.X, MAX_SIZE.X),
							math.clamp(resizeOriginSize.Y + delta.Y, MIN_SIZE.Y, MAX_SIZE.Y)
						)
					end
					-- never grow past the edge of the screen
					newSize = Vector2.new(
						math.min(newSize.X, v.X - SCREEN_MARGIN - resizeTopLeft.X),
						math.min(newSize.Y, v.Y - SCREEN_MARGIN - BAR_BELOW - resizeTopLeft.Y)
					)
					if mode == "circle" then
						local side = math.min(newSize.X, newSize.Y)
						newSize = Vector2.new(side, side)
					end
					sizeTarget = newSize
					posTarget = resizeTopLeft + newSize / 2 -- top-left corner stays put
				end
			end)

			-- Shape name: sits on top of the title and shows for a moment when the shape changes
			local modeLabel = make("TextLabel", {
				Name = "ModeLabel",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = label.Position,
				Size = label.Size,
				BackgroundTransparency = 1,
				Text = "",
				TextColor3 = WHITE,
				TextTransparency = 1,
				TextSize = TEXT_SIZE,
				TextScaled = false,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Center,
				FontFace = FONT,
				ZIndex = 2,
			}, box)

			local flashToken = 0
			local function flashModeName(name)
				flashToken += 1
				local token = flashToken
				modeLabel.Text = name

				-- quick crossfade: the title fades out while the shape name fades in
				tween(label, 0.2, { TextTransparency = 1 }, Enum.EasingStyle.Quad)
				tween(modeLabel, 0.2, { TextTransparency = TEXT_TRANSPARENCY }, Enum.EasingStyle.Quad)

				-- after a moment it fades out into the normal title
				task.delay(0.2 + MODE_TEXT_TIME, function()
					if token ~= flashToken or not screenGui.Parent then return end
					tween(modeLabel, 0.4, { TextTransparency = 1 }, Enum.EasingStyle.Sine)
					tween(label, 0.4, { TextTransparency = TEXT_TRANSPARENCY }, Enum.EasingStyle.Sine)
				end)
			end

			-- Shapes: the cycle button goes default > pill > circle > default
			local MODES = { "default", "pill", "circle" }

			local function setMode(newMode)
				if newMode == mode or dragging or resizing then return end
				modeSizes[mode] = sizeTarget -- remember the shape we're leaving
				mode = newMode
				sizeTarget = fitSize(modeSizes[newMode])
				morphUntil = os.clock() + 0.8

				-- the old resize icon fades out, the new one fades in
				local isPill = newMode == "pill"
				handle.Interactable = not isPill
				pillHandle.Interactable = isPill
				tween(iconGroup, 0.35, { GroupTransparency = isPill and 1 or ICON_IDLE }, Enum.EasingStyle.Quad)
				tween(pillBar, 0.4, { BackgroundTransparency = isPill and BAR_IDLE or 1 }, Enum.EasingStyle.Quad)

				-- the text glides to the right height for the new shape
				local nudge = TEXT_NUDGE_Y
				if isPill then nudge = PILL_TEXT_NUDGE_Y elseif newMode == "circle" then nudge = CIRCLE_TEXT_NUDGE_Y end
				local textPosition = UDim2.new(0.5, 0, 0.5, nudge)
				tween(label, 0.45, { Position = textPosition })
				tween(modeLabel, 0.45, { Position = textPosition })

				flashModeName(MODE_NAMES[newMode] or newMode)
			end

			local spin = 0
			collapseHit.Activated:Connect(function()
				local before = mode
				setMode(MODES[(table.find(MODES, mode) or 1) % #MODES + 1])
				if mode == before then return end -- it didn't switch (busy dragging or resizing)

				-- spin once, smoothly, every time the shape switches
				spin += 360
				tween(cycleIcon, 0.7, { Rotation = spin }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
			end)
			collapseHit.MouseEnter:Connect(function()
				tween(cycleIcon, 0.2, { GroupTransparency = 0.2 })
			end)
			collapseHit.MouseLeave:Connect(function()
				tween(cycleIcon, 0.25, { GroupTransparency = CYCLE_IDLE })
			end)

			----------------------------------------------------------------
			-- Click: a toggle keeps a steady on/off state, a button flashes
			----------------------------------------------------------------
			local isOn = opts.initial == true and kind == "Toggle"
			local stateToken = 0
			local glowToken = 0

			local function setState(on)
				isOn = on
				stateToken += 1
				local token = stateToken

				tween(box, 0.25, { BackgroundColor3 = on and BG_ON or BG_COLOR })
				tween(stroke, 0.25, { Transparency = on and 0.3 or STROKE_IDLE, Thickness = on and 2 or 1 })

				if on then
					-- bright flash, then settle into a steady glow
					setGlow(1, 0.08, Enum.EasingStyle.Quad)
					task.delay(0.1, function()
						if token ~= stateToken or not screenGui.Parent then return end
						setGlow(0.55, 0.3, Enum.EasingStyle.Sine)
					end)
				else
					setGlow(0, 0.25, Enum.EasingStyle.Sine)
				end
			end

			local function pulse()
				glowToken += 1
				local token = glowToken
				setGlow(1, 0.08, Enum.EasingStyle.Quad)
				tween(stroke, 0.08, { Transparency = 0.1, Thickness = 2 }, Enum.EasingStyle.Quad)

				task.delay(0.12, function()
					if token ~= glowToken or not screenGui.Parent then return end
					setGlow(0, 0.35, Enum.EasingStyle.Sine)
					tween(stroke, 0.35, { Transparency = STROKE_IDLE, Thickness = 1 }, Enum.EasingStyle.Sine)
				end)
			end

			body.InputBegan:Connect(function(input)
				if isPress(input) then tween(popScale, 0.12, { Scale = 0.96 }) end
			end)
			body.InputEnded:Connect(function(input)
				if isPress(input) then tween(popScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back) end
			end)
			body.MouseEnter:Connect(function()
				tween(box, 0.25, { BackgroundColor3 = isOn and BG_ON:Lerp(WHITE, 0.06) or BG_HOVER })
			end)
			body.MouseLeave:Connect(function()
				tween(box, 0.3, { BackgroundColor3 = isOn and BG_ON or BG_COLOR })
				tween(popScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
			end)

			body.Activated:Connect(function()
				if kind == "Toggle" then
					local nextState = not isOn
					setState(nextState)
					if opts.onToggle then run(function() opts.onToggle(nextState) end) end
				else
					pulse()
					if opts.onClick then run(opts.onClick) end
				end
			end)

			-- what the library uses to drive this button
			local api = {}
			function api.SetState(on)
				if kind ~= "Toggle" or on == isOn then return end
				setState(on)
			end
			function api.Pulse()
				if kind == "Button" then pulse() end
			end
			function api.Destroy()
				if screenGui.Parent then screenGui:Destroy() end
			end
			api.Gui = screenGui

			----------------------------------------------------------------
			-- Cleanup + pop-in
			----------------------------------------------------------------
			screenGui.Destroying:Connect(function()
				for _, c in ipairs(connections) do c:Disconnect() end
				table.clear(connections)
				if opts.onGone then run(opts.onGone) end
			end)


			local fades = {
				{ box, "BackgroundTransparency", BG_TRANSPARENCY },
				{ stroke, "Transparency", STROKE_IDLE },
				{ label, "TextTransparency", TEXT_TRANSPARENCY },
				{ bar, "BackgroundTransparency", BAR_IDLE },
				{ iconGroup, "GroupTransparency", ICON_IDLE },
				{ cycleIcon, "GroupTransparency", CYCLE_IDLE },
			}
			tween(popScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
			for _, f in ipairs(fades) do
				tween(f[1], 0.4, { [f[2]] = f[3] }, Enum.EasingStyle.Quad)
			end


			-- a toggle that was already on when its button was made shows that after the pop-in
			if isOn then
				task.delay(0.45, function()
					if screenGui.Parent then setState(true) end
				end)
			end

			return api

		end

		return create
	end)()

	----------------------------------------------------------------
	-- Components
	----------------------------------------------------------------
	do
		local ROW_H = C.ROW_H

		-- the frame every component lives in (the thin line under it is shown by the layout when another component follows)
		local function makeItem(row, height)
			local frame = U.make("Frame", {
				Name = "Item",
				Size = UDim2.new(1, 0, 0, height or ROW_H),
				BackgroundTransparency = 1,
			}, row._frame)
			local sep = U.make("Frame", {
				Name = "Sep",
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.new(0, 10, 1, 0),
				Size = UDim2.new(1, -20, 0, 1),
				BackgroundColor3 = T.line,
				BorderSizePixel = 0,
				Visible = false,
				ZIndex = 2,
			}, frame)
			return frame, sep
		end

		local function makeHit(frame, height)
			return U.button(frame, { Name = "Hit", Size = UDim2.new(1, 0, 0, height or ROW_H), ZIndex = 1 })
		end

		local function makeSwitch(parent, position, anchor)
			local track = U.make("Frame", {
				AnchorPoint = anchor,
				Position = position,
				Size = UDim2.fromOffset(40, 22),
				BackgroundColor3 = T.off,
				BorderSizePixel = 0,
				ZIndex = 2,
			}, parent)
			U.corner(track, 11)
			local knob = U.make("Frame", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 3, 0.5, 0),
				Size = UDim2.fromOffset(16, 16),
				BackgroundColor3 = T.knobOff,
				BorderSizePixel = 0,
				ZIndex = 3,
			}, track)
			U.corner(knob, 8)
			local function set(on, instant)
				local trackProps = { BackgroundColor3 = on and T.green or T.off }
				local knobProps = {
					Position = on and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
					BackgroundColor3 = on and T.white or T.knobOff,
				}
				if instant then
					for key, value in pairs(trackProps) do track[key] = value end
					for key, value in pairs(knobProps) do knob[key] = value end
				else
					U.tween(track, 0.22, trackProps, Enum.EasingStyle.Quad)
					U.tween(knob, 0.3, knobProps, Enum.EasingStyle.Back)
				end
			end
			return { track = track, knob = knob, set = set }
		end

		-- a small rounded box with a text box inside
		local function makeChipBox(parent, props)
			local chip = U.make("Frame", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = props.position,
				Size = props.size,
				BackgroundColor3 = T.chip,
				BorderSizePixel = 0,
				ZIndex = 3,
			}, parent)
			U.corner(chip, 6)
			local ring = U.stroke(chip, T.green, 1)
			local box = U.make("TextBox", {
				Position = UDim2.fromOffset(8, 0),
				Size = UDim2.new(1, -16, 1, 0),
				BackgroundTransparency = 1,
				ClearTextOnFocus = false,
				Text = props.text or "",
				PlaceholderText = props.placeholder or "",
				PlaceholderColor3 = T.sub,
				TextColor3 = T.text,
				TextSize = 12,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = props.align or Enum.TextXAlignment.Left,
				ClipsDescendants = true,
				ZIndex = 4,
			}, chip)
			box.Focused:Connect(function()
				U.tween(ring, 0.15, { Transparency = 0.2 }, Enum.EasingStyle.Quad)
			end)
			box.FocusLost:Connect(function()
				U.tween(ring, 0.2, { Transparency = 1 }, Enum.EasingStyle.Quad)
			end)
			return chip, box
		end

		----------------------------------------------------------------
		-- The 3 dots on toggles and buttons: Keybind + Mobile Button
		----------------------------------------------------------------
		local function closeMenu(window)
			if window._menu then window._menu.close() end
		end

		local function setKey(el, keyCode)
			el._key = keyCode
			if keyCode then K.add(el) else K.remove(el) end
			el._window:_changed()
		end

		local function destroyMB(el)
			local handle = el._mb
			el._mb = nil
			el._mbOn = false
			if handle then handle.Destroy() end
		end

		local function spawnMB(el)
			if el._mb then return end
			local window = el._window
			el._mbOn = true

			local count = 0
			for _, other in ipairs(window._allList) do
				if other._mb then count += 1 end
			end

			local handle
			local ok, result = pcall(createMobileButton, {
				text = el.name,
				flag = el.flag,
				kind = el.kind == "toggle" and "Toggle" or "Button",
				initial = el.kind == "toggle" and el.value == true,
				offset = (count % 5) * 28,
				onToggle = function(on) el:_set(on) end,
				onClick = function() el:_run() end,
				onGone = function()
					-- it was deleted from outside (DestroyAllGuis, DeleteGuiByFlag): the switch goes off too
					if el._mb ~= handle then return end
					el._mb = nil
					el._mbOn = false
					if el._menuSwitch then el._menuSwitch.set(false) end
					window:_changed()
				end,
			})
			if not ok then
				warn("[Library] mobile button: " .. tostring(result))
				el._mbOn = false
				return
			end
			handle = result
			el._mb = handle
		end

		local function openMenu(window, el, anchor)
			closeMenu(window)

			local rows = {}
			if el.haveKeybinds then rows[#rows + 1] = "keybind" end
			if el.haveMB then rows[#rows + 1] = "mb" end
			if #rows == 0 then return end

			local root = window._root
			local MENU_W, ROW = 212, 36
			local menuH = #rows * ROW + (#rows - 1) * 4 + 12

			local catcher = U.button(root, { Name = "MenuCatcher", Size = UDim2.fromScale(1, 1), ZIndex = 60 })

			local rootSize = root.AbsoluteSize
			local relative = anchor.AbsolutePosition - root.AbsolutePosition
			local x = math.clamp(relative.X + anchor.AbsoluteSize.X - MENU_W, 8, math.max(8, rootSize.X - MENU_W - 8))
			local y = math.clamp(relative.Y + anchor.AbsoluteSize.Y + 4, 8, math.max(8, rootSize.Y - menuH - 8))

			local menu = U.make("Frame", {
				Name = "Menu",
				Position = UDim2.fromOffset(x, y),
				Size = UDim2.fromOffset(MENU_W, menuH),
				BackgroundColor3 = T.card,
				BorderSizePixel = 0,
				ZIndex = 61,
			}, root)
			U.corner(menu, 10)
			U.stroke(menu, T.white, 0.85)
			local menuScale = U.make("UIScale", { Scale = 0.85 }, menu)
			U.tween(menuScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)

			local closed = false
			local function close()
				if closed then return end
				closed = true
				window._menu = nil
				el._menuSwitch = nil
				if K.capturing then
					if K.cancel then K.cancel() end
					K.capturing = nil
					K.cancel = nil
				end
				catcher:Destroy()
				U.tween(menuScale, 0.15, { Scale = 0.85 }, Enum.EasingStyle.Quad)
				U.tween(menu, 0.15, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
				task.delay(0.16, function() menu:Destroy() end)
			end
			window._menu = { close = close }
			catcher.Activated:Connect(close)

			for index, kind in ipairs(rows) do
				local line = U.make("Frame", {
					Position = UDim2.fromOffset(6, 6 + (index - 1) * (ROW + 4)),
					Size = UDim2.new(1, -12, 0, ROW),
					BackgroundColor3 = T.chip,
					BorderSizePixel = 0,
					ZIndex = 62,
				}, menu)
				U.corner(line, 8)

				if kind == "keybind" then
					U.label(line, {
						Position = UDim2.fromOffset(10, 0),
						Size = UDim2.new(1, -100, 1, 0),
						Text = "Keybind",
						ZIndex = 63,
					})
					local keyButton = U.button(line, {
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, -6, 0.5, 0),
						Size = UDim2.fromOffset(84, 24),
						BackgroundTransparency = 0,
						BackgroundColor3 = T.off,
						Text = K.label(el._key),
						TextColor3 = T.text,
						TextSize = 12,
						Font = Enum.Font.GothamMedium,
						ZIndex = 63,
					})
					U.corner(keyButton, 6)
					keyButton.Activated:Connect(function()
						-- the next key you press becomes the keybind (Escape cancels, Backspace clears it)
						keyButton.Text = "..."
						U.tween(keyButton, 0.15, { BackgroundColor3 = T.green }, Enum.EasingStyle.Quad)
						K.capture(function(keyCode)
							if keyCode == Enum.KeyCode.Backspace then
								setKey(el, nil)
							elseif keyCode ~= Enum.KeyCode.Escape then
								setKey(el, keyCode)
							end
							if keyButton.Parent then
								keyButton.Text = K.label(el._key)
								U.tween(keyButton, 0.2, { BackgroundColor3 = T.off }, Enum.EasingStyle.Quad)
							end
						end, function()
							if keyButton.Parent then
								keyButton.Text = K.label(el._key)
								U.tween(keyButton, 0.2, { BackgroundColor3 = T.off }, Enum.EasingStyle.Quad)
							end
						end)
					end)
				else
					U.label(line, {
						Position = UDim2.fromOffset(10, 0),
						Size = UDim2.new(1, -70, 1, 0),
						Text = "Mobile Button",
						ZIndex = 63,
					})
					local switch = makeSwitch(line, UDim2.new(1, -8, 0.5, 0), Vector2.new(1, 0.5))
					switch.track.ZIndex = 63
					switch.knob.ZIndex = 64
					switch.set(el._mbOn == true, true)
					el._menuSwitch = switch
					local hit = U.button(line, { Size = UDim2.fromScale(1, 1), ZIndex = 65 })
					hit.Activated:Connect(function()
						el:_setMB(not el._mbOn)
						switch.set(el._mbOn == true)
						window:_changed()
					end)
				end
			end
		end

		-- the 3 dots (only when the component has a keybind or a mobile button), and the methods the window
		-- uses to apply saved extras
		local function attachOptions(el, frame, rightOffset)
			function el:_setKey(keyCode) setKey(self, keyCode) end
			function el:_setMB(state)
				if state then spawnMB(self) else destroyMB(self) end
			end
			if not (el.haveKeybinds or el.haveMB) then return end
			el._hasOptions = true
			local window = el._window

			local dots = U.button(frame, {
				Name = "Options",
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -rightOffset, 0.5, 0),
				Size = UDim2.fromOffset(26, 26),
				BackgroundColor3 = T.white,
				ZIndex = 3,
			})
			U.corner(dots, 13)
			local icon = U.make("ImageLabel", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(18, 18),
				BackgroundTransparency = 1,
				Image = U.assetUrl(ICON_DOTS),
				ImageColor3 = T.sub,
				ScaleType = Enum.ScaleType.Fit,
				ZIndex = 4,
			}, dots)
			dots.MouseEnter:Connect(function()
				U.tween(dots, 0.15, { BackgroundTransparency = 0.88 }, Enum.EasingStyle.Quad)
				U.tween(icon, 0.15, { ImageColor3 = T.text }, Enum.EasingStyle.Quad)
			end)
			dots.MouseLeave:Connect(function()
				U.tween(dots, 0.2, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
				U.tween(icon, 0.2, { ImageColor3 = T.sub }, Enum.EasingStyle.Quad)
			end)
			dots.Activated:Connect(function()
				openMenu(window, el, dots)
			end)
