            return Players:GetUserThumbnailAsync(Players.LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
        end)
        
        Create("ImageLabel", { Parent = Profile, Size = UDim2.new(0, 36, 0, 36), Position = UDim2.new(0, 0, 0.5, -18), BackgroundColor3 = self.Theme.Element, Image = success and thumbnail or "rbxthumb://type=Avatar&id=" .. Players.LocalPlayer.UserId .. "&w=150&h=150" }, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }), Create("UIStroke", { Color = self.Theme.Stroke }) })
        Create("TextLabel", { Parent = Profile, Text = Players.LocalPlayer.DisplayName, Size = UDim2.new(1, -50, 0, 20), Position = UDim2.new(0, 45, 0, 10), BackgroundTransparency = 1, TextColor3 = self.Theme.Accent, Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left })
        Create("TextLabel", { Parent = Profile, Text = "Overhaul | Release", Size = UDim2.new(1, -50, 0, 20), Position = UDim2.new(0, 45, 0, 28), BackgroundTransparency = 1, TextColor3 = self.Theme.TextDim, Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left })

        -- ============================================================
        -- TAB CREATION
        -- ============================================================
        function Window:CreateTab(name, icon)
            local TabBtn = Create("TextButton", { Parent = Sidebar, Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = self.Theme.Background, Text = "", TextXAlignment = Enum.TextXAlignment.Left }, { Create("UICorner", { CornerRadius = UDim.new(0, 6) }) })
            
            -- Icon placeholder (circle)
            Create("Frame", { Parent = TabBtn, Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(0, 10, 0.5, -10), BackgroundColor3 = self.Theme.TextDim }, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
            Create("TextLabel", { Parent = TabBtn, Text = name, Size = UDim2.new(1, -45, 1, 0), Position = UDim2.new(0, 40, 0, 0), BackgroundTransparency = 1, TextColor3 = self.Theme.TextDim, Font = Enum.Font.Gotham, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left })
            
            local TabFrame = Create("Frame", { Parent = Content, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Visible = false })
            
            -- Columns (Left & Right)
            local LeftCol = Create("ScrollingFrame", { Parent = TabFrame, Size = UDim2.new(0.48, 0, 1, 0), BackgroundTransparency = 1, ScrollBarThickness = 0, CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarImageColor3 = self.Theme.Stroke }, { Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }) })
            local RightCol = Create("ScrollingFrame", { Parent = TabFrame, Size = UDim2.new(0.48, 0, 1, 0), Position = UDim2.new(0.52, 0, 0, 0), BackgroundTransparency = 1, ScrollBarThickness = 0, CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarImageColor3 = self.Theme.Stroke }, { Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }) })

            local Tab = {}
            
            TabBtn.MouseButton1Click:Connect(function()
                for _, v in pairs(Window.Tabs) do
                    TweenService:Create(v.TabBtn, TweenInfo, { BackgroundColor3 = self.Theme.Background }):Play()
                    v.TabFrame.Visible = false
                end
                TweenService:Create(TabBtn, TweenInfo, { BackgroundColor3 = self.Theme.Element }):Play()
                TabFrame.Visible = true
            end)

            table.insert(Window.Tabs, { TabBtn = TabBtn, TabFrame = TabFrame })
            if #Window.Tabs == 1 then
                TweenService:Create(TabBtn, TweenInfo, { BackgroundColor3 = self.Theme.Element }):Play()
                TabFrame.Visible = true
            end

            function Tab:CreateLeft() return LeftCol end
            function Tab:CreateRight() return RightCol end
            return Tab
        end

        -- ============================================================
        -- REOPEN PILL
        -- ============================================================
        local Pill = Create("TextButton", { Parent = ScreenGui, Size = UDim2.new(0, 160, 0, 36), Position = UDim2.new(0.5, -80, 0, 15), BackgroundColor3 = self.Theme.Background, Text = "Evaware Alpha", TextColor3 = self.Theme.Accent, Font = Enum.Font.GothamBold, TextSize = 14, Visible = false }, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }), Create("UIStroke", { Color = self.Theme.Stroke }) })
        
        CloseBtn.MouseButton1Click:Connect(function()
            Main.Visible = false
            Pill.Visible = true
        end)
        Pill.MouseButton1Click:Connect(function()
            Main.Visible = true
            Pill.Visible = false
        end)

        return Window
    end

    -- ============================================================
    -- UI ELEMENTS
    -- ============================================================
    local function CreateBase(parent, height, text)
        local Frame = Create("Frame", { Parent = parent, Size = UDim2.new(1, 0, 0, height), BackgroundColor3 = Library.Theme.Element, BorderSizePixel = 0 }, { Create("UICorner", { CornerRadius = UDim.new(0, 6) }) })
        Create("TextLabel", { Parent = Frame, Text = text, Size = UDim2.new(0.6, 0, 1, 0), Position = UDim2.new(0, 12, 0, 0), BackgroundTransparency = 1, TextColor3 = Library.Theme.Accent, Font = Enum.Font.Gotham, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left })
        return Frame
    end

    -- Section Header
    function Library:CreateSection(parent, name)
        local Section = Create("TextLabel", { Parent = parent, Text = name, Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, TextColor3 = Library.Theme.TextDim, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left })
        Create("UIPadding", { Parent = Section, PaddingLeft = UDim.new(0, 4) })
    end

    -- Divider
    function Library:CreateDivider(parent)
        local Div = Create("Frame", { Parent = parent, Size = UDim2.new(1, -10, 0, 1), BackgroundColor3 = Library.Theme.Stroke, BorderSizePixel = 0 })
        Create("UIPadding", { Parent = Div, PaddingLeft = UDim.new(0, 5) })
    end

    -- Toggle
    function Library:CreateToggle(parent, config)
        local Frame = CreateBase(parent, 42, config.name)
        local RightGroup = Create("Frame", { Parent = Frame, Size = UDim2.new(0, 100, 1, 0), Position = UDim2.new(1, -110, 0, 0), BackgroundTransparency = 1 })
        
        Create("TextLabel", { Parent = RightGroup, Text = "...", Size = UDim2.new(0, 30, 1, 0), BackgroundTransparency = 1, TextColor3 = Library.Theme.TextDim, Font = Enum.Font.GothamBold, TextSize = 16 })
        Create("TextLabel", { Parent = RightGroup, Text = "None", Size = UDim2.new(0, 40, 1, 0), Position = UDim2.new(0, 25, 0, 0), BackgroundTransparency = 1, TextColor3 = Library.Theme.TextDim, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right })

        local SwitchBg = Create("Frame", { Parent = RightGroup, Size = UDim2.new(0, 34, 0, 20), Position = UDim2.new(0, 66, 0.5, -10), BackgroundColor3 = Library.Theme.ToggleOff }, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
        local Knob = Create("Frame", { Parent = SwitchBg, Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 2, 0.5, -8), BackgroundColor3 = Library.Theme.Accent }, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
        
        local Btn = Create("TextButton", { Parent = Frame, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "" })
        local state = config.value or false
        
        local function update()
            TweenService:Create(SwitchBg, TweenInfo, { BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.ToggleOff }):Play()
            TweenService:Create(Knob, TweenInfo, { Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8), BackgroundColor3 = state and Library.Theme.Background or Library.Theme.TextDim }):Play()
            if config.callback then config.callback(state) end
        end
        
        Btn.MouseButton1Click:Connect(function() state = not state; update() end)
        update()
    end

    -- Button
    function Library:CreateButton(parent, config)
        local Frame = CreateBase(parent, 42, config.name)
        Create("TextLabel", { Parent = Frame, Text = "button", Size = UDim2.new(0, 60, 1, 0), Position = UDim2.new(1, -70, 0, 0), BackgroundTransparency = 1, TextColor3 = Library.Theme.TextDim, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right })
        
        local Btn = Create("TextButton", { Parent = Frame, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "" })
        Btn.MouseEnter:Connect(function() TweenService:Create(Frame, TweenInfo, { BackgroundColor3 = Library.Theme.ElementHover }):Play() end)
        Btn.MouseLeave:Connect(function() TweenService:Create(Frame, TweenInfo, { BackgroundColor3 = Library.Theme.Element }):Play() end)
        Btn.MouseButton1Click:Connect(function() if config.callback then config.callback() end end)
    end

    -- Slider
    function Library:CreateSlider(parent, config)
        local Frame = CreateBase(parent, 52, config.name)
        
        local ValueBox = Create("Frame", { Parent = Frame, Size = UDim2.new(0, 40, 0, 22), Position = UDim2.new(1, -115, 0.5, -11), BackgroundColor3 = Library.Theme.Background }, { Create("UICorner", { CornerRadius = UDim.new(0, 4) }) })
        local ValueText = Create("TextLabel", { Parent = ValueBox, Text = tostring(config.value or 0), Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, TextColor3 = Library.Theme.Text, Font = Enum.Font.Gotham, TextSize = 12 })
        Create("TextLabel", { Parent = Frame, Text = "...", Size = UDim2.new(0, 30, 0, 22), Position = UDim2.new(1, -145, 0.5, -11), BackgroundTransparency = 1, TextColor3 = Library.Theme.TextDim, Font = Enum.Font.GothamBold, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Right })
        Create("TextLabel", { Parent = Frame, Text = "None", Size = UDim2.new(0, 30, 0, 22), Position = UDim2.new(1, -70, 0.5, -11), BackgroundTransparency = 1, TextColor3 = Library.Theme.TextDim, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right })

        local Bar = Create("Frame", { Parent = Frame, Size = UDim2.new(0.6, 0, 0, 4), Position = UDim2.new(0, 12, 1, -14), BackgroundColor3 = Library.Theme.Background }, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
        local Fill = Create("Frame", { Parent = Bar, Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Library.Theme.Accent }, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
        local Knob = Create("Frame", { Parent = Fill, Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(1, -6, 0.5, -6), BackgroundColor3 = Library.Theme.Accent }, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
        
        local dragging = false
        local min, max = config.range[1], config.range[2]
        local value = config.value or min
        
        local function set(val)
            val = math.clamp(val, min, max)
            value = val
            Fill.Size = UDim2.new((val - min) / (max - min), 0, 1, 0)
            ValueText.Text = tostring(math.floor(val))
            if config.callback then config.callback(math.floor(val)) end
        end
        
        Bar.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end end)
        UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local relX = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                set(min + (max - min) * relX)
            end
        end)
        set(value)
    end

    -- Input
    function Library:CreateInput(parent, config)
        local Frame = CreateBase(parent, 42, config.name)
        local Box = Create("TextBox", { Parent = Frame, Size = UDim2.new(0, 100, 0, 24), Position = UDim2.new(1, -115, 0.5, -12), BackgroundColor3 = Library.Theme.Background, TextColor3 = Library.Theme.Text, Font = Enum.Font.Gotham, TextSize = 12, PlaceholderText = "None", PlaceholderColor3 = Library.Theme.TextDim, Text = "", ClearTextOnFocus = false }, { Create("UICorner", { CornerRadius = UDim.new(0, 4) }) })
        Box.FocusLost:Connect(function() if config.callback then config.callback(Box.Text) end end)
    end

    -- Keybind
    function Library:CreateKeybind(parent, config)
        local Frame = CreateBase(parent, 42, config.name)
        local Btn = Create("TextButton", { Parent = Frame, Size = UDim2.new(0, 100, 0, 24), Position = UDim2.new(1, -115, 0.5, -12), BackgroundColor3 = Library.Theme.Background, Text = "None", TextColor3 = Library.Theme.TextDim, Font = Enum.Font.Gotham, TextSize = 12 }, { Create("UICorner", { CornerRadius = UDim.new(0, 4) }) })
        
        local binding = false
        Btn.MouseButton1Click:Connect(function()
            binding = true; Btn.Text = "..."; Btn.TextColor3 = Library.Theme.Accent
            local conn
            conn = UserInputService.InputBegan:Connect(function(input)
                if binding and (input.UserInputType == Enum.UserInputType.Keyboard or input.UserInputType == Enum.UserInputType.MouseButton1) then
                    Btn.Text = tostring(input.KeyCode.Name or "MB1")
                    Btn.TextColor3 = Library.Theme.Text
                    binding = false
                    if config.callback then config.callback(input.KeyCode) end
                    conn:Disconnect()
                end
            end)
        end)
    end

    -- Dropdown
    function Library:CreateDropdown(parent, config)
        local Frame = CreateBase(parent, 42, config.name)
        local Btn = Create("TextButton", { Parent = Frame, Size = UDim2.new(0, 100, 0, 24), Position = UDim2.new(1, -115, 0.5, -12), BackgroundColor3 = Library.Theme.Background, Text = config.currentOption or "None", TextColor3 = Library.Theme.TextDim, Font = Enum.Font.Gotham, TextSize = 12 }, { Create("UICorner", { CornerRadius = UDim.new(0, 4) }) })
        
        local List = Create("Frame", { Parent = Frame, Size = UDim2.new(0, 100, 0, 0), Position = UDim2.new(1, -115, 1, 2), BackgroundColor3 = Library.Theme.Background, Visible = false, ClipsDescendants = true, ZIndex = 10 }, { Create("UICorner", { CornerRadius = UDim.new(0, 4) }), Create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }), Create("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2) }) })
        
        local open = false
        Btn.MouseButton1Click:Connect(function()
            open = not open; List.Visible = true
            TweenService:Create(List, TweenInfo, { Size = open and UDim2.new(0, 100, 0, #config.options * 24) or UDim2.new(0, 100, 0, 0) }):Play()
            if not open then task.delay(0.2, function() if not open then List.Visible = false end end) end
        end)
        
        for _, opt in pairs(config.options) do
            local OptBtn = Create("TextButton", { Parent = List, Size = UDim2.new(1, 0, 0, 22), BackgroundColor3 = Library.Theme.Element, Text = opt, TextColor3 = Library.Theme.Text, Font = Enum.Font.Gotham, TextSize = 12, ZIndex = 11 }, { Create("UICorner", { CornerRadius = UDim.new(0, 2) }) })
            OptBtn.MouseButton1Click:Connect(function()
                Btn.Text = opt; Btn.TextColor3 = Library.Theme.Text; open = false; List.Visible = false
                if config.callback then config.callback(opt) end
            end)
        end
    end

