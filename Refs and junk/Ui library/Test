    -- ============================================================
    -- Custom UI Library (Evaware Style) - V3 Fixed
    -- ============================================================
    local TweenService = game:GetService("TweenService")
    local UserInputService = game:GetService("UserInputService")
    local CoreGui = game:GetService("CoreGui")
    local Players = game:GetService("Players")

    local Library = {}
    Library.Theme = {
        Background = Color3.fromRGB(15, 15, 20),     
        Sidebar = Color3.fromRGB(15, 15, 20),        
        TopBar = Color3.fromRGB(15, 15, 20),
        Element = Color3.fromRGB(25, 25, 30),        
        ElementHover = Color3.fromRGB(35, 35, 40),
        Accent = Color3.fromRGB(255, 255, 255),      
        Text = Color3.fromRGB(220, 220, 220),
        TextDim = Color3.fromRGB(120, 120, 125),
        Stroke = Color3.fromRGB(40, 40, 45),
        ToggleOff = Color3.fromRGB(60, 60, 65)
    }
    local TweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    local function Create(instance, properties, children)
        local obj = Instance.new(instance)
        for k, v in pairs(properties or {}) do obj[k] = v end
        for _, v in pairs(children or {}) do v.Parent = obj end
        return obj
    end

    -- ============================================================
    -- WINDOW CREATION
    -- ============================================================
    function Library:CreateWindow(config)
        local Window = { Tabs = {} }
        
        local ScreenGui = Create("ScreenGui", { Name = "EvawareUI", ResetOnSpawn = false, Parent = CoreGui, ZIndexBehavior = Enum.ZIndexBehavior.Sibling })
        
        -- Base UI Scale (Increased size)
        local UIScale = Create("UIScale", { Parent = ScreenGui, Scale = 1 })
        if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
            UIScale.Scale = 0.9
        end

        local Main = Create("Frame", {
            Name = "Main", Parent = ScreenGui, Size = UDim2.new(0, 850, 0, 600),
            Position = UDim2.new(0.5, -425, 0.5, -300), BackgroundColor3 = self.Theme.Background,
            BorderSizePixel = 0, ClipsDescendants = true
        }, { 
            Create("UICorner", { CornerRadius = UDim.new(0, 8) }), 
            Create("UIStroke", { Color = self.Theme.Stroke, Thickness = 1 }) 
        })

        -- Top Bar
        local TopBar = Create("Frame", { Parent = Main, Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1 })
        
        -- Drag Logic (Fixes camera dragging by using an active TextButton)
        local dragging, dragInput, dragStart, startPos
        local DragBtn = Create("TextButton", { Parent = TopBar, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Active = true })
        DragBtn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = Main.Position
                input.Changed:Connect(function() 
                    if input.UserInputState == Enum.UserInputState.End then dragging = false end 
                end)
            end
        end)
        DragBtn.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then 
                dragInput = input 
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and input == dragInput then
                local delta = input.Position - dragStart
                Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)

        -- Header Text & Icon
        Create("TextLabel", { Parent = TopBar, Text = config.name, Size = UDim2.new(0.5, 0, 0, 20), Position = UDim2.new(0, 70, 0, 12), BackgroundTransparency = 1, TextColor3 = self.Theme.Accent, Font = Enum.Font.GothamBold, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left })
        Create("TextLabel", { Parent = TopBar, Text = config.subtitle, Size = UDim2.new(0.5, 0, 0, 20), Position = UDim2.new(0, 70, 0, 34), BackgroundTransparency = 1, TextColor3 = self.Theme.TextDim, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left })
        
        -- Fallback Icon if invalid
        local iconId = config.icon or 1234
        local IconImg = Create("ImageLabel", { Parent = TopBar, Size = UDim2.new(0, 42, 0, 42), Position = UDim2.new(0, 15, 0, 9), BackgroundColor3 = self.Theme.Element, Image = "rbxassetid://" .. tostring(iconId) }, { Create("UICorner", { CornerRadius = UDim.new(0, 8) }) })
        IconImg.ImageFailed:Connect(function() IconImg.Image = "rbxassetid://1234" end) -- Generic fallback

        -- Close / Minimize Button
        local CloseBtn = Create("TextButton", { Parent = TopBar, Size = UDim2.new(0, 40, 0, 40), Position = UDim2.new(1, -50, 0, 10), BackgroundTransparency = 1, Text = "✕", TextColor3 = self.Theme.TextDim, Font = Enum.Font.GothamBold, TextSize = 16 })

        -- Sidebar
        local Sidebar = Create("Frame", { Parent = Main, Size = UDim2.new(0, 220, 1, -60), Position = UDim2.new(0, 0, 0, 60), BackgroundColor3 = self.Theme.Sidebar, BorderSizePixel = 0 })
        Create("UIListLayout", { Parent = Sidebar, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) })
        Create("UIPadding", { Parent = Sidebar, PaddingTop = UDim.new(0, 10), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) })
        
        -- Sidebar Divider Line
        Create("Frame", { Parent = Main, Size = UDim2.new(0, 1, 1, -60), Position = UDim2.new(0, 220, 0, 60), BackgroundColor3 = self.Theme.Stroke, BorderSizePixel = 0 })

        -- Content Container
