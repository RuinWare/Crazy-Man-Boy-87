-- UI Library (basic dark theme, runs in CoreGui)
--
-- The first part is the library body: it only declares what everything is, it doesn't build any UI.
-- The second part (below "TEST") builds a small window to try it out.
-- To use the library from a loadstring, put the body in its own file and end it with `return Library`.

----------------------------------------------------------------
-- LIBRARY BODY
----------------------------------------------------------------
local Library = (function()
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local TweenService = game:GetService("TweenService")
	local UserInputService = game:GetService("UserInputService")

	local Library = {
		Flags = {},     -- Library.Flags["ToggleFlag"] is the current value of the element with that flag
		Elements = {},  -- Library.Elements["ToggleFlag"] is the element itself
		Windows = {},
	}

	----------------------------------------------------------------
	-- Theme
	----------------------------------------------------------------
	local THEME = {
		window = Color3.fromRGB(22, 22, 26),
		topbar = Color3.fromRGB(30, 30, 35),
		element = Color3.fromRGB(36, 36, 42),
		elementHover = Color3.fromRGB(45, 45, 52),
		stroke = Color3.fromRGB(58, 58, 66),
		text = Color3.fromRGB(236, 236, 241),
		subtext = Color3.fromRGB(150, 150, 163),
		accent = Color3.fromRGB(64, 140, 255),
		toggleOff = Color3.fromRGB(72, 72, 82),
		white = Color3.new(1, 1, 1),
	}
	Library.Theme = THEME

	----------------------------------------------------------------
	-- Helpers
	----------------------------------------------------------------
	local function tween(obj, time, props, style, direction)
		local t = TweenService:Create(
			obj,
			TweenInfo.new(time, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out),
			props
		)
		t:Play()
		return t
	end

	local function make(class, props, parent)
		local inst = Instance.new(class)
		for key, value in pairs(props) do
			inst[key] = value
		end
		inst.Parent = parent
		return inst
	end

	local function corner(parent, radius)
		return make("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
	end

	local function outline(parent, color, transparency)
		return make("UIStroke", {
			Color = color or THEME.stroke,
			Thickness = 1,
			Transparency = transparency or 0,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}, parent)
	end

	local function isPress(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
	end

	local function p2(input)
		return Vector2.new(input.Position.X, input.Position.Y)
	end

	local function hasIcon(id)
		return id ~= nil and id ~= 0 and id ~= "0" and id ~= ""
	end

	local function assetUrl(id)
		if type(id) == "string" and id:find("rbxassetid://", 1, true) then return id end
		return "rbxassetid://" .. tostring(id)
	end

	-- Runs a callback on its own thread, so an error in it can't break the UI
	local function runCallback(callback, ...)
		if type(callback) ~= "function" then return end
		local args = table.pack(...)
		task.spawn(function()
			local ok, err = pcall(callback, table.unpack(args, 1, args.n))
			if not ok then warn("[Library] " .. tostring(err)) end
		end)
	end

	local CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
	local rng = Random.new()
	local function randomName(length)
		local out = {}
		for i = 1, length do
			local n = rng:NextInteger(1, #CHARS)
			out[i] = CHARS:sub(n, n)
		end
		return table.concat(out)
	end

	-- CoreGui (through the hidden UI container if there is one), PlayerGui only as a last resort
	local function parentGui(gui)
		local targets = {}
		if gethui then
			local ok, container = pcall(gethui)
			if ok and container then targets[#targets + 1] = container end
		end
		local okCore, coreGui = pcall(function() return game:GetService("CoreGui") end)
		if okCore and coreGui then targets[#targets + 1] = coreGui end
		local localPlayer = Players.LocalPlayer
		local playerGui = localPlayer and localPlayer:FindFirstChildOfClass("PlayerGui")
		if playerGui then targets[#targets + 1] = playerGui end

		for _, target in ipairs(targets) do
			local ok = pcall(function() gui.Parent = target end)
			if ok and gui.Parent == target then return end
		end
	end

	-- How many decimals a step like 0.01 has (so the slider shows 0.25, and 1 shows plain whole numbers)
	local function decimalsOf(step)
		local text = string.format("%.8f", step)
		text = text:gsub("0+$", "")
		local decimals = text:match("%.(%d*)$")
		return decimals and #decimals or 0
	end

	----------------------------------------------------------------
	-- Shared state
	----------------------------------------------------------------
	local screenGui = nil
	local connections = {}
	local mobileButtons = {}    -- element -> mobile button
	local keybindElements = {}  -- elements that have a key assigned
	local capturing = nil       -- when set, the next key press goes to this function (picking a keybind)
	local dragState = nil       -- what is being dragged right now
	local activeMenu = nil
	local inputReady = false

	local function getGui()
		if screenGui and screenGui.Parent then return screenGui end
		screenGui = make("ScreenGui", {
			Name = randomName(20),
			ResetOnSpawn = false,
			IgnoreGuiInset = true,
			DisplayOrder = 2147483000,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		}, nil)
		parentGui(screenGui)
		return screenGui
	end

	local function viewport()
		if screenGui and screenGui.AbsoluteSize.X > 0 then return screenGui.AbsoluteSize end
		return workspace.CurrentCamera.ViewportSize
	end

	-- Off-screen protection
	local function clampWindow(window, position)
		local v = viewport()
		local margin = 6
		return Vector2.new(
			math.clamp(position.X, margin, math.max(margin, v.X - window._width - margin)),
			math.clamp(position.Y, margin, math.max(margin, v.Y - window._height - margin))
		)
	end

	local function clampCenter(center, half)
		local v = viewport()
		local margin = 6
		return Vector2.new(
			math.clamp(center.X, half + margin, math.max(half + margin, v.X - half - margin)),
			math.clamp(center.Y, half + margin, math.max(half + margin, v.Y - half - margin))
		)
	end

	local function closeMenu()
		if activeMenu then activeMenu.close() end
	end

	----------------------------------------------------------------
	-- Small building blocks
	----------------------------------------------------------------
	-- An icon from an asset id (the images are white, so they are recolored)
	local function makeIcon(parent, id, size, color, extra)
		local props = {
			BackgroundTransparency = 1,
			Image = assetUrl(id),
			ImageColor3 = color or THEME.subtext,
			ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromOffset(size, size),
			ZIndex = 4,
		}
		if extra then
			for key, value in pairs(extra) do props[key] = value end
		end
		return make("ImageLabel", props, parent)
	end

	-- A switch (track + knob)
	local function makeSwitch(parent, anchor, position, zindex)
		local track = make("Frame", {
			AnchorPoint = anchor,
			Position = position,
			Size = UDim2.fromOffset(38, 20),
			BackgroundColor3 = THEME.toggleOff,
			BorderSizePixel = 0,
			ZIndex = zindex,
		}, parent)
		corner(track, 10)
		local knob = make("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 2, 0.5, 0),
			Size = UDim2.fromOffset(16, 16),
			BackgroundColor3 = THEME.white,
			BorderSizePixel = 0,
			ZIndex = zindex + 1,
		}, track)
		corner(knob, 8)
		local function set(on, animate)
			local color = on and THEME.accent or THEME.toggleOff
			local position2 = on and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
			if animate == false then
				track.BackgroundColor3 = color
				knob.Position = position2
			else
				tween(track, 0.22, { BackgroundColor3 = color }, Enum.EasingStyle.Quad)
				tween(knob, 0.32, { Position = position2 }, Enum.EasingStyle.Back)
			end
		end
		return { track = track, knob = knob, set = set }
	end

	-- A press squish for clickable things
	local function attachPress(button, scale, down)
		down = down or 0.96
		button.InputBegan:Connect(function(input)
			if isPress(input) then tween(scale, 0.08, { Scale = down }, Enum.EasingStyle.Quad) end
		end)
		button.InputEnded:Connect(function(input)
			if isPress(input) then tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back) end
		end)
	end

	-- A row in a tab (rounded, with a soft outline)
	local function makeRow(tab, height)
		local row = make("Frame", {
			Name = "Row",
			Size = UDim2.new(1, 0, 0, height),
			BackgroundColor3 = THEME.element,
			BorderSizePixel = 0,
			ClipsDescendants = true,
		}, tab._page)
		corner(row, 8)
		outline(row)
		return row
	end

	local function makeRowLabel(row, text, rightMargin)
		return make("TextLabel", {
			Name = "Name",
			Position = UDim2.fromOffset(12, 0),
			Size = UDim2.new(1, -(12 + rightMargin), 0, 40),
			BackgroundTransparency = 1,
			Text = text,
			TextColor3 = THEME.text,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Font = Enum.Font.GothamMedium,
			ZIndex = 3,
		}, row)
	end

	-- Hover color for a row
	local function attachHover(row, hit)
		hit.MouseEnter:Connect(function()
			tween(row, 0.15, { BackgroundColor3 = THEME.elementHover }, Enum.EasingStyle.Quad)
		end)
		hit.MouseLeave:Connect(function()
			tween(row, 0.2, { BackgroundColor3 = THEME.element }, Enum.EasingStyle.Quad)
		end)
	end

	local function newHit(row, zindex)
		return make("TextButton", {
			Name = "Hit",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Selectable = false,
			ZIndex = zindex or 2,
		}, row)
	end

	----------------------------------------------------------------
	-- Mobile buttons
	----------------------------------------------------------------
	local MB_SIZE = 78

	local function destroyMobileButton(element)
		local mb = mobileButtons[element]
		if not mb then return end
		mobileButtons[element] = nil
		element._mb = nil
		tween(mb.scale, 0.2, { Scale = 0.4 }, Enum.EasingStyle.Quad)
		tween(mb.frame, 0.2, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
		tween(mb.label, 0.2, { TextTransparency = 1 }, Enum.EasingStyle.Quad)
		task.delay(0.22, function() mb.frame:Destroy() end)
	end

	local function spawnMobileButton(element)
		if element._mb then return end
		local gui = getGui()
		local v = viewport()
		local count = 0
		for _ in pairs(mobileButtons) do count += 1 end
		local start = element._mbPosition or Vector2.new(v.X - 70, 150 + count * (MB_SIZE + 10))

		local mb = { element = element, _position = clampCenter(start, MB_SIZE / 2) }
		local frame = make("TextButton", {
			Name = "MobileButton",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(mb._position.X, mb._position.Y),
			Size = UDim2.fromOffset(MB_SIZE, MB_SIZE),
			BackgroundColor3 = THEME.element,
			Text = "",
			AutoButtonColor = false,
			Selectable = false,
			ZIndex = 40,
		}, gui)
		corner(frame, 14)
		outline(frame)
		local scale = make("UIScale", { Scale = 0.4 }, frame)
		local label = make("TextLabel", {
			Position = UDim2.fromOffset(6, 6),
			Size = UDim2.new(1, -12, 1, -12),
			BackgroundTransparency = 1,
			Text = element.Name,
			TextColor3 = THEME.text,
			TextSize = 12,
			TextWrapped = true,
			Font = Enum.Font.GothamMedium,
			ZIndex = 41,
		}, frame)
		local status
		if element.Type == "Toggle" then
			status = make("Frame", {
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, 0, 1, -7),
				Size = UDim2.fromOffset(26, 4),
				BackgroundColor3 = THEME.toggleOff,
				BorderSizePixel = 0,
				ZIndex = 42,
			}, frame)
			corner(status, 2)
		end
		mb.frame, mb.scale, mb.label, mb.status = frame, scale, label, status
		tween(scale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)

		function mb:Refresh()
			if element.Type ~= "Toggle" then return end
			local on = element.Value == true
			tween(frame, 0.2, { BackgroundColor3 = on and THEME.accent or THEME.element }, Enum.EasingStyle.Quad)
			tween(status, 0.2, { BackgroundColor3 = on and THEME.white or THEME.toggleOff }, Enum.EasingStyle.Quad)
		end

		function mb:Move(position)
			self._position = clampCenter(position, MB_SIZE / 2)
			element._mbPosition = self._position
			frame.Position = UDim2.fromOffset(math.floor(self._position.X), math.floor(self._position.Y))
		end

		-- a tap triggers it, a drag moves it
		frame.InputBegan:Connect(function(input)
			if not isPress(input) or dragState then return end
			dragState = { kind = "mb", mb = mb, input = input, start = p2(input), origin = mb._position, moved = false }
			tween(scale, 0.08, { Scale = 0.92 }, Enum.EasingStyle.Quad)
			input.Changed:Connect(function()
				if input.UserInputState ~= Enum.UserInputState.End then return end
				local state = dragState
				dragState = nil
				tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
				if state and state.mb == mb and not state.moved then element:_trigger() end
			end)
		end)

		mobileButtons[element] = mb
		element._mb = mb
		mb:Refresh()
	end

	----------------------------------------------------------------
	-- The small menu behind the 3 dots (Keybind + Mobile Button)
	----------------------------------------------------------------
	local function keyName(keyCode)
		return keyCode and keyCode.Name or "None"
	end

	local function setKeybind(element, keyCode)
		element.Keybind = keyCode
		local index = table.find(keybindElements, element)
		if keyCode and not index then
			keybindElements[#keybindElements + 1] = element
		elseif not keyCode and index then
			table.remove(keybindElements, index)
		end
	end

	local function openMenu(window, element, anchor)
		closeMenu()

		local rows = {}
		if element.HaveKeybinds then rows[#rows + 1] = "keybind" end
		if element.HaveMB then rows[#rows + 1] = "mb" end
		if #rows == 0 then return end

		local MENU_W, ROW_H = 210, 36
		local menuH = #rows * ROW_H + (#rows - 1) * 4 + 12

		local catcher = make("TextButton", {
			Name = "MenuCatcher",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Selectable = false,
			ZIndex = 30,
		}, window.root)

		-- next to the dots, kept inside the window
		local relative = anchor.AbsolutePosition - window.root.AbsolutePosition
		local x = math.clamp(relative.X + anchor.AbsoluteSize.X - MENU_W, 8, math.max(8, window._width - MENU_W - 8))
		local y = math.clamp(relative.Y + anchor.AbsoluteSize.Y + 4, 8, math.max(8, window._height - menuH - 8))

		local menu = make("Frame", {
			Name = "Menu",
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(MENU_W, menuH),
			BackgroundColor3 = THEME.topbar,
			BorderSizePixel = 0,
			ZIndex = 31,
		}, window.root)
		corner(menu, 10)
		outline(menu)
		local menuScale = make("UIScale", { Scale = 0.85 }, menu)
		tween(menuScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)

		local keyButton
		local closed = false
		local function close()
			if closed then return end
			closed = true
			activeMenu = nil
			capturing = nil
			catcher:Destroy()
			tween(menuScale, 0.15, { Scale = 0.85 }, Enum.EasingStyle.Quad)
			tween(menu, 0.15, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
			task.delay(0.16, function() menu:Destroy() end)
		end
		activeMenu = { close = close }
		catcher.Activated:Connect(close)

		for index, kind in ipairs(rows) do
			local rowFrame = make("Frame", {
				Position = UDim2.fromOffset(6, 6 + (index - 1) * (ROW_H + 4)),
				Size = UDim2.new(1, -12, 0, ROW_H),
				BackgroundColor3 = THEME.element,
				BorderSizePixel = 0,
				ZIndex = 32,
			}, menu)
			corner(rowFrame, 8)

			if kind == "keybind" then
				make("TextLabel", {
					Position = UDim2.fromOffset(10, 0),
					Size = UDim2.new(1, -100, 1, 0),
					BackgroundTransparency = 1,
					Text = "Keybind",
					TextColor3 = THEME.text,
					TextSize = 13,
					TextXAlignment = Enum.TextXAlignment.Left,
					Font = Enum.Font.GothamMedium,
					ZIndex = 33,
				}, rowFrame)
				keyButton = make("TextButton", {
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -6, 0.5, 0),
					Size = UDim2.fromOffset(82, 24),
					BackgroundColor3 = THEME.toggleOff,
					Text = keyName(element.Keybind),
					TextColor3 = THEME.text,
					TextSize = 12,
					AutoButtonColor = false,
					Selectable = false,
					Font = Enum.Font.GothamMedium,
					ZIndex = 33,
				}, rowFrame)
				corner(keyButton, 6)
				local keyScale = make("UIScale", { Scale = 1 }, keyButton)
				attachPress(keyButton, keyScale, 0.93)
				keyButton.MouseEnter:Connect(function()
					if not capturing then tween(keyButton, 0.15, { BackgroundColor3 = THEME.elementHover }, Enum.EasingStyle.Quad) end
				end)
				keyButton.MouseLeave:Connect(function()
					if not capturing then tween(keyButton, 0.2, { BackgroundColor3 = THEME.toggleOff }, Enum.EasingStyle.Quad) end
				end)
				keyButton.Activated:Connect(function()
					-- the next key you press becomes the keybind (Escape or Backspace clears it)
					keyButton.Text = "..."
					tween(keyButton, 0.15, { BackgroundColor3 = THEME.accent }, Enum.EasingStyle.Quad)
					capturing = function(keyCode)
						if keyCode == Enum.KeyCode.Escape or keyCode == Enum.KeyCode.Backspace then
							setKeybind(element, nil)
						else
							setKeybind(element, keyCode)
						end
						if keyButton.Parent then
							keyButton.Text = keyName(element.Keybind)
							tween(keyButton, 0.2, { BackgroundColor3 = THEME.toggleOff }, Enum.EasingStyle.Quad)
						end
					end
				end)
			else
				make("TextLabel", {
					Position = UDim2.fromOffset(10, 0),
					Size = UDim2.new(1, -70, 1, 0),
					BackgroundTransparency = 1,
					Text = "Mobile Button",
					TextColor3 = THEME.text,
					TextSize = 13,
					TextXAlignment = Enum.TextXAlignment.Left,
					Font = Enum.Font.GothamMedium,
					ZIndex = 33,
				}, rowFrame)
				local switch = makeSwitch(rowFrame, Vector2.new(1, 0.5), UDim2.new(1, -8, 0.5, 0), 33)
				switch.set(element.MobileButtonEnabled, false)
				local toggleHit = newHit(rowFrame, 34)
				toggleHit.Activated:Connect(function()
					element:SetMobileButton(not element.MobileButtonEnabled)
					switch.set(element.MobileButtonEnabled)
				end)
			end
		end
	end

	-- The 3 dots on a row. They only exist if the element has keybinds or a mobile button.
	local function attachOptions(window, element, row, rightMargin)
		if not (element.HaveKeybinds or element.HaveMB) then return end
		local button = make("TextButton", {
			Name = "Options",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -rightMargin, 0, 20),
			Size = UDim2.fromOffset(26, 26),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Selectable = false,
			ZIndex = 5,
		}, row)
		corner(button, 13)

		local dotsParts = {}
		if hasIcon(window._optionsIcon) then
			dotsParts[1] = makeIcon(button, window._optionsIcon, 16, THEME.subtext, {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				ZIndex = 6,
			})
		else
			for index = 1, 3 do
				local dot = make("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(0.5, (index - 2) * 6, 0.5, 0),
					Size = UDim2.fromOffset(3, 3),
					BackgroundColor3 = THEME.subtext,
					BorderSizePixel = 0,
					ZIndex = 6,
				}, button)
				corner(dot, 2)
				dotsParts[index] = dot
			end
		end

		local function recolor(color)
			for _, part in ipairs(dotsParts) do
				if part:IsA("ImageLabel") then
					tween(part, 0.15, { ImageColor3 = color }, Enum.EasingStyle.Quad)
				else
					tween(part, 0.15, { BackgroundColor3 = color }, Enum.EasingStyle.Quad)
				end
			end
		end
		button.MouseEnter:Connect(function()
			tween(button, 0.15, { BackgroundTransparency = 0.85, BackgroundColor3 = THEME.white }, Enum.EasingStyle.Quad)
			recolor(THEME.text)
		end)
		button.MouseLeave:Connect(function()
			tween(button, 0.2, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
			recolor(THEME.subtext)
		end)
		button.Activated:Connect(function()
			openMenu(window, element, button)
		end)
	end

	local function register(element)
		if element.Flag then
			Library.Flags[element.Flag] = element.Value
			Library.Elements[element.Flag] = element
		end
	end

	-- the key and the mobile button are shared by toggles and buttons
	local function addExtraApi(element)
		function element:SetKeybind(keyCode)
			setKeybind(self, keyCode)
		end
		function element:SetMobileButton(state)
			self.MobileButtonEnabled = state == true
			if self.MobileButtonEnabled then
				spawnMobileButton(self)
			else
				destroyMobileButton(self)
			end
		end
	end

	----------------------------------------------------------------
	-- Global input: keybinds, picking a keybind, dragging
	----------------------------------------------------------------
	local function ensureInput()
		if inputReady then return end
		inputReady = true

		connections[#connections + 1] = UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
			if capturing then
				local callback = capturing
				capturing = nil
				callback(input.KeyCode)
				return
			end
			if UserInputService:GetFocusedTextBox() then return end
			for _, element in ipairs(keybindElements) do
				if element.Keybind == input.KeyCode then element:_trigger() end
			end
		end)

		connections[#connections + 1] = UserInputService.InputChanged:Connect(function(input)
			local state = dragState
			if not state then return end
			if input.UserInputType ~= Enum.UserInputType.MouseMovement and input ~= state.input then return end
			local delta = p2(input) - state.start
			if state.kind == "window" then
				local position = clampWindow(state.window, state.origin + delta)
				state.window._position = position
				state.window.root.Position = UDim2.fromOffset(math.floor(position.X), math.floor(position.Y))
			elseif state.kind == "mb" then
				if delta.Magnitude > 8 then state.moved = true end
				if state.moved then state.mb:Move(state.origin + delta) end
			elseif state.kind == "slider" then
				state.slider:_dragTo(p2(input).X)
			end
		end)

		-- keep windows and mobile buttons on the screen if the screen changes size
		connections[#connections + 1] = RunService.RenderStepped:Connect(function()
			for _, window in ipairs(Library.Windows) do
				local clamped = clampWindow(window, window._position)
				if clamped ~= window._position then
					window._position = clamped
					window.root.Position = UDim2.fromOffset(math.floor(clamped.X), math.floor(clamped.Y))
				end
			end
			for _, mb in pairs(mobileButtons) do
				local clamped = clampCenter(mb._position, MB_SIZE / 2)
				if clamped ~= mb._position then mb:Move(clamped) end
			end
		end)
	end

