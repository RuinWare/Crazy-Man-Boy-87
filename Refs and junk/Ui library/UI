	local Tab = {}
	Tab.__index = Tab

	function Library:CreateWindow(config)
		config = config or {}
		local gui = getGui()
		ensureInput()

		local WIDTH = config.width or 300
		local TOP_H, TAB_H = 42, 36
		local CONTENT_H = config.contentHeight or 250
		local FULL_H = TOP_H + TAB_H + CONTENT_H

		local window = {
			Tabs = {},
			_width = WIDTH,
			_height = FULL_H,
			_minimized = false,
			_optionsIcon = config.TBOptionsIcon,
			_selected = nil,
		}
		local v = viewport()
		window._position = clampWindow(window, Vector2.new(math.floor((v.X - WIDTH) / 2), math.floor(v.Y * 0.18)))

		local root = make("Frame", {
			Name = "Window",
			Position = UDim2.fromOffset(window._position.X, window._position.Y),
			Size = UDim2.fromOffset(WIDTH, FULL_H),
			BackgroundColor3 = THEME.window,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			ZIndex = 1,
		}, gui)
		corner(root, 10)
		outline(root)
		local rootScale = make("UIScale", { Scale = 0.9 }, root)
		tween(rootScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
		window.root = root

		-- top bar: icon + title on the left, minimize on the right
		local topbar = make("Frame", {
			Name = "TopBar",
			Size = UDim2.new(1, 0, 0, TOP_H),
			BackgroundColor3 = THEME.topbar,
			BorderSizePixel = 0,
			ZIndex = 5,
		}, root)

		local titleX = 14
		if hasIcon(config.icon) then
			makeIcon(topbar, config.icon, 20, THEME.text, {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 12, 0.5, 0),
				ZIndex = 6,
			})
			titleX = 12 + 20 + 8
		end
		make("TextLabel", {
			Name = "Title",
			Position = UDim2.fromOffset(titleX, 0),
			Size = UDim2.new(1, -(titleX + 46), 1, 0),
			BackgroundTransparency = 1,
			Text = config.title or "Window",
			TextColor3 = THEME.text,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Font = Enum.Font.GothamBold,
			ZIndex = 6,
		}, topbar)

		local minimize = make("TextButton", {
			Name = "Minimize",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.fromOffset(28, 28),
			BackgroundColor3 = THEME.white,
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Selectable = false,
			ZIndex = 6,
		}, topbar)
		corner(minimize, 8)
		local minimizeScale = make("UIScale", { Scale = 1 }, minimize)
		attachPress(minimize, minimizeScale, 0.85)
		local minimizeParts = {}
		if hasIcon(config.CloseIcon) then
			minimizeParts[1] = makeIcon(minimize, config.CloseIcon, 16, THEME.subtext, {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				ZIndex = 7,
			})
		else
			local dash = make("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(12, 2),
				BackgroundColor3 = THEME.subtext,
				BorderSizePixel = 0,
				ZIndex = 7,
			}, minimize)
			corner(dash, 1)
			minimizeParts[1] = dash
		end
		minimize.MouseEnter:Connect(function()
			tween(minimize, 0.15, { BackgroundTransparency = 0.88 }, Enum.EasingStyle.Quad)
			for _, part in ipairs(minimizeParts) do
				tween(part, 0.15, part:IsA("ImageLabel") and { ImageColor3 = THEME.text } or { BackgroundColor3 = THEME.text }, Enum.EasingStyle.Quad)
			end
		end)
		minimize.MouseLeave:Connect(function()
			tween(minimize, 0.2, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
			for _, part in ipairs(minimizeParts) do
				tween(part, 0.2, part:IsA("ImageLabel") and { ImageColor3 = THEME.subtext } or { BackgroundColor3 = THEME.subtext }, Enum.EasingStyle.Quad)
			end
		end)

		-- the window is moved by its top bar
		topbar.InputBegan:Connect(function(input)
			if not isPress(input) or dragState then return end
			dragState = { kind = "window", window = window, input = input, start = p2(input), origin = window._position }
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragState = nil end
			end)
		end)

		-- tabs along the top
		local tabBar = make("Frame", {
			Name = "TabBar",
			Position = UDim2.fromOffset(0, TOP_H),
			Size = UDim2.new(1, 0, 0, TAB_H),
			BackgroundTransparency = 1,
			ZIndex = 2,
		}, root)
		local tabList = make("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 0,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.X,
			ScrollingDirection = Enum.ScrollingDirection.X,
			ZIndex = 2,
		}, tabBar)
		make("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}, tabList)
		make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, tabList)
		make("Frame", {
			Position = UDim2.fromOffset(0, TOP_H + TAB_H - 1),
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundColor3 = THEME.stroke,
			BorderSizePixel = 0,
			ZIndex = 3,
		}, root)

		local content = make("Frame", {
			Name = "Content",
			Position = UDim2.fromOffset(0, TOP_H + TAB_H),
			Size = UDim2.new(1, 0, 0, CONTENT_H),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			ZIndex = 2,
		}, root)

		window.Library = Library
		window._tabList = tabList
		window._content = content

		function window:SetMinimized(state)
			self._minimized = state == true
			self._height = self._minimized and TOP_H or FULL_H
			closeMenu()
			tween(root, 0.4, { Size = UDim2.fromOffset(WIDTH, self._height) }, Enum.EasingStyle.Quint)
			self._position = clampWindow(self, self._position)
			tween(root, 0.4, { Position = UDim2.fromOffset(self._position.X, self._position.Y) }, Enum.EasingStyle.Quint)
		end
		minimize.Activated:Connect(function()
			window:SetMinimized(not window._minimized)
		end)

		local function selectTab(target)
			if window._selected == target then return end
			local previous = window._selected
			window._selected = target
			for _, tab in ipairs(window.Tabs) do
				local on = tab == target
				tween(tab._button, 0.2, { BackgroundTransparency = on and 0 or 1 }, Enum.EasingStyle.Quad)
				tween(tab._label, 0.2, { TextColor3 = on and THEME.text or THEME.subtext }, Enum.EasingStyle.Quad)
				if tab._icon then
					tween(tab._icon, 0.2, { ImageColor3 = on and THEME.text or THEME.subtext }, Enum.EasingStyle.Quad)
				end
			end
			closeMenu()
			if previous then previous._page.Visible = false end
			target._page.Visible = true
			target._page.Position = UDim2.fromOffset(0, 14)
			tween(target._page, 0.35, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quint)
		end

		function window:CreateTab(tabConfig)
			tabConfig = tabConfig or {}
			local tab = setmetatable({ _window = window, Elements = {} }, Tab)

			local button = make("TextButton", {
				Name = tabConfig.name or "Tab",
				LayoutOrder = #window.Tabs + 1,
				Size = UDim2.fromOffset(0, 26),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = THEME.element,
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				Selectable = false,
				ZIndex = 3,
			}, tabList)
			corner(button, 8)
			make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, button)
			make("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}, button)
			if hasIcon(tabConfig.icon) then
				tab._icon = makeIcon(button, tabConfig.icon, 14, THEME.subtext, { LayoutOrder = 1, ZIndex = 4 })
			end
			tab._label = make("TextLabel", {
				LayoutOrder = 2,
				Size = UDim2.fromOffset(0, 16),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundTransparency = 1,
				Text = tabConfig.name or "Tab",
				TextColor3 = THEME.subtext,
				TextSize = 13,
				Font = Enum.Font.GothamMedium,
				ZIndex = 4,
			}, button)
			tab._button = button

			local page = make("ScrollingFrame", {
				Name = "Page",
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScrollBarThickness = 3,
				ScrollBarImageColor3 = THEME.stroke,
				CanvasSize = UDim2.new(),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollingDirection = Enum.ScrollingDirection.Y,
				Visible = false,
				ZIndex = 2,
			}, content)
			make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, page)
			make("UIPadding", {
				PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 12),
				PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
			}, page)
			tab._page = page

			button.MouseEnter:Connect(function()
				if window._selected ~= tab then tween(button, 0.15, { BackgroundTransparency = 0.6 }, Enum.EasingStyle.Quad) end
			end)
			button.MouseLeave:Connect(function()
				if window._selected ~= tab then tween(button, 0.2, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad) end
			end)
			button.Activated:Connect(function()
				selectTab(tab)
			end)

			window.Tabs[#window.Tabs + 1] = tab
			if #window.Tabs == 1 then selectTab(tab) end
			return tab
		end

		Library.Windows[#Library.Windows + 1] = window
		return window
	end

