	function Tab:CreateToggle(config)
		config = config or {}
		local window = self._window
		local element = {
			Type = "Toggle",
			Name = config.name or "Toggle",
			Flag = config.flag,
			Value = config.value == true,
			Callback = config.callback,
			HaveKeybinds = config.haveKeybinds == true,
			HaveMB = config.haveMB == true,
			MobileButtonEnabled = false,
		}
		addExtraApi(element)

		local hasOptions = element.HaveKeybinds or element.HaveMB
		local rightMargin = 12 + 38 + 6 + (hasOptions and 28 or 0)
		local row = makeRow(self, 40)
		makeRowLabel(row, element.Name, rightMargin)
		local hit = newHit(row, 2)
		attachHover(row, hit)
		local switch = makeSwitch(row, Vector2.new(1, 0.5), UDim2.new(1, -12, 0, 20), 3)
		switch.set(element.Value, false)
		attachOptions(window, element, row, 12 + 38 + 6)

		function element:Set(value, silent)
			value = value == true
			if self.Value == value then return end
			self.Value = value
			switch.set(value)
			if self.Flag then Library.Flags[self.Flag] = value end
			if self._mb then self._mb:Refresh() end
			if not silent then runCallback(self.Callback, value) end
		end
		function element:Get()
			return self.Value
		end
		function element:_trigger()
			self:Set(not self.Value)
		end
		hit.Activated:Connect(function()
			element:_trigger()
		end)

		register(element)
		self.Elements[#self.Elements + 1] = element
		return element
	end

	function Tab:CreateButton(config)
		config = config or {}
		local window = self._window
		local element = {
			Type = "Button",
			Name = config.name or "Button",
			Flag = config.flag,
			Callback = config.callback,
			HaveKeybinds = config.haveKeybinds == true,
			HaveMB = config.haveMB == true,
			MobileButtonEnabled = false,
		}
		addExtraApi(element)

		local hasOptions = element.HaveKeybinds or element.HaveMB
		local row = makeRow(self, 40)
		makeRowLabel(row, element.Name, 12 + (hasOptions and 32 or 0))
		local hit = newHit(row, 2)
		attachHover(row, hit)
		attachOptions(window, element, row, 10)

		-- a quick flash of the accent color when it is pressed
		function element:Fire()
			row.BackgroundColor3 = THEME.accent:Lerp(THEME.element, 0.55)
			tween(row, 0.4, { BackgroundColor3 = THEME.element }, Enum.EasingStyle.Quint)
			runCallback(self.Callback)
			if self._mb then
				tween(self._mb.frame, 0.08, { BackgroundColor3 = THEME.accent }, Enum.EasingStyle.Quad)
				task.delay(0.1, function()
					if self._mb then tween(self._mb.frame, 0.3, { BackgroundColor3 = THEME.element }, Enum.EasingStyle.Quad) end
				end)
			end
		end
		function element:_trigger()
			self:Fire()
		end
		hit.Activated:Connect(function()
			element:Fire()
		end)

		register(element)
		self.Elements[#self.Elements + 1] = element
		return element
	end

	function Tab:CreateSlider(config)
		config = config or {}
		local minValue, maxValue = 0, 100
		if type(config.range) == "table" then
			minValue = tonumber(config.range[1]) or 0
			maxValue = tonumber(config.range[2]) or (minValue + 100)
		end
		if maxValue <= minValue then maxValue = minValue + 1 end
		local increment = tonumber(config.increment) or 1
		if increment <= 0 then increment = 1 end
		local decimals = decimalsOf(increment)

		local function snap(value)
			value = math.clamp(value, minValue, maxValue)
			local steps = math.floor((value - minValue) / increment + 0.5)
			value = minValue + steps * increment
			value = tonumber(string.format("%." .. decimals .. "f", value)) or value
			return math.clamp(value, minValue, maxValue)
		end

		local element = {
			Type = "Slider",
			Name = config.name or "Slider",
			Flag = config.flag,
			Callback = config.callback,
			Value = snap(tonumber(config.value) or minValue),
		}

		local row = makeRow(self, 54)
		local nameLabel = makeRowLabel(row, element.Name, 90)
		nameLabel.Size = UDim2.new(1, -102, 0, 30)
		local valueLabel = make("TextLabel", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 0),
			Size = UDim2.fromOffset(80, 30),
			BackgroundTransparency = 1,
			Text = "",
			TextColor3 = THEME.subtext,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Right,
			Font = Enum.Font.GothamMedium,
			ZIndex = 3,
		}, row)

		local track = make("Frame", {
			Position = UDim2.fromOffset(12, 36),
			Size = UDim2.new(1, -24, 0, 6),
			BackgroundColor3 = THEME.toggleOff,
			BorderSizePixel = 0,
			ZIndex = 3,
		}, row)
		corner(track, 3)
		local fill = make("Frame", {
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = THEME.accent,
			BorderSizePixel = 0,
			ZIndex = 4,
		}, track)
		corner(fill, 3)
		local knob = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = THEME.white,
			BorderSizePixel = 0,
			ZIndex = 5,
		}, track)
		corner(knob, 7)

		local hit = make("TextButton", {
			Position = UDim2.fromOffset(0, 24),
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Selectable = false,
			ZIndex = 6,
		}, row)
		attachHover(row, hit)

		local function render(animate)
			local alpha = (element.Value - minValue) / (maxValue - minValue)
			local time = animate == false and 0 or 0.08
			if time == 0 then
				fill.Size = UDim2.fromScale(alpha, 1)
				knob.Position = UDim2.fromScale(alpha, 0.5)
			else
				tween(fill, time, { Size = UDim2.fromScale(alpha, 1) }, Enum.EasingStyle.Linear)
				tween(knob, time, { Position = UDim2.fromScale(alpha, 0.5) }, Enum.EasingStyle.Linear)
			end
			valueLabel.Text = string.format("%." .. decimals .. "f", element.Value)
		end
		render(false)

		function element:Set(value, silent)
			value = snap(tonumber(value) or self.Value)
			if value == self.Value then return end
			self.Value = value
			render()
			if self.Flag then Library.Flags[self.Flag] = value end
			if not silent then runCallback(self.Callback, value) end
		end
		function element:Get()
			return self.Value
		end
		function element:_dragTo(x)
			local alpha = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
			self:Set(minValue + (maxValue - minValue) * alpha)
		end

		hit.InputBegan:Connect(function(input)
			if not isPress(input) or dragState then return end
			dragState = { kind = "slider", slider = element, input = input }
			tween(knob, 0.15, { Size = UDim2.fromOffset(18, 18) }, Enum.EasingStyle.Back)
			element:_dragTo(p2(input).X)
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragState = nil
					tween(knob, 0.2, { Size = UDim2.fromOffset(14, 14) }, Enum.EasingStyle.Quad)
				end
			end)
		end)

		register(element)
		self.Elements[#self.Elements + 1] = element
		return element
	end

	function Tab:CreateDropdown(config)
		config = config or {}
		local options = {}
		for _, option in ipairs(config.options or {}) do options[#options + 1] = tostring(option) end

		local element = {
			Type = "Dropdown",
			Name = config.name or "Dropdown",
			Flag = config.flag,
			Callback = config.callback,
			Value = config.value ~= nil and tostring(config.value) or options[1],
		}

		local HEADER_H, OPTION_H = 40, 30
		local listHeight = #options * OPTION_H + 8
		local closedHeight = HEADER_H
		local openHeight = HEADER_H + listHeight + 6

		local row = makeRow(self, closedHeight)
		makeRowLabel(row, element.Name, 150)
		local valueLabel = make("TextLabel", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -34, 0, 0),
			Size = UDim2.fromOffset(120, HEADER_H),
			BackgroundTransparency = 1,
			Text = element.Value or "",
			TextColor3 = THEME.subtext,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Font = Enum.Font.GothamMedium,
			ZIndex = 3,
		}, row)

		-- a small "v" that flips when the dropdown opens
		local chevron = make("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0, HEADER_H / 2),
			Size = UDim2.fromOffset(12, 12),
			BackgroundTransparency = 1,
			ZIndex = 3,
		}, row)
		for _, spec in ipairs({ { -3, 45 }, { 3, -45 } }) do
			local arm = make("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, spec[1], 0.5, 0),
				Size = UDim2.fromOffset(7, 2),
				Rotation = spec[2],
				BackgroundColor3 = THEME.subtext,
				BorderSizePixel = 0,
				ZIndex = 3,
			}, chevron)
			corner(arm, 1)
		end

		local hit = make("TextButton", {
			Size = UDim2.new(1, 0, 0, HEADER_H),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Selectable = false,
			ZIndex = 4,
		}, row)
		attachHover(row, hit)

		local list = make("Frame", {
			Position = UDim2.fromOffset(6, HEADER_H),
			Size = UDim2.new(1, -12, 0, listHeight),
			BackgroundColor3 = THEME.window,
			BorderSizePixel = 0,
			ZIndex = 3,
		}, row)
		corner(list, 8)
		make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, list)
		make("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }, list)

		local optionButtons = {}
		local open = false

		local function setOpen(state)
			open = state
			tween(row, 0.35, { Size = UDim2.new(1, 0, 0, state and openHeight or closedHeight) }, Enum.EasingStyle.Quint)
			tween(chevron, 0.35, { Rotation = state and 180 or 0 }, Enum.EasingStyle.Quint)
		end

		local function refresh()
			valueLabel.Text = element.Value or ""
			for index, button in ipairs(optionButtons) do
				local selected = options[index] == element.Value
				tween(button, 0.2, {
					TextColor3 = selected and THEME.accent or THEME.text,
					BackgroundTransparency = selected and 0.88 or 1,
				}, Enum.EasingStyle.Quad)
			end
		end

		for index, option in ipairs(options) do
			local button = make("TextButton", {
				LayoutOrder = index,
				Size = UDim2.new(1, 0, 0, OPTION_H),
				BackgroundColor3 = THEME.accent,
				BackgroundTransparency = 1,
				Text = option,
				TextColor3 = THEME.text,
				TextSize = 12,
				AutoButtonColor = false,
				Selectable = false,
				Font = Enum.Font.GothamMedium,
				ZIndex = 4,
			}, list)
			corner(button, 6)
			button.MouseEnter:Connect(function()
				if element.Value ~= option then tween(button, 0.15, { BackgroundTransparency = 0.94, BackgroundColor3 = THEME.white }, Enum.EasingStyle.Quad) end
			end)
			button.MouseLeave:Connect(function()
				if element.Value ~= option then tween(button, 0.2, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad) end
			end)
			button.Activated:Connect(function()
				element:Set(option)
				setOpen(false)
			end)
			optionButtons[index] = button
		end

		function element:Set(value, silent)
			value = tostring(value)
			if not table.find(options, value) then return end
			local changed = self.Value ~= value
			self.Value = value
			refresh()
			if changed then
				if self.Flag then Library.Flags[self.Flag] = value end
				if not silent then runCallback(self.Callback, value) end
			end
		end
		function element:Get()
			return self.Value
		end

		hit.Activated:Connect(function()
			setOpen(not open)
		end)
		refresh()

		register(element)
		self.Elements[#self.Elements + 1] = element
		return element
	end

	----------------------------------------------------------------
	-- Popup: a big window with options to pick from. It has no close button: it closes itself when
	-- an option is picked (pass closeOnSelect = false to keep it open and close it from code).
	----------------------------------------------------------------
	function Library:CreatePopup(config)
		config = config or {}
		local gui = getGui()
		local options = config.options or {}
		local popup = {}

		local backdrop = make("TextButton", {
			Name = "PopupBackdrop",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Selectable = false,
			ZIndex = 100,
		}, gui)
		tween(backdrop, 0.3, { BackgroundTransparency = 0.5 }, Enum.EasingStyle.Quad)

		local ROW_H = 46
		local v = viewport()
		local width = math.min(360, v.X - 24)
		local listHeight = #options * (ROW_H + 6) + 6
		local height = math.min(listHeight + 64, math.max(160, v.Y * 0.75))

		local panel = make("Frame", {
			Name = "Popup",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(width, height),
			BackgroundColor3 = THEME.window,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			ZIndex = 101,
		}, backdrop)
		corner(panel, 12)
		outline(panel)
		local panelScale = make("UIScale", { Scale = 0.88 }, panel)
		tween(panelScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)

		make("TextLabel", {
			Position = UDim2.fromOffset(18, 0),
			Size = UDim2.new(1, -36, 0, 52),
			BackgroundTransparency = 1,
			Text = config.name or "Popup",
			TextColor3 = THEME.text,
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Enum.Font.GothamBold,
			ZIndex = 102,
		}, panel)
		make("Frame", {
			Position = UDim2.fromOffset(0, 52),
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundColor3 = THEME.stroke,
			BorderSizePixel = 0,
			ZIndex = 102,
		}, panel)

		local scroller = make("ScrollingFrame", {
			Position = UDim2.fromOffset(0, 53),
			Size = UDim2.new(1, 0, 1, -53),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = THEME.stroke,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ZIndex = 102,
		}, panel)
		make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, scroller)
		make("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 10) }, scroller)

		local closed = false
		function popup:Close()
			if closed then return end
			closed = true
			tween(panelScale, 0.2, { Scale = 0.9 }, Enum.EasingStyle.Quad)
			tween(backdrop, 0.2, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
			task.delay(0.21, function() backdrop:Destroy() end)
		end

		local selectedIndex = nil
		local entries = {}

		local function updateMarks()
			for index, entry in ipairs(entries) do
				local on = index == selectedIndex
				tween(entry.dot, 0.2, { Size = on and UDim2.fromOffset(10, 10) or UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
				tween(entry.row, 0.2, { BackgroundColor3 = on and THEME.elementHover or THEME.element }, Enum.EasingStyle.Quad)
			end
		end

		for index, option in ipairs(options) do
			local row = make("TextButton", {
				LayoutOrder = index,
				Size = UDim2.new(1, 0, 0, ROW_H),
				BackgroundColor3 = THEME.element,
				Text = "",
				AutoButtonColor = false,
				Selectable = false,
				ZIndex = 103,
			}, scroller)
			corner(row, 8)
			outline(row)
			local rowScale = make("UIScale", { Scale = 1 }, row)
			attachPress(row, rowScale, 0.98)

			local textX = 14
			if hasIcon(option.icon) then
				makeIcon(row, option.icon, 22, THEME.text, {
					AnchorPoint = Vector2.new(0, 0.5),
					Position = UDim2.new(0, 12, 0.5, 0),
					ZIndex = 104,
				})
				textX = 12 + 22 + 10
			end
			make("TextLabel", {
				Position = UDim2.fromOffset(textX, 0),
				Size = UDim2.new(1, -(textX + 40), 1, 0),
				BackgroundTransparency = 1,
				Text = option.name or ("Option " .. index),
				TextColor3 = THEME.text,
				TextSize = 14,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Font = Enum.Font.GothamMedium,
				ZIndex = 104,
			}, row)

			-- a round mark on the right that fills in when the option is selected
			local mark = make("Frame", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -14, 0.5, 0),
				Size = UDim2.fromOffset(18, 18),
				BackgroundTransparency = 1,
				ZIndex = 104,
			}, row)
			corner(mark, 9)
			outline(mark, THEME.subtext)
			local dot = make("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(0, 0),
				BackgroundColor3 = THEME.accent,
				BorderSizePixel = 0,
				ZIndex = 105,
			}, mark)
			corner(dot, 5)
			entries[index] = { row = row, dot = dot }

			if option.selected then selectedIndex = index end

			row.MouseEnter:Connect(function()
				if index ~= selectedIndex then tween(row, 0.15, { BackgroundColor3 = THEME.elementHover }, Enum.EasingStyle.Quad) end
			end)
			row.MouseLeave:Connect(function()
				if index ~= selectedIndex then tween(row, 0.2, { BackgroundColor3 = THEME.element }, Enum.EasingStyle.Quad) end
			end)
			row.Activated:Connect(function()
				if closed then return end
				local previous = selectedIndex
				selectedIndex = index
				updateMarks()
				if previous and previous ~= index then
					runCallback(options[previous].callback, false)
				end
				runCallback(option.callback, true)
				if config.closeOnSelect ~= false then
					task.delay(0.25, function() popup:Close() end)
				end
			end)
		end
		updateMarks()

		return popup
	end

	function Library:Destroy()
		for _, connection in ipairs(connections) do connection:Disconnect() end
		table.clear(connections)
		for _, element in ipairs(table.clone(keybindElements)) do setKeybind(element, nil) end
		if screenGui then screenGui:Destroy() end
		screenGui = nil
		table.clear(Library.Windows)
		table.clear(mobileButtons)
		inputReady = false
	end
