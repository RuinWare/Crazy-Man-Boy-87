local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/RuinWare/Crazy-Man-Boy-87/refs/heads/main/Refs%20and%20junk/Ui%20library/File"))()

local SCSLIDERV = 16

tab:CreateToggle({
	name = "Speed Changer",
	haveKeybinds = true,
	haveMB = true,
	flag = "SCFLAG",
	value = false,
	callback = function(v)
		if v then
         game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = SCSLIDERV
         else
game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 16
	end,
})

