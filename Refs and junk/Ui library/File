	function Tab:CreateToggle(config)
		config = config or {}
		local window = self._window
		local element = {
			Type = "Toggle",
			Name = config.name or "Toggle",
			Flag = config.flag,
			Value = config.value == true,
			Callback = config.callback,
			HaveKeybinds = config.haveKeybinds == true,
			HaveMB = config.haveMB == true,
			MobileButtonEnabled = false,
		}
		addExtraApi(element)

		local hasOptions = element.HaveKeybinds or element.HaveMB
		local rightMargin = 12 + 38 + 6 + (hasOptions and 28 or 0)
		local row = makeRow(self, 40)
		makeRowLabel(row, element.Name, rightMargin)
		local hit = newHit(row, 2)
		attachHover(row, hit)
		local switch = makeSwitch(row, Vector2.new(1, 0.5), UDim2.new(1, -12, 0, 20), 3)
		switch.set(element.Value, false)
		attachOptions(window, element, row, 12 + 38 + 6)

		function element:Set(value, silent)
			value = value == true
			if self.Value == value then return end
			self.Value = value
			switch.set(value)
			if self.Flag then LayerLib.Flags[self.Flag] = value end
			if self._mb then self._mb.SetState(value) end
			if not silent then runCallback(self.Callback, value) end
		end
		function element:Get()
			return self.Value
		end
		function element:_trigger()
			self:Set(not self.Value)
		end
		hit.Activated:Connect(function()
			element:_trigger()
		end)

		register(element)
		self.Elements[#self.Elements + 1] = element
		return element
	end

	function Tab:CreateButton(config)
		config = config or {}
		local window = self._window
		local element = {
			Type = "Button",
			Name = config.name or "Button",
			Flag = config.flag,
			Callback = config.callback,
			HaveKeybinds = config.haveKeybinds == true,
			HaveMB = config.haveMB == true,
			MobileButtonEnabled = false,
		}
		addExtraApi(element)

		local hasOptions = element.HaveKeybinds or element.HaveMB
		local row = makeRow(self, 40)
		makeRowLabel(row, element.Name, 12 + (hasOptions and 32 or 0))
		local hit = newHit(row, 2)
		attachHover(row, hit)
		attachOptions(window, element, row, 10)

		-- runs the callback only (the mobile button already flashes by itself)
		function element:_run()
			runCallback(self.Callback)
		end
		-- a quick flash of the accent color when it is pressed
		function element:Fire()
			row.BackgroundColor3 = THEME.accent:Lerp(THEME.element, 0.55)
			tween(row, 0.4, { BackgroundColor3 = THEME.element }, Enum.EasingStyle.Quint)
			self:_run()
			if self._mb then self._mb.Pulse() end
		end
		function element:_trigger()
			self:Fire()
		end
		hit.Activated:Connect(function()
			element:Fire()
		end)

		register(element)
		self.Elements[#self.Elements + 1] = element
		return element
	end

	function Tab:CreateSlider(config)
		config = config or {}
		local tab = self
		local minValue, maxValue = 0, 100
		if type(config.range) == "table" then
			minValue = tonumber(config.range[1]) or 0
			maxValue = tonumber(config.range[2]) or (minValue + 100)
		end
		if maxValue <= minValue then maxValue = minValue + 1 end
		local increment = tonumber(config.increment) or 1
		if increment <= 0 then increment = 1 end
		local decimals = decimalsOf(increment)

		local function snap(value)
			value = math.clamp(value, minValue, maxValue)
			local steps = math.floor((value - minValue) / increment + 0.5)
			value = minValue + steps * increment
			value = tonumber(string.format("%." .. decimals .. "f", value)) or value
			return math.clamp(value, minValue, maxValue)
		end

		local element = {
			Type = "Slider",
			Name = config.name or "Slider",
			Flag = config.flag,
			Callback = config.callback,
			Value = snap(tonumber(config.value) or minValue),
		}

		local row = makeRow(self, 54)
		local nameLabel = makeRowLabel(row, element.Name, 90)
		nameLabel.Size = UDim2.new(1, -102, 0, 30)
		local valueLabel = make("TextLabel", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 0),
			Size = UDim2.fromOffset(80, 30),
			BackgroundTransparency = 1,
			Text = "",
			TextColor3 = THEME.subtext,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Right,
			Font = Enum.Font.GothamMedium,
			ZIndex = 3,
		}, row)

		local track = make("Frame", {
			Position = UDim2.fromOffset(12, 36),
			Size = UDim2.new(1, -24, 0, 6),
			BackgroundColor3 = THEME.toggleOff,
			BorderSizePixel = 0,
			ZIndex = 3,
		}, row)
		corner(track, 3)
		local fill = make("Frame", {
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = THEME.accent,
			BorderSizePixel = 0,
			ZIndex = 4,
		}, track)
		corner(fill, 3)
		local knob = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = THEME.white,
			BorderSizePixel = 0,
			ZIndex = 5,
		}, track)
		corner(knob, 7)

		local hit = make("TextButton", {
			Position = UDim2.fromOffset(0, 22),
			Size = UDim2.new(1, 0, 0, 32),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Selectable = false,
			ZIndex = 6,
		}, row)
		attachHover(row, hit)

		local function render(animate)
			local alpha = (element.Value - minValue) / (maxValue - minValue)
			if animate == false then
				fill.Size = UDim2.fromScale(alpha, 1)
				knob.Position = UDim2.fromScale(alpha, 0.5)
			else
				tween(fill, 0.08, { Size = UDim2.fromScale(alpha, 1) }, Enum.EasingStyle.Linear)
				tween(knob, 0.08, { Position = UDim2.fromScale(alpha, 0.5) }, Enum.EasingStyle.Linear)
			end
			valueLabel.Text = string.format("%." .. decimals .. "f", element.Value)
		end
		render(false)

		function element:Set(value, silent)
			value = snap(tonumber(value) or self.Value)
			if value == self.Value then return end
			self.Value = value
			render()
			if self.Flag then LayerLib.Flags[self.Flag] = value end
			if not silent then runCallback(self.Callback, value) end
		end
		function element:Get()
			return self.Value
		end
		function element:_dragTo(x)
			local alpha = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
			self:Set(minValue + (maxValue - minValue) * alpha)
		end

		-- Press and hold on the bar, then slide. The tab's page stops scrolling while you do it,
		-- otherwise a finger moving sideways gets taken over by the scrolling and only a tap lands.
		hit.InputBegan:Connect(function(input)
			if not isPress(input) then return end
			local page = tab._page
			local started = beginDrag({
				kind = "slider",
				slider = element,
				input = input,
				onEnd = function()
					page.ScrollingEnabled = true
					tween(knob, 0.2, { Size = UDim2.fromOffset(14, 14) }, Enum.EasingStyle.Quad)
				end,
			})
			if not started then return end
			page.ScrollingEnabled = false
			tween(knob, 0.15, { Size = UDim2.fromOffset(18, 18) }, Enum.EasingStyle.Back)
			element:_dragTo(p2(input).X)
		end)

		register(element)
		self.Elements[#self.Elements + 1] = element
		return element
	end

	function Tab:CreateDropdown(config)
		config = config or {}
		local options = {}
		for _, option in ipairs(config.options or {}) do options[#options + 1] = tostring(option) end

		local element = {
			Type = "Dropdown",
			Name = config.name or "Dropdown",
			Flag = config.flag,
			Callback = config.callback,
			Value = config.value ~= nil and tostring(config.value) or options[1],
		}

		local HEADER_H, OPTION_H = 40, 30
		local listHeight = #options * OPTION_H + 8
		local closedHeight = HEADER_H
		local openHeight = HEADER_H + listHeight + 6

		local row = makeRow(self, closedHeight)
		makeRowLabel(row, element.Name, 150)
		local valueLabel = make("TextLabel", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -34, 0, 0),
			Size = UDim2.fromOffset(120, HEADER_H),
			BackgroundTransparency = 1,
			Text = element.Value or "",
			TextColor3 = THEME.subtext,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Font = Enum.Font.GothamMedium,
			ZIndex = 3,
		}, row)

		-- a small "v" that flips when the dropdown opens
		local chevron = make("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0, HEADER_H / 2),
			Size = UDim2.fromOffset(12, 12),
			BackgroundTransparency = 1,
			ZIndex = 3,
		}, row)
		for _, spec in ipairs({ { -3, 45 }, { 3, -45 } }) do
			local arm = make("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, spec[1], 0.5, 0),
				Size = UDim2.fromOffset(7, 2),
				Rotation = spec[2],
				BackgroundColor3 = THEME.subtext,
				BorderSizePixel = 0,
				ZIndex = 3,
			}, chevron)
			corner(arm, 1)
		end

		local hit = make("TextButton", {
			Size = UDim2.new(1, 0, 0, HEADER_H),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Selectable = false,
			ZIndex = 4,
		}, row)
		attachHover(row, hit)

		local list = make("Frame", {
			Position = UDim2.fromOffset(6, HEADER_H),
			Size = UDim2.new(1, -12, 0, listHeight),
			BackgroundColor3 = THEME.window,
			BorderSizePixel = 0,
			ZIndex = 3,
		}, row)
		corner(list, 8)
		make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, list)
		make("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }, list)

		local optionButtons = {}
		local open = false

		local function setOpen(state)
			open = state
			tween(row, 0.35, { Size = UDim2.new(1, 0, 0, state and openHeight or closedHeight) }, Enum.EasingStyle.Quint)
			tween(chevron, 0.35, { Rotation = state and 180 or 0 }, Enum.EasingStyle.Quint)
		end

		local function refresh()
			valueLabel.Text = element.Value or ""
			for index, button in ipairs(optionButtons) do
				local selected = options[index] == element.Value
				tween(button, 0.2, {
					TextColor3 = selected and THEME.accent or THEME.text,
					BackgroundTransparency = selected and 0.88 or 1,
				}, Enum.EasingStyle.Quad)
			end
		end

		for index, option in ipairs(options) do
			local button = make("TextButton", {
				LayoutOrder = index,
				Size = UDim2.new(1, 0, 0, OPTION_H),
				BackgroundColor3 = THEME.accent,
				BackgroundTransparency = 1,
				Text = option,
				TextColor3 = THEME.text,
				TextSize = 12,
				AutoButtonColor = false,
				Selectable = false,
				Font = Enum.Font.GothamMedium,
				ZIndex = 4,
			}, list)
			corner(button, 6)
			button.MouseEnter:Connect(function()
				if element.Value ~= option then tween(button, 0.15, { BackgroundTransparency = 0.94, BackgroundColor3 = THEME.white }, Enum.EasingStyle.Quad) end
			end)
			button.MouseLeave:Connect(function()
				if element.Value ~= option then tween(button, 0.2, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad) end
			end)
			button.Activated:Connect(function()
				element:Set(option)
				setOpen(false)
			end)
			optionButtons[index] = button
		end

		function element:Set(value, silent)
			value = tostring(value)
			if not table.find(options, value) then return end
			local changed = self.Value ~= value
			self.Value = value
			refresh()
			if changed then
				if self.Flag then LayerLib.Flags[self.Flag] = value end
				if not silent then runCallback(self.Callback, value) end
			end
		end
		function element:Get()
			return self.Value
		end

		hit.Activated:Connect(function()
			setOpen(not open)
		end)
		refresh()

		register(element)
		self.Elements[#self.Elements + 1] = element
		return element
	end

	----------------------------------------------------------------
	-- Popup: a grid of tiles (image on top, a bar under it, the name below).
	-- It sits on the screen with no dimmed background, you drag it by its top bar, picking a tile
	-- highlights it and does not close it. It only closes with Popup:Close().
	----------------------------------------------------------------
	function LayerLib:CreatePopup(config)
		config = config or {}
		local gui = getGui()
		ensureInput()

		local options = {}
		for _, option in ipairs(config.options or {}) do options[#options + 1] = option end
		local flag = config.flag
		local accent = toColor3(config.color, THEME.accent) -- the bar under each tile: Color3 or { r, g, b }

		-- one popup per flag: opening it again replaces the old one
		if flag and openPopups[flag] then openPopups[flag]:Close(true) end

		local TILE_W, TILE_H, GAP, PAD, HEAD_H, RADIUS = 132, 150, 8, 14, 40, 12
		local BAR_LINE = 104 -- the line the bar sits on (the highlight ends here too)

		local v = viewport()
		local cols = math.max(1, math.floor(tonumber(config.columns) or 4))
		cols = math.max(1, math.min(cols, math.floor((v.X - 20 - PAD * 2 + GAP) / (TILE_W + GAP))))
		local rows = math.max(1, math.ceil(#options / cols))
		local width = cols * TILE_W + (cols - 1) * GAP + PAD * 2
		local gridHeight = rows * TILE_H + (rows - 1) * GAP + PAD * 2
		local height = math.min(HEAD_H + gridHeight, math.max(HEAD_H + TILE_H + PAD * 2, v.Y - 20))

		local popup = { Name = config.name or "Popup", Flag = flag, _width = width, _height = height }
		popup._position = clampWindow(popup, Vector2.new(math.floor((v.X - width) / 2), math.floor((v.Y - height) / 2)))

		local root = make("Frame", {
			Name = "Popup",
			Position = UDim2.fromOffset(popup._position.X, popup._position.Y),
			Size = UDim2.fromOffset(width, height),
			BackgroundColor3 = THEME.window,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			ZIndex = 100,
		}, gui)
		corner(root, RADIUS)
		outline(root)
		local rootScale = make("UIScale", { Scale = 0.9 }, root)
		tween(rootScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
		popup.root = root

		-- top bar (rounded like the window): the title and a small grip, drag it to move the popup
		local head = make("Frame", {
			Name = "Head",
			Size = UDim2.new(1, 0, 0, HEAD_H),
			BackgroundColor3 = THEME.topbar,
			BorderSizePixel = 0,
			ZIndex = 2,
		}, root)
		corner(head, RADIUS)
		make("Frame", {
			Position = UDim2.new(0, 0, 1, -RADIUS),
			Size = UDim2.new(1, 0, 0, RADIUS),
			BackgroundColor3 = THEME.topbar,
			BorderSizePixel = 0,
			ZIndex = 2,
		}, head)
		make("TextLabel", {
			Position = UDim2.fromOffset(16, 0),
			Size = UDim2.new(0.5, -16, 1, 0),
			BackgroundTransparency = 1,
			Text = popup.Name,
			TextColor3 = THEME.text,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Font = Enum.Font.GothamBold,
			ZIndex = 3,
		}, head)
		local grip = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(40, 3),
			BackgroundColor3 = THEME.white,
			BackgroundTransparency = 0.8,
			BorderSizePixel = 0,
			ZIndex = 3,
		}, head)
		corner(grip, 2)
		make("Frame", {
			Position = UDim2.fromOffset(0, HEAD_H),
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundColor3 = THEME.stroke,
			BorderSizePixel = 0,
			ZIndex = 3,
		}, root)

		head.InputBegan:Connect(function(input)
			if not isPress(input) then return end
			if beginDrag({
				kind = "window", window = popup, input = input, start = p2(input), origin = popup._position,
				onEnd = function() tween(grip, 0.25, { BackgroundTransparency = 0.8 }, Enum.EasingStyle.Quad) end,
			}) then
				tween(grip, 0.15, { BackgroundTransparency = 0.4 }, Enum.EasingStyle.Quad)
			end
		end)

		local scroller = make("ScrollingFrame", {
			Name = "Grid",
			Position = UDim2.fromOffset(0, HEAD_H + 1),
			Size = UDim2.new(1, 0, 1, -(HEAD_H + 1)),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = THEME.stroke,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ZIndex = 2,
		}, root)
		make("UIGridLayout", {
			CellSize = UDim2.fromOffset(TILE_W, TILE_H),
			CellPadding = UDim2.fromOffset(GAP, GAP),
			SortOrder = Enum.SortOrder.LayoutOrder,
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Left,
		}, scroller)
		make("UIPadding", {
			PaddingLeft = UDim.new(0, PAD), PaddingRight = UDim.new(0, PAD),
			PaddingTop = UDim.new(0, PAD - 4), PaddingBottom = UDim.new(0, PAD),
		}, scroller)

		local closed = false
		local selected = nil -- index of the selected option
		local entries = {}

		local function findIndex(name)
			for index, option in ipairs(options) do
				if option.name == name then return index end
			end
			return nil
		end

		-- the core: change the selection (the old option gets callback(false), the new one callback(true))
		local function setSelected(newIndex, silent)
			local previous = selected
			if previous == newIndex then return end
			selected = newIndex
			if previous and entries[previous] then entries[previous].visual(false) end
			if newIndex and entries[newIndex] then entries[newIndex].visual(true) end
			if silent then return end
			if previous then runCallback(options[previous].callback, false) end
			if newIndex then runCallback(options[newIndex].callback, true) end
			if config.autoSave == true then popup:Save() end
		end

		for index, option in ipairs(options) do
			local tile = make("TextButton", {
				Name = "Tile",
				LayoutOrder = index,
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				Selectable = false,
				ZIndex = 2,
			}, scroller)
			local tileScale = make("UIScale", { Scale = 1 }, tile)
			attachPress(tile, tileScale, 0.96)

			-- the highlight panel behind the image and the bar (only the selected tile shows it)
			local highlight = make("Frame", {
				Name = "Highlight",
				Size = UDim2.new(1, 0, 0, BAR_LINE),
				BackgroundColor3 = THEME.element,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = 2,
			}, tile)
			corner(highlight, 10)

			local imageY = (BAR_LINE - 10) / 2
			if hasIcon(option.icon) then
				make("ImageLabel", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(0.5, 0, 0, imageY),
					Size = UDim2.fromOffset(66, 66),
					BackgroundTransparency = 1,
					Image = assetUrl(option.icon),
					ScaleType = Enum.ScaleType.Fit,
					ZIndex = 3,
				}, tile)
			else
				-- no image: the first letter stands in for it
				make("TextLabel", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(0.5, 0, 0, imageY),
					Size = UDim2.fromOffset(66, 66),
					BackgroundTransparency = 1,
					Text = string.upper(string.sub(tostring(option.name or "?"), 1, 1)),
					TextColor3 = THEME.subtext,
					TextSize = 38,
					Font = Enum.Font.GothamBold,
					ZIndex = 3,
				}, tile)
			end

			-- the bar: a thin line, and on the selected tile a bigger block sitting on the line
			local bar = make("Frame", {
				Name = "Bar",
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, 0, 0, BAR_LINE),
				Size = UDim2.new(0.62, 0, 0, 4),
				BackgroundColor3 = accent,
				BackgroundTransparency = 0.35,
				BorderSizePixel = 0,
				ZIndex = 3,
			}, tile)
			local barCorner = corner(bar, 2)
			local barFlat = make("Frame", {
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.fromScale(0, 1),
				Size = UDim2.new(1, 0, 0, 9),
				BackgroundColor3 = accent,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = 3,
			}, bar)

			local label = make("TextLabel", {
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, BAR_LINE + 8),
				Size = UDim2.new(1, -12, 0, TILE_H - BAR_LINE - 12),
				BackgroundTransparency = 1,
				Text = tostring(option.name or ("Option " .. index)),
				TextColor3 = THEME.text,
				TextSize = 13,
				TextWrapped = true,
				Font = Enum.Font.GothamMedium,
				ZIndex = 3,
			}, tile)

			local entry = { on = false }
			function entry.visual(on)
				entry.on = on
				tween(highlight, 0.25, { BackgroundTransparency = on and 0 or 1 }, Enum.EasingStyle.Quad)
				tween(bar, 0.4, {
					Size = on and UDim2.new(0.74, 0, 0, 22) or UDim2.new(0.62, 0, 0, 4),
					BackgroundTransparency = on and 0 or 0.35,
				}, Enum.EasingStyle.Back)
				tween(barCorner, 0.3, { CornerRadius = UDim.new(0, on and 7 or 2) }, Enum.EasingStyle.Quad)
				tween(barFlat, 0.3, { BackgroundTransparency = on and 0 or 1 }, Enum.EasingStyle.Quad)
				label.Font = on and Enum.Font.GothamBold or Enum.Font.GothamMedium
			end
			entries[index] = entry

			tile.MouseEnter:Connect(function()
				if not entry.on then tween(highlight, 0.15, { BackgroundTransparency = 0.75 }, Enum.EasingStyle.Quad) end
			end)
			tile.MouseLeave:Connect(function()
				if not entry.on then tween(highlight, 0.2, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad) end
			end)
			tile.Activated:Connect(function()
				if closed then return end
				setSelected(index)
			end)
		end

		----------------------------------------------------------------
		-- Popup methods
		----------------------------------------------------------------
		-- picks an option by its name, like a click would
		function popup:Select(name)
			if closed then return false end
			local index = findIndex(name)
			if not index then return false end
			setSelected(index)
			return true
		end

		-- nothing selected any more
		function popup:Reset()
			if closed then return end
			setSelected(nil)
		end

		-- remembers the current pick under the flag, so a popup opened later with the same flag starts on it
		-- (kept until the game closes, not saved to a file)
		function popup:Save()
			if not flag then return end
			popupSaves[flag] = selected and options[selected].name or false
		end

		function popup:GetSelected()
			return selected and options[selected].name or nil
		end

		function popup:Close(instant)
			if closed then return end
			closed = true
			if flag and openPopups[flag] == popup then openPopups[flag] = nil end
			local at = table.find(popupList, popup)
			if at then table.remove(popupList, at) end
			if dragState and dragState.window == popup then endDrag(dragState) end
			if instant then
				root:Destroy()
				return
			end
			tween(rootScale, 0.2, { Scale = 0.88 }, Enum.EasingStyle.Quad)
			task.delay(0.2, function() root:Destroy() end)
		end

		-- start on the saved option (without running its callback), else on the one marked selected = true
		local startIndex = nil
		if flag and popupSaves[flag] then
			startIndex = findIndex(popupSaves[flag])
		elseif not (flag and popupSaves[flag] == false) then
			for index, option in ipairs(options) do
				if option.selected == true then startIndex = index end
			end
		end
		if startIndex then setSelected(startIndex, true) end

		popupList[#popupList + 1] = popup
		if flag then openPopups[flag] = popup end
		return popup
	end

	function LayerLib:Destroy()
		local gone = {}
		for element in pairs(mobileButtons) do gone[#gone + 1] = element end
		for _, element in ipairs(gone) do destroyMobileButton(element) end
		for _, connection in ipairs(connections) do connection:Disconnect() end
		table.clear(connections)
		for _, element in ipairs(table.clone(keybindElements)) do setKeybind(element, nil) end
		if screenGui then screenGui:Destroy() end
		screenGui = nil
		table.clear(LayerLib.Windows)
		table.clear(popupList)
		table.clear(openPopups)
		dragState = nil
		inputReady = false
	end
   
                    	return LayerLib
               end)()
return LayerLib
