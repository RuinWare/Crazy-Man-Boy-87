	----------------------------------------------------------------
	-- Mobile buttons (the real MBs: they come from the MB code above)
	----------------------------------------------------------------
	local function destroyMobileButton(element)
		local handle = element._mb
		element._mb = nil
		element.MobileButtonEnabled = false
		mobileButtons[element] = nil
		if handle then handle.Destroy() end
	end

	local function spawnMobileButton(element)
		if element._mb then return end
		element.MobileButtonEnabled = true

		local count = 0
		for _ in pairs(mobileButtons) do count += 1 end

		local handle
		local ok, result = pcall(createMobileButton, {
			text = element.Name,
			flag = element.Flag or element.Name,
			kind = element.Type,
			initial = element.Value == true,
			offset = (count % 5) * 28, -- so several new buttons don't sit exactly on top of each other
			onToggle = function(on) element:Set(on) end,
			onClick = function() element:_run() end,
			onGone = function()
				-- it was deleted from outside (DestroyAllGuis, DeleteGuiByFlag): the switch goes off too
				if element._mb ~= handle then return end
				element._mb = nil
				element.MobileButtonEnabled = false
				mobileButtons[element] = nil
				if element._menuSwitch then element._menuSwitch.set(false) end
			end,
		})
		if not ok then
			warn("[LayerLib] mobile button: " .. tostring(result))
			element.MobileButtonEnabled = false
			return
		end
		handle = result
		element._mb = handle
		mobileButtons[element] = handle
	end

	----------------------------------------------------------------
	-- The small menu behind the 3 dots (Keybind + Mobile Button)
	----------------------------------------------------------------
	local function keyName(keyCode)
		return keyCode and keyCode.Name or "None"
	end

	local function setKeybind(element, keyCode)
		element.Keybind = keyCode
		local index = table.find(keybindElements, element)
		if keyCode and not index then
			keybindElements[#keybindElements + 1] = element
		elseif not keyCode and index then
			table.remove(keybindElements, index)
		end
	end

	local function openMenu(window, element, anchor)
		closeMenu()

		local rows = {}
		if element.HaveKeybinds then rows[#rows + 1] = "keybind" end
		if element.HaveMB then rows[#rows + 1] = "mb" end
		if #rows == 0 then return end

		local MENU_W, ROW_H = 210, 36
		local menuH = #rows * ROW_H + (#rows - 1) * 4 + 12

		local catcher = make("TextButton", {
			Name = "MenuCatcher",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Selectable = false,
			ZIndex = 30,
		}, window.root)

		-- next to the dots, kept inside the window
		local relative = anchor.AbsolutePosition - window.root.AbsolutePosition
		local x = math.clamp(relative.X + anchor.AbsoluteSize.X - MENU_W, 8, math.max(8, window._width - MENU_W - 8))
		local y = math.clamp(relative.Y + anchor.AbsoluteSize.Y + 4, 8, math.max(8, window._height - menuH - 8))

		local menu = make("Frame", {
			Name = "Menu",
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(MENU_W, menuH),
			BackgroundColor3 = THEME.topbar,
			BorderSizePixel = 0,
			ZIndex = 31,
		}, window.root)
		corner(menu, 10)
		outline(menu)
		local menuScale = make("UIScale", { Scale = 0.85 }, menu)
		tween(menuScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)

		local keyButton
		local closed = false
		local function close()
			if closed then return end
			closed = true
			activeMenu = nil
			capturing = nil
			element._menuSwitch = nil
			catcher:Destroy()
			tween(menuScale, 0.15, { Scale = 0.85 }, Enum.EasingStyle.Quad)
			tween(menu, 0.15, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
			task.delay(0.16, function() menu:Destroy() end)
		end
		activeMenu = { close = close }
		catcher.Activated:Connect(close)

		for index, kind in ipairs(rows) do
			local rowFrame = make("Frame", {
				Position = UDim2.fromOffset(6, 6 + (index - 1) * (ROW_H + 4)),
				Size = UDim2.new(1, -12, 0, ROW_H),
				BackgroundColor3 = THEME.element,
				BorderSizePixel = 0,
				ZIndex = 32,
			}, menu)
			corner(rowFrame, 8)

			if kind == "keybind" then
				make("TextLabel", {
					Position = UDim2.fromOffset(10, 0),
					Size = UDim2.new(1, -100, 1, 0),
					BackgroundTransparency = 1,
					Text = "Keybind",
					TextColor3 = THEME.text,
					TextSize = 13,
					TextXAlignment = Enum.TextXAlignment.Left,
					Font = Enum.Font.GothamMedium,
					ZIndex = 33,
				}, rowFrame)
				keyButton = make("TextButton", {
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -6, 0.5, 0),
					Size = UDim2.fromOffset(82, 24),
					BackgroundColor3 = THEME.toggleOff,
					Text = keyName(element.Keybind),
					TextColor3 = THEME.text,
					TextSize = 12,
					AutoButtonColor = false,
					Selectable = false,
					Font = Enum.Font.GothamMedium,
					ZIndex = 33,
				}, rowFrame)
				corner(keyButton, 6)
				local keyScale = make("UIScale", { Scale = 1 }, keyButton)
				attachPress(keyButton, keyScale, 0.93)
				keyButton.MouseEnter:Connect(function()
					if not capturing then tween(keyButton, 0.15, { BackgroundColor3 = THEME.elementHover }, Enum.EasingStyle.Quad) end
				end)
				keyButton.MouseLeave:Connect(function()
					if not capturing then tween(keyButton, 0.2, { BackgroundColor3 = THEME.toggleOff }, Enum.EasingStyle.Quad) end
				end)
				keyButton.Activated:Connect(function()
					-- the next key you press becomes the keybind (Escape or Backspace clears it)
					keyButton.Text = "..."
					tween(keyButton, 0.15, { BackgroundColor3 = THEME.accent }, Enum.EasingStyle.Quad)
					capturing = function(keyCode)
						if keyCode == Enum.KeyCode.Escape or keyCode == Enum.KeyCode.Backspace then
							setKeybind(element, nil)
						else
							setKeybind(element, keyCode)
						end
						if keyButton.Parent then
							keyButton.Text = keyName(element.Keybind)
							tween(keyButton, 0.2, { BackgroundColor3 = THEME.toggleOff }, Enum.EasingStyle.Quad)
						end
					end
				end)
			else
				make("TextLabel", {
					Position = UDim2.fromOffset(10, 0),
					Size = UDim2.new(1, -70, 1, 0),
					BackgroundTransparency = 1,
					Text = "Mobile Button",
					TextColor3 = THEME.text,
					TextSize = 13,
					TextXAlignment = Enum.TextXAlignment.Left,
					Font = Enum.Font.GothamMedium,
					ZIndex = 33,
				}, rowFrame)
				local switch = makeSwitch(rowFrame, Vector2.new(1, 0.5), UDim2.new(1, -8, 0.5, 0), 33)
				switch.set(element.MobileButtonEnabled, false)
				element._menuSwitch = switch
				local toggleHit = newHit(rowFrame, 34)
				toggleHit.Activated:Connect(function()
					element:SetMobileButton(not element.MobileButtonEnabled)
					switch.set(element.MobileButtonEnabled)
				end)
			end
		end
	end

	-- The 3 dots on a row. They only exist if the element has keybinds or a mobile button.
	local function attachOptions(window, element, row, rightMargin)
		if not (element.HaveKeybinds or element.HaveMB) then return end
		local button = make("TextButton", {
			Name = "Options",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -rightMargin, 0, 20),
			Size = UDim2.fromOffset(26, 26),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Selectable = false,
			ZIndex = 5,
		}, row)
		corner(button, 13)

		local dotsParts = {}
		if hasIcon(window._optionsIcon) then
			dotsParts[1] = makeIcon(button, window._optionsIcon, 16, THEME.subtext, {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				ZIndex = 6,
			})
		else
			for index = 1, 3 do
				local dot = make("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(0.5, (index - 2) * 6, 0.5, 0),
					Size = UDim2.fromOffset(3, 3),
					BackgroundColor3 = THEME.subtext,
					BorderSizePixel = 0,
					ZIndex = 6,
				}, button)
				corner(dot, 2)
				dotsParts[index] = dot
			end
		end

		local function recolor(color)
			for _, part in ipairs(dotsParts) do
				if part:IsA("ImageLabel") then
					tween(part, 0.15, { ImageColor3 = color }, Enum.EasingStyle.Quad)
				else
					tween(part, 0.15, { BackgroundColor3 = color }, Enum.EasingStyle.Quad)
				end
			end
		end
		button.MouseEnter:Connect(function()
			tween(button, 0.15, { BackgroundTransparency = 0.85, BackgroundColor3 = THEME.white }, Enum.EasingStyle.Quad)
			recolor(THEME.text)
		end)
		button.MouseLeave:Connect(function()
			tween(button, 0.2, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
			recolor(THEME.subtext)
		end)
		button.Activated:Connect(function()
			openMenu(window, element, button)
		end)
	end

	local function register(element)
		if element.Flag then
			LayerLib.Flags[element.Flag] = element.Value
			LayerLib.Elements[element.Flag] = element
		end
	end

	-- the key and the mobile button are shared by toggles and buttons
	local function addExtraApi(element)
		function element:SetKeybind(keyCode)
			setKeybind(self, keyCode)
		end
		function element:SetMobileButton(state)
			if state == true then
				spawnMobileButton(self)
			else
				destroyMobileButton(self)
			end
		end
	end

	----------------------------------------------------------------
	-- Global input: keybinds, picking a keybind, dragging
	----------------------------------------------------------------
	local function ensureInput()
		if inputReady then return end
		inputReady = true

		connections[#connections + 1] = UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
			if capturing then
				local callback = capturing
				capturing = nil
				callback(input.KeyCode)
				return
			end
			if UserInputService:GetFocusedTextBox() then return end
			for _, element in ipairs(keybindElements) do
				if element.Keybind == input.KeyCode then element:_trigger() end
			end
		end)

		connections[#connections + 1] = UserInputService.InputChanged:Connect(function(input)
			local state = dragState
			if not state then return end
			if input.UserInputType ~= Enum.UserInputType.MouseMovement and input ~= state.input then return end
			updateDrag(state, input)
		end)

		-- a second way to notice the finger or button going up, in case the first one is missed
		connections[#connections + 1] = UserInputService.InputEnded:Connect(function(input)
			local state = dragState
			if not state then return end
			local sameInput = input == state.input
				or (state.input.UserInputType == Enum.UserInputType.MouseButton1
					and input.UserInputType == Enum.UserInputType.MouseButton1)
			if sameInput then endDrag(state) end
		end)

		-- keep windows and popups on the screen if the screen changes size
		connections[#connections + 1] = RunService.RenderStepped:Connect(function()
			for _, list in ipairs({ LayerLib.Windows, popupList }) do
				for _, item in ipairs(list) do
					local clamped = clampWindow(item, item._position)
					if clamped ~= item._position then
						item._position = clamped
						item.root.Position = UDim2.fromOffset(math.floor(clamped.X), math.floor(clamped.Y))
					end
				end
			end
		end)
	end

	----------------------------------------------------------------
	-- Window
	----------------------------------------------------------------
	local Tab = {}
	Tab.__index = Tab

	function LayerLib:CreateWindow(config)
		config = config or {}
		local gui = getGui()
		ensureInput()

		local WIDTH = config.width or 300
		local TOP_H, TAB_H = 42, 36
		local CONTENT_H = config.contentHeight or 250
		local FULL_H = TOP_H + TAB_H + CONTENT_H
		local RADIUS = 10

		local window = {
			Tabs = {},
			_width = WIDTH,
			_height = FULL_H,
			_minimized = false,
			_optionsIcon = config.TBOptionsIcon,
			_selected = nil,
		}
		local v = viewport()
		window._position = clampWindow(window, Vector2.new(math.floor((v.X - WIDTH) / 2), math.floor(v.Y * 0.18)))

		local root = make("Frame", {
			Name = "Window",
			Position = UDim2.fromOffset(window._position.X, window._position.Y),
			Size = UDim2.fromOffset(WIDTH, FULL_H),
			BackgroundColor3 = THEME.window,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			ZIndex = 1,
		}, gui)
		corner(root, RADIUS)
		outline(root)
		local rootScale = make("UIScale", { Scale = 0.9 }, root)
		tween(rootScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
		window.root = root

		-- top bar: icon + title on the left, minimize on the right.
		-- It has the same rounded corners as the window; the flat strip at its bottom squares
		-- the lower corners while the window is open and fades out when it is minimized.
		local topbar = make("Frame", {
			Name = "TopBar",
			Size = UDim2.new(1, 0, 0, TOP_H),
			BackgroundColor3 = THEME.topbar,
			BorderSizePixel = 0,
			ZIndex = 5,
		}, root)
		corner(topbar, RADIUS)
		local topbarFlat = make("Frame", {
			Name = "Flat",
			Position = UDim2.new(0, 0, 1, -RADIUS),
			Size = UDim2.new(1, 0, 0, RADIUS),
			BackgroundColor3 = THEME.topbar,
			BorderSizePixel = 0,
			ZIndex = 5,
		}, topbar)

		local titleX = 14
		if hasIcon(config.icon) then
			makeIcon(topbar, config.icon, 20, THEME.text, {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 12, 0.5, 0),
				ZIndex = 6,
			})
			titleX = 12 + 20 + 8
		end
		make("TextLabel", {
			Name = "Title",
			Position = UDim2.fromOffset(titleX, 0),
			Size = UDim2.new(1, -(titleX + 46), 1, 0),
			BackgroundTransparency = 1,
			Text = config.title or "Window",
			TextColor3 = THEME.text,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Font = Enum.Font.GothamBold,
			ZIndex = 6,
		}, topbar)

		local minimize = make("TextButton", {
			Name = "Minimize",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.fromOffset(28, 28),
			BackgroundColor3 = THEME.white,
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Selectable = false,
			ZIndex = 6,
		}, topbar)
		corner(minimize, 8)
		local minimizeScale = make("UIScale", { Scale = 1 }, minimize)
		attachPress(minimize, minimizeScale, 0.85)
		local minimizeParts = {}
		if hasIcon(config.CloseIcon) then
			minimizeParts[1] = makeIcon(minimize, config.CloseIcon, 16, THEME.subtext, {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				ZIndex = 7,
			})
		else
			local dash = make("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(12, 2),
				BackgroundColor3 = THEME.subtext,
				BorderSizePixel = 0,
				ZIndex = 7,
			}, minimize)
			corner(dash, 1)
			minimizeParts[1] = dash
		end
		minimize.MouseEnter:Connect(function()
			tween(minimize, 0.15, { BackgroundTransparency = 0.88 }, Enum.EasingStyle.Quad)
			for _, part in ipairs(minimizeParts) do
				tween(part, 0.15, part:IsA("ImageLabel") and { ImageColor3 = THEME.text } or { BackgroundColor3 = THEME.text }, Enum.EasingStyle.Quad)
			end
		end)
		minimize.MouseLeave:Connect(function()
			tween(minimize, 0.2, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
			for _, part in ipairs(minimizeParts) do
				tween(part, 0.2, part:IsA("ImageLabel") and { ImageColor3 = THEME.subtext } or { BackgroundColor3 = THEME.subtext }, Enum.EasingStyle.Quad)
			end
		end)

		-- the window is moved by its top bar
		topbar.InputBegan:Connect(function(input)
			if not isPress(input) then return end
			beginDrag({ kind = "window", window = window, input = input, start = p2(input), origin = window._position })
		end)

		-- tabs along the top
		local tabBar = make("Frame", {
			Name = "TabBar",
			Position = UDim2.fromOffset(0, TOP_H),
			Size = UDim2.new(1, 0, 0, TAB_H),
			BackgroundTransparency = 1,
			ZIndex = 2,
		}, root)
		local tabList = make("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 0,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.X,
			ScrollingDirection = Enum.ScrollingDirection.X,
			ZIndex = 2,
		}, tabBar)
		make("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}, tabList)
		make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, tabList)
		make("Frame", {
			Position = UDim2.fromOffset(0, TOP_H + TAB_H - 1),
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundColor3 = THEME.stroke,
			BorderSizePixel = 0,
			ZIndex = 3,
		}, root)

		local content = make("Frame", {
			Name = "Content",
			Position = UDim2.fromOffset(0, TOP_H + TAB_H),
			Size = UDim2.new(1, 0, 0, CONTENT_H),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			ZIndex = 2,
		}, root)

		window._tabList = tabList
		window._content = content

		function window:SetMinimized(state)
			self._minimized = state == true
			self._height = self._minimized and TOP_H or FULL_H
			closeMenu()
			tween(root, 0.4, { Size = UDim2.fromOffset(WIDTH, self._height) }, Enum.EasingStyle.Quint)
			tween(topbarFlat, 0.3, { BackgroundTransparency = self._minimized and 1 or 0 }, Enum.EasingStyle.Quad)
			self._position = clampWindow(self, self._position)
			tween(root, 0.4, { Position = UDim2.fromOffset(self._position.X, self._position.Y) }, Enum.EasingStyle.Quint)
		end
		minimize.Activated:Connect(function()
			window:SetMinimized(not window._minimized)
		end)

		local function selectTab(target)
			if window._selected == target then return end
			local previous = window._selected
			window._selected = target
			for _, tab in ipairs(window.Tabs) do
				local on = tab == target
				tween(tab._button, 0.2, { BackgroundTransparency = on and 0 or 1 }, Enum.EasingStyle.Quad)
				tween(tab._label, 0.2, { TextColor3 = on and THEME.text or THEME.subtext }, Enum.EasingStyle.Quad)
				if tab._icon then
					tween(tab._icon, 0.2, { ImageColor3 = on and THEME.text or THEME.subtext }, Enum.EasingStyle.Quad)
				end
			end
			closeMenu()
			if previous then previous._page.Visible = false end
			target._page.Visible = true
			target._page.Position = UDim2.fromOffset(0, 14)
			tween(target._page, 0.35, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quint)
		end

		function window:CreateTab(tabConfig)
			tabConfig = tabConfig or {}
			local tab = setmetatable({ _window = window, Elements = {} }, Tab)

			local button = make("TextButton", {
				Name = tabConfig.name or "Tab",
				LayoutOrder = #window.Tabs + 1,
				Size = UDim2.fromOffset(0, 26),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = THEME.element,
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				Selectable = false,
				ZIndex = 3,
			}, tabList)
			corner(button, 8)
			make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, button)
			make("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				Padding = UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}, button)
			if hasIcon(tabConfig.icon) then
				tab._icon = makeIcon(button, tabConfig.icon, 14, THEME.subtext, { LayoutOrder = 1, ZIndex = 4 })
			end
			tab._label = make("TextLabel", {
				LayoutOrder = 2,
				Size = UDim2.fromOffset(0, 16),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundTransparency = 1,
				Text = tabConfig.name or "Tab",
				TextColor3 = THEME.subtext,
				TextSize = 13,
				Font = Enum.Font.GothamMedium,
				ZIndex = 4,
			}, button)
			tab._button = button

			local page = make("ScrollingFrame", {
				Name = "Page",
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScrollBarThickness = 3,
				ScrollBarImageColor3 = THEME.stroke,
				CanvasSize = UDim2.new(),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollingDirection = Enum.ScrollingDirection.Y,
				Visible = false,
				ZIndex = 2,
			}, content)
			make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, page)
			make("UIPadding", {
				PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 12),
				PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
			}, page)
			tab._page = page

			button.MouseEnter:Connect(function()
				if window._selected ~= tab then tween(button, 0.15, { BackgroundTransparency = 0.6 }, Enum.EasingStyle.Quad) end
			end)
			button.MouseLeave:Connect(function()
				if window._selected ~= tab then tween(button, 0.2, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad) end
			end)
			button.Activated:Connect(function()
				selectTab(tab)
			end)

			window.Tabs[#window.Tabs + 1] = tab
			if #window.Tabs == 1 then selectTab(tab) end
			return tab
		end

		LayerLib.Windows[#LayerLib.Windows + 1] = window
		return window
	end

