-- LayerLib (basic dark theme, runs in CoreGui)
--
-- The first part is the library body: it only declares what everything is, it doesn't build any UI.
-- The second part (below "TEST") builds a small window to try it out.
-- To use the body from a loadstring, put it in its own file and end it with `return LayerLib`.
--
-- Popup methods (the popup is whatever you stored it in):
--   Popup1:Select("Option 2")   picks an option like a click would
--   Popup1:Reset()              nothing selected
--   Popup1:Save()               remembers the pick under the popup's flag, for the next time it is opened
--   Popup1:Close()              closes it (it never closes on its own)

----------------------------------------------------------------
-- LIBRARY BODY
----------------------------------------------------------------
local LayerLib = (function()
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local TweenService = game:GetService("TweenService")
	local UserInputService = game:GetService("UserInputService")

	local LayerLib = {
		Flags = {},     -- LayerLib.Flags["ToggleFlag"] is the current value of the element with that flag
		Elements = {},  -- LayerLib.Elements["ToggleFlag"] is the element itself
		Windows = {},
	}

	----------------------------------------------------------------
	-- Theme
	----------------------------------------------------------------
	local THEME = {
		window = Color3.fromRGB(22, 22, 26),
		topbar = Color3.fromRGB(30, 30, 35),
		element = Color3.fromRGB(36, 36, 42),
		elementHover = Color3.fromRGB(45, 45, 52),
		stroke = Color3.fromRGB(58, 58, 66),
		text = Color3.fromRGB(236, 236, 241),
		subtext = Color3.fromRGB(150, 150, 163),
		accent = Color3.fromRGB(64, 140, 255),
		toggleOff = Color3.fromRGB(72, 72, 82),
		white = Color3.new(1, 1, 1),
	}
	LayerLib.Theme = THEME

	----------------------------------------------------------------
	-- Helpers
	----------------------------------------------------------------
	local function tween(obj, time, props, style, direction)
		local t = TweenService:Create(
			obj,
			TweenInfo.new(time, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out),
			props
		)
		t:Play()
		return t
	end

	local function make(class, props, parent)
		local inst = Instance.new(class)
		for key, value in pairs(props) do
			inst[key] = value
		end
		inst.Parent = parent
		return inst
	end

	local function corner(parent, radius)
		return make("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
	end

	local function outline(parent, color, transparency)
		return make("UIStroke", {
			Color = color or THEME.stroke,
			Thickness = 1,
			Transparency = transparency or 0,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}, parent)
	end

	local function isPress(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
	end

	local function p2(input)
		return Vector2.new(input.Position.X, input.Position.Y)
	end

	local function hasIcon(id)
		return id ~= nil and id ~= 0 and id ~= "0" and id ~= ""
	end

	local function assetUrl(id)
		if type(id) == "string" and id:find("rbxassetid://", 1, true) then return id end
		return "rbxassetid://" .. tostring(id)
	end

	-- colors can be given as a Color3 or as plain numbers { r, g, b } from 0 to 255
	local function toColor3(value, fallback)
		if typeof(value) == "Color3" then return value end
		if type(value) == "table" and #value >= 3 then
			return Color3.fromRGB(value[1], value[2], value[3])
		end
		return fallback
	end

	-- Runs a callback on its own thread, so an error in it can't break the UI
	local function runCallback(callback, ...)
		if type(callback) ~= "function" then return end
		local args = table.pack(...)
		task.spawn(function()
			local ok, err = pcall(callback, table.unpack(args, 1, args.n))
			if not ok then warn("[LayerLib] " .. tostring(err)) end
		end)
	end

	local CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
	local rng = Random.new()
	local function randomName(length)
		local out = {}
		for i = 1, length do
			local n = rng:NextInteger(1, #CHARS)
			out[i] = CHARS:sub(n, n)
		end
		return table.concat(out)
	end

	-- CoreGui (through the hidden UI container if there is one), PlayerGui only as a last resort
	local function parentGui(gui)
		local targets = {}
		if gethui then
			local ok, container = pcall(gethui)
			if ok and container then targets[#targets + 1] = container end
		end
		local okCore, coreGui = pcall(function() return game:GetService("CoreGui") end)
		if okCore and coreGui then targets[#targets + 1] = coreGui end
		local localPlayer = Players.LocalPlayer
		local playerGui = localPlayer and localPlayer:FindFirstChildOfClass("PlayerGui")
		if playerGui then targets[#targets + 1] = playerGui end

		for _, target in ipairs(targets) do
			local ok = pcall(function() gui.Parent = target end)
			if ok and gui.Parent == target then return end
		end
	end

	-- How many decimals a step like 0.01 has (so the slider shows 0.25, and 1 shows plain whole numbers)
	local function decimalsOf(step)
		local text = string.format("%.8f", step)
		text = text:gsub("0+$", "")
		local decimals = text:match("%.(%d*)$")
		return decimals and #decimals or 0
	end

	----------------------------------------------------------------
	-- Mobile button: the same MB as the Button / Toggle GUI scripts (same look, shapes, drag bar, resize,
	-- saved position in MobileButtons_Positions.json, tag DraggableBoxGui so DestroyAllGuis,
	-- DeleteGuiByFlag and ResetMBPositions work on it)
	----------------------------------------------------------------
	local createMobileButton = (function()
		local CollectionService = game:GetService("CollectionService")
		local HttpService = game:GetService("HttpService")

		local TEXT_SIZE = 18
		local FONT = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.Medium)
		local START_SIZE = Vector2.new(130, 130)
		local MIN_SIZE = Vector2.new(100, 100)
		local MAX_SIZE = Vector2.new(520, 520)
		local SPAWN = Vector2.new(0.5, 0.5)
		local CORNER = 0.27
		local MAX_CORNER = 40
		local BG_COLOR = Color3.fromRGB(18, 18, 18)
		local BG_TRANSPARENCY = 0.09
		local GLOW_ASSET = "rbxassetid://138843696730147"
		local GLOW_COLOR = Color3.new(1, 1, 1)
		local GLOW_SPREAD = 70
		local GLOW_BRIGHTNESS = 0.50
		local GLOW_SLICE = 0.4
		local SCREEN_MARGIN = 6
		local TEXT_NUDGE_Y = 0
		local BAR_DISTANCE = 5
		local DRAG_FOLLOW_SPEED = 9
		local RESIZE_FOLLOW_SPEED = 26
		local PILL_HEIGHT = MIN_SIZE.Y                 -- how tall the pill shape is
		local PILL_TEXT_NUDGE_Y = 0                    -- text height in the pill shape
		local CIRCLE_TEXT_NUDGE_Y = TEXT_NUDGE_Y       -- text height in the circle shape
		local MORPH_FOLLOW_SPEED = 10                  -- lower = slower, smoother shape changes
		local SAVE_POSITION = true                     -- remember where you left each button (by its FLAG)
		local SAVE_FILE = "MobileButtons_Positions.json" -- must match ResetMBPositions
		local MODE_NAMES = { default = "Square", pill = "Pill", circle = "Circle" } -- shown when the shape changes
		local MODE_TEXT_TIME = 1                       -- seconds the shape name stays before fading back to the title

		local TAG = "DraggableBoxGui" -- must match DestroyAllGuis
		local player = Players.LocalPlayer
		local playerGui = player:WaitForChild("PlayerGui")

		local WHITE = Color3.new(1, 1, 1)
		local BG_HOVER = BG_COLOR:Lerp(WHITE, 0.06)
		local BG_ON = BG_COLOR:Lerp(WHITE, 0.12)
		local STROKE_IDLE = 0.9
		local BAR_IDLE = 0.55
		local ICON_IDLE = 0.45
		local TEXT_TRANSPARENCY = 0.05

		-- Drag bar sits outside, below the box
		local BAR_SIZE = UDim2.fromOffset(51, 3)
		local BAR_SIZE_ACTIVE = UDim2.fromOffset(61, 4)
		local BAR_HIT = Vector2.new(72, 22)
		local BAR_BELOW = BAR_DISTANCE + BAR_HIT.Y / 2 -- how far the bar area reaches below the box

		-- Pill shape: a vertical resize bar inside the body (resizes the length only)
		local PILL_BAR_SIZE = UDim2.fromOffset(3, 36)
		local PILL_BAR_SIZE_ACTIVE = UDim2.fromOffset(4, 46)
		local PILL_HIT = Vector2.new(30, 60)

		-- Cycle button (top-left): a circle with two arrows, cycles the shape (default > pill > circle)
		local CYCLE_BOX = 26
		local CYCLE_R = 7
		local CYCLE_THICK = 2
		local CYCLE_HIT = 34
		local CYCLE_IDLE = 0.55
		local CORNER_SPEED = 14 -- how fast the corners ease between shapes

		-- Resize icon: a hollow quarter circle with rounded ends
		local ICON_R = 15          -- radius of the quarter circle
		local ICON_THICK = 2.5     -- line thickness
		local ICON_INSET = 12      -- distance from the box edges
		local ICON_BOX = math.ceil(ICON_R + ICON_THICK)

		-- Flag rules: no spaces and none of these characters
		local FLAG_FORBIDDEN = [===['";*()^%$+×÷=/€£¥₩`~\|<>{}[]▪︎○●□■♤♡◇♧☆⊙°•¤《》¡¿,.]===]

		local function flagProblem(flag)
			if type(flag) ~= "string" or flag == "" then
				return "the flag is empty"
			end
			if flag:find("%s") then
				return "the flag contains a space"
			end
			local banned = { [160] = true, [0x200B] = true, [0x3000] = true }
			for _, cp in utf8.codes(FLAG_FORBIDDEN) do
				banned[cp] = true
			end
			for _, cp in utf8.codes(flag) do
				if banned[cp] then
					return 'the flag contains a character that is not allowed: "' .. utf8.char(cp) .. '"'
				end
			end
			return nil
		end

		-- Turns any text into a valid flag: spaces and the forbidden characters are dropped
		local function cleanFlag(raw)
			local banned = { [160] = true, [0x200B] = true, [0x3000] = true }
			pcall(function()
				for _, cp in utf8.codes(FLAG_FORBIDDEN) do banned[cp] = true end
			end)
			local out = {}
			local ok = pcall(function()
				for _, cp in utf8.codes(tostring(raw)) do
					local ch = utf8.char(cp)
					if not banned[cp] and not ch:find("%s") then out[#out + 1] = ch end
				end
			end)
			local text = table.concat(out)
			if not ok or text == "" then return "MB" end
			return text
		end

		-- Every GUI made by these scripts, wherever it lives
		local function collectGuis()
			local list, seen = {}, {}
			local function add(inst)
				if inst:IsA("ScreenGui") and not seen[inst] then
					seen[inst] = true
					list[#list + 1] = inst
				end
			end
			for _, inst in ipairs(CollectionService:GetTagged(TAG)) do add(inst) end

			local function scan(container)
				if not container then return end
				local ok, children = pcall(function() return container:GetChildren() end)
				if not ok then return end
				for _, child in ipairs(children) do
					if child:IsA("ScreenGui") and child:GetAttribute(TAG) then add(child) end
				end
			end
			scan(playerGui)
			pcall(function() scan(game:GetService("CoreGui")) end)
			if gethui then pcall(function() scan(gethui()) end) end
			return list
		end


		-- Saved positions: kept in a file by FLAG, so they survive between sessions
		local canUseFiles = type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
		local memoryStore = _G
		pcall(function()
			if getgenv then memoryStore = getgenv() end
		end)

		local function loadAllPositions()
			if canUseFiles then
				local ok, result = pcall(function()
					if not isfile(SAVE_FILE) then return {} end
					local data = HttpService:JSONDecode(readfile(SAVE_FILE))
					if type(data) == "table" and type(data.positions) == "table" then
						return data.positions
					end
					return {}
				end)
				if ok and type(result) == "table" then return result end
				return {}
			end
			return memoryStore.MobileButtonPositions or {} -- no file access here: remembered until the game closes
		end

		local function saveAllPositions(positions)
			if canUseFiles then
				pcall(function()
					writefile(SAVE_FILE, HttpService:JSONEncode({ version = 1, positions = positions }))
				end)
			else
				memoryStore.MobileButtonPositions = positions
			end
		end

		-- Random 20-character name, different for every GUI
		local CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789*^%/?#$"
		local rng = Random.new()

		local function randomName(length)
			local out = {}
			for i = 1, length do
				local n = rng:NextInteger(1, #CHARS)
				out[i] = CHARS:sub(n, n)
			end
			return table.concat(out)
		end

		local function tween(obj, time, props, style, direction)
			local t = TweenService:Create(
				obj,
				TweenInfo.new(time, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out),
				props
			)
			t:Play()
			return t
		end

		local function make(class, props, parent)
			local inst = Instance.new(class)
			for key, value in pairs(props) do
				inst[key] = value
			end
			inst.Parent = parent
			return inst
		end

		local function isPress(input)
			return input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
		end

		local function p2(input)
			return Vector2.new(input.Position.X, input.Position.Y)
		end

		local function run(fn)
			task.spawn(function()
				local ok, err = pcall(fn)
				if not ok then warn(err) end
			end)
		end

		-- Highest place available: hidden UI container > CoreGui > PlayerGui
		local function parentGui(gui)
			local targets = {}
			if gethui then
				local ok, container = pcall(gethui)
				if ok and container then targets[#targets + 1] = container end
			end
			local okCore, coreGui = pcall(function() return game:GetService("CoreGui") end)
			if okCore and coreGui then targets[#targets + 1] = coreGui end
			targets[#targets + 1] = playerGui

			for _, target in ipairs(targets) do
				local ok = pcall(function() gui.Parent = target end)
				if ok and gui.Parent == target then return end
			end
		end

		local function create(opts)
			local TEXT = tostring(opts.text or "Button")
			local kind = opts.kind == "Toggle" and "Toggle" or "Button"
			local FLAG = cleanFlag(opts.flag or TEXT)

			-- One GUI per flag: making it again with the same flag replaces the old one
			for _, old in ipairs(collectGuis()) do
				if old:GetAttribute("Flag") == FLAG then
					old:Destroy()
				end
			end

			local screenGui = make("ScreenGui", {
				Name = randomName(20),
				ResetOnSpawn = false,
				IgnoreGuiInset = true,
				DisplayOrder = 2147483647, -- above every other GUI
				OnTopOfCoreBlur = true,
				ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
			}, nil)
			screenGui:SetAttribute(TAG, kind)
			screenGui:SetAttribute("Flag", FLAG)
			CollectionService:AddTag(screenGui, TAG)
			parentGui(screenGui)

			local function viewport()
				local size = screenGui.AbsoluteSize
				if size.X < 1 or size.Y < 1 then
					size = workspace.CurrentCamera.ViewportSize
				end
				return size
			end

			-- Off-screen protection (the drag bar below the box is counted too)
			local function fitSize(size)
				local v = viewport()
				return Vector2.new(
					math.min(size.X, v.X - SCREEN_MARGIN * 2),
					math.min(size.Y, v.Y - SCREEN_MARGIN * 2 - BAR_BELOW)
				)
			end

			local function clampCenter(center, size)
				local v = viewport()
				local half = size / 2
				local minX, minY = half.X + SCREEN_MARGIN, half.Y + SCREEN_MARGIN
				local maxX = v.X - half.X - SCREEN_MARGIN
				local maxY = v.Y - half.Y - SCREEN_MARGIN - BAR_BELOW
				return Vector2.new(
					math.clamp(center.X, minX, math.max(minX, maxX)),
					math.clamp(center.Y, minY, math.max(minY, maxY))
				)
			end

			-- Corner roundness: the default shape scales with the box (never past MAX_CORNER pixels),
			-- the pill and circle shapes are fully round
			local function cornerFor(size, forMode)
				if forMode == "pill" or forMode == "circle" then
					return math.floor(math.min(size.X, size.Y) / 2 + 0.5)
				end
				return math.floor(math.min(CORNER * math.min(size.X, size.Y), MAX_CORNER) + 0.5)
			end

			-- Both versions use the same size and the same SPAWN point, so they appear in the exact same spot
			local startSize = fitSize(START_SIZE)
			local v0 = viewport()
			local defaultCenter = clampCenter(Vector2.new(v0.X * SPAWN.X + (opts.offset or 0), v0.Y * SPAWN.Y + (opts.offset or 0)), startSize) -- the starting point
			local startCenter = defaultCenter
			if SAVE_POSITION then
				local saved = loadAllPositions()[FLAG]
				if type(saved) == "table" and type(saved.x) == "number" and type(saved.y) == "number" then
					startCenter = clampCenter(Vector2.new(v0.X * saved.x, v0.Y * saved.y), startSize)
				end
			end

			-- Holder: the thing that moves and resizes. Everything lives inside it.
			local holder = make("Frame", {
				Name = "Holder",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(startCenter.X, startCenter.Y),
				Size = UDim2.fromOffset(startSize.X, startSize.Y),
				BackgroundTransparency = 1,
			}, screenGui)

			local popScale = make("UIScale", { Name = "PopScale", Scale = 0.7 }, holder)

			-- Glow: soft image behind the box
			local glow = make("ImageLabel", {
				Name = "Glow",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.new(1, GLOW_SPREAD * 2, 1, GLOW_SPREAD * 2),
				BackgroundTransparency = 1,
				Image = GLOW_ASSET,
				ImageColor3 = GLOW_COLOR,
				ImageTransparency = 1,
				ScaleType = Enum.ScaleType.Stretch,
				ZIndex = 1,
			}, holder)

			-- 9-slice the glow using the image's real size: the corners and soft edges stay a
			-- constant size and only the middle stretches, so resizing never distorts it.
			task.spawn(function()
				local deadline = os.clock() + 5
				while glow.Parent and os.clock() < deadline do
					local ok, size = pcall(function() return glow.ContentImageSize end)
					if not ok then return end -- older client: keep the plain stretch
					if size.X > 0 and size.Y > 0 then
						local sx, sy = size.X * GLOW_SLICE, size.Y * GLOW_SLICE
						glow.SliceCenter = Rect.new(sx, sy, size.X - sx, size.Y - sy)
						glow.SliceScale = math.max(GLOW_SPREAD, 1) / sx
						glow.ScaleType = Enum.ScaleType.Slice
						return
					end
					task.wait(0.05)
				end
			end)

			-- strength: 0 = off, 1 = full flash
			local function setGlow(strength, time, style)
				tween(glow, time, { ImageTransparency = 1 - GLOW_BRIGHTNESS * strength }, style)
			end

			-- Box
			local box = make("Frame", {
				Name = "Box",
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = BG_COLOR,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = 2,
			}, holder)
			local boxCorner = make("UICorner", { CornerRadius = UDim.new(0, cornerFor(startSize)) }, box)
			local stroke = make("UIStroke", {
				Color = WHITE,
				Transparency = 1,
				Thickness = 1,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			}, box)

			-- Clickable body
			local body = make("TextButton", {
				Name = "Body",
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				Selectable = false,
				ZIndex = 1,
			}, box)

			-- Text: fixed size, dead center of the box
			local label = make("TextLabel", {
				Name = "Label",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, 0, 0.5, TEXT_NUDGE_Y),
				Size = UDim2.new(1, -28, 1, -28),
				BackgroundTransparency = 1,
				Text = TEXT,
				TextColor3 = WHITE,
				TextTransparency = 1,
				TextSize = TEXT_SIZE,
				TextScaled = false,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Center,
				FontFace = FONT,
				ZIndex = 2,
			}, box)

			-- Drag bar: outside the box, just below it (fixed pixel size)
			local dragHit = make("TextButton", {
				Name = "DragHit",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, 0, 1, BAR_DISTANCE),
				Size = UDim2.fromOffset(BAR_HIT.X, BAR_HIT.Y),
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				Selectable = false,
				ZIndex = 5,
			}, box)
			local bar = make("Frame", {
				Name = "Bar",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = BAR_SIZE,
				BackgroundColor3 = WHITE,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = 5,
			}, dragHit)
			make("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)

			-- Resize handle in the bottom-right corner (invisible hit area + the arc icon)
			local handle = make("TextButton", {
				Name = "ResizeHandle",
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, 0, 1, 0),
				Size = UDim2.fromOffset(34, 34),
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				Selectable = false,
				ZIndex = 5,
			}, box)

			-- The icon is a quarter circle drawn with round dots, so both ends are rounded.
			-- It sits in a CanvasGroup so the overlapping dots fade as one clean shape.
			local iconGroup = make("CanvasGroup", {
				Name = "Icon",
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -ICON_INSET, 1, -ICON_INSET),
				Size = UDim2.fromOffset(ICON_BOX, ICON_BOX),
				BackgroundTransparency = 1,
				GroupTransparency = 1,
				ZIndex = 5,
			}, handle)
			do
				local half = ICON_THICK / 2
				local steps = math.max(8, math.ceil((math.pi / 2 * ICON_R) / (ICON_THICK / 3)))
				for i = 0, steps do
					local angle = (math.pi / 2) * (i / steps)
					local dot = make("Frame", {
						Name = "Dot",
						AnchorPoint = Vector2.new(0.5, 0.5),
						Position = UDim2.fromOffset(half + ICON_R * math.cos(angle), half + ICON_R * math.sin(angle)),
						Size = UDim2.fromOffset(ICON_THICK, ICON_THICK),
						BackgroundColor3 = WHITE,
						BorderSizePixel = 0,
						ZIndex = 5,
					}, iconGroup)
					make("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
				end
			end

			-- Pill shape: a vertical bar inside the body at the right end (resizes the length only)
			local pillHandle = make("TextButton", {
				Name = "PillHandle",
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -6, 0.5, 0),
				Size = UDim2.fromOffset(PILL_HIT.X, PILL_HIT.Y),
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				Selectable = false,
				Interactable = false,
				ZIndex = 5,
			}, box)
			local pillBar = make("Frame", {
				Name = "PillBar",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = PILL_BAR_SIZE,
				BackgroundColor3 = WHITE,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = 5,
			}, pillHandle)
			make("UICorner", { CornerRadius = UDim.new(1, 0) }, pillBar)

			-- Cycle button (top-left): a circle with two arrows. Tapping it cycles the shape
			-- default > pill > circle, and the icon spins every time it switches
			local collapseHit = make("TextButton", {
				Name = "CycleHit",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0, 21, 0, 21),
				Size = UDim2.fromOffset(CYCLE_HIT, CYCLE_HIT),
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				Selectable = false,
				ZIndex = 5,
			}, box)
			local cycleIcon = make("CanvasGroup", {
				Name = "CycleIcon",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(CYCLE_BOX, CYCLE_BOX),
				BackgroundTransparency = 1,
				GroupTransparency = 1,
				ZIndex = 5,
			}, collapseHit)
			do
				local center = CYCLE_BOX / 2
				local wing = 5              -- length of each arrow-head line
				local sweep = math.rad(120) -- how much of the circle each arrow covers
				local steps = math.max(8, math.ceil((CYCLE_R * sweep) / (CYCLE_THICK / 3)))

				local function roundPart(position, size, rotation)
					local part = make("Frame", {
						AnchorPoint = Vector2.new(0.5, 0.5),
						Position = UDim2.fromOffset(position.X, position.Y),
						Size = UDim2.fromOffset(size.X, size.Y),
						Rotation = rotation,
						BackgroundColor3 = WHITE,
						BorderSizePixel = 0,
						ZIndex = 5,
					}, cycleIcon)
					make("UICorner", { CornerRadius = UDim.new(1, 0) }, part)
				end

				for _, startAngle in ipairs({ 0, math.pi }) do
					-- the arc, drawn with round dots
					for i = 0, steps do
						local angle = startAngle + sweep * (i / steps)
						roundPart(
							Vector2.new(center + CYCLE_R * math.cos(angle), center + CYCLE_R * math.sin(angle)),
							Vector2.new(CYCLE_THICK, CYCLE_THICK),
							0
						)
					end

					-- the arrow head at the end of the arc (two short lines meeting at the tip)
					local endAngle = startAngle + sweep
					local tip = Vector2.new(center + CYCLE_R * math.cos(endAngle), center + CYCLE_R * math.sin(endAngle))
					local back = Vector2.new(math.sin(endAngle), -math.cos(endAngle)) -- back along the arc
					for _, spread in ipairs({ math.rad(40), -math.rad(40) }) do
						local cosS, sinS = math.cos(spread), math.sin(spread)
						local dir = Vector2.new(back.X * cosS - back.Y * sinS, back.X * sinS + back.Y * cosS)
						roundPart(tip + dir * (wing / 2), Vector2.new(wing, CYCLE_THICK), math.deg(math.atan2(dir.Y, dir.X)))
					end
				end
			end

			----------------------------------------------------------------
			-- Smooth move + resize + shapes
			----------------------------------------------------------------
			local connections = {}

			local mode = "default" -- "default", "pill" or "circle"
			local dragging, resizing = false, false
			local activeInput, inputStart
			local dragOrigin, resizeOriginSize, resizeTopLeft

			-- Size limits for the pill and circle shapes
			local pillMinWidth = math.max(MIN_SIZE.X, PILL_HEIGHT * 1.25)
			local circleMin = math.max(MIN_SIZE.X, MIN_SIZE.Y)
			local circleMax = math.min(MAX_SIZE.X, MAX_SIZE.Y)

			local sizeTarget = startSize
			local posTarget = startCenter
			local sizeCur, posCur = startSize, startCenter
			local cornerCur = cornerFor(startSize, "default")
			local lastCorner = -1
			local lastInset = -1
			local morphUntil = 0

			-- Each shape remembers its own size, so switching back and forth feels natural
			local circleStart = math.clamp((startSize.X + startSize.Y) / 2, circleMin, circleMax)
			local modeSizes = {
				default = startSize,
				pill = Vector2.new(math.clamp(startSize.X, pillMinWidth, MAX_SIZE.X), PILL_HEIGHT),
				circle = Vector2.new(circleStart, circleStart),
			}

			connections[#connections + 1] = RunService.RenderStepped:Connect(function(dt)
				-- off-screen protection every frame (and the shape rules)
				sizeTarget = fitSize(sizeTarget)
				if mode == "circle" then
					local side = math.min(sizeTarget.X, sizeTarget.Y)
					sizeTarget = Vector2.new(side, side)
				elseif mode == "pill" then
					sizeTarget = Vector2.new(sizeTarget.X, math.min(sizeTarget.Y, PILL_HEIGHT))
				end
				posTarget = clampCenter(posTarget, sizeTarget)

				-- slower follow while dragging = the box trails behind the bar, shape changes ease in gently
				local speed = DRAG_FOLLOW_SPEED
				if resizing then
					speed = RESIZE_FOLLOW_SPEED
				elseif os.clock() < morphUntil then
					speed = MORPH_FOLLOW_SPEED
				end
				local alpha = 1 - math.exp(-dt * speed)
				sizeCur = fitSize(sizeCur:Lerp(sizeTarget, alpha))
				posCur = clampCenter(posCur:Lerp(posTarget, alpha), sizeCur)

				holder.Size = UDim2.fromOffset(math.floor(sizeCur.X + 0.5), math.floor(sizeCur.Y + 0.5))
				holder.Position = UDim2.fromOffset(math.floor(posCur.X + 0.5), math.floor(posCur.Y + 0.5))

				-- the corners ease toward the roundness of the current shape
				cornerCur += (cornerFor(sizeCur, mode) - cornerCur) * (1 - math.exp(-dt * CORNER_SPEED))
				local corner = math.floor(cornerCur + 0.5)
				if corner ~= lastCorner then
					lastCorner = corner
					boxCorner.CornerRadius = UDim.new(0, corner)
				end

				-- the corner icons follow the rounded edge, so they always stay inside the shape
				local inset = math.max(ICON_INSET, 0.293 * cornerCur + 1)
				if math.abs(inset - lastInset) > 0.05 then
					lastInset = inset
					local extra = inset - ICON_INSET
					handle.Position = UDim2.new(1, -extra, 1, -extra)
					local c = inset + 9
					collapseHit.Position = UDim2.new(0, c, 0, c)
				end
			end)

			-- Save where this button is (by its FLAG)
			local function savePosition()
				if not SAVE_POSITION then return end
				local v = viewport()
				local all = loadAllPositions()
				all[FLAG] = { x = posTarget.X / v.X, y = posTarget.Y / v.Y }
				saveAllPositions(all)
			end

			-- ResetMBPositions sends every button back to its starting point
			screenGui:GetAttributeChangedSignal("ResetPosition"):Connect(function()
				posTarget = clampCenter(defaultCenter, sizeTarget)
			end)

			-- Drag: only while holding the bar
			dragHit.InputBegan:Connect(function(input)
				if not isPress(input) or dragging or resizing then return end
				dragging = true
				activeInput = input
				inputStart = p2(input)
				dragOrigin = posTarget
				tween(bar, 0.2, { BackgroundTransparency = 0.15, Size = BAR_SIZE_ACTIVE })
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
						tween(bar, 0.3, { BackgroundTransparency = BAR_IDLE, Size = BAR_SIZE })
						savePosition()
					end
				end)
			end)
			dragHit.MouseEnter:Connect(function()
				if not dragging then tween(bar, 0.2, { BackgroundTransparency = 0.3 }) end
			end)
			dragHit.MouseLeave:Connect(function()
				if not dragging then tween(bar, 0.25, { BackgroundTransparency = BAR_IDLE }) end
			end)

			-- Resize (default and circle shapes): only while holding the corner handle
			handle.InputBegan:Connect(function(input)
				if not isPress(input) or dragging or resizing or mode == "pill" then return end
				resizing = true
				activeInput = input
				inputStart = p2(input)
				resizeOriginSize = sizeTarget
				resizeTopLeft = posTarget - sizeTarget / 2
				tween(iconGroup, 0.2, { GroupTransparency = 0.05 })
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						resizing = false
						if mode ~= "pill" then tween(iconGroup, 0.3, { GroupTransparency = ICON_IDLE }) end
					end
				end)
			end)
			handle.MouseEnter:Connect(function()
				if not resizing and mode ~= "pill" then tween(iconGroup, 0.2, { GroupTransparency = 0.2 }) end
			end)
			handle.MouseLeave:Connect(function()
				if not resizing and mode ~= "pill" then tween(iconGroup, 0.25, { GroupTransparency = ICON_IDLE }) end
			end)

			-- Resize (pill shape): only the length, by holding the vertical bar
			pillHandle.InputBegan:Connect(function(input)
				if not isPress(input) or dragging or resizing or mode ~= "pill" then return end
				resizing = true
				activeInput = input
				inputStart = p2(input)
				resizeOriginSize = sizeTarget
				resizeTopLeft = posTarget - sizeTarget / 2
				tween(pillBar, 0.2, { BackgroundTransparency = 0.15, Size = PILL_BAR_SIZE_ACTIVE })
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						resizing = false
						if mode == "pill" then tween(pillBar, 0.3, { BackgroundTransparency = BAR_IDLE, Size = PILL_BAR_SIZE }) end
					end
				end)
			end)
			pillHandle.MouseEnter:Connect(function()
				if not resizing and mode == "pill" then tween(pillBar, 0.2, { BackgroundTransparency = 0.3 }) end
			end)
			pillHandle.MouseLeave:Connect(function()
				if not resizing and mode == "pill" then tween(pillBar, 0.25, { BackgroundTransparency = BAR_IDLE }) end
			end)

			connections[#connections + 1] = UserInputService.InputChanged:Connect(function(input)
				if not (dragging or resizing) then return end
				if input.UserInputType ~= Enum.UserInputType.MouseMovement and input ~= activeInput then return end

				local delta = p2(input) - inputStart
				if dragging then
					posTarget = clampCenter(dragOrigin + delta, sizeTarget)
				else
					local v = viewport()
					local newSize
					if mode == "pill" then
						-- only the length changes, the height stays locked
						newSize = Vector2.new(math.clamp(resizeOriginSize.X + delta.X, pillMinWidth, MAX_SIZE.X), PILL_HEIGHT)
					elseif mode == "circle" then
						-- x and y always stay the same size
						local side = math.clamp(resizeOriginSize.X + (delta.X + delta.Y) / 2, circleMin, circleMax)
						newSize = Vector2.new(side, side)
					else
						newSize = Vector2.new(
							math.clamp(resizeOriginSize.X + delta.X, MIN_SIZE.X, MAX_SIZE.X),
							math.clamp(resizeOriginSize.Y + delta.Y, MIN_SIZE.Y, MAX_SIZE.Y)
						)
					end
					-- never grow past the edge of the screen
					newSize = Vector2.new(
						math.min(newSize.X, v.X - SCREEN_MARGIN - resizeTopLeft.X),
						math.min(newSize.Y, v.Y - SCREEN_MARGIN - BAR_BELOW - resizeTopLeft.Y)
					)
					if mode == "circle" then
						local side = math.min(newSize.X, newSize.Y)
						newSize = Vector2.new(side, side)
					end
					sizeTarget = newSize
					posTarget = resizeTopLeft + newSize / 2 -- top-left corner stays put
				end
			end)

			-- Shape name: sits on top of the title and shows for a moment when the shape changes
			local modeLabel = make("TextLabel", {
				Name = "ModeLabel",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = label.Position,
				Size = label.Size,
				BackgroundTransparency = 1,
				Text = "",
				TextColor3 = WHITE,
				TextTransparency = 1,
				TextSize = TEXT_SIZE,
				TextScaled = false,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Center,
				FontFace = FONT,
				ZIndex = 2,
			}, box)

			local flashToken = 0
			local function flashModeName(name)
				flashToken += 1
				local token = flashToken
				modeLabel.Text = name

				-- quick crossfade: the title fades out while the shape name fades in
				tween(label, 0.2, { TextTransparency = 1 }, Enum.EasingStyle.Quad)
				tween(modeLabel, 0.2, { TextTransparency = TEXT_TRANSPARENCY }, Enum.EasingStyle.Quad)

				-- after a moment it fades out into the normal title
				task.delay(0.2 + MODE_TEXT_TIME, function()
					if token ~= flashToken or not screenGui.Parent then return end
					tween(modeLabel, 0.4, { TextTransparency = 1 }, Enum.EasingStyle.Sine)
					tween(label, 0.4, { TextTransparency = TEXT_TRANSPARENCY }, Enum.EasingStyle.Sine)
				end)
			end

			-- Shapes: the cycle button goes default > pill > circle > default
			local MODES = { "default", "pill", "circle" }

			local function setMode(newMode)
				if newMode == mode or dragging or resizing then return end
				modeSizes[mode] = sizeTarget -- remember the shape we're leaving
				mode = newMode
				sizeTarget = fitSize(modeSizes[newMode])
				morphUntil = os.clock() + 0.8

				-- the old resize icon fades out, the new one fades in
				local isPill = newMode == "pill"
				handle.Interactable = not isPill
				pillHandle.Interactable = isPill
				tween(iconGroup, 0.35, { GroupTransparency = isPill and 1 or ICON_IDLE }, Enum.EasingStyle.Quad)
				tween(pillBar, 0.4, { BackgroundTransparency = isPill and BAR_IDLE or 1 }, Enum.EasingStyle.Quad)

				-- the text glides to the right height for the new shape
				local nudge = TEXT_NUDGE_Y
				if isPill then nudge = PILL_TEXT_NUDGE_Y elseif newMode == "circle" then nudge = CIRCLE_TEXT_NUDGE_Y end
				local textPosition = UDim2.new(0.5, 0, 0.5, nudge)
				tween(label, 0.45, { Position = textPosition })
				tween(modeLabel, 0.45, { Position = textPosition })

				flashModeName(MODE_NAMES[newMode] or newMode)
			end

			local spin = 0
			collapseHit.Activated:Connect(function()
				local before = mode
				setMode(MODES[(table.find(MODES, mode) or 1) % #MODES + 1])
				if mode == before then return end -- it didn't switch (busy dragging or resizing)

				-- spin once, smoothly, every time the shape switches
				spin += 360
				tween(cycleIcon, 0.7, { Rotation = spin }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
			end)
			collapseHit.MouseEnter:Connect(function()
				tween(cycleIcon, 0.2, { GroupTransparency = 0.2 })
			end)
			collapseHit.MouseLeave:Connect(function()
				tween(cycleIcon, 0.25, { GroupTransparency = CYCLE_IDLE })
			end)

			----------------------------------------------------------------
			-- Click: a toggle keeps a steady on/off state, a button flashes
			----------------------------------------------------------------
			local isOn = opts.initial == true and kind == "Toggle"
			local stateToken = 0
			local glowToken = 0

			local function setState(on)
				isOn = on
				stateToken += 1
				local token = stateToken

				tween(box, 0.25, { BackgroundColor3 = on and BG_ON or BG_COLOR })
				tween(stroke, 0.25, { Transparency = on and 0.3 or STROKE_IDLE, Thickness = on and 2 or 1 })

				if on then
					-- bright flash, then settle into a steady glow
					setGlow(1, 0.08, Enum.EasingStyle.Quad)
					task.delay(0.1, function()
						if token ~= stateToken or not screenGui.Parent then return end
						setGlow(0.55, 0.3, Enum.EasingStyle.Sine)
					end)
				else
					setGlow(0, 0.25, Enum.EasingStyle.Sine)
				end
			end

			local function pulse()
				glowToken += 1
				local token = glowToken
				setGlow(1, 0.08, Enum.EasingStyle.Quad)
				tween(stroke, 0.08, { Transparency = 0.1, Thickness = 2 }, Enum.EasingStyle.Quad)

				task.delay(0.12, function()
					if token ~= glowToken or not screenGui.Parent then return end
					setGlow(0, 0.35, Enum.EasingStyle.Sine)
					tween(stroke, 0.35, { Transparency = STROKE_IDLE, Thickness = 1 }, Enum.EasingStyle.Sine)
				end)
			end

			body.InputBegan:Connect(function(input)
				if isPress(input) then tween(popScale, 0.12, { Scale = 0.96 }) end
			end)
			body.InputEnded:Connect(function(input)
				if isPress(input) then tween(popScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back) end
			end)
			body.MouseEnter:Connect(function()
				tween(box, 0.25, { BackgroundColor3 = isOn and BG_ON:Lerp(WHITE, 0.06) or BG_HOVER })
			end)
			body.MouseLeave:Connect(function()
				tween(box, 0.3, { BackgroundColor3 = isOn and BG_ON or BG_COLOR })
				tween(popScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
			end)

			body.Activated:Connect(function()
				if kind == "Toggle" then
					local nextState = not isOn
					setState(nextState)
					if opts.onToggle then run(function() opts.onToggle(nextState) end) end
				else
					pulse()
					if opts.onClick then run(opts.onClick) end
				end
			end)

			-- what the library uses to drive this button
			local api = {}
			function api.SetState(on)
				if kind ~= "Toggle" or on == isOn then return end
				setState(on)
			end
			function api.Pulse()
				if kind == "Button" then pulse() end
			end
			function api.Destroy()
				if screenGui.Parent then screenGui:Destroy() end
			end
			api.Gui = screenGui

			----------------------------------------------------------------
			-- Cleanup + pop-in
			----------------------------------------------------------------
			screenGui.Destroying:Connect(function()
				for _, c in ipairs(connections) do c:Disconnect() end
				table.clear(connections)
				if opts.onGone then run(opts.onGone) end
			end)


			local fades = {
				{ box, "BackgroundTransparency", BG_TRANSPARENCY },
				{ stroke, "Transparency", STROKE_IDLE },
				{ label, "TextTransparency", TEXT_TRANSPARENCY },
				{ bar, "BackgroundTransparency", BAR_IDLE },
				{ iconGroup, "GroupTransparency", ICON_IDLE },
				{ cycleIcon, "GroupTransparency", CYCLE_IDLE },
			}
			tween(popScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
			for _, f in ipairs(fades) do
				tween(f[1], 0.4, { [f[2]] = f[3] }, Enum.EasingStyle.Quad)
			end


			-- a toggle that was already on when its button was made shows that after the pop-in
			if isOn then
				task.delay(0.45, function()
					if screenGui.Parent then setState(true) end
				end)
			end

			return api

		end

		return create
	end)()


	----------------------------------------------------------------
	-- Shared state
	----------------------------------------------------------------
	local screenGui = nil
	local connections = {}
	local mobileButtons = {}    -- element -> its mobile button
	local keybindElements = {}  -- elements that have a key assigned
	local capturing = nil       -- when set, the next key press goes to this function (picking a keybind)
	local dragState = nil       -- what is being dragged right now
	local activeMenu = nil
	local inputReady = false
	local popupList = {}        -- popups that are open
	local openPopups = {}       -- flag -> open popup
	local popupSaves = {}       -- flag -> the option name saved with Popup:Save() (kept until the game closes)

	local function getGui()
		if screenGui and screenGui.Parent then return screenGui end
		screenGui = make("ScreenGui", {
			Name = randomName(20),
			ResetOnSpawn = false,
			IgnoreGuiInset = true,
			DisplayOrder = 2147483000,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		}, nil)
		parentGui(screenGui)
		return screenGui
	end

	local function viewport()
		if screenGui and screenGui.AbsoluteSize.X > 0 then return screenGui.AbsoluteSize end
		return workspace.CurrentCamera.ViewportSize
	end

	-- Off-screen protection (windows and popups)
	local function clampWindow(window, position)
		local v = viewport()
		local margin = 6
		return Vector2.new(
			math.clamp(position.X, margin, math.max(margin, v.X - window._width - margin)),
			math.clamp(position.Y, margin, math.max(margin, v.Y - window._height - margin))
		)
	end

	local function closeMenu()
		if activeMenu then activeMenu.close() end
	end

	----------------------------------------------------------------
	-- Dragging: one thing at a time
	----------------------------------------------------------------
	local function endDrag(state)
		if dragState ~= state then return end
		dragState = nil
		if state.connection then state.connection:Disconnect() end
		if state.onEnd then state.onEnd() end
	end

	local function beginDrag(state)
		if dragState then return false end
		dragState = state
		state.connection = state.input.Changed:Connect(function()
			local s = state.input.UserInputState
			if s == Enum.UserInputState.End or s == Enum.UserInputState.Cancel then endDrag(state) end
		end)
		return true
	end

	local function updateDrag(state, input)
		if state.kind == "window" then
			local delta = p2(input) - state.start
			local position = clampWindow(state.window, state.origin + delta)
			state.window._position = position
			state.window.root.Position = UDim2.fromOffset(math.floor(position.X), math.floor(position.Y))
		elseif state.kind == "slider" then
			state.slider:_dragTo(p2(input).X)
		end
	end

	----------------------------------------------------------------
	-- Small building blocks
	----------------------------------------------------------------
	-- An icon from an asset id (the images are white, so they are recolored)
	local function makeIcon(parent, id, size, color, extra)
		local props = {
			BackgroundTransparency = 1,
			Image = assetUrl(id),
			ImageColor3 = color or THEME.subtext,
			ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromOffset(size, size),
			ZIndex = 4,
		}
		if extra then
			for key, value in pairs(extra) do props[key] = value end
		end
		return make("ImageLabel", props, parent)
	end

	-- A switch (track + knob)
	local function makeSwitch(parent, anchor, position, zindex)
		local track = make("Frame", {
			AnchorPoint = anchor,
			Position = position,
			Size = UDim2.fromOffset(38, 20),
			BackgroundColor3 = THEME.toggleOff,
			BorderSizePixel = 0,
			ZIndex = zindex,
		}, parent)
		corner(track, 10)
		local knob = make("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 2, 0.5, 0),
			Size = UDim2.fromOffset(16, 16),
			BackgroundColor3 = THEME.white,
			BorderSizePixel = 0,
			ZIndex = zindex + 1,
		}, track)
		corner(knob, 8)
		local function set(on, animate)
			local color = on and THEME.accent or THEME.toggleOff
			local position2 = on and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
			if animate == false then
				track.BackgroundColor3 = color
				knob.Position = position2
			else
				tween(track, 0.22, { BackgroundColor3 = color }, Enum.EasingStyle.Quad)
				tween(knob, 0.32, { Position = position2 }, Enum.EasingStyle.Back)
			end
		end
		return { track = track, knob = knob, set = set }
	end

	-- A press squish for clickable things
	local function attachPress(button, scale, down)
		down = down or 0.96
		button.InputBegan:Connect(function(input)
			if isPress(input) then tween(scale, 0.08, { Scale = down }, Enum.EasingStyle.Quad) end
		end)
		button.InputEnded:Connect(function(input)
			if isPress(input) then tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back) end
		end)
	end

