-- Apply it when creating the window:
Rayfield:CreateWindow({
    name = "Example Hub",
    subtitle = "Rayfield Gen2",
    sidebarLayout = true,
    theme = DarkGrayTheme,
})

local tab = window:CreateTab({ name = "Combat", icon = 93364949241311 })

tab:CreateButton({
    name = "Reset character",
    callback = function()
        game.Players.LocalPlayer.Character:BreakJoints()
    end,
})

local sprint = tab:CreateToggle({
    name = "Auto Sprint",
    flag = "AutoSprint",
    value = true,
    callback = function(value)
        print("Auto Sprint:", value)
    end,
})

sprint:Set(false)

tab:CreateSlider({
    name = "Field of view",
    range = { 70, 120 },
    increment = 1,
    value = 90,
    suffix = "°",
    callback = function(value)
        workspace.CurrentCamera.FieldOfView = value
    end,
})

tab:CreateDropdown({
    name = "Modules",
    multiSelect = true,
    options = { "Aimbot", "ESP", "Fly", "Noclip" },
    value = { "ESP" },
    callback = function(selected)
        print(selected)  -- { "ESP" }
    end,
})

tab:CreateInput({
    name = "Max players",
    numeric = true,
    value = "16",
    placeholder = "Enter a number",
    callback = function(text)
        print("Committed:", text)
    end,
})

tab:CreateKeybind({
    name = "Sprint",
    value = Enum.KeyCode.LeftShift,
    callback = function(key)
        print("Pressed", key)
    end,
})

tab:CreateColorPicker({
    name = "Highlight",
    color = Color3.fromRGB(96, 205, 255),
    callback = function(color, alpha)
        print(color, alpha)
    end,
})

local revenue = tab:CreateStat({
    name = "Revenue",
    prefix = "$",
    value = 12400,
})

revenue:Set(revenue.value + 500)

local download = tab:CreateProgress({
    name = "Download",
    range = { 0, 100 },
    value = 35,
})

download:Set(80)

tab:CreateText({
    name = "Read this first",
    text = "Either half can be left out, and the card closes up around what is left.",
})

tab:CreateDivider()
tab:CreateDivider({ text = "or" })
tab:CreateDivider({ line = false, spacing = 20 })  -- room, no rule
