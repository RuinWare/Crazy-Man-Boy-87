local window = Rayfield:CreateWindow({
    name = "Example Hub",
    subtitle = "Rayfield Gen2",
    sidebarLayout = true,
    theme = DarkGrayTheme,

})

local tab = window:CreateTab({ name = "Combat", icon = 93364949241311 })

tab:CreateButton({
    name = "Reset character",
    callback = function()
        game.Players.LocalPlayer.Character:BreakJoints()
    end,
})

local sprint = tab:CreateToggle({
    name = "Auto Sprint",
    flag = "AutoSprint",
    value = true,
    callback = function(value)
        print("Auto Sprint:", value)
    end,
})

sprint:Set(false)

tab:CreateSlider({
    name = "Field of view",
    range = { 70, 120 },
    increment = 1,
    value = 90,
    suffix = "°",
    callback = function(value)
        workspace.CurrentCamera.FieldOfView = value
    end,
})

tab:CreateDropdown({
    name = "Modules",
    multiSelect = true,
    options = { "Aimbot", "ESP", "Fly", "Noclip" },
    value = { "ESP" },
    callback = function(selected)
        print(selected)  -- { "ESP" }
    end,
})

tab:CreateInput({
    name = "Max players",
    numeric = true,
    value = "16",
    placeholder = "Enter a number",
    callback = function(text)
        print("Committed:", text)
    end,
})

tab:CreateKeybind({
    name = "Sprint",
    value = Enum.KeyCode.LeftShift,
    callback = function(key)
        print("Pressed", key)
    end,
})

tab:CreateColorPicker({
    name = "Highlight",
