local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local window = Rayfield:CreateWindow({
    name = "RW TESTING",
    subtitle = "Evade",
    sidebarLayout = true,
})

local tab = window:CreateTab({ name = "Test", icon = 0 })

do
	local noclipEnabled = false
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local PhysicsService = game:GetService("PhysicsService")
	local LP = Players.LocalPlayer

	-- Create a custom collision group for Noclip
	pcall(function()
		PhysicsService:RegisterCollisionGroup("NoclipGroup")
		PhysicsService:CollisionGroupSetCollidable("NoclipGroup", "Default", false)
		PhysicsService:CollisionGroupSetCollidable("NoclipGroup", "NoclipGroup", false)
	end)

	tab:CreateDivider()

	tab:CreateToggle({
		name = "Noclip",
		value = false,
		callback = function(v)
			noclipEnabled = v
			
			-- Instantly restore everything when turned off
			if not v then
				local rigs = workspace:FindFirstChild("Rigs")
				if rigs then
					for _, rig in ipairs(rigs:GetChildren()) do
						if rig.Name == LP.Name then
							for _, descendant in ipairs(rig:GetDescendants()) do
								if descendant:IsA("BasePart") then
									descendant.CanCollide = true
									descendant.CanTouch = true
									descendant.CanQuery = true
									pcall(function() descendant.CollisionGroup = "Default" end)
								end
							end
						end
					end
				end
			end
		end,
	})

	-- Update every physics step to fight the game's map protection
	RunService.Stepped:Connect(function()
		if not noclipEnabled then return end
		
		local rigs = workspace:FindFirstChild("Rigs")
		if rigs then
			for _, rig in ipairs(rigs:GetChildren()) do
				if rig.Name == LP.Name then
					-- Loop through every single part in the rig
					for _, descendant in ipairs(rig:GetDescendants()) do
						if descendant:IsA("BasePart") then
							-- 1. Disable standard physics
							descendant.CanCollide = false
							descendant.CanTouch = false
							descendant.CanQuery = false 
							
							-- 2. Apply the invisible collision group
							pcall(function() descendant.CollisionGroup = "NoclipGroup" end)
							
							-- 3. Clear velocity so the game can't push you backwards
							if descendant.AssemblyLinearVelocity.Magnitude > 0 then
								descendant.AssemblyLinearVelocity = Vector3.new(0, descendant.AssemblyLinearVelocity.Y, 0)
							end
						end
					end
					
					-- Make sure joints are also phantom
					local joints = rig:FindFirstChild("Joints")
					if joints then
						for _, joint in ipairs(joints:GetDescendants()) do
							if joint:IsA("BasePart") then
								joint.CanCollide = false
								joint.CanTouch = false
								joint.CanQuery = false
								pcall(function() joint.CollisionGroup = "NoclipGroup" end)
							end
						end
					end
				end
			end
		end
	end)
end

-- new

window:Notify({
    title = "All Loaded",
    content = "All tests were successful at loading.",
    duration = 10,
})
