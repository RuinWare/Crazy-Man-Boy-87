local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local window = Rayfield:CreateWindow({
    name = "RW TESTING",
    subtitle = "Evade",
    sidebarLayout = true,
})
-- tabb
local tab = window:CreateTab({ name = "Test", icon = 0 })

do
	local noclipEnabled = false
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local LP = Players.LocalPlayer

	tab:CreateDivider()

	tab:CreateToggle({
		name = "Noclip",
		value = false,
		callback = function(v)
			noclipEnabled = v
			
			-- When turning off, restore EVERYTHING to normal
			if not v then
				local rig = workspace.Rigs:FindFirstChild(LP.Name)
				if rig then
					for _, part in ipairs(rig:GetDescendants()) do
						if part:IsA("BasePart") then
							part.CanCollide = true
							part.CanTouch = true
							part.CanQuery = true
						end
					end
				end
			end
		end,
	})

	-- Apply every physics step so the game can't fight it
	RunService.Stepped:Connect(function()
		if not noclipEnabled then return end
		
		local rig = workspace.Rigs:FindFirstChild(LP.Name)
		if rig then
			for _, part in ipairs(rig:GetDescendants()) do
				if part:IsA("BasePart") then
					
					-- Disable physical collisions
					part.CanCollide = false
					part.CanTouch = false
					
					-- Disable raycasts on the BODY so the game's wall detection ignores you.
					-- We leave the Head's CanQuery alone so your camera doesn't bug out.
					if part.Name ~= "Head" then
						part.CanQuery = false
					end
					
				end
			end
		end
	end)
end

-- new new

window:Notify({
    title = "All Loaded",
    content = "All tests were successful at loading.",
    duration = 10,
})
