local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local window = Rayfield:CreateWindow({
    name = "RW TESTING",
    subtitle = "Evade",
    sidebarLayout = true,
})
-- tab
local tab = window:CreateTab({ name = "Test", icon = 0 })

do
	local noclipEnabled = false
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local LP = Players.LocalPlayer

	tab:CreateDivider()

	tab:CreateToggle({
		name = "Noclip",
		value = false,
		callback = function(v)
			noclipEnabled = v
			
			-- When turning off, restore collisions
			if not v then
				local rigs = workspace:FindFirstChild("Rigs")
				if rigs then
					for _, rig in ipairs(rigs:GetChildren()) do
						if rig.Name == LP.Name then
							for _, descendant in ipairs(rig:GetDescendants()) do
								if descendant:IsA("BasePart") then
									descendant.CanCollide = true
									descendant.CanTouch = true
								end
							end
						end
					end
				end
			end
		end,
	})

	-- Every frame, disable collisions on all parts of the rig
	RunService.Stepped:Connect(function()
		if not noclipEnabled then return end
		
		local rigs = workspace:FindFirstChild("Rigs")
		if rigs then
			for _, rig in ipairs(rigs:GetChildren()) do
				if rig.Name == LP.Name then
					-- Loops through Torso, TorsoRot, Head, Arms, Legs, ArmRot, Joints, etc.
					for _, descendant in ipairs(rig:GetDescendants()) do
						if descendant:IsA("BasePart") then
							descendant.CanCollide = false
							descendant.CanTouch = false
							-- We leave CanQuery alone so your camera doesn't bug out
						end
					end
				end
			end
		end
	end)
end

-- new new

window:Notify({
    title = "All Loaded",
    content = "All tests were successful at loading.",
    duration = 10,
})
