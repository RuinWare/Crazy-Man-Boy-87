local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local window = Rayfield:CreateWindow({
    name = "RW TESTING",
    subtitle = "Evade",
    sidebarLayout = true,
})
-- tabb
local tab = window:CreateTab({ name = "Test", icon = 0 })

do
	local noclipEnabled = false
	local walkSpeed = 16
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	local LP = Players.LocalPlayer

	tab:CreateDivider()

	tab:CreateToggle({
		name = "Noclip",
		value = false,
		callback = function(v)
			noclipEnabled = v
			
			local rig = workspace.Rigs:FindFirstChild(LP.Name)
			if rig then
				local hum = rig:FindFirstChild("Humanoid")
				
				if v then
					-- Save normal speed and freeze the game's movement controller
					if hum then
						walkSpeed = hum.WalkSpeed
						hum.WalkSpeed = 0 
					end
				else
					-- Restore normal speed
					if hum then
						hum.WalkSpeed = walkSpeed
					end
				end

				-- Toggle physical collisions
				for _, part in ipairs(rig:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = not v
						part.CanTouch = not v
						-- We leave CanQuery alone so the camera doesn't bug
					end
				end
			end
		end,
	})

	-- Manually move the character with CFrame, ignoring the game's movement checks
	RunService.RenderStepped:Connect(function(dt)
		if not noclipEnabled then return end
		
		local rig = workspace.Rigs:FindFirstChild(LP.Name)
		if rig then
			local hum = rig:FindFirstChild("Humanoid")
			local root = rig:FindFirstChild("TorsoRot") or rig:FindFirstChild("Torso") or rig:FindFirstChild("HumanoidRootPart")
			
			-- Keep WalkSpeed at 0 so the game can't cancel your movement
			if hum then hum.WalkSpeed = 0 end 
			
			if root then
				-- Get WASD, Mobile Joystick, or Controller Stick
				local move = UserInputService:GetMoveVector()
				
				if move.Magnitude > 0 then
					local cam = workspace.CurrentCamera
					-- Calculate direction based on camera
					local dir = (cam.CFrame.LookVector * -move.Z) + (cam.CFrame.RightVector * move.X)
					dir = Vector3.new(dir.X, 0, dir.Z).Unit -- Keep it flat/horizontal
					
					-- Physically push the rig through the wall
					root.CFrame = root.CFrame + (dir * walkSpeed * dt)
				end
			end
		end
	end)
end

-- new new

window:Notify({
    title = "All Loaded",
    content = "All tests were successful at loading.",
    duration = 10,
})
