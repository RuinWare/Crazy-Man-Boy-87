				local row = getUI("HomePage", "Root", "Bottom", "Left", "StreakRow")
				restoreOriginal("Winstreak", el, false)
				restoreOriginal("WinstreakVisible", row, true)
			end
		end,
	})
	VisTab:CreateInput({
		name = "Winstreak:",
		placeholder = "1000000",
		removeTextAfterFocusLost = false,
		callback = function(text) if text then streakText = formatCommas(text) end end,
	})

	-- ==========================================
	-- Heartbeat Loop (Wrapped in pcall for safety)
	-- ==========================================
	RunService.Heartbeat:Connect(function()
		pcall(function()
			-- 1. Level
			if levelEnabled then
				local el = getUI("HomePage", "Root", "Bottom", "Level", "Level")
				if el then
					saveOriginal("Level", el, false)
					el.Text = "LEVEL " .. levelText
				end
			end

			-- 2. XP
			if xpEnabled then
				local el = getUI("HomePage", "Root", "Bottom", "Level", "Experience")
				if el then
					saveOriginal("XP", el, false)
					el.Text = xpText .. "/" .. xpOutOfText
				end
			end

			-- 3. Tokens
			if tokenEnabled then
				local el = getUI("HomePage", "Root", "Bottom", "Left", "Tokens", "Pill", "Body", "Amount")
				if el then
					saveOriginal("Tokens", el, false)
					el.Text = tokenText
				end
			end

			-- 4. Points
			if pointEnabled then
				local el = getUI("HomePage", "Root", "Bottom", "Left", "Points", "Pill", "Body", "Amount")
				if el then
					saveOriginal("Points", el, false)
					el.Text = pointText
				end
			end

			-- 5. Vouchers
			if voucherEnabled then
				local el = getUI("HomePage", "Root", "Bottom", "Left", "Vouchers", "Pill", "Body", "Amount")
				if el then
					saveOriginal("Vouchers", el, false)
					el.Text = voucherText
				end
			end

			-- 6. Tickets
			if ticketEnabled then
				local el = getUI("HomePage", "Root", "Bottom", "Left", "Tickets", "Pill", "Body", "Amount")
				if el then
					saveOriginal("Tickets", el, false)
					el.Text = ticketText
				end
			end

			-- 7. Survivals
			if survivalEnabled then
				local el = getUI("HomePage", "Root", "Bottom", "Left", "Survivals", "Pill", "Body", "Amount")
				if el then
					saveOriginal("Survivals", el, false)
					el.Text = survivalText
				end
			end

			-- 8. Winstreak + Visibility
			if streakEnabled then
				local el = getUI("HomePage", "Root", "Bottom", "Left", "StreakRow", "Streak", "Pill", "Body", "Amount")
				local row = getUI("HomePage", "Root", "Bottom", "Left", "StreakRow")
				
				if el then
					saveOriginal("Winstreak", el, false)
					el.Text = streakText
				end
				
				if row then
					saveOriginal("WinstreakVisible", row, true)
					-- If text is "0", hide it. Otherwise show it.
					if streakText == "0" then
						row.Visible = false
					else
						row.Visible = true
					end
				end
			end
		end)
	end)
end
