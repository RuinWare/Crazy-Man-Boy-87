do
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local LP = Players.LocalPlayer

	-- State Variables
	local levelEnabled, xpEnabled = false, false
	local tokenEnabled, pointEnabled, voucherEnabled = false, false, false
	local ticketEnabled, survivalEnabled, streakEnabled = false, false, false

	local levelText, xpText, xpOutOfText = "1", "0", "0"
	local tokenText, pointText, voucherText = "0", "0", "0"
	local ticketText, survivalText, streakText = "0", "0", "0"

	-- Original Value Storage
	local originals = {}

	VisTab:CreateDivider()

	-- Robust comma formatter (prevents nil errors)
	local function formatCommas(input)
		if not input then return "0" end
		local str = tostring(input):gsub("%D", "")
		if str == "" then return "0" end
		
		local num = tonumber(str)
		if not num then return "0" end
		
		local formatted = tostring(num)
		while true do
			local newFormatted, k = formatted:gsub("^(%d+)(%d%d%d)", "%1,%2")
			formatted = newFormatted
			if k == 0 then break end
		end
		return formatted
	end

	-- Helper to safely traverse the UI path
	local function getUI(...)
		local current = LP:FindFirstChild("PlayerGui")
		if not current then return nil end
		for _, v in ipairs({...}) do
			if not current then return nil end
			current = current:FindFirstChild(v)
		end
		return current
	end

	-- Helper to save original values
	local function saveOriginal(key, element, isVisible)
		if not originals[key] and element then
			if isVisible then
				originals[key] = { Visible = element.Visible }
			else
				originals[key] = { Text = element.Text }
			end
		end
	end

	-- Helper to restore original values
	local function restoreOriginal(key, element, isVisible)
		local data = originals[key]
		if data and element then
			if isVisible then
				element.Visible = data.Visible
			else
				element.Text = data.Text
			end
		end
	end

	-- ==========================================
	-- 1. Level Spoofer
	-- ==========================================
	VisTab:CreateToggle({
		name = "Level Spoofer",
		value = false,
		callback = function(v)
			levelEnabled = v
			if not v then
				local el = getUI("HomePage", "Root", "Bottom", "Level", "Level")
				restoreOriginal("Level", el, false)
			end
		end,
	})
	VisTab:CreateInput({
		name = "Level:",
		placeholder = "100",
		removeTextAfterFocusLost = false,
		callback = function(text) if text then levelText = formatCommas(text) end end,
	})

	-- ==========================================
	-- 2. XP Spoofer
	-- ==========================================
	VisTab:CreateToggle({
		name = "XP Spoofer",
		value = false,
		callback = function(v)
			xpEnabled = v
			if not v then
