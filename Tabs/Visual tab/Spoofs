	-- ==========================================
	-- 4. Points Spoofer
	-- ==========================================
	VisTab:CreateToggle({
		name = "Points Spoofer",
		value = false,
		callback = function(v)
			pointEnabled = v
			if not v then
				local el = getUI("HomePage", "Root", "Bottom", "Left", "Points", "Pill", "Body", "Amount")
				restoreOriginal("Points", el, false)
			end
		end,
	})
	VisTab:CreateInput({
