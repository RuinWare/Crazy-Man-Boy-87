				restoreOriginal("XP", el, false)
			end
		end,
	})
	VisTab:CreateInput({
		name = "XP:",
		placeholder = "500",
		removeTextAfterFocusLost = false,
		callback = function(text) if text then xpText = formatCommas(text) end end,
	})
	VisTab:CreateInput({
		name = "Out Of:",
		placeholder = "1000",
		removeTextAfterFocusLost = false,
		callback = function(text) if text then xpOutOfText = formatCommas(text) end end,
	})

	-- ==========================================
	-- 3. Token Spoofer
	-- ==========================================
	VisTab:CreateToggle({
		name = "Token Spoofer",
		value = false,
		callback = function(v)
			tokenEnabled = v
			if not v then
				local el = getUI("HomePage", "Root", "Bottom", "Left", "Tokens", "Pill", "Body", "Amount")
				restoreOriginal("Tokens", el, false)
			end
		end,
	})
	VisTab:CreateInput({
		name = "Tokens:",
		placeholder = "1000000",
		removeTextAfterFocusLost = false,
		callback = function(text) if text then tokenText = formatCommas(text) end end,
