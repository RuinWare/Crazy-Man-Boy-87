--[[
===========================
HIDE PLYS
===========================
]]--

do
	local hidePlayersEnabled = false
	local showFriendsEnabled = false
	
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local LP = Players.LocalPlayer
	
	-- Hidden folder kept in memory (unparented) so the game doesn't see the rigs
	local hiddenFolder = Instance.new("Folder")
	hiddenFolder.Name = "HiddenPlayerRigs"
	
	-- Tracks rigs we hid and their original parent so we can restore them
	local hiddenRigs = {}

	-- Helper to check if a rig belongs to a friend
	local function isFriend(player)
		local success, result = pcall(function()
			return LP:IsFriendsWith(player.UserId)
		end)
		return success and result
	end

	VisTab:CreateDivider({ text = "Player + Character" })

	VisTab:CreateToggle({
		name = "Hide Players",
		value = false,
		callback = function(v)
			hidePlayersEnabled = v
			
			if not v then
				-- Restore all hidden rigs to their original locations
				for rig, originalParent in pairs(hiddenRigs) do
					if rig and originalParent then
						pcall(function()
							rig.Parent = originalParent
						end)
					end
				end
				hiddenRigs = {}
			end
		end,
	})

	VisTab:CreateToggle({
		name = "Show Friends",
		value = false,
		callback = function(v)
			showFriendsEnabled = v
		end,
	})

	-- Enforce hiding every frame to catch newly spawned rigs
	RunService.Heartbeat:Connect(function()
		if not hidePlayersEnabled then return end
		
		-- Check both workspace.Rigs and workspace.Players
		local containers = {
			workspace:FindFirstChild("Rigs"),
			workspace:FindFirstChild("Players")
		}
		
		for _, container in ipairs(containers) do
			if container then
				for _, rig in ipairs(container:GetChildren()) do
					-- Ensure it's a real player (prevents deleting Nextbots)
					local plr = Players:FindFirstChild(rig.Name)
					
					if plr and plr ~= LP then
						local shouldHide = true
						
						-- Check if we should keep friends visible
						if showFriendsEnabled and isFriend(plr) then
							shouldHide = false
						end
						
						if shouldHide then
							-- If it's not already hidden, hide it
							if rig.Parent ~= hiddenFolder then
								hiddenRigs[rig] = container
								rig.Parent = hiddenFolder
							end
						end
					end
				end
			end
		end
	end)
end

--[[
===========================
RSGASC p
===========================
]]--

do
	local modelEnabled = false
	local assetIdText = ""
	local savedOriginals = {}
	
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local RunService = game:GetService("RunService")
	local Players = game:GetService("Players")
	local LP = Players.LocalPlayer

	-- The exact CFrames you found
	local C0_VAL = CFrame.new(0.0410000011, -0.200000003, 0.138999999, 1, 0, 0, 0, 0, 1, 0, -1, 0)
	local C1_VAL = CFrame.new(0, 1, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1)

	-- Helper to find the EmoteModels in ReplicatedStorage and the active rig
	local function getEmoteModels()
		local models = {}
		
		local items = ReplicatedStorage:FindFirstChild("Items")
		local itemPacks = items and items:FindFirstChild("ItemPacks")
		local events = itemPacks and itemPacks:FindFirstChild("Events")
		local y2022 = events and events:FindFirstChild("2022")
		local halloween = y2022 and y2022:FindFirstChild("Halloween2022")
		local emotes = halloween and halloween:FindFirstChild("Emotes")
		local rockinStride = emotes and emotes:FindFirstChild("RockinStride")
		
		if rockinStride then
			local classicModel = rockinStride:FindFirstChild("CharacterClassic") and rockinStride.CharacterClassic:FindFirstChild("EmoteModel")
			if classicModel then table.insert(models, classicModel) end
			
			local charModel = rockinStride:FindFirstChild("Character") and rockinStride.Character:FindFirstChild("EmoteModel")
			if charModel then table.insert(models, charModel) end
		end

		local rig = workspace:FindFirstChild("Rigs") and workspace.Rigs:FindFirstChild(LP.Name)
		if rig then
			for _, v in ipairs(rig:GetDescendants()) do
				if v.Name == "EmoteModel" then
					table.insert(models, v)
				end
			end
		end

		return models
	end

	-- Load the 3D Asset (Handles both Models and MeshParts safely)
	local function createCustomModel(assetId)
		local success, objects = pcall(function()
			return game:GetObjects("rbxassetid://" .. tostring(assetId))
		end)
		
		if not success or not objects or #objects == 0 then return nil, nil end
		
		local newModel = Instance.new("Model")
		newModel.Name = "CustomRockinStride"
		
		-- Parent everything into the new model
		for _, obj in ipairs(objects) do
			obj.Parent = newModel
		end
		
		-- 1. Find the Handle (or create one)
		local handle = newModel:FindFirstChild("Handle", true)
		if not handle then
			handle = newModel.PrimaryPart or newModel:FindFirstChildWhichIsA("BasePart")
			if not handle then
				handle = Instance.new("Part")
				handle.Size = Vector3.new(1, 1, 1)
				handle.Transparency = 1
				handle.CanCollide = false
				handle.Parent = newModel
			end
			handle.Name = "Handle"
		end
		
		newModel.PrimaryPart = handle
		
		-- 2. Unanchor and Weld everything to the Handle
		for _, part in ipairs(newModel:GetDescendants()) do
			if part:IsA("BasePart") then
				part.Anchored = false
				part.CanCollide = false
				
				if part ~= handle then
					local weld = Instance.new("WeldConstraint")
					weld.Part0 = handle
					weld.Part1 = part
					weld.Parent = part
				end
			end
		end
		
		return newModel, handle
	end

	local function applyModel()
		if not modelEnabled or assetIdText == "" then return end
		local models = getEmoteModels()
		if #models == 0 then return end
		
		local customAsset, customHandle = createCustomModel(assetIdText)
		if not customAsset then
			window:Notify({ title = "Model Changer", content = "Failed to load Asset ID: "..assetIdText, duration = 3 })
			return
		end

		local rig = workspace:FindFirstChild("Rigs") and workspace.Rigs:FindFirstChild(LP.Name)
		local leftHand = rig and (rig:FindFirstChild("LeftHand") or rig:FindFirstChild("Left Hand") or rig:FindFirstChild("Left Arm"))

		for _, model in ipairs(models) do
			-- Save originals only once
			if not savedOriginals[model] then
				savedOriginals[model] = {}
				for _, child in ipairs(model:GetChildren()) do
					table.insert(savedOriginals[model], child:Clone())
				end
			end

			-- Nuke the old children
			for _, child in ipairs(model:GetChildren()) do
				child:Destroy()
			end

			-- Put in the new model
			local clone = customAsset:Clone()
			clone.Parent = model
			
			local cloneHandle = clone:FindFirstChild("Handle", true)
			
			-- 3. Wire up the Motor6D to the LeftHand
			if rig and model:IsDescendantOf(rig) and cloneHandle and leftHand then
				-- Remove any existing Motor6D in the Handle
				for _, c in ipairs(cloneHandle:GetChildren()) do
					if c:IsA("Motor6D") then c:Destroy() end
				end

				local motor = Instance.new("Motor6D")
				motor.Name = "HandleWeld"
				motor.Part0 = leftHand
				motor.Part1 = cloneHandle
				motor.C0 = C0_VAL
				motor.C1 = C1_VAL
				motor.Parent = leftHand -- Parent to Part0 (LeftHand)
			end
		end
		
		customAsset:Destroy()
	end

	local function revertModel()
		for model, children in pairs(savedOriginals) do
			if model and model.Parent then
				for _, child in ipairs(model:GetChildren()) do
					child:Destroy()
				end
				for _, child in ipairs(children) do
					child:Clone().Parent = model
				end
			end
		end
		savedOriginals = {}
	end

	VisTab:CreateDivider()

	VisTab:CreateToggle({
		name = "Rockin' Stride Guitar Model Changer",
		value = false,
		callback = function(v)
			modelEnabled = v
			if v then
				savedOriginals = {}
				applyModel()
			else
				revertModel()
			end
		end,
	})

	VisTab:CreateInput({
		name = "Asset ID:",
		placeholder = "e.g. 123456789",
		removeTextAfterFocusLost = false,
		callback = function(text)
			if not text then return end
			assetIdText = tostring(text):gsub("%D", "")
			
			if modelEnabled and assetIdText ~= "" then
				revertModel()
				applyModel()
			end
		end,
	})

	-- Loop to enforce it in case the game resets the EmoteModel
	RunService.Heartbeat:Connect(function()
		if modelEnabled and assetIdText ~= "" then
			local rig = workspace:FindFirstChild("Rigs") and workspace.Rigs:FindFirstChild(LP.Name)
			if rig then
				for _, v in ipairs(rig:GetDescendants()) do
					if v.Name == "EmoteModel" then
						local hasCustom = false
						for _, child in ipairs(v:GetChildren()) do
							if child.Name == "CustomRockinStride" then
								hasCustom = true
								break
							end
						end
						if not hasCustom then
							applyModel()
							break
						end
					end
				end
			end
		end
	end)
end
