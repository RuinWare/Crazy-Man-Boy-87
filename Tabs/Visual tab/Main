do
VisTab:CreateDivider({ "Game" })

VisTab:CreateToggle({
    name = "Remove Breacher Lag",
    flag = "RBLREMOVEBREACHERLAG",
    currentValue = false,
    callback = function(v)
        if v then
   _G.RuinWarePortalLag = true

if _G.RuinWarePortalLagThread then
    task.cancel(_G.RuinWarePortalLagThread)
end

_G.RuinWarePortalLagThread = task.spawn(function()
    while _G.RuinWarePortalLag do
        task.wait(1)
        
        local effects = workspace:FindFirstChild("Effects")
        if effects then
            local portals = effects:FindFirstChild("Portals")
            if portals then
                for _, portal in ipairs(portals:GetChildren()) do
                    if portal.Name == "PortalYellow" or portal.Name == "PortalBlue" then
                        for _, attName in ipairs({"Attachment1", "Attachment3"}) do
                            local att = portal:FindFirstChild(attName)
                            if att then
                                for _, child in ipairs(att:GetChildren()) do
                                    if child.Name == "Left" or child.Name == "Right" or child.Name == "Vortex" then
                                        pcall(function() child:Destroy() end)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

window:Notify({
    title = "RuinWare",
    content = "Breacher Effects Removed",
    duration = 5,
})
       else
_G.RuinWarePortalLag = false

if _G.RuinWarePortalLagThread then
    task.cancel(_G.RuinWarePortalLagThread)
    _G.RuinWarePortalLagThread = nil
   end
end
    end,
})
end

--[[
===========================
HIDE NVV
===========================
]]--

do
	local hideVignetteEnabled = false
	local savedVignette = nil
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local LP = Players.LocalPlayer

	VisTab:CreateDivider()

	-- Helper to safely get the NightVision folder
	local function getNightVisionFolder()
		local playerGui = LP:FindFirstChild("PlayerGui")
		if not playerGui then return nil end
		
		local gameGui = playerGui:FindFirstChild("Game")
		if not gameGui then return nil end
		
		local hud = gameGui:FindFirstChild("HUD")
		if not hud then return nil end
		
		return hud:FindFirstChild("NightVision")
	end

	VisTab:CreateToggle({
		name = "Remove Night Vision Vignette",
		value = false,
		callback = function(v)
			hideVignetteEnabled = v
			
			if v then
				-- Save the original and delete it
				local nv = getNightVisionFolder()
				local vignette = nv and nv:FindFirstChild("Vignette")
				
				if vignette and not savedVignette then
					savedVignette = vignette:Clone()
					vignette:Destroy()
				end
			else
				-- Restore the original
				if savedVignette then
					local nv = getNightVisionFolder()
					if nv and not nv:FindFirstChild("Vignette") then
						savedVignette:Clone().Parent = nv
					end
					savedVignette = nil
				end
			end
		end,
	})

	-- Enforce deletion every frame to prevent the game from recreating it
	RunService.Heartbeat:Connect(function()
		if hideVignetteEnabled then
			local nv = getNightVisionFolder()
			if nv then
				local vignette = nv:FindFirstChild("Vignette")
				if vignette then
					-- If we haven't saved it yet, save it now before destroying
					if not savedVignette then
						savedVignette = vignette:Clone()
					end
					vignette:Destroy()
				end
			end
		end
	end)
end

--[[
===========================
ROUND TIMER
===========================
]]--

do
	local roundTimerEnabled = false
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local LP = Players.LocalPlayer

	-- Helper to safely traverse the long UI path and get the IngameRoundTimer
	local function getIngameTimer()
		local playerGui = LP:FindFirstChild("PlayerGui")
		if not playerGui then return nil end
		
		local gameGui = playerGui:FindFirstChild("Game")
		if not gameGui then return nil end
		
		local hud = gameGui:FindFirstChild("HUD")
		if not hud then return nil end
		
		local overlay = hud:FindFirstChild("Overlay")
		if not overlay then return nil end
		
		local roundOverlay = overlay:FindFirstChild("RoundOverlay")
		if not roundOverlay then return nil end
		
		local roundTimer = roundOverlay:FindFirstChild("RoundTimer")
		if not roundTimer then return nil end
		
		return roundTimer:FindFirstChild("IngameRoundTimer")
	end

	VisTab:CreateDivider()

	VisTab:CreateToggle({
		name = "Round Timer",
		value = false,
		callback = function(v)
			roundTimerEnabled = v
			
			if not v then
				-- Turn both invisible once and stop
				local ingameTimer = getIngameTimer()
				if ingameTimer then
					ingameTimer.Visible = false
					local timerText = ingameTimer:FindFirstChild("Timer")
					if timerText then timerText.Visible = false end
				end
			end
		end,
	})

	-- Loop only runs when toggle is on
	RunService.RenderStepped:Connect(function()
		if not roundTimerEnabled then return end
		
		local ingameTimer = getIngameTimer()
		if ingameTimer then
			ingameTimer.Visible = true
			local timerText = ingameTimer:FindFirstChild("Timer")
			if timerText then timerText.Visible = true end
		end
	end)
end

--[[
===========================
RES STRECHER
===========================
]]--
do
-- declare
local RunService = game:GetService("RunService")

local BIND_RESTORE = "StretchResolutionRestore"
local BIND_STRETCH = "StretchResolutionStretch"
local currentAmount = nil
local originalCFrame = nil
local stretchEnabled = true
local RESAMOUNT1 = 1

local function stopStretch()
	if currentAmount ~= nil then
		RunService:UnbindFromRenderStep(BIND_RESTORE)
		RunService:UnbindFromRenderStep(BIND_STRETCH)
		local cam = workspace.CurrentCamera
		if originalCFrame and cam then
			cam.CFrame = originalCFrame
		end
		originalCFrame = nil
	end
	currentAmount = nil
end

local function setStretch(amount)
	if amount == nil then return end
	if amount == currentAmount then return end

	stopStretch()

	if amount == 1 then
		currentAmount = 1
		return
	end

	currentAmount = amount

	RunService:BindToRenderStep(
		BIND_RESTORE,
		Enum.RenderPriority.Camera.Value - 1,
		function()
			local cam = workspace.CurrentCamera
			if cam and originalCFrame then
				cam.CFrame = originalCFrame
			end
		end
	)

	RunService:BindToRenderStep(
		BIND_STRETCH,
		Enum.RenderPriority.Camera.Value + 1,
		function()
			local cam = workspace.CurrentCamera
			if not cam then return end
			originalCFrame = cam.CFrame
			cam.CFrame = cam.CFrame
				* CFrame.new(0, 0, 0, 1, 0, 0, 0, amount, 0, 0, 0, 1)
		end
	)
end

-- per-tick update of the stretch from RESAMOUNT1
RunService.Heartbeat:Connect(function()
	if not stretchEnabled then
		stopStretch()
		return
	end
	setStretch(tonumber(RESAMOUNT1) or 1)
end)

VisTab:CreateDivider({ text = "Camera" })

VisTab:CreateToggle({
	name = "Resolution Stretcher",
	flag = "resstrecheromgggg",
	value = false,
	callback = function(value)
		stretchEnabled = value
	end,
})

VisTab:CreateInput({
	name = "Amount:",
	value = "",
	placeholder = "0.00",
	callback = function(text)
		RESAMOUNT1 = tonumber(text) or 1
	end,
})
end

--[[
===========================
3RD PERSON
===========================
]]--

do
    local thirdPersonEnabled = false
    local zoomDistance = 10
    local bindName = "ThirdPersonZoom"
    local bound = false

    local function applyZoom()
        if not thirdPersonEnabled then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        -- Positive Z in camera-local space = backward = zoom out
        cam.CFrame = cam.CFrame * CFrame.new(0, 0, zoomDistance)
    end

    local function start()
        if bound then return end
        bound = true
        RunService:BindToRenderStep(bindName, Enum.RenderPriority.Camera.Value + 1, applyZoom)
    end

    local function stop()
        if bound then
            pcall(function() RunService:UnbindFromRenderStep(bindName) end)
            bound = false
        end
        -- Game camera rebuilds CFrame next frame automatically, snaps back
    end

    VisTab:CreateDivider()

    VisTab:CreateToggle({
        name = "3rd Person",
        currentValue = false,
        flag = "ThirdPerson_Toggle",
        callback = function(v)
            thirdPersonEnabled = v
            if v then start() else stop() end
        end,
    })

    VisTab:CreateSlider({
        name = "Zoom Distance",
        range = {1, 50},
        increment = 0.5,
        suffix = "s",
        currentValue = 10,
        flag = "ThirdPerson_Distance",
        callback = function(v) zoomDistance = v end,
    })

    _G.RWCallbacks = _G.RWCallbacks or {}
    _G.RWCallbacks["ThirdPerson"] = function(v)
        thirdPersonEnabled = v
        if v then start() else stop() end
    end
end

--[[
===========================
SPOOFING
===========================
]]--

do
    local Plr = game.Players.LocalPlayer
    getgenv().spoofState = getgenv().spoofState or {}

    local function escPattern(s) return s:gsub("[%^%$%(%)%%%.%[%]%*%+%-%?]", "%%%0") end
    local function escRepl(s)    return s:gsub("%%", "%%%%") end

    local function makeSpoofer(flag, getOriginal)
        local api = { active = false, name = getOriginal() }
        local function getState() return getgenv().spoofState[flag] end

        local function render(label)
            local state = getState()
            if not state then return end
            local real = state.originals[label]
            if real == nil then return end
            local desired = real:gsub(state.escName, state.nameRepl)
            if label.Text ~= desired then
                state.lastSet[label] = desired
                label.Text = desired
            end
        end

        local function renderAll()
            local state = getState()
            if not state then return end
            for label in pairs(state.hooked) do pcall(render, label) end
        end

        local function attach(label)
            local state = getState()
            if not state then return end
            if state.originals[label] == nil then
                if not label.Text:find(getOriginal(), 1, true) then return end
                state.originals[label] = label.Text
            end
            render(label)
            if state.hooked[label] then return end
            state.hooked[label] = true
            table.insert(state.hooks, label:GetPropertyChangedSignal("Text"):Connect(function()
                local st = getState()
                if not st then return end
                local cur = label.Text
                if cur == st.lastSet[label] then return end
                st.originals[label] = cur
                render(label)
            end))
        end

        function api.setName(newName)
            if not newName or newName == "" then return end
            api.name = newName
            local state = getState()
            if state then
                state.nameRepl = escRepl(newName)
                renderAll()
            end
        end

        function api.on()
            local prev = getgenv().spoofState[flag]
            if prev then
                for _, c in ipairs(prev.hooks) do c:Disconnect() end
            end
            local state = {
                originals = (prev and prev.originals) or setmetatable({}, {__mode="k"}),
                hooked    = (prev and prev.hooked)    or setmetatable({}, {__mode="k"}),
                lastSet   = (prev and prev.lastSet)   or setmetatable({}, {__mode="k"}),
                hooks = {},
                escName  = escPattern(getOriginal()),
                nameRepl = escRepl(api.name),
            }
            getgenv().spoofState[flag] = state
            for _, v in next, game:GetDescendants() do
                if v.ClassName == "TextLabel" then attach(v) end
            end
            table.insert(state.hooks, game.DescendantAdded:Connect(function(v)
                if v.ClassName == "TextLabel" then attach(v) end
            end))
            api.active = true
        end

        function api.off()
            local state = getState()
            if not state then return end
            for _, c in ipairs(state.hooks) do c:Disconnect() end
            for label, real in pairs(state.originals) do
                if label.Parent then pcall(function() label.Text = real end) end
            end
            getgenv().spoofState[flag] = nil
            api.active = false
        end

        return api
    end

    local usernameSpoofer = makeSpoofer("username",    function() return Plr.Name        end)
    local displaySpoofer  = makeSpoofer("displayName", function() return Plr.DisplayName end)

    VisTab:CreateDivider({ text = "Spoofing" })

    VisTab:CreateToggle({
        name = "Local Spoof Username",
        flag = "SpoofUsername",
        value = false,
        callback = function(v)
            if v then usernameSpoofer.on() else usernameSpoofer.off() end
        end,
    })

    VisTab:CreateInput({
        name = "Username:",
        value = Plr.Name,
        placeholder = "New username",
        callback = function(text)
            if text ~= "" then usernameSpoofer.setName(text) end
        end,
    })

    VisTab:CreateToggle({
        name = "Local Spoof Display Name",
        flag = "SpoofDisplayName",
        value = false,
        callback = function(v)
            if v then displaySpoofer.on() else displaySpoofer.off() end
        end,
    })

    VisTab:CreateInput({
        name = "Display Name:",
        value = Plr.DisplayName,
        placeholder = "New display name",
        callback = function(text)
            if text ~= "" then displaySpoofer.setName(text) end
        end,
    })
end

-- avatar 4.0

do
	local avatarEnabled = false
	local targetUsername = ""
	local cachedDesc = nil
	local appliedRigs = {} -- Tracks which rigs have already been modified
	
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local LP = Players.LocalPlayer

	VisTab:CreateDivider()

	-- Helper to fetch the description and cache it
	local function getDesc(username)
		local ok, userId = pcall(function() return Players:GetUserIdFromNameAsync(username) end)
		if ok and userId then
			local dOk, desc = pcall(function() return Players:GetHumanoidDescriptionFromUserId(userId) end)
			if dOk then return desc end
		end
		return nil
	end

	-- Helper to apply the description to a specific rig
	local function applyToRig(rig, desc)
		local hum = rig:FindFirstChildOfClass("Humanoid")
		if not hum then return end
		
		-- Clear old items
		for _, item in ipairs(rig:GetDescendants()) do
			if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("BodyColors") or item:IsA("CharacterMesh") then
				item:Destroy()
			end
		end
		
		local head = rig:FindFirstChild("Head")
		if head then
			for _, item in ipairs(head:GetChildren()) do
				if item:IsA("Decal") then item:Destroy() end
			end
		end

		-- Apply description
		local successApply = pcall(function()
			hum:ApplyDescription(desc)
		end)

		-- Fallback for custom rigs
		if not successApply then
			local userId = Players:GetUserIdFromNameAsync(desc.Name)
			local aSuccess, appearance = pcall(function() return Players:GetCharacterAppearanceAsync(userId) end)
			if aSuccess and appearance then
				for _, item in ipairs(appearance:GetDescendants()) do
					if item:IsA("Accessory") then
						pcall(function() hum:AddAccessory(item:Clone()) end)
					elseif item:IsA("Shirt") or item:IsA("Pants") or item:IsA("BodyColors") or item:IsA("CharacterMesh") then
						item:Clone().Parent = rig
					end
				end
			end
		end
		
		-- Force apply Face
		if desc.Face > 0 and head then
			local face = Instance.new("Decal")
			face.Name = "face"
			face.Texture = "rbxassetid://" .. desc.Face
			face.Parent = head
		end
	end

	VisTab:CreateToggle({
		name = "Local Avatar Changer",
		value = false,
		callback = function(v)
			avatarEnabled = v
			appliedRigs = {} -- Reset cache
			
			if v then
				cachedDesc = nil
				if targetUsername ~= "" then
					task.spawn(function()
						cachedDesc = getDesc(targetUsername)
					end)
				end
			else
				-- Revert everything to LocalPlayer
				task.spawn(function()
					local myDesc = getDesc(LP.Name)
					if myDesc then
						local rigs = workspace:FindFirstChild("Rigs")
						if rigs then
							for _, rig in ipairs(rigs:GetChildren()) do
								if rig.Name == LP.Name then
									applyToRig(rig, myDesc)
								end
							end
						end
					end
				end)
			end
		end,
	})

	VisTab:CreateInput({
		name = "Username:",
		placeholder = "Enter username",
		removeTextAfterFocusLost = false,
		callback = function(text)
			targetUsername = text
			cachedDesc = nil -- Reset cache so it fetches the new name
			appliedRigs = {} -- Force all rigs to update to the new name
			
			if avatarEnabled and targetUsername ~= "" then
				task.spawn(function()
					cachedDesc = getDesc(targetUsername)
				end)
			end
		end,
	})

	-- Live updating loop
	RunService.Heartbeat:Connect(function()
		if not avatarEnabled then return end
		if not targetUsername or targetUsername == "" then return end
		
		-- Wait for the description to load
		if not cachedDesc then
			cachedDesc = getDesc(targetUsername)
			if not cachedDesc then return end
		end

		local rigs = workspace:FindFirstChild("Rigs")
		if not rigs then return end
		
		local activeRigs = {}
		
		for _, rig in ipairs(rigs:GetChildren()) do
			if rig.Name == LP.Name then
				activeRigs[rig] = true
				
				-- If we haven't applied the avatar to this specific rig yet, do it now
				if not appliedRigs[rig] then
					appliedRigs[rig] = true
					applyToRig(rig, cachedDesc)
				end
			end
		end
		
		-- Cleanup the cache to prevent memory leaks from destroyed rigs
		for rig in pairs(appliedRigs) do
			if not activeRigs[rig] then
				appliedRigs[rig] = nil
			end
		end
	end)
end

-- others avatar v1.0

do
	local avatarEnabled = false
	local targetUsername = ""
	local cachedDesc = nil
	local targetUserId = nil
	local appliedRigs = {}
	
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local LP = Players.LocalPlayer

	VisTab:CreateDivider()

	-- Helper to fetch the description and UserId
	local function getDesc(username)
		local ok, userId = pcall(function() return Players:GetUserIdFromNameAsync(username) end)
		if ok and userId then
			local dOk, desc = pcall(function() return Players:GetHumanoidDescriptionFromUserId(userId) end)
			if dOk then 
				return desc, userId
			end
		end
		return nil, nil
	end

	-- Helper to apply the description to a specific rig
	local function applyToRig(rig, desc, userId)
		local hum = rig:FindFirstChildOfClass("Humanoid")
		if not hum then return end
		
		-- Clear old items
		for _, item in ipairs(rig:GetDescendants()) do
			if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("BodyColors") or item:IsA("CharacterMesh") then
				item:Destroy()
			end
		end
		
		local head = rig:FindFirstChild("Head")
		if head then
			for _, item in ipairs(head:GetChildren()) do
				if item:IsA("Decal") then item:Destroy() end
			end
		end

		-- Apply description
		local successApply = pcall(function()
			hum:ApplyDescription(desc)
		end)

		-- Fallback for custom rigs
		if not successApply and userId then
			local aSuccess, appearance = pcall(function() return Players:GetCharacterAppearanceAsync(userId) end)
			if aSuccess and appearance then
				for _, item in ipairs(appearance:GetDescendants()) do
					if item:IsA("Accessory") then
						pcall(function() hum:AddAccessory(item:Clone()) end)
					elseif item:IsA("Shirt") or item:IsA("Pants") or item:IsA("BodyColors") or item:IsA("CharacterMesh") then
						item:Clone().Parent = rig
					end
				end
			end
		end
		
		-- Force apply Face
		if desc.Face > 0 and head then
			local face = Instance.new("Decal")
			face.Name = "face"
			face.Texture = "rbxassetid://" .. desc.Face
			face.Parent = head
		end
	end

	VisTab:CreateToggle({
		name = "Others Avatar Spoofer",
		value = false,
		callback = function(v)
			avatarEnabled = v
			appliedRigs = {}
			
			if v then
				cachedDesc = nil
				targetUserId = nil
				if targetUsername ~= "" then
					task.spawn(function()
						cachedDesc, targetUserId = getDesc(targetUsername)
					end)
				end
			else
				-- Revert everything to their own actual avatars
				task.spawn(function()
					local rigs = workspace:FindFirstChild("Rigs")
					if rigs then
						for _, rig in ipairs(rigs:GetChildren()) do
							-- Check if it's a real player
							local plr = Players:FindFirstChild(rig.Name)
							if plr and plr ~= LP then
								local myDesc, myId = getDesc(plr.Name)
								if myDesc then
									applyToRig(rig, myDesc, myId)
									task.wait(0.1) -- Small delay to prevent rate limits
								end
							end
						end
					end
				end)
			end
		end,
	})

	VisTab:CreateInput({
		name = "Username:",
		placeholder = "Enter username",
		removeTextAfterFocusLost = false,
		callback = function(text)
			targetUsername = text
			cachedDesc = nil
			targetUserId = nil
			appliedRigs = {}
			
			if avatarEnabled and targetUsername ~= "" then
				task.spawn(function()
					cachedDesc, targetUserId = getDesc(targetUsername)
				end)
			end
		end,
	})

	-- Live updating loop
	RunService.Heartbeat:Connect(function()
		if not avatarEnabled then return end
		if not targetUsername or targetUsername == "" then return end
		
		-- Wait for description to load
		if not cachedDesc then
			cachedDesc, targetUserId = getDesc(targetUsername)
			if not cachedDesc then return end
		end

		-- Build a table of valid players (excluding LocalPlayer)
		local validPlayers = {}
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LP then
				validPlayers[plr.Name] = true
			end
		end

		local rigs = workspace:FindFirstChild("Rigs")
		if not rigs then return end
		
		local activeRigs = {}
		
		for _, rig in ipairs(rigs:GetChildren()) do
			-- NEXTBOT CHECK: Only edit rigs that match an actual player in the game
			if validPlayers[rig.Name] then
				activeRigs[rig] = true
				
				-- If we haven't applied the avatar to this specific rig yet, do it now
				if not appliedRigs[rig] then
					appliedRigs[rig] = true
					applyToRig(rig, cachedDesc, targetUserId)
				end
			end
		end
		
		-- Cleanup the cache
		for rig in pairs(appliedRigs) do
			if not activeRigs[rig] then
				appliedRigs[rig] = nil
			end
		end
	end)
end

