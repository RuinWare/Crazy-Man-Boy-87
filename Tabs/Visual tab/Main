--[[
===========================
FULLBRIGHT
===========================
]]--

do
	local fullbrightEnabled = false
	local currentLevel = "Medium"
	local RunService = game:GetService("RunService")
	local Lighting = game:GetService("Lighting")

	-- Save original lighting properties so we can revert cleanly
	local originalProps = {
		Brightness = Lighting.Brightness,
		ClockTime = Lighting.ClockTime,
		GlobalShadows = Lighting.GlobalShadows,
		Ambient = Lighting.Ambient,
		OutdoorAmbient = Lighting.OutdoorAmbient,
		FogEnd = Lighting.FogEnd,
		FogStart = Lighting.FogStart,
		FogColor = Lighting.FogColor
	}
	
	-- Track atmospheric objects that we might need to hide
	local hiddenObjects = {}

	local function applyFullbright()
		if not fullbrightEnabled then return end

		-- Nuke fog
		Lighting.FogEnd = 100000
		Lighting.FogStart = 0
		Lighting.FogColor = Color3.fromRGB(255, 255, 255)

		-- Hide any Atmosphere or Clouds
		for _, v in ipairs(Lighting:GetDescendants()) do
			if v:IsA("Atmosphere") or v:IsA("Sky") then
				if not hiddenObjects[v] then
					hiddenObjects[v] = v.Parent
					v.Parent = nil -- Hide it
				end
			end
		end
		local terrain = workspace:FindFirstChild("Terrain")
		if terrain then
			local clouds = terrain:FindFirstChild("Clouds")
			if clouds and not hiddenObjects[clouds] then
				hiddenObjects[clouds] = clouds.Parent
				clouds.Parent = nil
			end
		end

		-- Apply settings based on level
		if currentLevel == "Low" then
			Lighting.Brightness = 2
			Lighting.ClockTime = 14
			Lighting.GlobalShadows = true
			Lighting.Ambient = Color3.fromRGB(120, 120, 120)
			Lighting.OutdoorAmbient = Color3.fromRGB(120, 120, 120)
		elseif currentLevel == "Medium" then
			Lighting.Brightness = 3
			Lighting.ClockTime = 12
			Lighting.GlobalShadows = false
			Lighting.Ambient = Color3.fromRGB(200, 200, 200)
			Lighting.OutdoorAmbient = Color3.fromRGB(200, 200, 200)
		elseif currentLevel == "Extreme" then
			Lighting.Brightness = 10
			Lighting.ClockTime = 12
			Lighting.GlobalShadows = false
			Lighting.Ambient = Color3.fromRGB(255, 255, 255)
			Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
		end
	end

	local function revertFullbright()
		-- Restore original lighting
		for prop, val in pairs(originalProps) do
			pcall(function()
				Lighting[prop] = val
			end)
		end

		-- Restore hidden objects
		for obj, parent in pairs(hiddenObjects) do
			if parent then
				pcall(function()
					obj.Parent = parent
				end)
			end
		end
		hiddenObjects = {}
	end

	VisTab:CreateDivider({ text = "Lighting" })

	VisTab:CreateToggle({
		name = "Fullbright",
		value = false,
		callback = function(v)
			fullbrightEnabled = v
			if v then
				applyFullbright()
			else
				revertFullbright()
			end
		end,
	})

	VisTab:CreateDropdown({
		name = "Level:",
		options = { "Low", "Medium", "Extreme" },
		default = { "Medium" },
		multiSelect = false,
		callback = function(selected)
			currentLevel = type(selected) == "table" and selected[1] or selected
			if fullbrightEnabled then
				applyFullbright() -- Instantly update if changed while on
			end
		end,
	})

	-- Loop to enforce the lighting every frame (stops the game from overriding it)
	RunService.Heartbeat:Connect(function()
		if fullbrightEnabled then
			applyFullbright()
		end
	end)
end

--[[
===========================
HUD COLORS (v.2.0)
===========================
]]--

do
	local hudEnabled = false
	local healthColor = Color3.fromRGB(255, 255, 255)
	local speedColor = Color3.fromRGB(255, 255, 255)
	
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local LP = Players.LocalPlayer
	
	-- Store originals per instance
	local savedColors = {}

	-- Helper to find the new UI elements safely
	local function getHUDElements()
		local playerGui = LP:FindFirstChild("PlayerGui")
		if not playerGui then return nil end
		
		local gameHud = playerGui:FindFirstChild("GameHud")
		if not gameHud then return nil end
		
		local root = gameHud:FindFirstChild("Root")
		if not root then return nil end
		
		local bottomLeft = root:FindFirstChild("BottomLeft")
		if not bottomLeft then return nil end
		
		-- 1. Speedometer Path
		local plate = bottomLeft:FindFirstChild("Plate")
		local content = plate and plate:FindFirstChild("Content")
		local speedText = content and content:FindFirstChild("Value")
		local speedIcon = content and content:FindFirstChild("Icon")
		
		-- 2. Health Path
		local row = bottomLeft:FindFirstChild("Row")
		local rowPlate = row and row:FindFirstChild("Plate")
		local rowContent = rowPlate and rowPlate:FindFirstChild("Content")
		local healthText = rowContent and rowContent:FindFirstChild("Value")
		local healthIcon = rowContent and rowContent:FindFirstChild("Icon")
		
		return {
			HealthIcon = healthIcon,
			HealthText = healthText,
			SpeedImage = speedIcon,  -- Keeping variable name consistent with old script
			SpeedText = speedText
		}
	end

	-- Save original colors based on the specific UI instance
	local function saveOriginalColor(inst, prop)
		if inst and not savedColors[inst] then
			savedColors[inst] = inst[prop]
		end
	end

	-- Apply the chosen colors
	local function applyColors()
		local elements = getHUDElements()
		if not elements then return end
		
		-- Health
		if elements.HealthIcon then 
			saveOriginalColor(elements.HealthIcon, "ImageColor3")
			elements.HealthIcon.ImageColor3 = healthColor 
		end
		if elements.HealthText then 
			saveOriginalColor(elements.HealthText, "TextColor3")
			elements.HealthText.TextColor3 = healthColor 
		end
		
		-- Speedometer
		if elements.SpeedImage then 
			saveOriginalColor(elements.SpeedImage, "ImageColor3")
			elements.SpeedImage.ImageColor3 = speedColor 
		end
		if elements.SpeedText then 
			saveOriginalColor(elements.SpeedText, "TextColor3")
			elements.SpeedText.TextColor3 = speedColor 
		end
	end

	-- Revert to original colors
	local function revertColors()
		local elements = getHUDElements()
		if not elements then return end
		
		if elements.HealthIcon and savedColors[elements.HealthIcon] then 
			elements.HealthIcon.ImageColor3 = savedColors[elements.HealthIcon] 
		end
		if elements.HealthText and savedColors[elements.HealthText] then 
			elements.HealthText.TextColor3 = savedColors[elements.HealthText] 
		end
		
		if elements.SpeedImage and savedColors[elements.SpeedImage] then 
			elements.SpeedImage.ImageColor3 = savedColors[elements.SpeedImage] 
		end
		if elements.SpeedText and savedColors[elements.SpeedText] then 
			elements.SpeedText.TextColor3 = savedColors[elements.SpeedText] 
		end
	end

	VisTab:CreateDivider()

	VisTab:CreateToggle({
		name = "Change HUD Colors",
		value = false,
		callback = function(v)
			hudEnabled = v
			if not v then
				revertColors()
			end
		end,
	})

	VisTab:CreateColorPicker({
		name = "Health",
		color = Color3.fromRGB(255, 50, 50), -- Default red
		callback = function(color)
			healthColor = color
			if hudEnabled then applyColors() end
		end,
	})

	VisTab:CreateColorPicker({
		name = "Speedometer",
		color = Color3.fromRGB(255, 255, 255), -- Default white
		callback = function(color)
			speedColor = color
			if hudEnabled then applyColors() end
		end,
	})

	-- Enforce colors every frame, wrapped in pcall just in case the UI disappears mid-frame
	RunService.Heartbeat:Connect(function()
		if hudEnabled then
			pcall(applyColors)
		end
	end)
end

--[[
===========================
HIDE HUD v2.1
===========================
]]--

do
	local hideHudEnabled = false
	local hideJumpEnabled = false
	
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local LP = Players.LocalPlayer

	VisTab:CreateDivider()

	VisTab:CreateToggle({
		name = "Hide HUD",
		value = false,
		callback = function(v)
			hideHudEnabled = v
			if not v then
				-- One-time restore so the game can take back over
				local playerGui = LP:FindFirstChild("PlayerGui")
				local gameGui = playerGui and playerGui:FindFirstChild("Game")
				local hud = gameGui and gameGui:FindFirstChild("HUD")
				if hud then
					if hud:IsA("ScreenGui") then hud.Enabled = true else hud.Visible = true end
				end
				if gameGui and gameGui:IsA("ScreenGui") then gameGui.Enabled = true end
				
				local touchGui = playerGui and playerGui:FindFirstChild("TouchGui")
				local touchFrame = touchGui and touchGui:FindFirstChild("TouchControlFrame")
				local jumpButton = touchFrame and touchFrame:FindFirstChild("JumpButton")
				if jumpButton then jumpButton.Visible = true end
			end
		end,
	})

	VisTab:CreateToggle({
		name = "Hide Mobile Jump Button",
		value = false,
		callback = function(v)
			hideJumpEnabled = v
		end,
	})

	RunService.RenderStepped:Connect(function()
		-- IF MAIN TOGGLE IS OFF, STOP COMPLETELY. LET THE GAME HANDLE IT.
		if not hideHudEnabled then return end
		
		local playerGui = LP:FindFirstChild("PlayerGui")
		if not playerGui then return end

		local gameGui = playerGui:FindFirstChild("Game")
		local hud = gameGui and gameGui:FindFirstChild("HUD")

		local touchGui = playerGui:FindFirstChild("TouchGui")
		local jumpButton = nil
		
		if touchGui then
			local frame = touchGui:FindFirstChild("TouchControlFrame")
			if frame then
				jumpButton = frame:FindFirstChild("JumpButton")
			end
		end

		-- HIDE MAIN HUD
		if hud then
			if hud:IsA("ScreenGui") then
				hud.Enabled = false
			else
				hud.Visible = false
				if gameGui and gameGui:IsA("ScreenGui") then
					gameGui.Enabled = false
				end
			end
		elseif gameGui and gameGui:IsA("ScreenGui") then
			gameGui.Enabled = false
		end
		
		-- HANDLE JUMP BUTTON
		if jumpButton then
			jumpButton.Visible = not hideJumpEnabled
		end
	end)
end

