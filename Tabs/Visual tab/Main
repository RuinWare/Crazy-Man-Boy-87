do
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local player = Players.LocalPlayer

    local espEnabled = false
    local showPlayers = false
    local showNextbots = false
    local optBox = false
    local optChams = false
    local optName = false
    local optDistance = false
    local optTracers = false

    local boxSize = 1
    local boxType = "Full"
    local boxOutlineColor = Color3.fromRGB(255, 255, 255)
    local fillBox = false
    local fillColor = Color3.fromRGB(255, 255, 255)
    local fillAssetId = ""
    local boxTransparency = 0
    local boxFillTransparency = 0.5

    local chamsColor = Color3.fromRGB(255, 0, 0)
    local chamsTransparency = 0.5

    local nameColorPlayers = Color3.fromRGB(255, 255, 255)
    local nameColorNextbots = Color3.fromRGB(255, 100, 100)
    local nameTransparency = 0

    local distanceColorPlayers = Color3.fromRGB(200, 200, 200)
    local distanceColorNextbots = Color3.fromRGB(255, 150, 150)
    local distanceTransparency = 0

    local tracerColorPlayers = Color3.fromRGB(255, 255, 255)
    local tracerColorNextbots = Color3.fromRGB(255, 100, 100)
    local tracerPart = "Bottom"
    local tracerTransparency = 0

    local gui = Instance.new("ScreenGui")
    gui.Name = "Qa6-¡》♤-w¿L9-ZELA♧-aHTW8SBQ9SHWKSHEKWSYWMaSKWWMSMDGW8YDGD7¡¡"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 999
    if gethui then pcall(function() gui.Parent = gethui() end) end
    if not gui.Parent then gui.Parent = player:WaitForChild("PlayerGui") end

    local playerNames = {}
    local function refreshPlayerNames()
        playerNames = {}
        for _, p in ipairs(Players:GetPlayers()) do
            playerNames[p.Name] = true
        end
    end
    refreshPlayerNames()
    Players.PlayerAdded:Connect(refreshPlayerNames)
    Players.PlayerRemoving:Connect(function(p) playerNames[p.Name] = nil end)

    local rigData = {}

    local function hideData(data)
        if data.boxContainer and data.boxContainer.Visible then data.boxContainer.Visible = false end
        if data.chamsBox and data.chamsBox.Visible then data.chamsBox.Visible = false end
        if data.nameLabel and data.nameLabel.Visible then data.nameLabel.Visible = false end
        if data.distLabel and data.distLabel.Visible then data.distLabel.Visible = false end
        if data.tracer and data.tracer.Visible then data.tracer.Visible = false end
        if data.highlight then
            pcall(function() data.highlight:Destroy() end)
            data.highlight = nil
        end
    end

    local function clearRigData(data)
        if data.boxContainer then data.boxContainer:Destroy() end
        if data.chamsBox then data.chamsBox:Destroy() end
        if data.nameLabel then data.nameLabel:Destroy() end
        if data.distLabel then data.distLabel:Destroy() end
        if data.tracer then data.tracer:Destroy() end
        if data.highlight then pcall(function() data.highlight:Destroy() end) end
    end

    local function buildRigElements()
        local data = {}

        local boxContainer = Instance.new("Frame")
        boxContainer.BackgroundTransparency = 1
        boxContainer.BorderSizePixel = 0
        boxContainer.Visible = false
        boxContainer.Parent = gui
        data.boxContainer = boxContainer

        data.sides = {}
        for i = 1, 4 do
            local f = Instance.new("Frame")
            f.BorderSizePixel = 0
            f.Parent = boxContainer
            data.sides[i] = f
        end
        data.sides[1].Position = UDim2.new(0, 0, 0, 0); data.sides[1].Size = UDim2.new(1, 0, 0, 2)
        data.sides[2].Position = UDim2.new(0, 0, 1, -2); data.sides[2].Size = UDim2.new(1, 0, 0, 2)
        data.sides[3].Position = UDim2.new(0, 0, 0, 0); data.sides[3].Size = UDim2.new(0, 2, 1, 0)
        data.sides[4].Position = UDim2.new(1, -2, 0, 0); data.sides[4].Size = UDim2.new(0, 2, 1, 0)

        data.corners = {}
        for i = 1, 8 do
            local f = Instance.new("Frame")
            f.BorderSizePixel = 0
            f.Parent = boxContainer
            data.corners[i] = f
        end
        data.corners[1].Position = UDim2.new(0, 0, 0, 0); data.corners[1].Size = UDim2.new(0.25, 0, 0, 2)
        data.corners[2].Position = UDim2.new(0, 0, 0, 0); data.corners[2].Size = UDim2.new(0, 2, 0.25, 0)
        data.corners[3].Position = UDim2.new(0.75, 0, 0, 0); data.corners[3].Size = UDim2.new(0.25, 0, 0, 2)
        data.corners[4].Position = UDim2.new(1, -2, 0, 0); data.corners[4].Size = UDim2.new(0, 2, 0.25, 0)
        data.corners[5].Position = UDim2.new(0, 0, 1, -2); data.corners[5].Size = UDim2.new(0.25, 0, 0, 2)
        data.corners[6].Position = UDim2.new(0, 0, 0.75, 0); data.corners[6].Size = UDim2.new(0, 2, 0.25, 0)
        data.corners[7].Position = UDim2.new(0.75, 0, 1, -2); data.corners[7].Size = UDim2.new(0.25, 0, 0, 2)
        data.corners[8].Position = UDim2.new(1, -2, 0.75, 0); data.corners[8].Size = UDim2.new(0, 2, 0.25, 0)

        local fillFrame = Instance.new("Frame")
        fillFrame.BorderSizePixel = 0
        fillFrame.BackgroundTransparency = 1
        fillFrame.Size = UDim2.new(1, 0, 1, 0)
        fillFrame.Parent = boxContainer
        data.fillFrame = fillFrame

        local fillImage = Instance.new("ImageLabel")
        fillImage.BorderSizePixel = 0
        fillImage.BackgroundTransparency = 1
        fillImage.ScaleType = Enum.ScaleType.Stretch
        fillImage.ImageTransparency = 1
        fillImage.Size = UDim2.new(1, 0, 1, 0)
        fillImage.Parent = boxContainer
        data.fillImage = fillImage

        local chamsBox = Instance.new("Frame")
        chamsBox.BorderSizePixel = 0
        chamsBox.BackgroundTransparency = 1
        chamsBox.Visible = false
        chamsBox.Parent = gui
        local cc = Instance.new("UICorner")
        cc.CornerRadius = UDim.new(0, 8)
        cc.Parent = chamsBox
        data.chamsBox = chamsBox

        local nameLabel = Instance.new("TextLabel")
        nameLabel.BackgroundTransparency = 1
        nameLabel.Font = Enum.Font.Code
        nameLabel.TextSize = 14
        nameLabel.TextStrokeTransparency = 0
        nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        nameLabel.TextXAlignment = Enum.TextXAlignment.Center
        nameLabel.TextYAlignment = Enum.TextYAlignment.Bottom
        nameLabel.Parent = gui
        nameLabel.Text = ""
        nameLabel.Visible = false
        data.nameLabel = nameLabel

        local distLabel = Instance.new("TextLabel")
        distLabel.BackgroundTransparency = 1
        distLabel.Font = Enum.Font.Code
        distLabel.TextSize = 14
        distLabel.TextStrokeTransparency = 0
        distLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        distLabel.TextXAlignment = Enum.TextXAlignment.Left
        distLabel.TextYAlignment = Enum.TextYAlignment.Bottom
        distLabel.Parent = gui
        distLabel.Text = ""
        distLabel.Visible = false
        data.distLabel = distLabel

        local tracer = Instance.new("Frame")
        tracer.BorderSizePixel = 0
        tracer.AnchorPoint = Vector2.new(0.5, 0.5)
        tracer.BackgroundColor3 = Color3.new(1, 1, 1)
        tracer.Parent = gui
        tracer.Visible = false
        data.tracer = tracer

        data.highlight = nil
        data.anchor = nil
        data.topOffset = 0
        data.botOffset = 0
        return data
    end

    -- Collects rigs from workspace.Players first, then workspace.Rigs.
    -- If a name appears in both, workspace.Players wins (Rigs version skipped).
    local function collectRigs()
        local result = {}
        local seen = {}
        local nameInPlayers = {}

        local playersFolder = workspace:FindFirstChild("Players")
        if playersFolder then
            for _, child in ipairs(playersFolder:GetChildren()) do
                if (child:IsA("Model") or child:IsA("BasePart")) and not seen[child] then
                    seen[child] = true
                    nameInPlayers[child.Name] = true
                    table.insert(result, child)
                end
            end
        end

        local rigsFolder = workspace:FindFirstChild("Rigs")
        if rigsFolder then
            for _, child in ipairs(rigsFolder:GetChildren()) do
                if (child:IsA("Model") or child:IsA("BasePart")) and not seen[child] then
                    if not nameInPlayers[child.Name] then
                        seen[child] = true
                        table.insert(result, child)
                    end
                end
            end
        end

        return result
    end

    local function computeBounds(rig, isPlayer)
        if isPlayer then
            local hrp = rig:FindFirstChild("HumanoidRootPart")
            if not hrp then return nil end
            local okBB, cf, sz = pcall(function() return rig:GetBoundingBox() end)
            if not okBB or not cf then return nil end
            return hrp, (cf.Position.Y + sz.Y / 2) - hrp.Position.Y, (cf.Position.Y - sz.Y / 2) - hrp.Position.Y
        end

        local hb = rig:FindFirstChild("Hitbox")
        if not hb then return nil end
        if hb:IsA("BasePart") then
            return hb, hb.Size.Y / 2, -hb.Size.Y / 2
        end
        if hb:IsA("Model") then
            local anchor = hb.PrimaryPart
            if not anchor then
                for _, d in ipairs(hb:GetDescendants()) do
                    if d:IsA("BasePart") then anchor = d break end
                end
            end
            if not anchor then return nil end
            local okBB, cf, sz = pcall(function() return hb:GetBoundingBox() end)
            if not okBB or not cf then return nil end
            return anchor, (cf.Position.Y + sz.Y / 2) - anchor.Position.Y, (cf.Position.Y - sz.Y / 2) - anchor.Position.Y
        end
        return nil
    end

    local function projectPoint(worldPos)
        local cam = workspace.CurrentCamera
        if not cam then return nil, false end
        local sp, onScreen = cam:WorldToViewportPoint(worldPos)
        return sp, onScreen and sp.Z > 0
    end

    RunService.RenderStepped:Connect(function()
        local cam = workspace.CurrentCamera
        if not cam then return end
        local viewportSize = cam.ViewportSize
        local camPos = cam.CFrame.Position
        local camLook = cam.CFrame.LookVector

        if not espEnabled then
            for _, data in pairs(rigData) do hideData(data) end
            return
        end

        local seen = {}

        for _, rig in ipairs(collectRigs()) do
            if rig.Name == player.Name then continue end

            local isPlayer = playerNames[rig.Name] == true
            local shouldRender = (isPlayer and showPlayers) or (not isPlayer and showNextbots)

            if not shouldRender then
                local data = rigData[rig]
                if data then hideData(data) end
                continue
            end

            local refPos
            if isPlayer then
                local hrp = rig:FindFirstChild("HumanoidRootPart")
                if hrp then refPos = hrp.Position end
            else
                local hb = rig:FindFirstChild("Hitbox")
                if hb and hb:IsA("BasePart") then refPos = hb.Position
                elseif hb then
                    for _, d in ipairs(hb:GetDescendants()) do
                        if d:IsA("BasePart") then refPos = d.Position break end
                    end
                end
            end
            if not refPos then continue end

            local toRig = refPos - camPos
            if toRig:Dot(camLook) < 0 or toRig.Magnitude > 500 then
                local data = rigData[rig]
                if data then hideData(data) end
                continue
            end

            seen[rig] = true

            local data = rigData[rig]
            if not data then
                data = buildRigElements()
                rigData[rig] = data
                data.anchor, data.topOffset, data.botOffset = computeBounds(rig, isPlayer)
            end

            if not data.anchor or not data.anchor.Parent then
                data.anchor, data.topOffset, data.botOffset = computeBounds(rig, isPlayer)
            end

            if not data.anchor then
                hideData(data)
                continue
            end

            local anchorPos = data.anchor.Position
            local topWorld = Vector3.new(anchorPos.X, anchorPos.Y + data.topOffset, anchorPos.Z)
            local botWorld = Vector3.new(anchorPos.X, anchorPos.Y + data.botOffset, anchorPos.Z)
            local centerWorld = (topWorld + botWorld) / 2

            local topScreen, topOn = projectPoint(topWorld)
            local botScreen, botOn = projectPoint(botWorld)
            local centerScreen, centerOn = projectPoint(centerWorld)
            local onScreen = topOn and botOn and centerOn

            local tNameColor = isPlayer and nameColorPlayers or nameColorNextbots
            local tDistColor = isPlayer and distanceColorPlayers or distanceColorNextbots
            local tTracerColor = isPlayer and tracerColorPlayers or tracerColorNextbots

            if optBox and onScreen then
                data.boxContainer.Visible = true
                local boxHeight = math.abs(botScreen.Y - topScreen.Y)
                local boxWidth = boxHeight * 0.55 * boxSize
                local px = math.floor(topScreen.X - boxWidth / 2 + 0.5)
                local py = math.floor(topScreen.Y + 0.5)
                local pw = math.floor(boxWidth + 0.5)
                local ph = math.floor(boxHeight + 0.5)
                data.boxContainer.Position = UDim2.fromOffset(px, py)
                data.boxContainer.Size = UDim2.fromOffset(pw, ph)

                local isFull = (boxType == "Full")
                for i = 1, 4 do
                    data.sides[i].Visible = isFull
                    data.sides[i].BackgroundColor3 = boxOutlineColor
                    data.sides[i].BackgroundTransparency = boxTransparency
                end
                for i = 1, 8 do
                    data.corners[i].Visible = not isFull
                    data.corners[i].BackgroundColor3 = boxOutlineColor
                    data.corners[i].BackgroundTransparency = boxTransparency
                end

                if fillBox then
                    local hasAsset = fillAssetId ~= "" and tonumber(fillAssetId)
                    if hasAsset then
                        data.fillImage.Visible = true
                        data.fillImage.Image = "rbxassetid://" .. tostring(fillAssetId)
                        data.fillImage.ImageTransparency = boxFillTransparency
                        data.fillFrame.BackgroundTransparency = 1
                    else
                        data.fillImage.Visible = false
                        data.fillImage.ImageTransparency = 1
                        data.fillFrame.BackgroundColor3 = fillColor
                        data.fillFrame.BackgroundTransparency = boxFillTransparency
                    end
                else
                    data.fillImage.Visible = false
                    data.fillImage.ImageTransparency = 1
                    data.fillFrame.BackgroundTransparency = 1
                end
            elseif data.boxContainer.Visible then
                data.boxContainer.Visible = false
            end

            if optChams then
                if isPlayer then
                    if not data.highlight then
                        local h = Instance.new("Highlight")
                        h.FillColor = chamsColor
                        h.FillTransparency = chamsTransparency
                        h.OutlineTransparency = 1
                        h.Parent = rig
                        data.highlight = h
                    else
                        if data.highlight.Parent ~= rig then data.highlight.Parent = rig end
                        data.highlight.FillColor = chamsColor
                        data.highlight.FillTransparency = chamsTransparency
                    end
                    if data.chamsBox.Visible then data.chamsBox.Visible = false end
                else
                    local hb = rig:FindFirstChild("Hitbox")
                    if hb and (hb:IsA("BasePart") or hb:IsA("Model")) then
                        if not data.highlight then
                            local h = Instance.new("Highlight")
                            h.FillColor = chamsColor
                            h.FillTransparency = chamsTransparency
                            h.OutlineTransparency = 1
                            h.Parent = hb
                            data.highlight = h
                        else
                            if data.highlight.Parent ~= hb then data.highlight.Parent = hb end
                            data.highlight.FillColor = chamsColor
                            data.highlight.FillTransparency = chamsTransparency
                        end
                        if data.chamsBox.Visible then data.chamsBox.Visible = false end
                    elseif onScreen then
                        if data.highlight then pcall(function() data.highlight:Destroy() end) data.highlight = nil end
                        data.chamsBox.Visible = true
                        local boxHeight = math.abs(botScreen.Y - topScreen.Y)
                        local boxWidth = boxHeight * 0.55 * boxSize
                        data.chamsBox.Position = UDim2.fromOffset(math.floor(topScreen.X - boxWidth / 2 + 0.5), math.floor(topScreen.Y + 0.5))
                        data.chamsBox.Size = UDim2.fromOffset(math.floor(boxWidth + 0.5), math.floor(boxHeight + 0.5))
                        data.chamsBox.BackgroundColor3 = chamsColor
                        data.chamsBox.BackgroundTransparency = chamsTransparency
                    else
                        if data.highlight then pcall(function() data.highlight:Destroy() end) data.highlight = nil end
                        if data.chamsBox.Visible then data.chamsBox.Visible = false end
                    end
                end
            else
                if data.highlight then pcall(function() data.highlight:Destroy() end) data.highlight = nil end
                if data.chamsBox.Visible then data.chamsBox.Visible = false end
            end

            if optName and topOn then
                data.nameLabel.Visible = true
                data.nameLabel.Text = rig.Name
                data.nameLabel.TextColor3 = tNameColor
                data.nameLabel.TextTransparency = nameTransparency
                data.nameLabel.TextStrokeTransparency = nameTransparency
                data.nameLabel.Position = UDim2.fromOffset(math.floor(topScreen.X - 100 + 0.5), math.floor(topScreen.Y - 20 + 0.5))
                data.nameLabel.Size = UDim2.fromOffset(200, 16)
            elseif data.nameLabel.Visible then
                data.nameLabel.Visible = false
            end

            if optDistance and topOn then
                data.distLabel.Visible = true
                local distStuds = (centerWorld - camPos).Magnitude
                data.distLabel.Text = "[" .. math.floor(distStuds) .. "m]"
                data.distLabel.TextColor3 = tDistColor
                data.distLabel.TextTransparency = distanceTransparency
                data.distLabel.TextStrokeTransparency = distanceTransparency
                data.distLabel.Position = UDim2.fromOffset(math.floor(topScreen.X + 5 + 0.5), math.floor(topScreen.Y - 20 + 0.5))
                data.distLabel.Size = UDim2.fromOffset(100, 16)
            elseif data.distLabel.Visible then
                data.distLabel.Visible = false
            end

            if optTracers and centerOn then
                local fromPos
                if tracerPart == "Bottom" then
                    fromPos = Vector2.new(viewportSize.X / 2, viewportSize.Y)
                elseif tracerPart == "Center" then
                    fromPos = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
                else
                    fromPos = Vector2.new(viewportSize.X / 2, 0)
                end
                local toPos = Vector2.new(centerScreen.X, centerScreen.Y)
                local delta = toPos - fromPos
                local length = delta.Magnitude
                local angle = math.deg(math.atan2(delta.Y, delta.X))
                local mid = (fromPos + toPos) / 2

                data.tracer.Visible = true
                data.tracer.Position = UDim2.fromOffset(math.floor(mid.X + 0.5), math.floor(mid.Y + 0.5))
                data.tracer.Size = UDim2.fromOffset(math.floor(length + 0.5), 1)
                data.tracer.Rotation = angle
                data.tracer.BackgroundColor3 = tTracerColor
                data.tracer.BackgroundTransparency = tracerTransparency
            elseif data.tracer.Visible then
                data.tracer.Visible = false
            end
        end

        for rig, data in pairs(rigData) do
            if not seen[rig] then
                clearRigData(data)
                rigData[rig] = nil
            end
        end
    end)

    VisTab:CreateDivider({ text = "ESP" })

    VisTab:CreateToggle({
        name = "ESP",
        currentValue = false,
        flag = "ESP_Toggle",
        callback = function(v) espEnabled = v end,
    })

    VisTab:CreateDropdown({
        name = "Selection",
        options = { "Players", "Nextbots" },
        currentOption = {},
        multiSelect = true,
        flag = "ESP_Selection",
        callback = function(selected)
            showPlayers = false
            showNextbots = false
            if type(selected) == "table" then
                for _, n in ipairs(selected) do
                    if n == "Players" then showPlayers = true end
                    if n == "Nextbots" then showNextbots = true end
                end
            end
        end,
    })

    VisTab:CreateDropdown({
        name = "Options:",
        options = { "Box ESP", "Chams", "Name", "Distance", "Tracers" },
        currentOption = {},
        multiSelect = true,
        flag = "ESP_Options",
        callback = function(selected)
            optBox = false; optChams = false; optName = false; optDistance = false; optTracers = false
            if type(selected) == "table" then
                for _, n in ipairs(selected) do
                    if n == "Box ESP" then optBox = true end
                    if n == "Chams" then optChams = true end
                    if n == "Name" then optName = true end
                    if n == "Distance" then optDistance = true end
                    if n == "Tracers" then optTracers = true end
                end
            end
        end,
    })

    VisTab:CreateSlider({ name = "Box Size", range = {0.5, 2.0}, increment = 0.05, suffix = "x", currentValue = 1, flag = "ESP_BoxSize", callback = function(v) boxSize = v end })
    VisTab:CreateDropdown({ name = "Box Type", options = { "Full", "Corners" }, currentOption = { "Full" }, multiSelect = false, flag = "ESP_BoxType", callback = function(sel) local p = type(sel) == "table" and sel[1] or sel; if p then boxType = p end end })
    VisTab:CreateColorPicker({ name = "Box Outline Color", color = Color3.fromRGB(255, 255, 255), flag = "ESP_BoxColor", callback = function(c) boxOutlineColor = c end })
    VisTab:CreateToggle({ name = "Fill Box", currentValue = false, flag = "ESP_FillBox", callback = function(v) fillBox = v end })
    VisTab:CreateColorPicker({ name = "Fill Color", color = Color3.fromRGB(255, 255, 255), flag = "ESP_FillColor", callback = function(c) fillColor = c end })
    VisTab:CreateInput({ name = "Box Fill Asset ID (Optional)", placeholder = "e.g. 1234", flag = "ESP_FillAsset", callback = function(text) fillAssetId = text or "" end })
    VisTab:CreateSlider({ name = "Box Transparency", range = {0, 1}, increment = 0.01, suffix = "", currentValue = 0, flag = "ESP_BoxTransparency", callback = function(v) boxTransparency = v end })
    VisTab:CreateSlider({ name = "Box Fill Transparency", range = {0, 1}, increment = 0.01, suffix = "", currentValue = 0.5, flag = "ESP_BoxFillTransparency", callback = function(v) boxFillTransparency = v end })
    VisTab:CreateColorPicker({ name = "Chams Color", color = Color3.fromRGB(255, 0, 0), flag = "ESP_ChamsColor", callback = function(c) chamsColor = c end })
    VisTab:CreateSlider({ name = "Chams Transparency", range = {0, 1}, increment = 0.01, suffix = "", currentValue = 0.5, flag = "ESP_ChamsTransparency", callback = function(v) chamsTransparency = v end })
    VisTab:CreateColorPicker({ name = "Name Color Players", color = Color3.fromRGB(255, 255, 255), flag = "ESP_NameColorPlayers", callback = function(c) nameColorPlayers = c end })
    VisTab:CreateColorPicker({ name = "Name Color Nextbots", color = Color3.fromRGB(255, 100, 100), flag = "ESP_NameColorNextbots", callback = function(c) nameColorNextbots = c end })
    VisTab:CreateSlider({ name = "Name Transparency", range = {0, 1}, increment = 0.01, suffix = "", currentValue = 0, flag = "ESP_NameTransparency", callback = function(v) nameTransparency = v end })
    VisTab:CreateColorPicker({ name = "Distance Color Players", color = Color3.fromRGB(200, 200, 200), flag = "ESP_DistColorPlayers", callback = function(c) distanceColorPlayers = c end })
    VisTab:CreateColorPicker({ name = "Distance Color Nextbots", color = Color3.fromRGB(255, 150, 150), flag = "ESP_DistColorNextbots", callback = function(c) distanceColorNextbots = c end })
    VisTab:CreateSlider({ name = "Distance Transparency", range = {0, 1}, increment = 0.01, suffix = "", currentValue = 0, flag = "ESP_DistTransparency", callback = function(v) distanceTransparency = v end })
    VisTab:CreateColorPicker({ name = "Tracers Color Players", color = Color3.fromRGB(255, 255, 255), flag = "ESP_TracerColorPlayers", callback = function(c) tracerColorPlayers = c end })
    VisTab:CreateColorPicker({ name = "Tracers Color Nextbots", color = Color3.fromRGB(255, 100, 100), flag = "ESP_TracerColorNextbots", callback = function(c) tracerColorNextbots = c end })
    VisTab:CreateDropdown({ name = "Tracers Part:", options = { "Bottom", "Center", "Top" }, currentOption = { "Bottom" }, multiSelect = false, flag = "ESP_TracerPart", callback = function(sel) local p = type(sel) == "table" and sel[1] or sel; if p then tracerPart = p end end })
    VisTab:CreateSlider({ name = "Tracers Transparency", range = {0, 1}, increment = 0.01, suffix = "", currentValue = 0, flag = "ESP_TracerTransparency", callback = function(v) tracerTransparency = v end })
end
